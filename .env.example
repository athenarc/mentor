# SR-agents environment
# Copy this file to .env and fill in local credentials.

# Primary Bastirr runtime configuration.
# This is the recommended path for main: choose a model profile and provide the
# key/base for the selected OpenAI-compatible provider.
BASTIRR_MODEL_PROFILE=openrouter_gpt5
BASTIRR_API_KEY=sk-or-v1-...
BASTIRR_API_BASE=https://openrouter.ai/api/v1

# Maximum seconds each agent code-execution step is allowed to run.
# The code default is lower (300); a larger value is useful for full SR workflows.
BASTIRR_EXECUTOR_TIMEOUT=1000

# Optional model-profile configuration.
# Bundled profiles live in bastirr/runtime_config/model_profiles.json.
# BASTIRR_MODEL_PROFILES_CONFIG=/absolute/path/to/model_profiles.json

# Optional direct OpenAI-compatible configuration without a bundled profile.
# Use this only when you intentionally want to bypass BASTIRR_MODEL_PROFILE:
# comment out BASTIRR_MODEL_PROFILE above before using these raw settings.
# BASTIRR_MODEL_BACKEND=openai
# BASTIRR_MODEL=gpt-5
# BASTIRR_API_KEY=sk-...
# BASTIRR_API_BASE=

# Optional LiteLLM local/self-hosted model example.
# Use this only without BASTIRR_MODEL_PROFILE.
# BASTIRR_MODEL_BACKEND=litellm
# BASTIRR_MODEL=ollama_chat/qwen3:latest
# BASTIRR_API_KEY=ollama
# BASTIRR_API_BASE=http://localhost:11434

# Legacy direct OpenAI fallback.
# Prefer BASTIRR_API_KEY for current Bastirr runs.
# OPENAI_API_KEY=sk-...

# Optional vaccine_indicators_demo credentials.
# These are not required for the main Bastirr profile-based workflow.
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_API_HOST=https://api.deepseek.com
