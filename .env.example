# Mentor environment
# Copy this file to .env and fill in local credentials.
#
# Env migration note: former BASTIRR_* / SR_AGENTS_* variables are now MENTOR_*.

# OpenRouter credentials (screening experiment presets).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Global runtime settings.
MENTOR_EXECUTOR_TIMEOUT=5000
MENTOR_MODEL_REQUEST_TIMEOUT=5000

# Optional model preset overrides.
# MENTOR_GPT5_MODEL=openai/gpt-5
# MENTOR_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro
# MENTOR_QWEN_OLLAMA_MODEL=qwen3.5:27b-bf16
# MENTOR_OLLAMA_API_BASE=http://localhost:11434/v1

# Optional full-pipeline runtime settings.
# MENTOR_MODEL_PROFILE=openrouter_gpt5
# MENTOR_API_KEY=sk-or-v1-...
# MENTOR_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-...
# MENTOR_MODEL_BACKEND=openai
# MENTOR_MODEL=gpt-5

# Optional vaccine_indicators_demo credentials.
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_API_HOST=https://api.deepseek.com

# Search MCP endpoints (optional)
SEARCH_BIP_MCP_URL=https://bip-mcp.imsi.athenarc.gr/mcp
SEARCH_BIP_AUTH_TOKEN=example_token
SEARCH_PUBMED_MCP_URL=https://pubmed-mcp.imsi.athenarc.gr/mcp

# Librarian search sources: local, bip, pubmed (comma-separated)
SEARCH_SOURCES=local
