# SR-agents Project Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# OpenAI-Compatible API Keys (REQUIRED for bastirr multi-agent system)
# ============================================================================
# Preferred runtime key path for Bastirr:
# - direct OpenAI: use your OpenAI key here
# - OpenRouter: use your OpenRouter key here
# - other OpenAI-compatible backends: use the corresponding key here
# Used by:
# - Bastirr multi-agent system (all agents)
# - vaccine_indicators_demo Stage 3 (extraction) and Stage 4 (synthesis)
BASTIRR_API_KEY=your_api_key_here

# Legacy direct OpenAI key fallback (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Mistral API Keys (for vaccine_indicators_demo Stage 1 - OCR)
# ============================================================================
# Get your API key from: https://console.mistral.ai/
# Used by: vaccine_indicators_demo PDF OCR processing
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================================================
# DeepSeek API Keys (for vaccine_indicators_demo Stage 2 - Cleaning)
# ============================================================================
# Get your API key from: https://platform.deepseek.com/
# Used by: vaccine_indicators_demo markdown cleaning
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_HOST=https://api.deepseek.com

# ============================================================================
# Model Configuration (OPTIONAL)
# ============================================================================
# Model backend: "openai" (default) or "litellm"
# Use "litellm" for local models (Ollama, vLLM), Anthropic, Bedrock, etc.
BASTIRR_MODEL_BACKEND=openai

# Model identifier for Bastirr agents.
# - OpenAI backend: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-5, etc.
# - OpenRouter via OpenAI backend: use explicit slugs like openai/gpt-5
# - LiteLLM backend: use provider-prefixed IDs, e.g.
#     anthropic/claude-3-5-sonnet-latest
#     ollama_chat/llama3.2
#     bedrock/anthropic.claude-3-sonnet-20240229-v1:0
#     azure/<DEPLOYMENT_NAME>
# If not set, defaults to "gpt-5"
BASTIRR_MODEL=gpt-5

# API base URL for OpenAI-compatible or local/self-hosted models (optional)
# e.g. http://localhost:11434 for Ollama, http://localhost:8000 for vLLM
#      https://openrouter.ai/api/v1 for OpenRouter
# BASTIRR_API_BASE=

# Optional runtime model profile.
# Profiles live in bastirr/runtime_config/model_profiles.json unless
# BASTIRR_MODEL_PROFILES_CONFIG points elsewhere.
# BASTIRR_MODEL_PROFILE=
# BASTIRR_MODEL_PROFILES_CONFIG=

# OpenRouter example using the bundled runtime profile:
# BASTIRR_MODEL_PROFILE=openrouter_gpt5
# BASTIRR_API_KEY=sk-or-v1-...
# BASTIRR_API_BASE=https://openrouter.ai/api/v1

# ============================================================================
# Execution Settings (OPTIONAL)
# ============================================================================
# Maximum seconds each agent code-execution step is allowed to run.
# smolagents defaults to 30s which is too short for processing many studies.
# Set to a generous value; max_steps still guards against infinite loops.
# If not set, defaults to 300 (5 minutes).
BASTIRR_EXECUTOR_TIMEOUT=500

# ============================================================================
# Search MCP endpoints (OPTIONAL)
# ============================================================================
# External MCP sources:
# - BIP (requires auth token)
# - PubMed (no auth token required)
SEARCH_BIP_MCP_URL=https://bip-mcp.imsi.athenarc.gr/mcp

# BIP MCP server requires authentication. Use token only or "Bearer example_token".
SEARCH_BIP_AUTH_TOKEN=example_token

# PubMed MCP endpoint (no auth token required).
SEARCH_PUBMED_MCP_URL=https://pubmed-mcp.imsi.athenarc.gr/mcp

# ============================================================================
# Librarian Search Source Selection
# ============================================================================
# Comma-separated values from:
#   { local, bip, pubmed }
# Examples:
#   SEARCH_SOURCES=local
#   SEARCH_SOURCES=bip,pubmed
#   SEARCH_SOURCES=local,bip,pubmed
SEARCH_SOURCES=local
