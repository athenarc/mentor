# SR-agents benchmark branch environment
# Copy this file to .env and fill in local credentials.

# OpenRouter benchmark credentials.
# Recommended for Gatekeeper benchmark presets in this branch.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Global runtime settings.
# BASTIRR_EXECUTOR_TIMEOUT controls smolagents code-execution steps.
# BASTIRR_MODEL_REQUEST_TIMEOUT controls provider HTTP/model requests.
BASTIRR_EXECUTOR_TIMEOUT=5000
BASTIRR_MODEL_REQUEST_TIMEOUT=5000

# Optional OpenRouter benchmark preset overrides.
# Keep these unset unless you intentionally want to point a preset key at a
# different provider/model ID while preserving the preset name in outputs.
# BASTIRR_GPT5_MODEL=openai/gpt-5
# BASTIRR_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro
# BASTIRR_QWEN_OLLAMA_MODEL=qwen3.5:27b-bf16
# BASTIRR_OLLAMA_API_BASE=http://localhost:11434/v1

# Optional Bastirr demo/runtime model settings.
# These are not required for the screening benchmark presets above.
# BASTIRR_MODEL_PROFILE=openrouter_gpt5
# BASTIRR_API_KEY=sk-or-v1-...
# BASTIRR_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-...
# BASTIRR_MODEL_BACKEND=openai
# BASTIRR_MODEL=gpt-5

# Optional vaccine_indicators_demo credentials.
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_API_HOST=https://api.deepseek.com

# ============================================================================
# Search MCP endpoints (OPTIONAL)
# ============================================================================
# External MCP sources:
# - BIP (requires auth token)
# - PubMed (no auth token required)
SEARCH_BIP_MCP_URL=https://bip-mcp.imsi.athenarc.gr/mcp

# BIP MCP server requires authentication. Use token only or "Bearer example_token".
SEARCH_BIP_AUTH_TOKEN=example_token

# PubMed MCP endpoint (no auth token required).
SEARCH_PUBMED_MCP_URL=https://pubmed-mcp.imsi.athenarc.gr/mcp

# ============================================================================
# Librarian Search Source Selection
# ============================================================================
# Comma-separated values from:
#   { local, bip, pubmed }
# Examples:
#   SEARCH_SOURCES=local
#   SEARCH_SOURCES=bip,pubmed
#   SEARCH_SOURCES=local,bip,pubmed
SEARCH_SOURCES=local
