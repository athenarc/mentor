# SR-agents Project Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# OpenAI API Keys (REQUIRED for bastirr multi-agent system)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used by:
# - Bastirr multi-agent system (all agents)
# - vaccine_indicators_demo Stage 3 (extraction) and Stage 4 (synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Mistral API Keys (for vaccine_indicators_demo Stage 1 - OCR)
# ============================================================================
# Get your API key from: https://console.mistral.ai/
# Used by: vaccine_indicators_demo PDF OCR processing
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================================================
# DeepSeek API Keys (for vaccine_indicators_demo Stage 2 - Cleaning)
# ============================================================================
# Get your API key from: https://platform.deepseek.com/
# Used by: vaccine_indicators_demo markdown cleaning
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_HOST=https://api.deepseek.com

# ============================================================================
# Model Configuration (OPTIONAL)
# ============================================================================
# Model backend: "openai" (default) or "litellm"
# Use "litellm" for local models (Ollama, vLLM), Anthropic, Bedrock, etc.
BASTIRR_MODEL_BACKEND=openai

# Model identifier for Bastirr agents.
# - OpenAI backend: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-5, etc.
# - LiteLLM backend: use provider-prefixed IDs, e.g.
#     anthropic/claude-3-5-sonnet-latest
#     ollama_chat/llama3.2
#     bedrock/anthropic.claude-3-sonnet-20240229-v1:0
#     azure/<DEPLOYMENT_NAME>
# If not set, defaults to "gpt-4o"
BASTIRR_MODEL=gpt-4o

# API base URL for local/self-hosted models (optional)
# e.g. http://localhost:11434 for Ollama, http://localhost:8000 for vLLM
# BASTIRR_API_BASE=

# Generic API key used by LiteLLM when OPENAI_API_KEY is not appropriate (optional)
# e.g. your Anthropic key when using anthropic/ models via LiteLLM
# BASTIRR_API_KEY=

# ============================================================================
# Execution Settings (OPTIONAL)
# ============================================================================
# Maximum seconds each agent code-execution step is allowed to run.
# smolagents defaults to 30s which is too short for processing many studies.
# Set to a generous value; max_steps still guards against infinite loops.
# If not set, defaults to 300 (5 minutes).
BASTIRR_EXECUTOR_TIMEOUT=300
