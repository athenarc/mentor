# Mentor environment
# Copy to .env and fill in credentials.
#
# Minimum for profiles / most suite runs:
#   set MENTOR_API_KEY to your OpenRouter (or OpenAI-compatible) key.
# Catalogue models already know the OpenRouter base URL.

MENTOR_API_KEY=sk-or-v1-...

# Profile keys: see src/config/model_profiles.json (docs: src/config/README.md)
# MENTOR_MODEL_PROFILE=openrouter_gpt5

# Optional: default model when you run without --profile
# MENTOR_MODEL_BACKEND=openai
# MENTOR_MODEL=openai/gpt-5
# MENTOR_API_BASE=https://openrouter.ai/api/v1

# Optional timeouts
MENTOR_EXECUTOR_TIMEOUT=5000
MENTOR_MODEL_REQUEST_TIMEOUT=5000

# Search MCP endpoints (optional)
# BIP: sign up, then create a token at https://bip.imsi.athenarc.gr/site/settings
# and set it as SEARCH_BIP_AUTH_TOKEN (needed when SEARCH_SOURCES includes bip).
SEARCH_BIP_MCP_URL=https://bip-mcp.imsi.athenarc.gr/mcp
SEARCH_BIP_AUTH_TOKEN=example_token
SEARCH_PUBMED_MCP_URL=https://pubmed-mcp.imsi.athenarc.gr/mcp

# Librarian search sources (comma-separated: local, bip, pubmed).
# local = search_studies over studies already in the review JSON (no network).
# bip / pubmed = external MCP search (needs the URLs/token above).
SEARCH_SOURCES=local
