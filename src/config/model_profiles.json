{
  "models": [
    {
      "key": "env_default",
      "description": "Shared Mentor runtime model resolved from environment variables.",
      "display_name": "env-default",
      "backend": "openai",
      "backend_env_var": "MENTOR_MODEL_BACKEND",
      "model_id": "gpt-5",
      "model_id_env_var": "MENTOR_MODEL",
      "api_base_env_var": "MENTOR_API_BASE",
      "api_key_env_vars": [
        "MENTOR_API_KEY"
      ],
      "requires_api_key": true
    },
    {
      "key": "openai_gpt5",
      "description": "OpenAI GPT5",
      "display_name": "openai-gpt-5",
      "backend": "openai",
      "model_id": "openai/gpt-5",
      "requires_api_key": true,
      "api_base": "https://openrouter.ai/api/v1",
      "api_key_env_vars": [
        "MENTOR_API_KEY"
      ],
      "request_kwargs": {
        "extra_body": {
          "plugins": [
            {
              "id": "context-compression",
              "enabled": false
            }
          ],
          "provider": {
            "order": [
              "openai/default"
            ],
            "allow_fallbacks": false,
            "require_parameters": true
          },
          "reasoning": {
            "enabled": true
          }
        }
      }
    },
