{
  "profiles": [
    {
      "key": "default_backwards_compatible",
      "description": "Single shared Bastirr runtime model resolved from environment variables.",
      "agents": {
        "shared": {
          "backend": "openai",
          "backend_env_var": "BASTIRR_MODEL_BACKEND",
          "model_id": "gpt-5",
          "model_id_env_var": "BASTIRR_MODEL",
          "api_base_env_var": "BASTIRR_API_BASE",
          "api_key_env_vars": ["BASTIRR_API_KEY", "OPENAI_API_KEY"],
          "requires_api_key": true
        }
      }
    },
    {
      "key": "openrouter_gpt5",
      "description": "Shared OpenRouter GPT-5 runtime with explicit provider pinning and reasoning settings.",
      "agents": {
        "shared": {
          "backend": "openai",
          "model_id": "openai/gpt-5",
          "api_base": "https://openrouter.ai/api/v1",
          "api_key_env_vars": ["BASTIRR_API_KEY"],
          "requires_api_key": true,
          "request_kwargs": {
            "extra_body": {
              "provider": {
                "order": ["openai/default"],
                "allow_fallbacks": false,
                "require_parameters": true
              },
              "reasoning": {
                "effort": "xhigh"
              }
            }
          }
        }
      }
    },
    {
      "key": "openrouter_deepseek_v4_pro",
      "description": "Shared OpenRouter DeepSeek v4 Pro runtime with explicit provider pinning and reasoning settings.",
      "agents": {
        "shared": {
          "backend": "openai",
          "model_id": "deepseek/deepseek-v4-pro",
          "api_base": "https://openrouter.ai/api/v1",
          "api_key_env_vars": ["BASTIRR_API_KEY"],
          "requires_api_key": true,
          "request_kwargs": {
            "extra_body": {
              "provider": {
                "order": ["deepseek"],
                "allow_fallbacks": false,
                "require_parameters": true
              },
              "reasoning": {
                "enabled": true,
                "effort": "xhigh"
              }
            }
          }
        }
      }
    },
    {
      "key": "multimodel_openrouter",
      "description": "GPT-5 for coordination, DeepSeek for screening.",
      "agents": {
        "shared": {
          "backend": "openai",
          "model_id": "openai/gpt-5",
          "api_base": "https://openrouter.ai/api/v1",
          "api_key_env_vars": ["BASTIRR_API_KEY"],
          "requires_api_key": true,
          "request_kwargs": {
            "extra_body": {
              "provider": {
                "order": ["openai/default"],
                "allow_fallbacks": false,
                "require_parameters": true
              },
              "reasoning": {
                "effort": "xhigh"
              }
            }
          }
        },
        "gatekeeper": {
          "backend": "openai",
          "model_id": "deepseek/deepseek-v4-pro",
          "api_base": "https://openrouter.ai/api/v1",
          "api_key_env_vars": ["BASTIRR_API_KEY"],
          "requires_api_key": true,
          "request_kwargs": {
            "extra_body": {
              "provider": {
                "order": ["deepseek"],
                "allow_fallbacks": false,
                "require_parameters": true
              },
              "reasoning": {
                "enabled": true,
                "effort": "xhigh"
              }
            }
          }
        }
      }
    }
  ]
}
