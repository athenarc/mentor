    ])                                                                                                                  
                                                                                                                        
    comparator_ok = any(kw in text for kw in ["placebo", "no therapy", "no treatment", "no suppressive therapy", "no    
prophylaxis"])                                                                                                          
                                                                                                                        
    # Study design disqualifiers                                                                                        
    is_observational = any(kw in text for kw in [                                                                       
        "prospective cohort", "cohort", "prospective study", "case series", "observational", "natural history",         
"cross-sectional"                                                                                                       
    ])                                                                                                                  
    is_review = any(kw in text for kw in ["review", "transmission", "narrative"]) and not is_randomized                 
                                                                                                                        
    # Apply strict inclusion                                                                                            
    if is_pediatric and is_randomized and uses_cotrimox and comparator_ok:                                              
        decision = "INCLUDE"                                                                                            
        rationale = "Pediatric randomized trial of cotrimoxazole prophylaxis with placebo/no-treatment comparator;      
matches all criteria."                                                                                                  
        confidence = "high"                                                                                             
        return decision, rationale, confidence                                                                          
                                                                                                                        
    # Else exclude with best-fit rationale                                                                              
    if not is_pediatric:                                                                                                
        decision = "EXCLUDE"                                                                                            
        rationale = "Adult-only population (not pediatric)."                                                            
        confidence = "high"                                                                                             
        return decision, rationale, confidence                                                                          
                                                                                                                        
    if not is_randomized or is_observational or is_review:                                                              
        decision = "EXCLUDE"                                                                                            
        # Refine rationale                                                                                              
        if is_review:                                                                                                   
            rationale = "Narrative/review or non-trial design."                                                         
        elif is_observational:                                                                                          
            rationale = "Observational/diagnostic/cohort/case-series (not randomized)."                                 
        else:                                                                                                           
            rationale = "Study not randomized/quasi-randomized."                                                        
        confidence = "high"                                                                                             
        return decision, rationale, confidence                                                                          
                                                                                                                        
    if not uses_cotrimox:                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = "Intervention is not cotrimoxazole prophylaxis."                                                    
        confidence = "high"                                                                                             
        return decision, rationale, confidence                                                                          
                                                                                                                        
    if not comparator_ok:                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = "Comparator is not placebo or no prophylaxis."                                                      
