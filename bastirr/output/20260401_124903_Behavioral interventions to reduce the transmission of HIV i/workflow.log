              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "INCLUDE",                                                                                    
              "rationale": included[idx]["rationale"],                                                                  
              "confidence": included[idx]["confidence"]                                                                 
          })                                                                                                            
      else:                                                                                                             
          rationale = excluded_specific.get(idx, "Non-randomized/observational design; not an RCT or quasi-RCT          
