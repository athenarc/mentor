      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  result_json = json.dumps(result_obj, ensure_ascii=False, indent=2)                                                    
  # Prepare a short list of included titles for quick view                                                              
