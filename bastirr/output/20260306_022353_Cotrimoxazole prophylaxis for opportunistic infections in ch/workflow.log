        "query_string": search_query,                                                                                   
        "description": search_strategy_desc                                                                             
    },                                                                                                                  
    "n_candidates": n_candidates_parsed,                                                                                
    "candidates": candidates                                                                                            
}                                                                                                                       
                                                                                                                        
result_json = json.dumps(result_obj, ensure_ascii=False, indent=2)                                                      
                                                                                                                        
