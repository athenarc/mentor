        "effect_size": effect_size if isinstance(effect_size, (int,float)) else None,                                   
        "ci_95_lower": ci_lo if isinstance(ci_lo, (int,float)) else None,                                               
        "ci_95_upper": ci_hi if isinstance(ci_hi, (int,float)) else None,                                               
