queries = [                                                                                                             
    'cotrimoxazole prophylaxis randomized trial HIV children placebo',                                                  
    'trimethoprim-sulfamethoxazole prophylaxis randomized HIV infants',                                                 
    'cotrimoxazole prophylaxis HIV-exposed infants randomized placebo',                                                 
    'cotrimoxazole prophylaxis HIV pediatric randomized trial'                                                          
]                                                                                                                       
                                                                                                                        
# MCP search parameters                                                                                                 
ordering = "citation_count"  # Keep a single fixed ordering                                                             
page_size = 20                                                                                                          
start_year = 1900                                                                                                       
end_year = 2026                                                                                                         
                                                                                                                        
# Step 3: Execute MCP searches, aggregate per query, and print required summary blocks                                  
all_rows_across_queries = []                                                                                            
query_summaries = []                                                                                                    
                                                                                                                        
for qi, q in enumerate(queries, start=1):                                                                               
    aggregated_rows = []                                                                                                
    total_count = None                                                                                                  
                                                                                                                        
    # Page 1                                                                                                            
    res1 = search_papers_in_bip(query=q, page=1, page_size=page_size, ordering=ordering, start_year=start_year,         
end_year=end_year)                                                                                                      
    # Expect JSON with keys: meta: {total_count, page}, rows: [...]                                                     
    if 'meta' in res1 and isinstance(res1['meta'], dict) and 'total_count' in res1['meta']:                             
        total_count = res1['meta']['total_count']                                                                       
    rows1 = res1.get('rows', []) or []                                                                                  
    aggregated_rows.extend(rows1)                                                                                       
                                                                                                                        
    # Decide whether to fetch page 2 (only if page 1 returned full page_size)                                           
    if len(rows1) == page_size:                                                                                         
