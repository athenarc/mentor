    title = r.get('title') or ""                                                                                        
    year = r.get('year')                                                                                                
    # Primary key: DOI if present                                                                                       
    if doi:                                                                                                             
        key = ("doi", doi)                                                                                              
    else:                                                                                                               
        norm_title = normalize_title(title)                                                                             
