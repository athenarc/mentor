import re                                                                                                               
def normalize_title(t):                                                                                                 
    if not t:                                                                                                           
        return ""                                                                                                       
    t = t.strip().lower()                                                                                               
    t = re.sub(r'\s+', ' ', t)               # collapse spaces                                                          
    t = re.sub(r'[^\w\s]', '', t)            # remove punctuation                                                       
    return t                                                                                                            
                                                                                                                        
deduped = {}                                                                                                            
seen_keys = set()                                                                                                       
                                                                                                                        
for r in all_rows_across_queries:                                                                                       
