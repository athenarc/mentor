    for line in decision_str.split('\n'):                                                                               
        if 'confidence' in line.lower():                                                                                
            if 'high' in line.lower():                                                                                  
                confidence = 'high'                                                                                     
            elif 'low' in line.lower():                                                                                 
                confidence = 'low'                                                                                      
            else:                                                                                                       
                confidence = 'medium'                                                                                   
    if decision == "INCLUDE":                                                                                           
        n_included += 1                                                                                                 
    else:                                                                                                               
        n_excluded += 1                                                                                                 
    decisions.append({                                                                                                  
