  for i, study in enumerate(studies):                                                                                   
      title = study['title']                                                                                            
      abstract = study['abstract']                                                                                      
      idx = study['study_index']                                                                                        
      decision_str = screen_study(                                                                                      
          study_title=title,                                                                                            
          study_abstract=abstract,                                                                                      
          selection_criteria=selection_criteria,                                                                        
          study_index=idx                                                                                               
      )                                                                                                                 
      # The decision_str is expected to be a structured screening decision.                                             
      # We'll parse it to extract decision (INCLUDE/EXCLUDE), rationale, confidence.                                    
      # For now, we'll store the raw string and parse later.                                                            
      # Since we don't know exact format, we'll parse lines.                                                            
      # The typical output might be like:                                                                               
      # Decision: INCLUDE                                                                                               
      # Rationale: ...                                                                                                  
      # Confidence: medium                                                                                              
      # We'll parse with simple splitting.                                                                              
      decision = "INCLUDE"  # default                                                                                   
      rationale = ""                                                                                                    
      confidence = "medium"                                                                                             
      if "INCLUDE" in decision_str and "EXCLUDE" not in decision_str:                                                   
          decision = "INCLUDE"                                                                                          
      elif "EXCLUDE" in decision_str:                                                                                   
          decision = "EXCLUDE"                                                                                          
      # Extract rationale: after "Rationale:" or "reason:"                                                              
      # For simplicity, we'll store the whole decision_str as rationale.                                                
      rationale = decision_str.strip()                                                                                  
      # Try to find confidence line                                                                                     
      for line in decision_str.split('\n'):                                                                             
          if 'confidence' in line.lower():                                                                              
              if 'high' in line.lower():                                                                                
                  confidence = 'high'                                                                                   
              elif 'low' in line.lower():                                                                               
                  confidence = 'low'                                                                                    
              else:                                                                                                     
                  confidence = 'medium'                                                                                 
      if decision == "INCLUDE":                                                                                         
          n_included += 1                                                                                               
      else:                                                                                                             
          n_excluded += 1                                                                                               
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # After looping, if n_included == 0, do a sanity check.                                                               
  # Double check some studies that clearly should be included.                                                          
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
  # Print for observation                                                                                               
  print("Preliminary screening results:", json.dumps(result, indent=2))                                                 
