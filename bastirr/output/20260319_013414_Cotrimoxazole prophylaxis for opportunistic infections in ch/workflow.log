def extract_json_from_text(text):                                                                                       
    """Try to find a JSON object or array in the text and parse it."""                                                  
    # Look for the first '{' or '['                                                                                     
    start_obj = text.find('{')                                                                                          
    start_arr = text.find('[')                                                                                          
    start = -1                                                                                                          
    if start_obj != -1 and (start_arr == -1 or start_obj < start_arr):                                                  
        start = start_obj                                                                                               
    elif start_arr != -1:                                                                                               
        start = start_arr                                                                                               
    if start == -1:                                                                                                     
        return None                                                                                                     
                                                                                                                        
    # Try to parse from start position                                                                                  
    for end in range(len(text), start, -1):                                                                             
        try:                                                                                                            
            return json.loads(text[start:end])                                                                          
        except json.JSONDecodeError:                                                                                    
            continue                                                                                                    
    return None                                                                                                         
                                                                                                                        
