import re                                                                                                               
                                                                                                                        
def count_studies_in_json(json_text: str) -> int:                                                                       
    # Find the "studies" array boundaries                                                                               
    key_idx = json_text.find('"studies"')                                                                               
    if key_idx == -1:                                                                                                   
        return 0                                                                                                        
    # Find the first '[' after "studies"                                                                                
    bracket_start = json_text.find('[', key_idx)                                                                        
    if bracket_start == -1:                                                                                             
        return 0                                                                                                        
    # Walk to matching closing ']' for the array                                                                        
    depth = 0                                                                                                           
    end_idx = -1                                                                                                        
    for i in range(bracket_start, len(json_text)):                                                                      
        ch = json_text[i]                                                                                               
        if ch == '[':                                                                                                   
            depth += 1                                                                                                  
        elif ch == ']':                                                                                                 
            depth -= 1                                                                                                  
            if depth == 0:                                                                                              
                end_idx = i                                                                                             
                break                                                                                                   
    if end_idx == -1:                                                                                                   
        return 0                                                                                                        
    studies_array_text = json_text[bracket_start:end_idx+1]                                                             
    # Count objects by counting "title" occurrences inside the studies array                                            
    return len(re.findall(r'"title"\s*:', studies_array_text))                                                          
                                                                                                                        
n_candidates = count_studies_in_json(candidates_json_str)                                                               
print(f"Loaded {n_candidates} candidate studies.")                                                                      
                                                                                                                        
