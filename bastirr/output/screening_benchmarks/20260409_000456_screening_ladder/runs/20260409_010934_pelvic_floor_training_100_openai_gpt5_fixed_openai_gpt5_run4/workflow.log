  decisions.sort(key=lambda d: d["study_index"])                                                                        
                                                                                                                        
  # Sanity checks                                                                                                       
  n_total = len(studies)                                                                                                
  n_included = sum(1 for d in decisions if d["decision"]=="INCLUDE")                                                    
  n_excluded = sum(1 for d in decisions if d["decision"]=="EXCLUDE")                                                    
                                                                                                                        
  assert n_total == 100, f"Expected 100 studies, found {n_total}"                                                       
