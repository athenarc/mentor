# Create decisions list                                                                                                 
decisions = []                                                                                                          
                                                                                                                        
# Define inclusion/exclusion criteria                                                                                   
# INCLUDE: RCTs of anaesthetic regimens or anaesthetic depth monitors                                                   
# EXCLUDE: volunteer studies, pre-incision studies, ICU studies, word presentation memory tests, non-RCTs               
                                                                                                                        
# Process each study                                                                                                    
studies_data = json.loads(candidate_chunk)['studies']                                                                   
                                                                                                                        
for study in studies_data:                                                                                              
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Determine decision based on study characteristics                                                                 
    decision = ""                                                                                                       
    rationale = ""                                                                                                      
    confidence = ""                                                                                                     
                                                                                                                        
    # Check for key indicators                                                                                          
    abstract_lower = abstract.lower()                                                                                   
    title_lower = title.lower()                                                                                         
                                                                                                                        
    # EXCLUDE: Volunteer studies                                                                                        
    if 'volunteer' in abstract_lower or 'volunteers' in abstract_lower:                                                 
        decision = "EXCLUDE"                                                                                            
        rationale = f"Volunteer study - exclusion criterion specifies volunteer studies should be excluded."            
        confidence = "high"                                                                                             
    # EXCLUDE: Non-RCT designs (cohort, observational, prospective study without randomization)                         
    elif 'cohort' in abstract_lower and 'random' not in abstract_lower:                                                 
        decision = "EXCLUDE"                                                                                            
        rationale = f"Cohort study design - not a randomized controlled trial."                                         
        confidence = "high"                                                                                             
    elif 'prospective study' in abstract_lower and 'random' not in abstract_lower:                                      
        decision = "EXCLUDE"                                                                                            
        rationale = f"Prospective observational study without randomization - not an RCT."                              
        confidence = "medium"                                                                                           
    elif 'observational' in abstract_lower:                                                                             
        decision = "EXCLUDE"                                                                                            
        rationale = f"Observational study design - not a randomized controlled trial."                                  
        confidence = "high"                                                                                             
    # EXCLUDE: Word presentation/memory test studies                                                                    
    elif 'word' in abstract_lower and ('presentation' in abstract_lower or 'memory' in abstract_lower):                 
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study focuses on word presentations for memory tests rather than anaesthetic interventions."      
        confidence = "medium"                                                                                           
    # EXCLUDE: Non-anaesthesia interventions (neuromuscular block reversal, sedation for procedures, etc.)              
    elif 'neuromuscular' in abstract_lower and 'block' in abstract_lower and 'reversal' in abstract_lower:              
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study focuses on neuromuscular block reversal rather than awareness prevention."                  
        confidence = "medium"                                                                                           
    elif 'sedation' in abstract_lower and ('bronchoscopy' in abstract_lower or 'colonoscopy' in abstract_lower or       
'endoscopy' in abstract_lower):                                                                                         
        decision = "EXCLUDE"                                                                                            
        rationale = f"Sedation for procedural sedation rather than general anesthesia for surgery."                     
        confidence = "medium"                                                                                           
    elif 'epidural' in abstract_lower and 'analgesia' in abstract_lower and 'labor' in abstract_lower:                  
        decision = "EXCLUDE"                                                                                            
        rationale = f"Epidural analgesia for labor - not general anesthesia for surgery."                               
        confidence = "high"                                                                                             
    # EXCLUDE: Reviews, guidelines, methodology papers                                                                  
    elif 'review' in abstract_lower or 'guideline' in abstract_lower or 'methodology' in abstract_lower:                
        decision = "EXCLUDE"                                                                                            
        rationale = f"Review article or methodology paper - not a primary RCT."                                         
        confidence = "high"                                                                                             
    # EXCLUDE: Studies focusing on premedication only                                                                   
    elif 'premedication' in abstract_lower and 'preoperative' in abstract_lower:                                        
        decision = "EXCLUDE"                                                                                            
        rationale = f"Premedication study - focuses on preoperative period rather than intraoperative anaesthetic       
interventions."                                                                                                         
        confidence = "medium"                                                                                           
    # EXCLUDE: Studies with unclear randomization                                                                       
    elif 'divided' in abstract_lower and 'group' in abstract_lower and 'random' not in abstract_lower:                  
        decision = "EXCLUDE"                                                                                            
        rationale = f"Unclear randomization - study design does not clearly indicate randomization."                    
        confidence = "medium"                                                                                           
    # EXCLUDE: Studies not about awareness prevention                                                                   
    elif 'psychomotor' in abstract_lower and 'recovery' in abstract_lower and 'awareness' not in abstract_lower:        
        decision = "EXCLUDE"                                                                                            
        rationale = f"Focus on psychomotor recovery rather than awareness prevention."                                  
        confidence = "medium"                                                                                           
    elif 'ect' in abstract_lower or 'electroconvulsive' in abstract_lower:                                              
        decision = "EXCLUDE"                                                                                            
        rationale = f"Electroconvulsive therapy study - not general anesthesia for surgery."                            
        confidence = "high"                                                                                             
    # INCLUDE: RCTs of anaesthetic regimens or monitors                                                                 
    elif 'random' in abstract_lower and ('bispectral' in abstract_lower or 'bis' in abstract_lower or 'monitor' in      
abstract_lower or 'anaesthetic' in abstract_lower or 'anesthesia' in abstract_lower):                                   
        decision = "INCLUDE"                                                                                            
        rationale = f"Randomized controlled trial of anaesthetic depth monitor or anaesthetic regimen."                 
        confidence = "high"                                                                                             
    elif 'random' in abstract_lower and ('regimen' in abstract_lower or 'comparison' in abstract_lower or 'compare' in  
abstract_lower):                                                                                                        
        decision = "INCLUDE"                                                                                            
        rationale = f"Randomized controlled trial comparing anaesthetic regimens."                                      
        confidence = "high"                                                                                             
    elif 'random' in abstract_lower and ('propofol' in abstract_lower or 'sevoflurane' in abstract_lower or 'isoflurane'
in abstract_lower or 'fentanyl' in abstract_lower or 'remifentanil' in abstract_lower):                                 
        decision = "INCLUDE"                                                                                            
        rationale = f"Randomized controlled trial of anaesthetic drug regimens."                                        
        confidence = "high"                                                                                             
    else:                                                                                                               
        # Default to conservative approach - INCLUDE if uncertain                                                       
        decision = "INCLUDE"                                                                                            
        rationale = f"Conservative decision - study may meet inclusion criteria but requires further review."           
        confidence = "low"                                                                                              
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(output, indent=2))                                                                                     
                                                                                                                        
