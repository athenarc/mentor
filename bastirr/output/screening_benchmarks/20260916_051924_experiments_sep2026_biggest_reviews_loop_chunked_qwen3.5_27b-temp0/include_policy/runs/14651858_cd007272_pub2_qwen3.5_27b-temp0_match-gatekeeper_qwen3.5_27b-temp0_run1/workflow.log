      if 'volunteer' in abstract_lower or 'volunteers' in abstract_lower:                                               
          decision = "EXCLUDE"                                                                                          
          rationale = f"Volunteer study - exclusion criterion specifies volunteer studies should be excluded."          
          confidence = "high"                                                                                           
      # EXCLUDE: Non-RCT designs (cohort, observational, prospective study without randomization)                       
