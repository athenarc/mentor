          decision = "INCLUDE"                                                                                          
          rationale = f"Randomized controlled trial of anaesthetic depth monitor or anaesthetic regimen."               
          confidence = "high"                                                                                           
      elif 'random' in abstract_lower and ('regimen' in abstract_lower or 'comparison' in abstract_lower or 'compare'   
  in abstract_lower):                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = f"Randomized controlled trial comparing anaesthetic regimens."                                    
          confidence = "high"                                                                                           
      elif 'random' in abstract_lower and ('propofol' in abstract_lower or 'sevoflurane' in abstract_lower or           
  'isoflurane' in abstract_lower or 'fentanyl' in abstract_lower or 'remifentanil' in abstract_lower):                  
          decision = "INCLUDE"                                                                                          
          rationale = f"Randomized controlled trial of anaesthetic drug regimens."                                      
          confidence = "high"                                                                                           
      else:                                                                                                             
          # Default to conservative approach - INCLUDE if uncertain                                                     
          decision = "INCLUDE"                                                                                          
