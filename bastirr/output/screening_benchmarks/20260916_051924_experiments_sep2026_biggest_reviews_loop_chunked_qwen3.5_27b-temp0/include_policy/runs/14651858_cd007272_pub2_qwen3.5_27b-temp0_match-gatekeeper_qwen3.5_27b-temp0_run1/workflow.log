      294: "RCT comparing anaesthetic regimens. RCT of anaesthetic regimens.",                                          
      295: "RCT comparing anaesthetic depth with BIS monitoring. Anaesthetic depth monitor RCT.",                       
      296: "RCT comparing BIS monitoring vs routine monitoring for awareness. Anaesthetic depth monitor RCT.",          
      297: "RCT comparing BIS vs anesthetic concentration monitoring for awareness. Anaesthetic depth monitor RCT.",    
      298: "Observational study. Not an RCT. EXCLUDE.",                                                                 
      299: "Observational cohort study. Not an RCT. EXCLUDE.",                                                          
      300: "RCT comparing BIS monitoring vs control. Anaesthetic depth monitor RCT."                                    
  }                                                                                                                     
                                                                                                                        
  # Build decisions list                                                                                                
  for study in chunk_data['studies']:                                                                                   
      idx = study['study_index']                                                                                        
      if idx in included_indices:                                                                                       
          decision = "INCLUDE"                                                                                          
          confidence = "high"                                                                                           
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": study['title'],                                                                                      
          "decision": decision,                                                                                         
          "rationale": rationales.get(idx, "Decision based on study design and selection criteria."),                   
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = len(included_indices)                                                                                    
  n_excluded = len(excluded_indices)                                                                                    
  n_total = n_included + n_excluded                                                                                     
                                                                                                                        
  # Create final output                                                                                                 
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
