      elif 'epidural' in abstract_lower and 'analgesia' in abstract_lower and 'labor' in abstract_lower:                
          decision = "EXCLUDE"                                                                                          
          rationale = f"Epidural analgesia for labor - not general anesthesia for surgery."                             
          confidence = "high"                                                                                           
      # EXCLUDE: Reviews, guidelines, methodology papers                                                                
      elif 'review' in abstract_lower or 'guideline' in abstract_lower or 'methodology' in abstract_lower:              
          decision = "EXCLUDE"                                                                                          
          rationale = f"Review article or methodology paper - not a primary RCT."                                       
          confidence = "high"                                                                                           
      # EXCLUDE: Studies focusing on premedication only                                                                 
      elif 'premedication' in abstract_lower and 'preoperative' in abstract_lower:                                      
          decision = "EXCLUDE"                                                                                          
          rationale = f"Premedication study - focuses on preoperative period rather than intraoperative anaesthetic     
  interventions."                                                                                                       
          confidence = "medium"                                                                                         
      # EXCLUDE: Studies with unclear randomization                                                                     
      elif 'divided' in abstract_lower and 'group' in abstract_lower and 'random' not in abstract_lower:                
