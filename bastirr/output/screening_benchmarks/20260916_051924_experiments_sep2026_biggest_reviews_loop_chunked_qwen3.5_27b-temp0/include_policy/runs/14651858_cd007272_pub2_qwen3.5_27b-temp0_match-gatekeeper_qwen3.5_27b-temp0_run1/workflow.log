import json                                                                                                             
                                                                                                                        
# Load the chunk_json                                                                                                   
chunk_data = json.loads(chunk_json)                                                                                     
studies = chunk_data['studies']                                                                                         
selection_criteria = chunk_data['selection_criteria']                                                                   
                                                                                                                        
# Initialize decisions list                                                                                             
decisions = []                                                                                                          
n_included = 0                                                                                                          
n_excluded = 0                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Default to EXCLUDE unless criteria met                                                                            
    decision = "EXCLUDE"                                                                                                
    confidence = "high"                                                                                                 
    rationale = ""                                                                                                      
                                                                                                                        
    # Check for RCT keywords                                                                                            
    rct_keywords = ['randomized', 'randomised', 'random allocation', 'controlled trial', 'prospective randomized']      
    is_rct = any(kw in (title + abstract).lower() for kw in rct_keywords)                                               
                                                                                                                        
    # Check for exclusion criteria                                                                                      
    exclude_keywords = ['volunteer', 'volunteers', 'icu', 'intensive care unit', 'prior to skin incision', 'word        
presentation']                                                                                                          
    is_excluded_by_type = any(kw in (title + abstract).lower() for kw in exclude_keywords)                              
                                                                                                                        
    # Check for intervention relevance (anaesthetic drugs or monitors)                                                  
    intervention_keywords = ['anaesthesia', 'anesthesia', 'bispectral index', 'bis', 'entropy', 'narcotrend', 'monitor',
'propofol', 'sevoflurane', 'isoflurane', 'remifentanil', 'fentanyl', 'midazolam', 'ketamine', 'thiopentone',            
'halothane', 'enflurane', 'desflurane', 'depth of anesthesia', 'awareness', 'recall', 'dreaming', 'wakefulness']        
    has_intervention = any(kw in (title + abstract).lower() for kw in intervention_keywords)                            
                                                                                                                        
    # Check for outcome relevance (awareness/recall/dreaming)                                                           
    outcome_keywords = ['awareness', 'recall', 'dreaming', 'wakefulness', 'consciousness', 'memory', 'explicit recall'] 
    has_outcome = any(kw in (title + abstract).lower() for kw in outcome_keywords)                                      
                                                                                                                        
    # Logic                                                                                                             
