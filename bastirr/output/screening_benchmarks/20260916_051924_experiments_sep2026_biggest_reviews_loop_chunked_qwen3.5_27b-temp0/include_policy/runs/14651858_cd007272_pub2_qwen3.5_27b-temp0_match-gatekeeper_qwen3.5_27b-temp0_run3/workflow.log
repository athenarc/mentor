      # Determine decision based on criteria                                                                            
      decision = ""                                                                                                     
      rationale = ""                                                                                                    
      confidence = "high"                                                                                               
                                                                                                                        
      # Check for volunteer studies                                                                                     
      if 'volunteer' in abstract.lower() or 'volunteers' in abstract.lower():                                           
          decision = "EXCLUDE"                                                                                          
