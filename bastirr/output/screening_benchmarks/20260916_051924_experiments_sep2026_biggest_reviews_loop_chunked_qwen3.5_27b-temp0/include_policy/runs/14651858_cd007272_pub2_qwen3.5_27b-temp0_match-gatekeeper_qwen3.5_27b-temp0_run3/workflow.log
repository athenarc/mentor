          decision = "EXCLUDE"                                                                                          
          rationale = "Pre-incision/intubation study - excluded per protocol criteria"                                  
          confidence = "medium"                                                                                         
      # Check for word presentation memory tests only                                                                   
      elif 'word' in abstract.lower() and ('memory' in abstract.lower() or 'priming' in abstract.lower()) and           
  'randomiz' in abstract.lower():                                                                                       
          if 'only' in abstract.lower() or 'presentation' in abstract.lower():                                          
              decision = "EXCLUDE"                                                                                      
              rationale = "Study only randomizing word presentations for memory tests - excluded per protocol"          
              confidence = "medium"                                                                                     
      # Check for non-RCT designs                                                                                       
      elif 'observational' in abstract.lower() or 'cohort' in abstract.lower() or 'cross-sectional' in                  
  abstract.lower() or 'retrospective' in abstract.lower():                                                              
          decision = "EXCLUDE"                                                                                          
          rationale = "Non-randomized study design - excluded per protocol criteria"                                    
          confidence = "high"                                                                                           
      # Check for non-anesthesia awareness topics                                                                       
      elif 'postoperative' in abstract.lower() and ('pain' in abstract.lower() or 'analgesia' in abstract.lower() or    
  'cognitive' in abstract.lower()):                                                                                     
          decision = "EXCLUDE"                                                                                          
          rationale = "Focus on postoperative outcomes rather than intraoperative awareness prevention"                 
          confidence = "medium"                                                                                         
      # Check for non-approved monitors                                                                                 
      elif 'sef' in abstract.lower() or 'spectral edge' in abstract.lower() or 'aep' in abstract.lower() or 'mlaer' in  
  abstract.lower() or 'aa' in abstract.lower() or 'spi' in abstract.lower() or 'ssi' in abstract.lower():               
          decision = "EXCLUDE"                                                                                          
          rationale = "Uses non-approved depth monitor (SEF/AEP/MLAER/AAI/SPI/SSI) - not in protocol list"              
          confidence = "high"                                                                                           
      # Check for reviews/letters                                                                                       
      elif 'review' in title.lower() or 'letter' in title.lower() or 'sir' in abstract.lower():                         
          decision = "EXCLUDE"                                                                                          
          rationale = "Review article or letter - not a primary RCT"                                                    
          confidence = "high"                                                                                           
      # Check for case series/small samples without randomization                                                       
      elif 'case' in abstract.lower() or 'series' in abstract.lower():                                                  
          decision = "EXCLUDE"                                                                                          
          rationale = "Case series without randomization - excluded per protocol criteria"                              
          confidence = "high"                                                                                           
      # Check for regional anesthesia/sedation studies                                                                  
      elif 'regional' in abstract.lower() or 'spinal' in abstract.lower() or 'epidural' in abstract.lower():            
          decision = "EXCLUDE"                                                                                          
          rationale = "Regional anesthesia/sedation study - not general anesthesia awareness prevention"                
          confidence = "medium"                                                                                         
      # Check for approved monitors (BIS, Entropy, Narcotrend)                                                          
      elif 'bis' in abstract.lower() or 'bispectral' in abstract.lower() or 'entropy' in abstract.lower() or            
  'narcotrend' in abstract.lower():                                                                                     
          if 'random' in abstract.lower() or 'randomiz' in abstract.lower():                                            
              decision = "INCLUDE"                                                                                      
              rationale = "RCT of approved anaesthetic depth monitor (BIS/Entropy/Narcotrend) for awareness             
  prevention"                                                                                                           
              confidence = "high"                                                                                       
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Not an RCT design"                                                                           
              confidence = "medium"                                                                                     
      # Check for anaesthetic drug regimen RCTs                                                                         
      elif 'random' in abstract.lower() or 'randomiz' in abstract.lower():                                              
          if 'propofol' in abstract.lower() or 'sevoflurane' in abstract.lower() or 'isoflurane' in abstract.lower()    
  or 'desflurane' in abstract.lower() or 'midazolam' in abstract.lower() or 'fentanyl' in abstract.lower() or           
  'remifentanil' in abstract.lower() or 'alfentanil' in abstract.lower() or 'ketamine' in abstract.lower() or           
  'thiopental' in abstract.lower():                                                                                     
              if 'awareness' in abstract.lower() or 'recall' in abstract.lower() or 'memory' in abstract.lower() or     
  'wakefulness' in abstract.lower():                                                                                    
                  decision = "INCLUDE"                                                                                  
                  rationale = "RCT of anaesthetic drug regimen for awareness prevention"                                
                  confidence = "high"                                                                                   
              else:                                                                                                     
                  decision = "EXCLUDE"                                                                                  
                  rationale = "RCT but not focused on awareness prevention"                                             
                  confidence = "medium"                                                                                 
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "RCT but not relevant anaesthetic intervention"                                               
              confidence = "medium"                                                                                     
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          rationale = "Does not meet inclusion criteria for RCT of anaesthetic interventions for awareness prevention"  
          confidence = "medium"                                                                                         
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  print(f"Total studies screened: {n_total}")                                                                           
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
                                                                                                                        
  # Output the decisions                                                                                                
  print(json.dumps(decisions, indent=2))                                                                                
