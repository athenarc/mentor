          decision = "EXCLUDE"                                                                                          
          rationale = "ICU/critical care study - excluded per protocol criteria"                                        
          confidence = "high"                                                                                           
      # Check for pre-incision/intubation-only studies                                                                  
      elif 'intubation' in title.lower() and ('pre-' in title.lower() or 'before' in title.lower() or 'induction' in    
