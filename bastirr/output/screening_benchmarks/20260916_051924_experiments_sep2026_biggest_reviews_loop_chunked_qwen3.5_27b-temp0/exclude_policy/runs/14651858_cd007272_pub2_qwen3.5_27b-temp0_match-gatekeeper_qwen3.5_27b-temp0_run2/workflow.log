<code>                                                                                                                  
import json                                                                                                             
                                                                                                                        
# Parse the candidate chunk                                                                                             
candidate_data = json.loads(candidate_chunk)                                                                            
                                                                                                                        
# Systematically evaluate each study against selection criteria                                                         
decisions = []                                                                                                          
                                                                                                                        
for study in candidate_data["studies"]:                                                                                 
    idx = study["study_index"]                                                                                          
    title = study["title"]                                                                                              
    abstract = study["abstract"]                                                                                        
                                                                                                                        
    # Determine decision based on selection criteria                                                                    
    decision = None                                                                                                     
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check for key indicators in title and abstract                                                                    
    title_lower = title.lower()                                                                                         
    abstract_lower = abstract.lower()                                                                                   
                                                                                                                        
    # EXCLUSION CRITERIA CHECKS                                                                                         
                                                                                                                        
    # 1. Volunteer studies                                                                                              
    if "volunteer" in title_lower or "volunteers" in abstract_lower:                                                    
        decision = "exclude"                                                                                            
        rationale = "Volunteer study - excluded per protocol"                                                           
    # 2. Non-RCT designs (cohort, observational, prospective without randomization)                                     
    elif "cohort study" in title_lower or ("prospective" in abstract_lower and "random" not in abstract_lower):         
        decision = "exclude"                                                                                            
        rationale = "Non-randomized study design (cohort/observational)"                                                
    # 3. Word presentation/memory test studies only                                                                     
    elif "word" in abstract_lower and "presentation" in abstract_lower and "memory" in abstract_lower:                  
        decision = "exclude"                                                                                            
        rationale = "Study only randomized word presentations for memory tests, not anaesthetic interventions"          
    # 4. ICU studies                                                                                                    
    elif "intensive care unit" in abstract_lower or "icu" in abstract_lower:                                            
        decision = "exclude"                                                                                            
        rationale = "ICU study - excluded per protocol"                                                                 
    # 5. Pre-incision studies                                                                                           
    elif "prior to skin incision" in abstract_lower or "pre-incision" in abstract_lower:                                
        decision = "exclude"                                                                                            
        rationale = "Study of patients prior to skin incision"                                                          
    # 6. Review articles/guidelines                                                                                     
    elif "review" in title_lower or "guideline" in title_lower or "grade" in title_lower:                               
        decision = "exclude"                                                                                            
        rationale = "Review article or guideline document, not primary RCT"                                             
    # 7. Regional anesthesia only (not general anesthesia)                                                              
    elif "epidural" in title_lower and "general" not in title_lower and "spinal" not in title_lower:                    
        decision = "exclude"                                                                                            
        rationale = "Regional anesthesia only, not general anesthesia for awareness prevention"                         
    # 8. Neuromuscular blockade focus (not awareness prevention)                                                        
    elif "neuromuscular block" in title_lower and "awareness" not in abstract_lower:                                    
        decision = "exclude"                                                                                            
        rationale = "Focus on neuromuscular blockade, not anaesthetic interventions for awareness prevention"           
    # 9. Sedation/procedure-only studies (colonoscopy, bronchoscopy without awareness focus)                            
    elif ("colonoscopy" in title_lower or "bronchoscopy" in title_lower) and "awareness" not in abstract_lower:         
        decision = "exclude"                                                                                            
        rationale = "Sedation for procedure without awareness prevention focus"                                         
    # 10. Statistical/methodology papers                                                                                
    elif "model" in title_lower and "statistical" in title_lower:                                                       
        decision = "exclude"                                                                                            
        rationale = "Statistical methodology paper, not clinical trial"                                                 
                                                                                                                        
    # INCLUSION CRITERIA CHECKS (if not excluded above)                                                                 
    else:                                                                                                               
        # Check for RCT + anaesthetic regimen OR depth monitor                                                          
        is_rct = any(term in abstract_lower for term in ["random", "randomized", "randomised"])                         
        is_anesthetic_regimen = any(term in abstract_lower for term in ["anaesthetic", "anesthesia", "propofol",        
"sevoflurane", "isoflurane", "fentanyl", "remifentanil", "midazolam", "ketamine", "thiopentone", "desflurane",          
"halothane", "enflurane", "nitrous oxide"])                                                                             
        is_depth_monitor = any(term in abstract_lower for term in ["bispectral index", "bis", "entropy", "narcotrend",  
"aep", "auditory evoked potential", "cerebral function", "patient state index", "lower oesophageal"])                   
                                                                                                                        
        if is_rct and (is_anesthetic_regimen or is_depth_monitor):                                                      
            decision = "include"                                                                                        
            if is_depth_monitor:                                                                                        
                rationale = "RCT of anaesthetic depth monitor(s)"                                                       
            else:                                                                                                       
                rationale = "RCT of anaesthetic drug regimen(s)"                                                        
        else:                                                                                                           
            decision = "exclude"                                                                                        
            rationale = "Does not meet RCT criteria for anaesthetic interventions or depth monitors"                    
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Calculate summary statistics                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "include")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "exclude")                                                    
                                                                                                                        
# Create final answer structure                                                                                         
final_result = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(final_result, indent=2))                                                                               
                                                                                                                        
