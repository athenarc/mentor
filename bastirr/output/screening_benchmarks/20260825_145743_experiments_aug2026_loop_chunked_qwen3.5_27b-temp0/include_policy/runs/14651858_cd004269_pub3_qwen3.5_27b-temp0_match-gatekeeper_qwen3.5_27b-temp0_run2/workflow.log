for d in decisions:                                                                                                     
    if d['decision'] == 'INCLUDE':                                                                                      
        print(f"  - Study {d['study_index']}: {d['title']}")                                                            
                                                                                                                        
# Create final output                                                                                                   
final_output = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print("\nFinal output JSON:")                                                                                           
print(json.dumps(final_output, indent=2))                                                                               
                                                                                                                        
