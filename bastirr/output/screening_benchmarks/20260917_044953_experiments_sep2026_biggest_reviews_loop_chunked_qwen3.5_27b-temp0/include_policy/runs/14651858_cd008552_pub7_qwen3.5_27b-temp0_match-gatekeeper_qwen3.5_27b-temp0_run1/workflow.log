data = json.loads(studies_data)                                                                                         
studies = data['studies']                                                                                               
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract'].lower()                                                                                
                                                                                                                        
    # Check RCT                                                                                                         
    rct_patterns = ['random', 'cluster-random', 'cross-over', 'controlled trial']                                       
    is_rct = any(p in abstract for p in rct_patterns)                                                                   
                                                                                                                        
    # Check age <= 5                                                                                                    
    age_keywords = ['preschool', 'toddler', 'infant', 'under 5', 'under five', 'up to 5', 'aged 5', '5 years', 'younger 
children', 'young children', 'early childhood']                                                                         
    age_check = any(kw in abstract for kw in age_keywords)                                                              
                                                                                                                        
    # Also check explicit age ranges                                                                                    
    age_match = re.search(r'(\d+)\s*(?:to|-)\s*(\d+)\s*years?', abstract)                                               
    if age_match:                                                                                                       
        min_age, max_age = int(age_match.group(1)), int(age_match.group(2))                                             
        if max_age <= 5:                                                                                                
            age_check = True                                                                                            
        elif min_age > 5:                                                                                               
            age_check = False                                                                                           
                                                                                                                        
    # Check F/V intervention - must be PRIMARY focus                                                                    
    fv_primary = ('fruit' in abstract and 'vegetable' in abstract) or \                                                 
                 'fruits and vegetables' in abstract or \                                                               
                 'fruit and vegetable' in abstract or \                                                                 
                 'f&v' in abstract or \                                                                                 
                 'fv' in abstract or \                                                                                  
                 'orange sweet potato' in abstract or \                                                                 
                 'ofsp' in abstract or \                                                                                
                 'osp' in abstract                                                                                      
                                                                                                                        
    # Check if it's ONLY about F/V (not just mentioned in passing)                                                      
    fv_only_mentioned = ('fruit' in abstract or 'vegetable' in abstract) and not fv_primary                             
                                                                                                                        
    # Check dietary/biochemical outcome                                                                                 
    outcome_patterns = ['intake', 'consumption', 'dietary', 'biochemical', 'serum', 'vitamin a',                        
                       'retinol', 'plate waste', 'food record', 'recall', 'frequency',                                  
                       'eating', 'ate', 'consumed', 'served', 'portion']                                                
    has_outcome = any(op in abstract for op in outcome_patterns)                                                        
                                                                                                                        
    # Decision logic                                                                                                    
    reasons = []                                                                                                        
                                                                                                                        
    if not is_rct:                                                                                                      
        reasons.append("Not an RCT")                                                                                    
                                                                                                                        
    if not age_check:                                                                                                   
        reasons.append("Age > 5 years or unclear")                                                                      
                                                                                                                        
    if not fv_primary:                                                                                                  
        reasons.append("Not primarily F/V intervention")                                                                
                                                                                                                        
    if not has_outcome:                                                                                                 
        reasons.append("No dietary/biochemical F/V outcome")                                                            
                                                                                                                        
    if len(reasons) == 0:                                                                                               
        decision = "INCLUDE"                                                                                            
        rationale = "RCT targeting F/V consumption in children ≤5 years with dietary/biochemical assessment."           
        confidence = "high"                                                                                             
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Excluded: {', '.join(reasons)}"                                                                   
        confidence = "medium" if len(reasons) == 1 else "high"                                                          
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d['decision'] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Print all decisions                                                                                                   
for d in decisions:                                                                                                     
    print(f"{d['study_index']}: {d['decision']} - {d['rationale']}")                                                    
                                                                                                                        
