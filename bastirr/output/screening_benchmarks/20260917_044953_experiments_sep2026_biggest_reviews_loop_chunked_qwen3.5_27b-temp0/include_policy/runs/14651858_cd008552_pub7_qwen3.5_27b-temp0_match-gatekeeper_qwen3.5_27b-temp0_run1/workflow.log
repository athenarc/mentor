n_total = len(studies)                                                                                                  
                                                                                                                        
# Selection criteria checklist for each study:                                                                          
# 1. Study design: RCT, cluster-RCT, or cross-over trial                                                                
# 2. Population: Children aged 5 years and under                                                                        
# 3. Intervention: Primarily targeting fruit/vegetable consumption                                                      
# 4. Outcome: Dietary or biochemical assessment of FV consumption                                                       
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract'].lower()                                                                                
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    confidence = "high"                                                                                                 
    rationale = ""                                                                                                      
                                                                                                                        
    # Check if it's an RCT/cluster-RCT/cross-over                                                                       
    is_rct = any(term in abstract for term in ['randomized', 'randomised', 'cluster-randomized', 'cluster randomised',  
'cross-over', 'crossover'])                                                                                             
                                                                                                                        
    # Check age - must be 5 years and under                                                                             
    has_age_5_under = any(term in abstract for term in ['preschool', 'under 5', 'under five', '0-5', '0-6', '1-5',      
'2-5', '3-5', '4-5', 'age 5', 'aged 5', 'five year', 'five-year', 'toddlers', 'infant', 'children aged 5', 'children    
aged 4', 'children aged 3', 'children aged 2', 'children aged 1', 'up to 5', 'up to six', 'up to 6'])                   
                                                                                                                        
    # Check if intervention targets FV consumption                                                                      
    targets_fv = any(term in abstract for term in ['fruit', 'vegetable', 'fruits', 'vegetables', 'f&v', 'f/v', 'green   
leafy', 'glv', 'produce', 'fresh produce'])                                                                             
                                                                                                                        
    # Check for dietary/biochemical assessment                                                                          
    has_assessment = any(term in abstract for term in ['dietary', 'food record', 'food recall', 'intake', 'consumption',
'biochemical', 'assessment', 'measurement', 'weighed', 'questionnaire', 'survey', 'diary'])                             
                                                                                                                        
    # Make decision                                                                                                     
    if is_rct and has_age_5_under and targets_fv and has_assessment:                                                    
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"RCT targeting FV consumption in children ≤5 years with dietary assessment."                       
    elif is_rct and has_age_5_under and targets_fv:                                                                     
        decision = "INCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale = f"RCT targeting FV consumption in children ≤5 years; dietary assessment likely but not explicitly   
stated."                                                                                                                
    elif is_rct and targets_fv:                                                                                         
        decision = "INCLUDE"                                                                                            
        confidence = "low"                                                                                              
        rationale = f"RCT targeting FV consumption; age group uncertain from abstract."                                 
    else:                                                                                                               
        reasons = []                                                                                                    
        if not is_rct:                                                                                                  
            reasons.append("not an RCT")                                                                                
        if not has_age_5_under:                                                                                         
            reasons.append("age >5 years or unclear")                                                                   
        if not targets_fv:                                                                                              
            reasons.append("does not target FV")                                                                        
        if not has_assessment:                                                                                          
            reasons.append("no dietary assessment")                                                                     
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"Excluded because: {', '.join(reasons)}"                                                           
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count results                                                                                                         
n_included = sum(1 for d in decisions if d['decision'] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == "EXCLUDE")                                                    
                                                                                                                        
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print("\nIncluded studies:")                                                                                            
for d in decisions:                                                                                                     
    if d['decision'] == "INCLUDE":                                                                                      
        print(f"  {d['study_index']}: {d['title']}")                                                                    
                                                                                                                        
