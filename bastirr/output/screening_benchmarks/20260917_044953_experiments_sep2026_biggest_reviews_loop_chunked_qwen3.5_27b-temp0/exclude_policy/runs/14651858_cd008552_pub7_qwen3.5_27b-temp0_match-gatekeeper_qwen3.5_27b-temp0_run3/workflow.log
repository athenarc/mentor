for i in range(1, 101):                                                                                                 
    if i in included_studies:                                                                                           
        decisions.append({                                                                                              
            "study_index": i,                                                                                           
            "title": f"Study {i}",                                                                                      
            "decision": "INCLUDE",                                                                                      
            "rationale": study_rationales[i]["rationale"],                                                              
            "confidence": study_rationales[i]["confidence"]                                                             
        })                                                                                                              
    else:                                                                                                               
        decisions.append({                                                                                              
            "study_index": i,                                                                                           
            "title": f"Study {i}",                                                                                      
            "decision": "EXCLUDE",                                                                                      
            "rationale": f"Excluded because: {exclusion_reasons.get(i, 'Does not meet selection criteria')}",           
            "confidence": "high"                                                                                        
        })                                                                                                              
                                                                                                                        
# Calculate summary statistics                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
