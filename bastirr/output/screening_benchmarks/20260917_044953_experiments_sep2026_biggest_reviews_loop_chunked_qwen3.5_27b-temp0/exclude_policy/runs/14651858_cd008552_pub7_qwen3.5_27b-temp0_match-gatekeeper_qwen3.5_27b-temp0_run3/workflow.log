      if is_protocol and ("will be" in abstract or "presented in future" in abstract or "rationale and study design"    
  in abstract):                                                                                                         
          decision = "EXCLUDE"                                                                                          
          rationale = "Protocol/design paper without outcomes reported"                                                 
      elif is_school_age:                                                                                               
          decision = "EXCLUDE"                                                                                          
          rationale = "Population is school-age children (>5 years)"                                                    
      elif targets_adults_only:                                                                                         
          decision = "EXCLUDE"                                                                                          
          rationale = "Targets adults/parents, not children directly"                                                   
      elif is_rct and has_young_children and has_fv_focus and has_dietary_outcome:                                      
          decision = "INCLUDE"                                                                                          
          rationale = "RCT; population includes children ≤5 years; intervention targets FV consumption; includes        
  dietary assessment of FV"                                                                                             
      elif is_rct and has_young_children and has_fv_focus:                                                              
          decision = "INCLUDE"                                                                                          
          rationale = "RCT; population includes children ≤5 years; intervention targets FV consumption"                 
      elif is_rct and has_young_children:                                                                               
          decision = "INCLUDE"                                                                                          
          rationale = "RCT; population includes children ≤5 years; may include FV outcomes"                             
      elif not is_rct:                                                                                                  
          decision = "EXCLUDE"                                                                                          
          rationale = "Not an RCT (observational, quasi-experimental, or other design)"                                 
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          rationale = "Does not meet selection criteria"                                                                
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  # Prepare final output                                                                                                
  final_output = {                                                                                                      
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(final_output, indent=2))                                                                             
