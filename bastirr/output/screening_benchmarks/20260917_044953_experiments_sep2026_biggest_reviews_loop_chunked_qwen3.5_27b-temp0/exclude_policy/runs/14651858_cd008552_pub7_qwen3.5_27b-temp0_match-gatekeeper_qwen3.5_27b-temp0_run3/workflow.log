          rationale = "Protocol/design paper without outcomes"                                                          
      elif "school" in abstract.lower() and ("elementary" in abstract.lower() or "middle" in abstract.lower() or "high  
  school" in abstract.lower() or "grades 1" in abstract.lower() or "grades 5" in abstract.lower()):                     
          decision = "EXCLUDE"                                                                                          
          rationale = "Population likely >5 years (school-age)"                                                         
      elif "adult" in abstract.lower() and "parent" in abstract.lower() and "mother" in abstract.lower():               
          decision = "EXCLUDE"                                                                                          
          rationale = "Targets adults/parents, not children directly"                                                   
      elif not is_rct:                                                                                                  
          decision = "EXCLUDE"                                                                                          
          rationale = "Not an RCT (observational, quasi-experimental, or other design)"                                 
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          rationale = "Does not meet selection criteria"                                                                
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  print(f"\nTotal studies screened: {n_total}")                                                                         
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
  print(f"\nIncluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'INCLUDE']}")             
                                                                                                                        
  # Print some sample decisions                                                                                         
  print("\nSample included studies:")                                                                                   
  for d in decisions[:5]:                                                                                               
      print(f"  {d['study_index']}: {d['decision']} - {d['rationale'][:80]}...")                                        
                                                                                                                        
  print("\nSample excluded studies:")                                                                                   
  for d in decisions[5:10]:                                                                                             
      print(f"  {d['study_index']}: {d['decision']} - {d['rationale'][:80]}...")                                        
