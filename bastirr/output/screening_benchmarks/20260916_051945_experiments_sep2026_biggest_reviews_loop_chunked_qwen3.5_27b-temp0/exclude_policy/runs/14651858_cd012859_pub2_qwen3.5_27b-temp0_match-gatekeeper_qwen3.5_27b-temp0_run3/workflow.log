      794: "Observational study, not an RCT"                                                                            
  }                                                                                                                     
                                                                                                                        
  for study in chunk_data['studies']:                                                                                   
      study_index = study['study_index']                                                                                
      title = study['title']                                                                                            
                                                                                                                        
      if study_index in excluded_studies:                                                                               
          decision = "EXCLUDE"                                                                                          
          rationale = excluded_studies[study_index]                                                                     
          confidence = "high"                                                                                           
      else:                                                                                                             
          decision = "INCLUDE"                                                                                          
          # Generate rationale based on study content                                                                   
          rationale = f"RCT comparing antiemetic drug(s) for PONV prevention in adults undergoing surgery under         
  general anesthesia. Meets selection criteria."                                                                        
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(f"Total studies screened: {n_total}")                                                                           
