      # 4. Outcome: Must be PONV prevention.                                                                            
      elif "bladder discomfort" in abstract.lower() and "ponv" not in abstract.lower():                                 
          decision = "EXCLUDE"                                                                                          
          rationale = "Primary outcome is bladder discomfort, not PONV."                                                
          confidence = "high"                                                                                           
      elif "intraocular pressure" in abstract.lower() and "ponv" not in abstract.lower():                               
          decision = "EXCLUDE"                                                                                          
          rationale = "Primary outcome is intraocular pressure, not PONV."                                              
          confidence = "high"                                                                                           
      elif "immune cell" in abstract.lower() and "ponv" not in abstract.lower():                                        
          decision = "EXCLUDE"                                                                                          
          rationale = "Primary outcome is immune response, not PONV."                                                   
          confidence = "high"                                                                                           
      elif "pain" in abstract.lower() and "analgesia" in abstract.lower() and "ponv" not in abstract.lower():           
          decision = "EXCLUDE"                                                                                          
          rationale = "Primary outcome is pain/analgesia, PONV not evaluated or not significant."                       
          confidence = "medium"                                                                                         
      elif "treatment" in abstract.lower() and "relief of vomiting" in abstract.lower() and "prophylaxis" not in        
  abstract.lower():                                                                                                     
          decision = "EXCLUDE"                                                                                          
          rationale = "Study evaluates treatment of established PONV, not prophylaxis/prevention."                      
          confidence = "high"                                                                                           
      elif "genetic polymorphisms" in title.lower() and "survey" in abstract.lower():                                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Observational survey/genetic study, not an RCT."                                                 
          confidence = "high"                                                                                           
                                                                                                                        
      # 5. Abstract Publications: Exclude if explicitly abstract only (hard to detect without tags, assuming journal    
  abstracts are ok).                                                                                                    
      # Based on text, none appear to be conference abstracts only.                                                     
                                                                                                                        
      # Add decision                                                                                                    
      decisions.append({                                                                                                
          "study_index": index,                                                                                         
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale if rationale else "Meets selection criteria: RCT, adults, general anaesthesia,         
  eligible antiemetic intervention, PONV outcome.",                                                                     
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Calculate totals                                                                                                    
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  # Prepare output structure                                                                                            
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
