[{"study_index": 1, "title": "Packing\xa0and\xa0stents\xa0in\xa0endonasal\xa0surgery", "abstract": "Nasal packing is    
used primarily to control bleeding in epistaxis and after surgical procedures to the nose such as septoplasty, turbinate
