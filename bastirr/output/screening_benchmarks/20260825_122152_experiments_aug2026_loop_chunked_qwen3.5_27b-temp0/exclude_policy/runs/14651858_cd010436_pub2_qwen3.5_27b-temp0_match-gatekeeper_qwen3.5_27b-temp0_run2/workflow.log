          confidence = "medium"                                                                                         
      else:                                                                                                             
          # All other studies don't involve steroid-eluting stents or aren't RCTs                                       
          decision = "EXCLUDE"                                                                                          
          if idx == 25 or idx == 28 or idx == 32 or idx == 36:                                                          
              rationale = f"Study {idx} is not an RCT (retrospective analysis/review/survey)."                          
          else:                                                                                                         
              rationale = f"Study {idx} is an RCT but does not involve steroid-eluting sinus stents. The intervention   
