# Build decisions list                                                                                                  
for study_index, title, rationale, confidence in include_studies:                                                       
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": "INCLUDE",                                                                                          
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
for study_index, title, rationale, confidence in exclude_studies:                                                       
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": "EXCLUDE",                                                                                          
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Sort by study_index                                                                                                   
decisions.sort(key=lambda x: x["study_index"])                                                                          
                                                                                                                        
# Calculate totals                                                                                                      
n_included = len(include_studies)                                                                                       
n_excluded = len(exclude_studies)                                                                                       
n_total = n_included + n_excluded                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(f"\nIncluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'INCLUDE']}")               
print(f"\nExcluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'EXCLUDE']}")               
                                                                                                                        
