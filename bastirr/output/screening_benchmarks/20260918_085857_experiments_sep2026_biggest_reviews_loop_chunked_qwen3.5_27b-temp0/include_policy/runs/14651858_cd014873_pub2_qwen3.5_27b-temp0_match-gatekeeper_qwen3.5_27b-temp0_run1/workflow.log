})                                                                                                                      
                                                                                                                        
# Study 506: CFS/ME - not primarily chronic pain condition                                                              
decisions.append({                                                                                                      
    "study_index": 506,                                                                                                 
    "title": "Qualitative study of the acceptability and feasibility of acceptance and commitment therapy for           
