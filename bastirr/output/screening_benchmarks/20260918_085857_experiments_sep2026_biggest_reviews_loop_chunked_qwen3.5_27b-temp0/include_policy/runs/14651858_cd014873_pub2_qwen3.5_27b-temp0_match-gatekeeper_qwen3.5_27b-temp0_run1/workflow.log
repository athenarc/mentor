  # Study 518: Cystic fibrosis - not primarily pain condition                                                           
  decisions.append({                                                                                                    
      "study_index": 518,                                                                                               
      "title": "Religious/spiritual coping in childhood cystic fibrosis: a qualitative study",                          
      "decision": "EXCLUDE",                                                                                            
      "rationale": "Qualitative study with children (5-12 years) with cystic fibrosis, but CF is primarily a            
  respiratory/genetic condition, not a chronic pain condition. The study focuses on religious/spiritual coping with     
  illness generally, not specifically on pain experiences or pain management. Does not meet the chronic non-cancer      
  pain focus.",                                                                                                         
      "confidence": "high"                                                                                              
  })                                                                                                                    
                                                                                                                        
  # Study 519: Fathers of CF children - not pain condition                                                              
  decisions.append({                                                                                                    
      "study_index": 519,                                                                                               
      "title": "Fathers' perspectives on the emotional impact of managing the care of their children with cystic        
  fibrosis",                                                                                                            
      "decision": "EXCLUDE",                                                                                            
      "rationale": "Qualitative study with fathers of children with cystic fibrosis, but CF is not a chronic pain       
  condition. The study focuses on emotional impact of caregiving, not on pain experiences or pain management. Does not  
  meet the chronic non-cancer pain focus.",                                                                             
      "confidence": "high"                                                                                              
  })                                                                                                                    
                                                                                                                        
  # Study 520: Functional disorders - qualitative, youths 11-15                                                         
  decisions.append({                                                                                                    
      "study_index": 520,                                                                                               
      "title": "Illness perceptions of youths with functional disorders and their parents: an interpretative            
  phenomenological analysis study",                                                                                     
      "decision": "INCLUDE",                                                                                            
      "rationale": "Qualitative study (interpretative phenomenological analysis) with youths aged 11-15 years with      
  functional disorders and their parents. Functional disorders commonly present with chronic pain symptoms (e.g.,       
  functional abdominal pain, functional neurological disorders). Explores illness perceptions, healthcare experiences,  
  and how families understand their condition. Relevant to understanding how children and families conceptualize        
