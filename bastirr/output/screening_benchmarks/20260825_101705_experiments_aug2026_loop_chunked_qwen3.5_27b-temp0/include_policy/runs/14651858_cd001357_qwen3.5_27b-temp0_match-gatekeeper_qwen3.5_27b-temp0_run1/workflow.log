  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
                                                                                                                        
  # Create final answer structure                                                                                       
  final_result = {                                                                                                      
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(f"Total studies screened: {n_total}")                                                                           
  print(f"Studies included: {n_included}")                                                                              
  print(f"Studies excluded: {n_excluded}")                                                                              
  print("\nIncluded studies:")                                                                                          
  for d in decisions:                                                                                                   
      if d["decision"] == "INCLUDE":                                                                                    
          print(f"  - Study {d['study_index']}: {d['title']}")                                                          
  print("\nExcluded studies:")                                                                                          
  for d in decisions:                                                                                                   
      if d["decision"] == "EXCLUDE":                                                                                    
          print(f"  - Study {d['study_index']}: {d['title']}")                                                          
                                                                                                                        
  # Convert to JSON string for final_answer                                                                             
  final_json = json.dumps(final_result, indent=2)                                                                       
  print("\nFinal JSON output:")                                                                                         
  print(final_json)                                                                                                     
