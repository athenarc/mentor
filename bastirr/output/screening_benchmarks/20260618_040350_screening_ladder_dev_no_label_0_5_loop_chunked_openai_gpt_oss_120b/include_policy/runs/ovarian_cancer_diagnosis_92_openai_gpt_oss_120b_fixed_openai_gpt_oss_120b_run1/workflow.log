              return "EXCLUDE", "Study is a review, epidemiology, genetics, or treatment article not primary            
  diagnostic accuracy.", "high"                                                                                         
                                                                                                                        
      # Include if it mentions diagnostic performance of ovarian cancer with biomarkers/ultrasound                      
      if any(kw in abstract for kw in diag_keywords):                                                                   
          # Ensure it involves patients with pelvic/adnexal masses (symptomatic)                                        
          if any(term in abstract for term in ["pelvic mass", "adnexal mass", "symptomatic", "women with",              
  "suspicious"]):                                                                                                       
              return "INCLUDE", "Primary diagnostic accuracy study of biomarkers/ultrasound in women with               
  pelvic/adnexal masses.", "high"                                                                                       
          else:                                                                                                         
              # Uncertain about patient population                                                                      
              return "INCLUDE", "Diagnostic accuracy study but patient population not clearly symptomatic; included     
  conservatively.", "medium"                                                                                            
                                                                                                                        
      # Default to exclude if none of the above                                                                         
      return "EXCLUDE", "Does not appear to evaluate diagnostic accuracy of ovarian cancer with relevant tests.",       
  "low"                                                                                                                 
                                                                                                                        
  # Process each study                                                                                                  
  for study in studies:                                                                                                 
      decision, rationale, confidence = decide(study)                                                                   
      decisions.append({                                                                                                
          "study_index": study["study_index"],                                                                          
          "title": study["title"],                                                                                      
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Summarize counts                                                                                                    
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  # Prepare final result JSON                                                                                           
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  # Output the result                                                                                                   
  final_answer(json.dumps(result, indent=2))                                                                            
