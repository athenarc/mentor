        "confidence": "high"
      },
      {
        "study_index": 5,
        "title": "Caffeine reduces cerebral blood flow in patients recovering from an acute ischaemic stroke",
        "decision": "EXCLUDE",
        "rationale": "Does not meet criteria: patients are 'recovering from' acute ischaemic stroke, not in the acute 
