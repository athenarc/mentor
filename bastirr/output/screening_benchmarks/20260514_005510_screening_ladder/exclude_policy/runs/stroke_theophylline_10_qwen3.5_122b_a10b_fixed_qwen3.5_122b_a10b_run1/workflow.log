        "confidence": "high"
      },
      {
        "study_index": 2,
        "title": "Controlled trial of intravenous aminophylline in acute cerebral infarction",
        "decision": "INCLUDE",
        "rationale": "Meets all criteria: double-blind randomised trial comparing intravenous aminophylline vs placebo 
in 79 patients with acute cerebral infarction. Treatment effects on neurological outcomes assessed.",
        "confidence": "high"
      }
    ],
    "excluded_studies": [
      {
        "study_index": 3,
        "title": "Pilot dose\u2010escalation study of caffeine plus ethanol (caffeinol) in acute ischemic stroke",
        "decision": "EXCLUDE",
        "rationale": "Does not meet criteria: open-label, single-arm dose-escalation study with no control/placebo 
