  "task_outcome_detailed": {
    "review_title": "Theophylline, aminophylline, caffeine and analogues for acute ischaemic stroke",
    "selection_criteria": "Randomised trials of theophylline or an analogue compound compared with placebo or control in
people with confirmed or presumed acute ischaemic stroke. Trials were included if treatment was started within one week 
of stroke onset.",
    "screening_summary": {
      "n_total": 10,
      "n_included": 2,
      "n_excluded": 8
    },
    "included_studies": [
      {
        "study_index": 1,
        "title": "Lack of effect of theophylline on the outcome of acute cerebral infarction",
        "decision": "INCLUDE",
        "rationale": "Meets all criteria: double-blind randomised trial comparing theophylline (as aminophylline) vs 
