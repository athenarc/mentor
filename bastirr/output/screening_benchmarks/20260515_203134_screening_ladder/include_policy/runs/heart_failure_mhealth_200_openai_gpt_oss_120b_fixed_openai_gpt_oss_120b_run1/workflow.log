  import re                                                                                                             
                                                                                                                        
  # Split the provided studies_summary into lines                                                                       
  lines = studies_summary.strip().split("\n")                                                                           
                                                                                                                        
  # Prepare regex patterns                                                                                              
  trial_pat = re.compile(r"\b(randomised|randomized|rct|trial)\b", re.I)                                                
  edu_pat =                                                                                                             
  re.compile(r"\b(education|educational|self[-\s]?care|self[-\s]?management|training|counselling|counseling|support)\b  
  ", re.I)                                                                                                              
  mobile_pat =                                                                                                          
  re.compile(r"\b(mobile|mhealth|app|tablet|smartphone|phone|web|website|internet|online|sms|text\s?message|social\s?m  
  edia|digital|ehealth|remote)\b", re.I)                                                                                
                                                                                                                        
  decisions = []                                                                                                        
  for line in lines:                                                                                                    
      parts = line.split("\t")                                                                                          
      if len(parts) < 3:                                                                                                
          decisions.append("EXCLUDE")                                                                                   
          continue                                                                                                      
      _, title, abstract = parts[0], parts[1], parts[2]                                                                 
                                                                                                                        
      # Criterion 1: Randomised controlled trial                                                                        
      is_rct = bool(trial_pat.search(title) or trial_pat.search(abstract))                                              
                                                                                                                        
      # Criterion 2: Adults with HF – assumed true for all entries (they all mention HF)                                
      is_adult_hf = True                                                                                                
                                                                                                                        
      # Criterion 3: mHealth-delivered education                                                                        
      has_edu = bool(edu_pat.search(title) or edu_pat.search(abstract))                                                 
      has_mobile = bool(mobile_pat.search(title) or mobile_pat.search(abstract))                                        
      is_mhealth_edu = has_edu and has_mobile                                                                           
                                                                                                                        
      if is_rct and is_adult_hf and is_mhealth_edu:                                                                     
          decisions.append("INCLUDE")                                                                                   
      else:                                                                                                             
          decisions.append("EXCLUDE")                                                                                   
                                                                                                                        
  # Verify we have 200 decisions                                                                                        
  assert len(decisions) == 200, f"Expected 200 decisions, got {len(decisions)}"                                         
                                                                                                                        
  # Prepare the output string: one decision per line                                                                    
  output = "\n".join(decisions)                                                                                         
  print(output)                                                                                                         
