    f"The studies are provided in the variable `studies_summary` (ID, Title, Abstract separated by tabs, one study per  
line). "                                                                                                                
    f"Return a plain‑text list with ONE decision per study, in the same order as the IDs (1‑200). "                     
    f"Each line must be either the word INCLUDE or the word EXCLUDE. Provide exactly 200 lines and no other text.\n\n"  
    f"Selection criteria (verbatim): \"{selection_criteria}\""                                                          
)                                                                                                                       
                                                                                                                        
# ---------- Call gatekeeper ----------                                                                                 
gatekeeper_response = gatekeeper(                                                                                       
    task=gatekeeper_task,                                                                                               
    additional_args={"studies_summary": studies_summary}                                                                
)                                                                                                                       
                                                                                                                        
# ---------- Verify decision count ----------                                                                           
decisions = re.findall(r"\\bINCLUDE\\b|\\bEXCLUDE\\b", gatekeeper_response, flags=re.IGNORECASE)                        
print("Number of decisions found:", len(decisions))                                                                     
