# Define keyword sets                                                                                                   
rct_keywords = [                                                                                                        
    "randomised", "randomized", "randomised controlled trial", "randomized controlled trial",                           
    "randomised trial", "randomized trial", "pilot", "feasibility", "multicenter", "multicentre",                       
    "study", "protocol", "trial"                                                                                        
]                                                                                                                       
hf_keywords = [                                                                                                         
    "heart failure", "hf", "congestive heart failure", "chronic heart failure", "systolic heart failure",               
    "diastolic heart failure", "heart‑failure", "heart‑failure"                                                         
]                                                                                                                       
intervention_keywords = [                                                                                               
    "tablet", "app", "mobile", "web‑based", "web-based", "internet", "sms", "text message",                             
    "e‑health", "e-health", "online", "digital", "smartphone", "social media", "phone", "mobile phone",                 
    "mhealth", "mobile health"                                                                                          
]                                                                                                                       
education_keywords = [                                                                                                  
    "education", "educational", "self‑care", "self-care", "self management", "self‑management",                         
    "knowledge", "training", "program", "programme", "counseling", "counselling", "support"                             
]                                                                                                                       
                                                                                                                        
def contains_any(text, keywords):                                                                                       
    text_lower = text.lower()                                                                                           
    for kw in keywords:                                                                                                 
        # use word boundaries for single words, allow phrase matches                                                    
        pattern = r'\b' + re.escape(kw.lower()) + r'\b'                                                                 
        if re.search(pattern, text_lower):                                                                              
            return True                                                                                                 
    return False                                                                                                        
                                                                                                                        
for title in titles:                                                                                                    
    is_rct = contains_any(title, rct_keywords)                                                                          
    has_hf = contains_any(title, hf_keywords)                                                                           
    has_intervention = contains_any(title, intervention_keywords)                                                       
    has_education = contains_any(title, education_keywords)                                                             
    if is_rct and has_hf and has_intervention and has_education:                                                        
        decisions.append("INCLUDE")                                                                                     
    else:                                                                                                               
        decisions.append("EXCLUDE")                                                                                     
                                                                                                                        
# Verify we have 200 decisions                                                                                          
if len(decisions) != 200:                                                                                               
    raise ValueError(f"Expected 200 decisions, got {len(decisions)}")                                                   
                                                                                                                        
