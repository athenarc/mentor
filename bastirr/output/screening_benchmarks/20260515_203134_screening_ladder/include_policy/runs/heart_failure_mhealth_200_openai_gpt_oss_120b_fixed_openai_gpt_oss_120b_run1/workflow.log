    output_dir=output_dir,                                                                                              
    expected_n_studies=200                                                                                              
)                                                                                                                       
print("Evidence saved to:", evidence_path)                                                                              
                                                                                                                        
# ------------------------------------------------------------------                                                    
# 6. Create a markdown summary of the screening                                                                         
