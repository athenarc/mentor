import json, re                                                                                                         
                                                                                                                        
# ---------- Load candidates ----------                                                                                 
candidates_json_str = get_candidates_json()                                                                             
candidates_data = json.loads(candidates_json_str)                                                                       
                                                                                                                        
studies = candidates_data.get("studies", [])                                                                            
assert len(studies) == 200, f"Expected 200 studies, found {len(studies)}"                                               
                                                                                                                        
# ---------- Build a compact representation ----------                                                                  
# We'll create a single string where each line is:                                                                      
#   ID<TAB>TITLE<TAB>ABSTRACT                                                                                           
compact_lines = []                                                                                                      
for idx, study in enumerate(studies, start=1):                                                                          
    title = study.get("title", "").replace("\n", " ").strip()                                                           
    abstract = study.get("abstract", "").replace("\n", " ").strip()                                                     
    # Truncate very long abstracts to first 500 characters to stay safe                                                 
    if len(abstract) > 500:                                                                                             
        abstract = abstract[:500] + "..."                                                                               
    compact_lines.append(f"{idx}\\t{title}\\t{abstract}")                                                               
                                                                                                                        
studies_summary = "\n".join(compact_lines)                                                                              
                                                                                                                        
# Check length (approx characters ≈ tokens)                                                                             
print("Compact summary length (characters):", len(studies_summary))                                                     
                                                                                                                        
# ---------- Gatekeeper prompt ----------                                                                               
