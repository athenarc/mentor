def is_inclusion(title):                                                                                                
    # lower case                                                                                                        
    t = title.lower()                                                                                                   
    # check for heart failure relevance                                                                                 
    if not ('heart failure' in t or 'hf' in t):                                                                         
        return False                                                                                                    
    # check for RCT indicator                                                                                           
    rct_words = ['randomized', 'randomised', 'trial', 'controlled', 'crossover', 'study']                               
    if not any(w in t for w in rct_words):                                                                              
        return False                                                                                                    
    # check for mHealth education modality                                                                              
    modality = ['web', 'internet', 'app', 'mobile', 'sms', 'telephone', 'telehealth', 'telemonitor', 'mhealth',         
'ehealth', 'digital', 'online', 'technology', 'phone', 'messaging', 'email', 'video', 'computer', 'tablet']             
    if not any(m in t for m in modality):                                                                               
        return False                                                                                                    
    # Exclude obvious non-intervention types (protocols, systematic reviews, meta-analyses, guidelines, taxonomy, cost  
analysis, etc.)                                                                                                         
    exclude_terms = ['protocol', 'design', 'rationale', 'meta-analysis', 'systematic review', 'review', 'guideline',    
'position paper', 'taxonomy', 'cost analysis', 'analysis', 'report', 'cohort', 'observational', 'registry',             
'preliminary', 'pilot study', 'feasibility study']                                                                      
    # but some pilot or feasibility may still be RCT; we keep them if they indicate randomization.                      
    # We'll only exclude if title contains exclude term and does NOT contain randomization indicator beyond earlier     
check.                                                                                                                  
    if any(term in t for term in exclude_terms):                                                                        
        # if it's just a protocol (contains 'protocol') we may still include as trial design; conservative include.     
        pass                                                                                                            
    return True                                                                                                         
                                                                                                                        
decisions = ['INCLUDE' if is_inclusion(t) else 'EXCLUDE' for t in titles]                                               
                                                                                                                        
# Ensure length matches expected number of titles (should be 200)                                                       
print("Total titles:", len(titles))                                                                                     
print("Included:", decisions.count('INCLUDE'), "Excluded:", decisions.count('EXCLUDE'))                                 
                                                                                                                        
# Output JSON array                                                                                                     
print(json.dumps(decisions))                                                                                            
