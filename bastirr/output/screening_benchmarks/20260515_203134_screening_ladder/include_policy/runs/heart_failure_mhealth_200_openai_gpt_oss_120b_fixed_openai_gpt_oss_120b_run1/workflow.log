  import re                                                                                                             
                                                                                                                        
  # The list of 200 titles is available in the variable `titles` (provided by the manager).                             
                                                                                                                        
  # Compile regex patterns (case‑insensitive)                                                                           
  rand_pat = re.compile(r'\b(randomized|randomised|rct|trial)\b', re.I)                                                 
  hf_pat   = re.compile(r'\bheart failure\b|\bHF\b', re.I)                                                              
  mhealth_pat = re.compile(                                                                                             
      r'app|mobile|mhealth|web|internet|sms|text message|social media|tablet|smartphone|ehealth|'                       
      r'telehealth|telemonitor|remote|digital|online|telemedicine|telephone|phone|call|video|email|'                    
      r'messaging|message|messenger', re.I)                                                                             
  educ_pat = re.compile(                                                                                                
      r'education|educational|self[- ]?care|self[- ]?management|knowledge|training|programme|program|'                  
      r'counseling|counselling|support|information|learning|behaviour|behavior|intervention|coach|'                     
      r'coaching|instruction|teach|teaching|awareness|literacy|advice|guide|guidance|inform', re.I)                     
                                                                                                                        
  decisions = []                                                                                                        
  for title in titles:                                                                                                  
      low = title.lower()                                                                                               
      is_rand = bool(rand_pat.search(low))                                                                              
      has_hf = bool(hf_pat.search(low))                                                                                 
      has_mh = bool(mhealth_pat.search(low))                                                                            
      has_ed = bool(educ_pat.search(low))                                                                               
      decision = "INCLUDE" if (is_rand and has_hf and has_mh and has_ed) else "EXCLUDE"                                 
      decisions.append(decision)                                                                                        
                                                                                                                        
  # Plain‑text list (one decision per line)                                                                             
  plain_list = "\n".join(decisions)                                                                                     
                                                                                                                        
  # Summary statistics                                                                                                  
  n_total = len(titles)                                                                                                 
  n_included = decisions.count("INCLUDE")                                                                               
  n_excluded = decisions.count("EXCLUDE")                                                                               
                                                                                                                        
  # Build the required output                                                                                           
  short_version = f"### 1. Task outcome (short version):\n{n_included} studies INCLUDED, {n_excluded} EXCLUDED out of   
  {n_total}.\n"                                                                                                         
                                                                                                                        
  detailed_version = (                                                                                                  
      "### 2. Task outcome (extremely detailed version):\n"                                                             
      f"Total studies screened: {n_total}\n"                                                                            
      f"Included studies: {n_included}\n"                                                                               
      f"Excluded studies: {n_excluded}\n\n"                                                                             
      "Decisions (in order of the provided titles):\n"                                                                  
      f"{plain_list}\n\n"                                                                                               
