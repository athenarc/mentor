### 3. Additional context (if relevant):                                                                                
- Only two studies met **all** criteria (randomised design, adult heart‑failure participants, mHealth‑delivered         
education component).                                                                                                   
- The majority were excluded because they lacked explicit mention of a randomised trial, did not involve a mobile/online
education modality, or did not clearly focus on heart‑failure patients.                                                 
 ─ Executing parsed code: ───────────────────────────────────────────────────────────────────────────────────────────── 
  import json, re                                                                                                       
                                                                                                                        
  # Load candidates                                                                                                     
  data = json.loads(candidates_json)                                                                                    
  studies = data["studies"]                                                                                             
                                                                                                                        
  # Keyword patterns                                                                                                    
  rct_pat = r"randomised|randomized|randomised controlled trial|randomized controlled trial|randomised                  
  trial|randomized trial"                                                                                               
  hf_pat = r"heart failure|HF|congestive heart failure"                                                                 
  mhealth_pat =                                                                                                         
  r"mobile|app|smartphone|tablet|web|internet|sms|text|telehealth|telemonitor|ehealth|digital|technology|remote|phone|  
  social media|online"                                                                                                  
  educ_pat = r"education|educ|self[-\s]?care|self[-\s]?management|knowledge|training|counselling|counseling"            
                                                                                                                        
  def has(p, txt):                                                                                                      
      return re.search(p, txt, flags=re.IGNORECASE) is not None                                                         
                                                                                                                        
  decisions = []                                                                                                        
  for s in studies:                                                                                                     
      txt = f"{s['title']} {s['abstract_snippet']}"                                                                     
      if (has(rct_pat, txt) and has(hf_pat, txt) and has(mhealth_pat, txt) and has(educ_pat, txt)):                     
          decisions.append("INCLUDE")                                                                                   
      else:                                                                                                             
          decisions.append("EXCLUDE")                                                                                   
                                                                                                                        
  # Verify count                                                                                                        
  assert len(decisions) == 200                                                                                          
                                                                                                                        
  # Produce the plain‑text list                                                                                         
  output = "\n".join(decisions)                                                                                         
  print(output)                                                                                                         
