  # 1. Split the input into individual study lines                                                                      
  lines = studies_summary.strip().split('\n')                                                                           
  decisions = []                                                                                                        
                                                                                                                        
  # 2. Keyword lists for inclusion criteria                                                                             
  rand_keys = ['randomized', 'randomised', 'rct', 'trial']                                                              
  pop_keys = ['heart failure', 'hf']                                                                                    
  education_keys = ['education']                                                                                        
  mhealth_keys = [                                                                                                      
      'app', 'smartphone', 'tablet', 'mobile', 'web', 'internet',                                                       
      'online', 'e‑health', 'e-health', 'mhealth', 'sms',                                                               
      'text message', 'social media', 'video education',                                                                
      'website', 'digital'                                                                                              
  ]                                                                                                                     
                                                                                                                        
  def contains_any(text, keys):                                                                                         
      return any(k in text for k in keys)                                                                               
                                                                                                                        
  # 3. Process each study entry                                                                                         
  for line in lines:                                                                                                    
      # The line uses the literal sequence "\t" to separate fields                                                      
      parts = line.split('\\t')                                                                                         
      if len(parts) < 3:                                                                                                
          decisions.append('EXCLUDE')                                                                                   
          continue                                                                                                      
                                                                                                                        
      study_id, title, abstract = parts[0], parts[1], parts[2]                                                          
      txt = (title + ' ' + abstract).lower()                                                                            
                                                                                                                        
      is_randomised = contains_any(txt, rand_keys)                                                                      
      has_population = contains_any(txt, pop_keys)                                                                      
      has_education = contains_any(txt, education_keys)                                                                 
      has_mhealth = contains_any(txt, mhealth_keys)                                                                     
                                                                                                                        
      if is_randomised and has_population and has_education and has_mhealth:                                            
          decisions.append('INCLUDE')                                                                                   
      else:                                                                                                             
          decisions.append('EXCLUDE')                                                                                   
                                                                                                                        
  # 4. Print exactly 200 decisions in the original order                                                                
  print('\n'.join(decisions))                                                                                           
