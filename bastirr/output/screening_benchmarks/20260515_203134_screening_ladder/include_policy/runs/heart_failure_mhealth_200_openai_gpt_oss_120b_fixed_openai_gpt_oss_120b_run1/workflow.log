Parse each line of `titles_summary`, extract the title, and apply the inclusion criteria:                               
1. Mention of a randomised controlled trial (`randomized`, `randomised`, `RCT`, `pilot study`, etc.).                   
2. Focus on heart‑failure patients (`heart failure`, `HF`, `congestive heart failure`).                                 
3. Use of a mobile‑health education component (keywords for mobile delivery **and** education).                         
                                                                                                                        
If all three conditions are met, mark the study **INCLUDE**; otherwise **EXCLUDE**.                                     
                                                                                                                        
**Code:**                                                                                                               
```python                                                                                                               
import re                                                                                                               
                                                                                                                        
# Split the input into lines                                                                                            
lines = titles_summary.strip().splitlines()                                                                             
                                                                                                                        
decisions = []                                                                                                          
for line in lines:                                                                                                      
    # Each line is "ID<TAB>Title"                                                                                       
    parts = line.split('\t', 1)                                                                                         
    if len(parts) != 2:                                                                                                 
        decisions.append('EXCLUDE')                                                                                     
        continue                                                                                                        
    title = parts[1].lower()                                                                                            
                                                                                                                        
    # 1. RCT indicator                                                                                                  
    rct = bool(re.search(r'\brandomi[sz]ed\b|\brandomised controlled trial\b|'                                          
                         r'\brandomized controlled trial\b|\brct\b|'                                                    
                         r'\bpilot study\b', title))                                                                    
                                                                                                                        
    # 2. Heart‑failure population indicator                                                                             
    hf = bool(re.search(r'heart failure|hf|congestive heart failure', title))                                           
                                                                                                                        
    # 3. Mobile‑health delivery indicator                                                                               
    mobile = bool(re.search(r'tablet|smartphone|app|mobile|web|internet|online|'                                        
                           r'sms|text|e[-]?health|m[-]?health|digital|'                                                 
                           r'social media|phone[-]?based|telemonitoring|remote', title))                                
                                                                                                                        
    # 4. Education / self‑care indicator                                                                                
    education = bool(re.search(r'education|educational|self[-]?care|self[-]?management|'                                
                               r'counseling|training|knowledge|patient[-]?centered|'                                    
                               r'support|programme|program|intervention', title))                                       
                                                                                                                        
    # Include only if all four conditions are satisfied                                                                 
    decisions.append('INCLUDE' if (rct and hf and mobile and education) else 'EXCLUDE')                                 
                                                                                                                        
# Ensure we have a decision for every of the 200 studies                                                                
assert len(decisions) == 200                                                                                            
                                                                                                                        
# Prepare the final plain‑text list                                                                                     
output = "\n".join(decisions)                                                                                           
print(output)                                                                                                           
```                                                                                                                     
                                                                                                                        
