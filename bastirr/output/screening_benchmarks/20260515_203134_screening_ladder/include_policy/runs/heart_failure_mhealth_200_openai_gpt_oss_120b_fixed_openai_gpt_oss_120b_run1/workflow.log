━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ Step 3 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Output message of the LLM: ─────────────────────────────────────────────────────────────────────────────────────────────
Below is the Python code that reads the provided `studies_summary`, applies the selection criteria, and prints a        
plain‑text list (one decision per line, in the original order 1‑200) containing either **INCLUDE** or **EXCLUDE**.      
                                                                                                                        
```python                                                                                                               
# -------------------------------------------------                                                                     
# 1. Parse the studies summary                                                                                          
# -------------------------------------------------                                                                     
lines = studies_summary.strip().split('\n')                                                                             
decisions = []                                                                                                          
                                                                                                                        
# Keywords for the selection criteria                                                                                   
rand_keys = ['randomised', 'randomized', 'randomised controlled', 'randomized controlled', 'rct']                       
pop_keys = ['heart failure', 'hf']                                                                                      
intervention_keys = [                                                                                                   
    'app', 'smartphone', 'tablet', 'mobile', 'web', 'internet',                                                         
    'online', 'e‑health', 'e-health', 'mhealth', 'm‑health',                                                            
    'sms', 'text message', 'social media', 'video education',                                                           
    'website', 'digital', 'remote education', 'education programme',                                                    
    'education program', 'education', 'e‑learning', 'e‑learning', 'e‑education'                                         
]                                                                                                                       
comparator_keys = ['usual care', 'standard care', 'usual treatment', 'usual therapy']                                   
                                                                                                                        
def contains_any(text, keys):                                                                                           
    return any(k in text for k in keys)                                                                                 
                                                                                                                        
for line in lines:                                                                                                      
    parts = line.split('\t')                                                                                            
    if len(parts) < 3:                                                                                                  
        # malformed line – automatically exclude                                                                        
        decisions.append('EXCLUDE')                                                                                     
        continue                                                                                                        
    study_id, title, abstract = parts[0], parts[1], parts[2]                                                            
    txt = (title + ' ' + abstract).lower()                                                                              
                                                                                                                        
    # ----- Apply the rules -----                                                                                       
    is_randomised = contains_any(txt, rand_keys)                                                                        
    has_population = contains_any(txt, pop_keys)   # assume adult if HF mentioned                                       
    has_intervention = contains_any(txt, intervention_keys) and 'education' in txt                                      
    has_comparator = contains_any(txt, comparator_keys)                                                                 
                                                                                                                        
    if is_randomised and has_population and has_intervention and has_comparator:                                        
        decisions.append('INCLUDE')                                                                                     
    else:                                                                                                               
        decisions.append('EXCLUDE')                                                                                     
                                                                                                                        
# -------------------------------------------------                                                                     
# 2. Output the decisions, one per line, in order 1‑200                                                                 
# -------------------------------------------------                                                                     
print('\n'.join(decisions))                                                                                             
```                                                                                                                     
                                                                                                                        
