import re                                                                                                               
                                                                                                                        
review_title = "mHealth education interventions in heart failure"                                                       
selection_criteria = (                                                                                                  
    "We included studies if they were conducted as a randomised controlled trial (RCT), "                               
    "involving adults (≥ 18 years) with a diagnosis of HF. We included trials comparing "                               
    "mHealth‑delivered education such as internet and web‑based education programmes for "                              
    "use on smartphones and tablets (including apps) and other mobile devices, SMS messages "                           
    "and social media‑delivered education programmes, versus usual HF care."                                            
)                                                                                                                       
                                                                                                                        
output_dir =                                                                                                            
"/var/folders/b7/kwcv3jkx39912qqb079d7xym0000gn/T/screening_benchmark_raw_nuavrf4o/20260515_204712_heart_failure_mhealth
_200_openai_gpt_oss_120b_fixed_openai_g"                                                                                
expected_n_studies = 200                                                                                                
                                                                                                                        
# Construct a concise gatekeeper prompt                                                                                 
gatekeeper_task = (                                                                                                     
    f"Screen the set of candidate studies for this review according to the EXACT selection criteria below. "            
    f"Return a plain‑text list with ONE decision per study, in the same order as the studies are stored internally. "   
    f"Each line must be either the word INCLUDE or the word EXCLUDE. Provide exactly {expected_n_studies} lines. "      
    f"Do not include any additional text, summaries, or grouping.\n\n"                                                  
    f"Selection criteria (verbatim): \"{selection_criteria}\""                                                          
)                                                                                                                       
                                                                                                                        
# Call gatekeeper (no large payload)                                                                                    
gatekeeper_response = gatekeeper(                                                                                       
    task=gatekeeper_task,                                                                                               
    additional_args={}                                                                                                  
)                                                                                                                       
                                                                                                                        
# Verify we have the expected number of decisions                                                                       
decisions = re.findall(r"\\bINCLUDE\\b|\\bEXCLUDE\\b", gatekeeper_response, flags=re.IGNORECASE)                        
print("Number of decisions found:", len(decisions))                                                                     
                                                                                                                        
if len(decisions) != expected_n_studies:                                                                                
    raise ValueError(f"Incomplete screening response: expected {expected_n_studies} decisions, found {len(decisions)}") 
                                                                                                                        
# Save evidence                                                                                                         
evidence_path = save_screening_evidence_json(                                                                           
    screening_response=gatekeeper_response,                                                                             
    output_dir=output_dir,                                                                                              
    expected_n_studies=expected_n_studies                                                                               
)                                                                                                                       
print("Evidence saved to:", evidence_path)                                                                              
                                                                                                                        
# Create summary                                                                                                        
summary_md = format_screening_summary(                                                                                  
    review_title=review_title,                                                                                          
    screening_response=gatekeeper_response                                                                              
)                                                                                                                       
print("Screening summary markdown:", summary_md)                                                                        
                                                                                                                        
# Return final answer                                                                                                   
final_answer(summary_md)                                                                                                
