import re                                                                                                               
                                                                                                                        
titles = titles_str.strip().split("\n")                                                                                 
decisions = []                                                                                                          
                                                                                                                        
# keywords for RCT                                                                                                      
rct_keywords = ["randomised", "randomized", "randomized controlled trial", "randomised controlled trial",               
                "randomised trial", "randomized trial", "pilot", "feasibility", "multicenter", "multicentre",           
                "study", "protocol", "trial"]                                                                           
# population keywords                                                                                                   
hf_keywords = ["heart failure", "hf", "congestive heart failure", "chronic heart failure", "systolic heart failure",    
               "heart‑failure", "heart‑failure", "heart failure"]                                                       
# intervention keywords for mHealth education                                                                           
intervention_keywords = ["tablet", "app", "mobile", "web‑based", "web-based", "internet", "sms", "text message",        
                         "e‑health", "e-health", "online", "digital", "smartphone", "social media", "phone", "mobile    
phone",                                                                                                                 
                         "mhealth", "mobile health"]                                                                    
# education related keywords                                                                                            
education_keywords = ["education", "educational", "self‑care", "self-care", "self management", "self‑management",       
                      "knowledge", "training", "program", "programme", "counseling", "counselling", "support"]          
                                                                                                                        
def contains_any(text, keywords):                                                                                       
    return any(re.search(r'\b' + re.escape(k) + r'\b', text.lower()) for k in keywords)                                 
                                                                                                                        
for title in titles:                                                                                                    
    # check RCT                                                                                                         
    is_rct = contains_any(title, rct_keywords)                                                                          
    # check HF population                                                                                               
    has_hf = contains_any(title, hf_keywords)                                                                           
    # check intervention                                                                                                
    has_intervention = contains_any(title, intervention_keywords)                                                       
    # check education component                                                                                         
    has_education = contains_any(title, education_keywords)                                                             
    # decision                                                                                                          
    if is_rct and has_hf and has_intervention and has_education:                                                        
        decisions.append("INCLUDE")                                                                                     
    else:                                                                                                               
        decisions.append("EXCLUDE")                                                                                     
                                                                                                                        
# Ensure we have 200 decisions                                                                                          
assert len(decisions) == 200                                                                                            
                                                                                                                        
# Output as plain text lines                                                                                            
output = "\n".join(decisions)                                                                                           
print(output)                                                                                                           
