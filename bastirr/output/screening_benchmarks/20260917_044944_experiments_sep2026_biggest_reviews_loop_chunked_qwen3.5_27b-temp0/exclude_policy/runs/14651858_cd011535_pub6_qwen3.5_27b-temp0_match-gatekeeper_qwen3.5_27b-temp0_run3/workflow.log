# Function to check if a study meets criteria                                                                           
def screen_study(study):                                                                                                
    title = study.get('title', '')                                                                                      
    abstract = study.get('abstract', '')                                                                                
    study_index = study.get('study_index')                                                                              
                                                                                                                        
    # Convert to lowercase for easier checking                                                                          
    title_lower = title.lower()                                                                                         
    abstract_lower = abstract.lower()                                                                                   
                                                                                                                        
    # Check for RCT                                                                                                     
    rct_keywords = ['randomised', 'randomized', 'randomized controlled trial', 'rct', 'randomized controlled']          
    is_rct = any(kw in abstract_lower or kw in title_lower for kw in rct_keywords)                                      
                                                                                                                        
    # Check for plaque psoriasis                                                                                        
    psoriasis_keywords = ['plaque psoriasis', 'psoriasis vulgaris', 'chronic plaque psoriasis']                         
    is_psoriasis = any(kw in abstract_lower or kw in title_lower for kw in psoriasis_keywords)                          
                                                                                                                        
    # Check for moderate-to-severe                                                                                      
    severity_keywords = ['moderate-to-severe', 'moderate to severe', 'moderate or severe', 'severe']                    
    is_severe = any(kw in abstract_lower or kw in title_lower for kw in severity_keywords)                              
                                                                                                                        
    # Check for systemic treatment                                                                                      
    systemic_keywords = ['systemic', 'oral', 'subcutaneous', 'intravenous', 'biologic', 'small molecule',               
'methotrexate', 'cyclosporin', 'acitretin', 'etanercept', 'adalimumab', 'infliximab', 'ustekinumab', 'secukinumab',     
'ixekizumab', 'guselkumab', 'risankizumab', 'bimekizumab', 'apremilast', 'tofacitinib', 'broadalumab', 'certolizumab',  
'tildrakizumab', 'mirikizumab', 'deucravacitinib', 'alefacept', 'siplizumab', 'sirolimus', 'mycophenolate']             
    is_systemic = any(kw in abstract_lower or kw in title_lower for kw in systemic_keywords)                            
                                                                                                                        
    # Check for topical exclusion                                                                                       
    topical_keywords = ['topical', 'cream', 'ointment', 'lotion', 'phototherapy', 'uvb', 'uva', 'pufa']                 
    is_topical = any(kw in abstract_lower or kw in title_lower for kw in topical_keywords)                              
                                                                                                                        
    # Check for PsA focus (exclude if primarily PsA without skin outcomes)                                              
    psa_keywords = ['psoriatic arthritis', 'psa']                                                                       
    is_psa = any(kw in abstract_lower or kw in title_lower for kw in psa_keywords)                                      
                                                                                                                        
    # Check for review/meta-analysis (exclude secondary research)                                                       
    review_keywords = ['meta-analysis', 'systematic review', 'network meta-analysis', 'review']                         
    is_review = any(kw in abstract_lower or kw in title_lower for kw in review_keywords)                                
                                                                                                                        
    # Decision logic                                                                                                    
    decision = 'EXCLUDE'                                                                                                
    rationale = ''                                                                                                      
    confidence = 'high'                                                                                                 
                                                                                                                        
    # Exclude if not RCT                                                                                                
    if not is_rct:                                                                                                      
        decision = 'EXCLUDE'                                                                                            
        rationale = 'Not a randomised controlled trial (RCT).'                                                          
        confidence = 'high'                                                                                             
    # Exclude if review/meta-analysis                                                                                   
    elif is_review and 'meta-analysis' in abstract_lower:                                                               
        decision = 'EXCLUDE'                                                                                            
        rationale = 'Study is a meta-analysis or systematic review, not a primary RCT.'                                 
        confidence = 'high'                                                                                             
    # Exclude if topical treatment only                                                                                 
    elif is_topical and not is_systemic:                                                                                
        decision = 'EXCLUDE'                                                                                            
        rationale = 'Study focuses on topical treatment or phototherapy, not systemic treatment.'                       
        confidence = 'high'                                                                                             
    # Exclude if not plaque psoriasis                                                                                   
    elif not is_psoriasis:                                                                                              
        decision = 'EXCLUDE'                                                                                            
        rationale = 'Study does not focus on plaque psoriasis.'                                                         
        confidence = 'high'                                                                                             
    # Exclude if not moderate-to-severe                                                                                 
    elif not is_severe:                                                                                                 
        decision = 'EXCLUDE'                                                                                            
        rationale = 'Study does not specify moderate-to-severe plaque psoriasis.'                                       
        confidence = 'medium'                                                                                           
    # Exclude if primarily PsA without skin outcomes                                                                    
    elif is_psa and 'pasi' not in abstract_lower:                                                                       
        decision = 'EXCLUDE'                                                                                            
        rationale = 'Study focuses on psoriatic arthritis without reporting skin outcomes (PASI).'                      
        confidence = 'medium'                                                                                           
    # Include if meets criteria                                                                                         
    else:                                                                                                               
        decision = 'INCLUDE'                                                                                            
        rationale = 'RCT of systemic treatment in adults with moderate-to-severe plaque psoriasis.'                     
        confidence = 'high'                                                                                             
                                                                                                                        
    return {                                                                                                            
        'study_index': study_index,                                                                                     
        'title': title,                                                                                                 
        'decision': decision,                                                                                           
        'rationale': rationale,                                                                                         
        'confidence': confidence                                                                                        
    }                                                                                                                   
                                                                                                                        
# Process each study                                                                                                    
for study in studies:                                                                                                   
    decision_obj = screen_study(study)                                                                                  
    decisions.append(decision_obj)                                                                                      
    if decision_obj['decision'] == 'INCLUDE':                                                                           
        n_included += 1                                                                                                 
    else:                                                                                                               
        n_excluded += 1                                                                                                 
                                                                                                                        
# Construct final result                                                                                                
result = {                                                                                                              
    'n_total': len(studies),                                                                                            
    'n_included': n_included,                                                                                           
    'n_excluded': n_excluded,                                                                                           
    'decisions': decisions                                                                                              
}                                                                                                                       
                                                                                                                        
