# Combine all decisions                                                                                                 
all_decisions = include_studies + exclude_studies                                                                       
                                                                                                                        
# Sort by study_index                                                                                                   
all_decisions.sort(key=lambda x: x[0])                                                                                  
                                                                                                                        
# Create decision objects                                                                                               
decision_objects = []                                                                                                   
for idx, title, decision, rationale, confidence in all_decisions:                                                       
    decision_objects.append({                                                                                           
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count included and excluded                                                                                           
n_included = sum(1 for d in decision_objects if d["decision"] == "INCLUDE")                                             
n_excluded = sum(1 for d in decision_objects if d["decision"] == "EXCLUDE")                                             
n_total = len(decision_objects)                                                                                         
                                                                                                                        
# Create final output                                                                                                   
final_output = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decision_objects                                                                                       
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(final_output, indent=2))                                                                               
                                                                                                                        
