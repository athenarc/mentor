      final_decisions.append({                                                                                          
          "study_index": idx,                                                                                           
          "title": title_lookup[idx],                                                                                   
          "decision": decision_info["decision"].upper(),                                                                
          "rationale": decision_info["rationale"],                                                                      
          "confidence": "high" if "RCT" in decision_info["rationale"] or "RCT" in decision_info["rationale"].lower()    
  else "medium"                                                                                                         
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in final_decisions if d["decision"] == "INCLUDE")                                            
  n_excluded = sum(1 for d in final_decisions if d["decision"] == "EXCLUDE")                                            
                                                                                                                        
  result = {                                                                                                            
      "n_total": 100,                                                                                                   
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": final_decisions                                                                                      
  }                                                                                                                     
                                                                                                                        
  print(f"Total: {result['n_total']}, Included: {result['n_included']}, Excluded: {result['n_excluded']}")              
