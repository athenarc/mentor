review assessing neurodevelopmental outcomes in children exposed to AEDs in pregnancy, not a randomised controlled trial
comparing phenobarbitone versus phenytoin monotherapy.", "confidence": "high"})                                         
                                                                                                                        
# Count included and excluded                                                                                           
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
result = {                                                                                                              
