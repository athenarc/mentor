      # Study 36: Case series - EXCLUDE                                                                                 
      elif idx == 36:                                                                                                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Case series of 4 patients describing treatment (not prevention) of OHSS with dopamine agonist +  
  GnRH antagonist. Wrong study design and focuses on treatment rather than prevention."                                 
          confidence = "high"                                                                                           
                                                                                                                        
      # Study 37: Symposium - EXCLUDE                                                                                   
      elif idx == 37:                                                                                                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Symposium presentation about OHSS prediction and management. Not an RCT."                        
          confidence = "high"                                                                                           
                                                                                                                        
      # Study 38: Calcium gluconate vs cabergoline RCT - INCLUDE                                                        
      elif idx == 38:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Randomized comparative study comparing calcium gluconate vs cabergoline (dopamine agonist) for   
  OHSS prevention in high-risk patients. Reports OHSS occurrence rates. Meets selection criteria (dopamine agonist vs   
  another intervention)."                                                                                               
          confidence = "high"                                                                                           
                                                                                                                        
      # Study 39: Cochrane review protocol - EXCLUDE                                                                    
      elif idx == 39:                                                                                                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Spanish language Cochrane review protocol about cabergoline for OHSS prevention. Not an RCT."    
          confidence = "high"                                                                                           
                                                                                                                        
      # Study 40: Cohort study - EXCLUDE                                                                                
      elif idx == 40:                                                                                                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Prospective cohort study examining follicular fluid hormone profiles with cabergoline. Not an    
  RCT, and primary outcomes are biomarker levels not OHSS incidence or live birth."                                     
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count included/excluded                                                                                             
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
