# Study 85 - Double-blind placebo controlled study                                                                      
decisions.append({"study_index": 85, "title": "Blood loss and safety with desmopressin or placebo during aorto‐iliac    
graft surgery", "decision": "INCLUDE", "rationale": "This is described as a 'double blind, placebo controlled study' in 
50 patients undergoing aorto-iliac graft surgery. While randomization is not explicitly stated, double-blind            
