# Create decisions list                                                                                                 
decisions = []                                                                                                          
                                                                                                                        
# Process each study                                                                                                    
for study in chunk_data['studies']:                                                                                     
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Check if study involves maternal URINE testing for Down's syndrome                                                
    # Key indicators: "urine", "urinary", "urine beta-core", "urine estriol", etc.                                      
                                                                                                                        
    # Convert to lowercase for easier matching                                                                          
    title_lower = title.lower()                                                                                         
    abstract_lower = abstract.lower()                                                                                   
                                                                                                                        
    # Check for urine-related terms                                                                                     
    has_urine = ('urine' in title_lower or 'urinary' in title_lower or                                                  
                 'urine' in abstract_lower or 'urinary' in abstract_lower)                                              
                                                                                                                        
    # Check for Down's syndrome/trisomy 21                                                                              
    has_ds = ('down' in title_lower or 'trisomy 21' in title_lower or 'trisomy 21' in abstract_lower or                 
              'down syndrome' in title_lower or 'down syndrome' in abstract_lower)                                      
                                                                                                                        
    # Decision logic                                                                                                    
    if has_urine and has_ds:                                                                                            
        decision = "include"                                                                                            
        rationale = f"Study evaluates maternal urine markers for Down's syndrome screening. Title mentions '{title}'.   
Abstract indicates urine testing for DS detection."                                                                     
    else:                                                                                                               
        decision = "exclude"                                                                                            
        if not has_urine:                                                                                               
            if 'serum' in title_lower or 'serum' in abstract_lower:                                                     
                rationale = "Study uses maternal SERUM markers, not urine. Does not meet selection criteria requiring   
urine tests."                                                                                                           
            elif 'ultrasound' in title_lower or 'ultrasound' in abstract_lower or 'nuchal' in title_lower or 'nasal     
bone' in title_lower:                                                                                                   
                rationale = "Study uses ultrasound markers, not urine. Does not meet selection criteria requiring urine 
tests."                                                                                                                 
            else:                                                                                                       
                rationale = "Study does not evaluate maternal urine tests for Down's syndrome. Does not meet selection  
criteria."                                                                                                              
        else:                                                                                                           
            rationale = "Study does not clearly evaluate urine tests for Down's syndrome detection."                    
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": "high"                                                                                            
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d['decision'] == 'include')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'exclude')                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print("\nIncluded studies:")                                                                                            
for d in decisions:                                                                                                     
    if d['decision'] == 'include':                                                                                      
        print(f"  {d['study_index']}: {d['title']}")                                                                    
                                                                                                                        
