    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Default to EXCLUDE                                                                                                
    decision = "EXCLUDE"                                                                                                
    confidence = "high"                                                                                                 
    rationale = ""                                                                                                      
                                                                                                                        
    # Check for keywords indicating urine test                                                                          
    is_urine = False                                                                                                    
    if 'urine' in title.lower() or 'urine' in abstract.lower() or 'urinary' in title.lower() or 'urinary' in            
abstract.lower():                                                                                                       
        is_urine = True                                                                                                 
                                                                                                                        
    # Check for Down's syndrome                                                                                         
    is_ds = False                                                                                                       
    if 'down' in title.lower() or 'trisomy 21' in title.lower() or 'down' in abstract.lower() or 'trisomy 21' in        
abstract.lower():                                                                                                       
        is_ds = True                                                                                                    
                                                                                                                        
    # Check for reference standard (karyotype, chromosomal, etc.)                                                       
    has_ref_std = False                                                                                                 
    ref_keywords = ['karyotype', 'chromosomal', 'chromosome', 'amniocentesis', 'cvs', 'chorionic villus', 'postnatal',  
'inspection', 'aneuploid', 'aneuploidy']                                                                                
    for kw in ref_keywords:                                                                                             
        if kw in abstract.lower():                                                                                      
            has_ref_std = True                                                                                          
            break                                                                                                       
                                                                                                                        
    # Decision Logic                                                                                                    
    if is_urine and is_ds and has_ref_std:                                                                              
        decision = "INCLUDE"                                                                                            
        rationale = f"Study evaluates maternal urine tests for Down's syndrome compared with a reference standard       
(chromosomal verification)."                                                                                            
        confidence = "high"                                                                                             
    else:                                                                                                               
        # Determine exclusion reason                                                                                    
        if not is_urine:                                                                                                
            if 'serum' in title.lower() or 'serum' in abstract.lower():                                                 
                rationale = "Study uses maternal serum/blood markers, not urine."                                       
            elif 'ultrasound' in title.lower() or 'nuchal' in title.lower() or 'sonograph' in title.lower() or          
'transvaginal' in title.lower():                                                                                        
                rationale = "Study uses ultrasound markers (e.g., nuchal translucency), not urine."                     
            else:                                                                                                       
                rationale = "Study does not evaluate maternal urine tests."                                             
        elif not is_ds:                                                                                                 
            rationale = "Study does not focus on Down's syndrome (Trisomy 21)."                                         
        elif not has_ref_std:                                                                                           
            rationale = "Study lacks comparison with a reference standard (chromosomal verification)."                  
        else:                                                                                                           
            rationale = "Study does not meet selection criteria."                                                       
                                                                                                                        
    if decision == "INCLUDE":                                                                                           
        n_included += 1                                                                                                 
    else:                                                                                                               
        n_excluded += 1                                                                                                 
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Prepare the final answer structure                                                                                    
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions,                                                                                             
    "task_outcome_short": f"Screened {n_total} studies. Included {n_included}, Excluded {n_excluded}. Only studies      
evaluating maternal urine tests for Down's syndrome with a reference standard were included.",                          
    "task_outcome_detailed": f"A total of {n_total} studies (indices 201-300) were screened against the protocol for    
'Urine tests for Down's syndrome screening'. Selection criteria required studies evaluating tests of maternal urine in  
women up to 24 weeks of gestation for Down's syndrome, compared with a reference standard. {n_included} studies met     
these criteria. The remaining {n_excluded} studies were excluded primarily because they evaluated serum markers,        
ultrasound markers, or did not involve urine testing for Down's syndrome.",                                             
    "additional_context": "Most excluded studies focused on maternal serum biochemistry (e.g., AFP, hCG, PAPP-A) or     
ultrasound markers (e.g., nuchal translucency). Studies establishing reference ranges in healthy pregnancies without DS 
case validation were also excluded."                                                                                    
}                                                                                                                       
                                                                                                                        
