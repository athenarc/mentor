# Prepare decisions                                                                                                     
decisions = []                                                                                                          
for study in chunk_data['studies']:                                                                                     
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Check for urine markers                                                                                           
    is_urine = 'urine' in title.lower() or 'urine' in abstract.lower() or 'urinary' in title.lower() or 'urinary' in    
abstract.lower()                                                                                                        
                                                                                                                        
    if is_urine:                                                                                                        
        # Check if it evaluates accuracy for DS with reference standard                                                 
        has_ds = 'down' in abstract.lower() or 'trisomy 21' in abstract.lower()                                         
        has_ref = 'karyotype' in abstract.lower() or 'chromosomal' in abstract.lower() or 'control' in abstract.lower() 
                                                                                                                        
        # Study 241 is only reference range, no DS cases                                                                
        if idx == 241:                                                                                                  
            decision = "EXCLUDE"                                                                                        
            rationale = "Study establishes reference ranges for urine free beta-hCG in healthy pregnancies only; does   
not evaluate screening accuracy against a reference standard for Down syndrome."                                        
        elif has_ds and has_ref:                                                                                        
            decision = "INCLUDE"                                                                                        
            rationale = "Evaluates maternal urine markers for Down syndrome screening compared with chromosomal         
verification/reference standard within the specified gestational window."                                               
        else:                                                                                                           
            decision = "EXCLUDE"                                                                                        
            rationale = "Mentions urine but does not meet all selection criteria for evaluating DS screening accuracy." 
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = "Study evaluates serum markers, ultrasound, or other non-urine tests; does not meet the selection   
criteria for maternal urine tests."                                                                                     
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": "high"                                                                                            
    })                                                                                                                  
                                                                                                                        
result = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": sum(1 for d in decisions if d['decision'] == 'INCLUDE'),                                              
    "n_excluded": sum(1 for d in decisions if d['decision'] == 'EXCLUDE'),                                              
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
