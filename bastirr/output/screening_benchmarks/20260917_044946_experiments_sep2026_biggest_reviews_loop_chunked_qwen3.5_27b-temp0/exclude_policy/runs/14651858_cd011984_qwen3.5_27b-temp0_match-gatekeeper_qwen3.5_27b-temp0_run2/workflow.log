# Create decisions list                                                                                                 
decisions = []                                                                                                          
                                                                                                                        
# Studies that meet the criteria (urine-based):                                                                         
# 307: First-trimester urine free β hCG, β core, and total oestriol                                                     
# 340: Screening for Down syndrome using urine hCG free beta-subunit in the second trimester                            
# 353: Measurement of urinary free β-human chorionic gonadotropin by immunoradiometric assay                            
# 360: Levels of urinary β-core fragment, total oestriol, and the ratio of the two in second-trimester screening        
# 377: Comparison of urinary hyperglycosylated human chorionic gonadotropin concentration with the serum triple screen  
# 385: Urinary free beta hCG, beta core fragment and total oestriol as markers of Down syndrome in the second trimester 
                                                                                                                        
included_indices = {307, 340, 353, 360, 377, 385}                                                                       
                                                                                                                        
for i in range(301, 401):                                                                                               
    if i in included_indices:                                                                                           
        decision = "include"                                                                                            
    else:                                                                                                               
        decision = "exclude"                                                                                            
                                                                                                                        
    # Generate rationale based on study content                                                                         
    if i == 307:                                                                                                        
        rationale = "Study evaluates maternal urine concentrations of beta core, free beta hCG, and total oestriol in   
first-trimester pregnancies (10-14 weeks) for Down's syndrome screening. Includes 373 control and 43 aneuploidy         
pregnancies (22 DS cases). Meets selection criteria for urine-based DS screening."                                      
    elif i == 340:                                                                                                      
        rationale = "Study determines hCG free beta-subunit levels in 709 control and 13 Down syndrome urine samples    
from second trimester. Results normalized to urine creatinine. Meets selection criteria for urine-based DS screening."  
    elif i == 353:                                                                                                      
        rationale = "Study evaluates immunoradiometric assay for urinary free beta-hCG measurement. While primarily     
methodological, it establishes applicability of urine samples for hCG measurement relevant to DS screening. Creatinine  
corrected urinary F beta hCG levels correlated with serum levels."                                                      
    elif i == 360:                                                                                                      
        rationale = "Study measures beta-core fragment and total oestriol in second-trimester maternal urine samples    
from 32 Down syndrome and 206 control pregnancies. Reports detection rates for urine markers. Meets selection criteria  
for urine-based DS screening."                                                                                          
    elif i == 377:                                                                                                      
        rationale = "Study compares urinary hyperglycosylated human chorionic gonadotropin concentration with serum     
triple screen for second-trimester Down syndrome detection. Includes 24 DS and 500 unaffected pregnancies. Meets        
selection criteria for urine-based DS screening."                                                                       
    elif i == 385:                                                                                                      
        rationale = "Study assesses urinary free beta hCG, beta core fragment, and total oestriol in 69 DS and 405      
unaffected pregnancies in second trimester. Reports detection rates for urine markers. Meets selection criteria for     
urine-based DS screening."                                                                                              
    else:                                                                                                               
        rationale = "Study does not evaluate maternal urine tests for Down's syndrome screening. Focuses on serum       
markers, ultrasound/nuchal translucency, invasive diagnostic procedures, or other screening modalities not meeting the  
selection criteria."                                                                                                    
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": i,                                                                                               
        "decision": decision,                                                                                           
        "rationale": rationale                                                                                          
    })                                                                                                                  
                                                                                                                        
print(f"Total studies: {len(decisions)}")                                                                               
print(f"Included: {sum(1 for d in decisions if d['decision'] == 'include')}")                                           
print(f"Excluded: {sum(1 for d in decisions if d['decision'] == 'exclude')}")                                           
                                                                                                                        
