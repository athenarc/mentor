# Helper to check if a study should be included based on criteria                                                       
def evaluate_study(s):                                                                                                  
    title = s['title'].lower()                                                                                          
    abstract = s['abstract'].lower()                                                                                    
    text = title + " " + abstract                                                                                       
                                                                                                                        
    # Exclude if it's a review, meta-analysis, guideline, or methodology paper                                          
    if any(kw in text for kw in ['systematic review', 'meta-analysis', 'meta analysis', 'prisma', 'guideline',          
'reporting', 'checklist', 'consensus', 'taxonomy', 'robvis', 'rob 2', 'cinema', 'p-score', 'sucra', 'network            
meta-analysis', 'mixed treatment comparison', 'imputing missing', 'bias in meta-analysis', 'funnel plot', 'ranking      
treatments', 'treatment hierarchy']):                                                                                   
        return "EXCLUDE", "Study is a review, meta-analysis, methodological paper, or guideline, not an RCT."           
                                                                                                                        
    # Exclude if it's an animal study                                                                                   
    if any(kw in text for kw in ['rat', 'mouse', 'rodent', '6-ohda', 'mptp', 'animal model', 'in vivo', 'striatal       
recordings', 'medium spiny']):                                                                                          
        return "EXCLUDE", "Study is an animal model study, not involving human adults with PD."                         
                                                                                                                        
    # Exclude if it's epidemiological, diagnostic, or clinical criteria                                                 
    if any(kw in text for kw in ['epidemiology', 'incidence', 'prevalence', 'mortality', 'risk factors', 'diagnostic    
criteria', 'clinico-pathological', 'burden of disease', 'global burden', 'comorbidity', 'prodromal', 'substantia nigra',
'patterns of loss']):                                                                                                   
        return "EXCLUDE", "Study is epidemiological, diagnostic, or pathological, not an intervention RCT."             
                                                                                                                        
    # Exclude if it's a measurement tool validation without intervention                                                
    if any(kw in text for kw in ['minimal detectable change', 'minimal clinically relevant change', 'validity of a short
measure', 'development and validation', 'reliability of the new freezing', 'measuring balance in the elderly',          
'euroqol', 'pdq-8', 'pdq-39', 'pdql', 'mds-updrs', 'clinimetric testing']):                                             
        return "EXCLUDE", "Study is a measurement tool validation or development paper, not an intervention RCT."       
                                                                                                                        
    # Exclude if it's not an RCT or not about exercise/physiotherapy                                                    
    if 'randomized' not in text and 'randomised' not in text and 'rct' not in text and 'trial' not in text:             
        # Check if it's clearly not a trial                                                                             
        if any(kw in text for kw in ['cross sectional', 'cohort study', 'prospective cohort', 'case series',            
'observational', 'survey', 'questionnaire development', 'consensus set of outcomes']):                                  
            return "EXCLUDE", "Study is not a randomized controlled trial."                                             
                                                                                                                        
    # Check for PD and Exercise/Intervention                                                                            
    has_pd = 'parkinson' in text or 'pd' in text                                                                        
    has_exercise = any(kw in text for kw in ['exercise', 'training', 'therapy', 'treadmill', 'dance', 'yoga', 'tai chi',
'aquatic', 'resistance', 'balance', 'aerobic', 'walking', 'nordic', 'tango', 'qigong', 'pilates', 'slackline',          
'exergaming', 'virtual reality', 'cueing', 'physiotherapy', 'rehabilitation', 'movement strategy', 'agility', 'boxing', 
'ballroom', 'folk dance', 'irish set', 'ai chi', 'wuqinxi', 'turo', 'halliwick', 'gpr', 'lsvt', 'music', 'rhythm',      
'slackline', 'slacklining', 'ballroom', 'foxtrot', 'waltz', 'dance/movement', 'dance therapy'])                         
                                                                                                                        
    if not has_pd:                                                                                                      
        return "EXCLUDE", "Study does not focus on Parkinson's disease."                                                
    if not has_exercise:                                                                                                
        return "EXCLUDE", "Study does not involve a physical exercise or rehabilitation intervention."                  
                                                                                                                        
    return "INCLUDE", "RCT comparing physical exercise/rehabilitation for adults with PD to control or another          
exercise."                                                                                                              
                                                                                                                        
for s in studies:                                                                                                       
    decision, rationale = evaluate_study(s)                                                                             
    decisions.append({                                                                                                  
        "study_index": s['study_index'],                                                                                
        "title": s['title'],                                                                                            
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": "high" if decision == "EXCLUDE" else "medium"                                                     
    })                                                                                                                  
                                                                                                                        
# Count included/excluded                                                                                               
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
result_json = json.dumps({                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}, indent=2)                                                                                                            
                                                                                                                        
print(f"Total: {len(decisions)}, Included: {n_included}, Excluded: {n_excluded}")                                       
print(result_json[:2000])                                                                                               
                                                                                                                        
