    if 'single-arm' in text or 'phase i' in text or 'phase ii' in text and 'randomized' not in text:                    
        # Many phase II are non-randomized; but we already caught randomization.                                        
        pass                                                                                                            
    return True, "Meets criteria: RCT comparing chemotherapy vs another intervention in advanced disease."              
                                                                                                                        
decisions = []                                                                                                          
for study in studies:                                                                                                   
    idx = study.get('study_index')                                                                                      
    title = study.get('title', '')                                                                                      
    abstract = study.get('abstract', '')                                                                                
    inc, rationale = is_included(title, abstract)                                                                       
    decision = "INCLUDE" if inc else "EXCLUDE"                                                                          
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "decision": decision,                                                                                           
        "rationale": rationale                                                                                          
    })                                                                                                                  
                                                                                                                        
# Prepare output                                                                                                        
n_total = len(studies)                                                                                                  
