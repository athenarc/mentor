def is_included(title, abstract):                                                                                       
    """Determine if study meets inclusion criteria."""                                                                  
    text = (title + " " + abstract).lower()                                                                             
    # Must be RCT (randomized controlled trial) - look for hints                                                        
    if 'randomized' not in text and 'randomised' not in text and 'rct' not in text:                                     
        # Some studies may not explicitly say randomized but describe randomization; we'll rely on explicit mention.    
        # For safety, we can also check for phrases like "patients were randomized" etc.                                
        if 'patients were randomized' not in text and 'patients were randomised' not in text:                           
            return False, "Not a randomized controlled trial (no evidence of randomization)."                           
    # Must involve chemotherapy vs another intervention (including different chemo)                                     
    # Check for chemotherapy terms                                                                                      
    chemo_terms = ['chemotherapy', 'chemotherapeutic', 'cytotoxic', 'doxorubicin', 'cisplatin', 'cyclophosphamide',     
                   'ifosfamide', 'melphalan', '5-fluorouracil', '5-fu', 'methotrexate', 'vinblastine', 'paclitaxel',    
                   'docetaxel', 'adriamycin', 'doxorubicin', 'mitomycin', 'fosfamide', 'carboplatin']                   
    has_chemo = any(term in text for term in chemo_terms)                                                               
    if not has_chemo:                                                                                                   
        return False, "Does not involve chemotherapy intervention."                                                     
    # Check for advanced disease (avoid adjuvant)                                                                       
    if 'adjuvant' in text:                                                                                              
        return False, "Adjuvant treatment (excluded per criteria)."                                                     
    # Check for sarcoma (excluded)                                                                                      
    if 'sarcoma' in text or 'sarcomatous' in text:                                                                      
        return False, "Sarcomatous tumour (excluded per criteria)."                                                     
    # Additional check: ensure it's comparing chemotherapy vs another intervention                                      
