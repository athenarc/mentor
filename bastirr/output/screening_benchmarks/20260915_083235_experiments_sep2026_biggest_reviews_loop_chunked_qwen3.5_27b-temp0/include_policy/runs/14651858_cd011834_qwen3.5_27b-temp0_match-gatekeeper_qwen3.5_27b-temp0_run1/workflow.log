import json                                                                                                             
                                                                                                                        
# Parse the candidate chunk data                                                                                        
candidate_data = json.loads(candidate_chunk)                                                                            
                                                                                                                        
# Extract studies and prepare for screening                                                                             
studies = candidate_data['studies']                                                                                     
selection_criteria = candidate_data['selection_criteria']                                                               
                                                                                                                        
# Analyze each study against the selection criteria                                                                     
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Determine decision based on selection criteria                                                                    
    # RCTs must: be randomised, include children >=24mo/young people/adults,                                            
    # compare lower fat vs usual/moderate fat diet, NO intention to reduce weight,                                      
    # not multifactorial, assess weight/body fatness after >=6 months                                                   
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check for weight loss intention (major exclusion criterion)                                                       
    if any(term in title.lower() or term in abstract.lower() for term in                                                
           ['weight reduction', 'weight loss', 'hypocaloric', 'calorie-restricted', 'energy-restricted']):              
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study involves weight loss/reduction intention which violates the 'no intention to reduce weight' 
criterion."                                                                                                             
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for multifactorial interventions                                                                            
    elif any(term in title.lower() or term in abstract.lower() for term in                                              
             ['exercise', 'physical activity', 'multifactorial', 'lifestyle', 'combined']):                             
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study appears to be multifactorial (includes exercise or multiple lifestyle components beyond fat 
reduction alone)."                                                                                                      
        confidence = "medium"                                                                                           
                                                                                                                        
    # Check for wrong outcomes (not weight/body fatness)                                                                
    elif any(term in title.lower() or term in abstract.lower() for term in                                              
             ['cholesterol', 'lipid', 'blood pressure', 'cardiovascular', 'diabetes', 'glucose', 'insulin',             
              'hemostasis', 'platelet', 'coagulation', 'fibrinolysis', 'inflammation', 'cancer',                        
              'coronary', 'myocardial', 'infarction', 'atherosclerosis', 'adipokine', 'vitamin',                        
              'carotenoid', 'genetic', 'polymorphism', 'endothelial', 'vascular', 'metabolic syndrome']):               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study focuses on outcomes other than weight or body fatness (e.g., lipids, blood pressure,        
cardiovascular events, etc.)."                                                                                          
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for duration < 6 months                                                                                     
    elif any(term in title.lower() or term in abstract.lower() for term in                                              
             ['3-mo', '3 month', '3-month', '4 week', '4-week', '8 week', '8-week', '12 week', '12-week',               
              '22 day', '22 days', '30 wk', '30 weeks', '18 week', '18-week', '6 week', '6-week']):                     
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study duration appears to be less than 6 months, which does not meet the minimum follow-up        
requirement."                                                                                                           
        confidence = "medium"                                                                                           
                                                                                                                        
    # Check for protocol/design papers                                                                                  
    elif any(term in title.lower() or term in abstract.lower() for term in                                              
             ['protocol', 'design', 'baseline', 'rationale', 'recruitment', 'objectives', 'methods']):                  
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study appears to be a protocol, design, or baseline paper rather than reporting intervention      
results."                                                                                                               
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for wrong population (pregnancy, children <24mo)                                                            
    elif any(term in title.lower() or term in abstract.lower() for term in                                              
             ['pregnancy', 'pregnant', 'maternal', 'neonate', 'colostrum', 'breast milk', 'antenatal']):                
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study involves pregnant women or neonates, which is outside the target population."               
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for wrong fat comparison (not lower fat vs usual/moderate)                                                  
    elif any(term in title.lower() or term in abstract.lower() for term in                                              
             ['trans fatty', 'sitosterol', 'plant sterol', 'probiotic', 'glycemic index', 'low-carbohydrate',           
              'high-protein', 'meatless', 'fiber', 'sodium', 'salt', 'omega-3', 'fish oil', 'margarine']):              
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study compares specific fatty acid types or other dietary components rather than total fat intake 
