          if ("goldman" in text or "detsky" in text or "lee" in text or "vsg" in text or "poss" in text or "possom" in  
  text):                                                                                                                
              if ("compare" in text or "versus" in text or "vs" in text or "better than" in text or                     
                  "more accurate" in text or "underestimate" in text or "predicts...than" in text or                    
                  "auc" in text or "roc" in text or "area under" in text):                                              
                  model_comparison = True                                                                               
                                                                                                                        
          # Criterion 1 & 2: Biomarkers added to or compared with RCRI                                                  
          biomarker_addition = False                                                                                    
          biomarkers = ["troponin", "bnp", "nt-probnp", "crp", "hs-crp", "leptin", "adrenomedullin",                    
                        "rdw", "hemoglobin", "glucose", "creatinine", "endothelial", "heart rate variability",          
                        "carotid intima", "calcium score", "natriuretic peptide", "brain natriuretic peptide"]          
                                                                                                                        
          has_biomarker = any(bm in text for bm in biomarkers)                                                          
                                                                                                                        
          # Look for explicit addition/comparison language with RCRI                                                    
          if has_biomarker:                                                                                             
              if ("add" in text and "rcri" in text) or ("incremental" in text and "rcri" in text) or \                  
                 ("combined" in text and "rcri" in text) or ("adjusted for rcri" in text) or \                          
                 ("independent of rcri" in text) or ("compared to rcri" in text) or \                                   
                 ("versus rcri" in text) or ("added value" in text and "rcri" in text) or \                             
                 ("predictive value" in text and "rcri" in text) or ("prognostic value" in text and "rcri" in text):    
                  biomarker_addition = True                                                                             
                                                                                                                        
          meets_criteria = False                                                                                        
                                                                                                                        
          if model_comparison:                                                                                          
              meets_criteria = True                                                                                     
              rationale = f"Study compares RCRI to other risk models (e.g., Goldman, Lee, VSG, POSSUM)."                
          elif biomarker_addition:                                                                                      
              meets_criteria = True                                                                                     
              biomarker_found = [bm for bm in biomarkers if bm in text][0]                                              
              rationale = f"Study investigates biomarker(s) ({biomarker_found}) added to or compared with RCRI."        
                                                                                                                        
          if not meets_criteria:                                                                                        
              rationale = f"Study reports on RCRI but does not add biomarkers, compare biomarkers to RCRI, or compare   
  RCRI to other models."                                                                                                
              decision = "EXCLUDE"                                                                                      
              confidence = "high"                                                                                       
          else:                                                                                                         
              decision = "INCLUDE"                                                                                      
              confidence = "high"                                                                                       
                                                                                                                        
          # Make rationales distinct                                                                                    
          if decision == "INCLUDE":                                                                                     
              rationale = f"Inclusion: Adults undergoing noncardiac surgery; {rationale}"                               
          else:                                                                                                         
              rationale = f"Exclusion: {rationale}"                                                                     
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Calculate totals                                                                                                    
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
