<code>                                                                                                                  
import json                                                                                                             
                                                                                                                        
# Parse the chunk data again to ensure we have the correct information                                                  
data = json.loads(chunk_data)                                                                                           
studies = data['studies']                                                                                               
                                                                                                                        
# Review and refine decisions based on careful reading of abstracts                                                     
# The criteria are:                                                                                                     
# 1. Addition of biomarker(s) to RCRI                                                                                   
# 2. Comparison of biomarker(s) predictive accuracy to RCRI                                                             
# 3. Comparison of RCRI to other models                                                                                 
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study.get('abstract', '')                                                                                
    text = (title + " " + abstract).lower()                                                                             
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check if RCRI is mentioned                                                                                        
    rcri_present = "rcri" in text or "revised cardiac risk index" in text                                               
                                                                                                                        
    if not rcri_present:                                                                                                
        rationale = f"Study does not mention RCRI or Revised Cardiac Risk Index."                                       
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
    else:                                                                                                               
        # Check for criterion 3: Comparison to other models                                                             
        other_models = ["goldman", "detsky", "lee", "vsg", "poss", "care", "ce", "risk score"]                          
        model_comparison = any(m in text for m in other_models)                                                         
                                                                                                                        
        # Check for criterion 1 & 2: Biomarkers added to or compared with RCRI                                          
        biomarkers = ["troponin", "bnp", "nt-probnp", "crp", "hs-crp", "leptin", "adrenomedullin",                      
                      "rdw", "hemoglobin", "glucose", "creatinine", "endothelial", "heart rate variability",            
                      "carotid intima", "calcium score", "natriuretic peptide", "brain natriuretic peptide"]            
        has_biomarker = any(bm in text for bm in biomarkers)                                                            
                                                                                                                        
        # Look for language indicating addition or comparison                                                           
        addition_language = ["add", "incremental", "combined", "plus", "together with", "adjusted for rcri",            
                            "independent of rcri", "compared to rcri", "versus rcri", "added value",                    
                            "predictive value", "prognostic value", "alongside rcri"]                                   
                                                                                                                        
        meets_criteria = False                                                                                          
                                                                                                                        
        # Criterion 3: Comparison to other models                                                                       
        if model_comparison:                                                                                            
            meets_criteria = True                                                                                       
            rationale = f"Study compares RCRI to other risk models (e.g., Goldman, Lee, VSG, POSSUM, etc.)."            
                                                                                                                        
        # Criterion 1 & 2: Biomarkers added to or compared with RCRI                                                    
        elif has_biomarker:                                                                                             
            if any(lang in text for lang in addition_language):                                                         
                meets_criteria = True                                                                                   
                biomarker_found = [bm for bm in biomarkers if bm in text][0]                                            
                rationale = f"Study investigates biomarker(s) ({biomarker_found}) in relation to RCRI (addition or      
comparison)."                                                                                                           
                                                                                                                        
        # If no clear criteria met                                                                                      
        if not meets_criteria:                                                                                          
            rationale = f"Study reports on RCRI but does not add biomarkers, compare biomarkers to RCRI, or compare RCRI
to other models."                                                                                                       
            decision = "EXCLUDE"                                                                                        
            confidence = "high"                                                                                         
        else:                                                                                                           
            decision = "INCLUDE"                                                                                        
            confidence = "high"                                                                                         
                                                                                                                        
        # Make rationales distinct                                                                                      
        if decision == "INCLUDE":                                                                                       
            rationale = f"Inclusion: Adults undergoing noncardiac surgery; {rationale}"                                 
        else:                                                                                                           
            rationale = f"Exclusion: {rationale}"                                                                       
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Calculate totals                                                                                                      
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
