# Call the gatekeeper with the chunk payload                                                                            
gatekeeper_response = gatekeeper(task=gatekeeper_task, additional_args={"candidate_chunk": candidate_chunk})            
print("Gatekeeper screening complete.")                                                                                 
                                                                                                                        
