          if has_comparison:                                                                                            
              return True, "Meets criteria: RCRI with biomarker/model comparison"                                       
          else:                                                                                                         
              # If it mentions RCRI and biomarkers/models but doesn't explicitly compare/add, might be borderline.      
              # Given conservative approach, if it mentions both, likely included.                                      
              return True, "Potential match: RCRI and biomarker/model mentioned"                                        
      else:                                                                                                             
          return False, "RCRI mentioned but no biomarker or other model comparison"                                     
                                                                                                                        
  decisions = []                                                                                                        
  included_count = 0                                                                                                    
  excluded_count = 0                                                                                                    
                                                                                                                        
  for study in candidate_data['studies']:                                                                               
      idx = study['study_index']                                                                                        
      inc, reason = check_inclusion(study)                                                                              
                                                                                                                        
      if inc:                                                                                                           
          decision = "include"                                                                                          
          included_count += 1                                                                                           
      else:                                                                                                             
          decision = "exclude"                                                                                          
          excluded_count += 1                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": study['title'],                                                                                      
          "decision": decision,                                                                                         
          "rationale": reason,                                                                                          
          "confidence": "medium"                                                                                        
      })                                                                                                                
                                                                                                                        
  # Prepare the output structure                                                                                        
  output_data = {                                                                                                       
      "n_total": len(decisions),                                                                                        
      "n_included": included_count,                                                                                     
      "n_excluded": excluded_count,                                                                                     
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(f"Total studies: {len(decisions)}")                                                                             
  print(f"Included: {included_count}")                                                                                  
  print(f"Excluded: {excluded_count}")                                                                                  
  print(json.dumps(output_data, indent=2))                                                                              
