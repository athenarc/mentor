          confidence = "high"                                                                                           
      elif study_index == 126:                                                                                          
          # RCT of physical therapy in PD                                                                               
          decision = "INCLUDE"                                                                                          
          rationale = "This is a randomized controlled trial with crossover design investigating physical therapy       
