          confidence = "high"                                                                                           
      elif study_index == 127:                                                                                          
          # RCT of yoga in PD                                                                                           
          decision = "INCLUDE"                                                                                          
          rationale = "This is an RCT comparing yoga intervention (twice-weekly for 12 weeks) to usual routines in      
