          confidence = "high"                                                                                           
      elif study_index == 132:                                                                                          
          # RCT of progressive resistance training in PD                                                                
          decision = "INCLUDE"                                                                                          
          rationale = "This is an RCT comparing progressive resistance training (twice weekly for 10 weeks) to          
