          confidence = "medium"                                                                                         
      elif study_index == 125:                                                                                          
          # Methodological paper about taxonomy development                                                             
          decision = "EXCLUDE"                                                                                          
          rationale = "This is a methodological paper developing a taxonomy to classify fall-prevention interventions   
