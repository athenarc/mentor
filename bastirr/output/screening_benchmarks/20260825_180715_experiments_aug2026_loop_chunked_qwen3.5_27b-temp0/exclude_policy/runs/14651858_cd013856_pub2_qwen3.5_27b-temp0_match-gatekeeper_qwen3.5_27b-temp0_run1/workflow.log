          confidence = "high"                                                                                           
      elif study_index == 133:                                                                                          
          # RCT of brisk walking and balance exercise in PD                                                             
          decision = "INCLUDE"                                                                                          
          rationale = "This is an RCT comparing six-month brisk walking and balance exercise to active control (upper   
