print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Show some examples                                                                                                    
print("\n--- Sample Decisions ---")                                                                                     
for i, d in enumerate(decisions[:10]):                                                                                  
