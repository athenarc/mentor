# Build decisions list                                                                                                  
for idx, data in include_studies.items():                                                                               
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": data["title"],                                                                                         
        "decision": "INCLUDE",                                                                                          
        "rationale": data["rationale"],                                                                                 
        "confidence": data["confidence"]                                                                                
    })                                                                                                                  
                                                                                                                        
for idx, data in exclude_studies.items():                                                                               
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": data["title"],                                                                                         
        "decision": "EXCLUDE",                                                                                          
        "rationale": data["rationale"],                                                                                 
        "confidence": data["confidence"]                                                                                
    })                                                                                                                  
                                                                                                                        
# Sort by study_index                                                                                                   
decisions.sort(key=lambda x: x["study_index"])                                                                          
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": len(include_studies),                                                                                 
    "n_excluded": len(exclude_studies),                                                                                 
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {output['n_total']}")                                                                   
print(f"Included: {output['n_included']}")                                                                              
print(f"Excluded: {output['n_excluded']}")                                                                              
                                                                                                                        
