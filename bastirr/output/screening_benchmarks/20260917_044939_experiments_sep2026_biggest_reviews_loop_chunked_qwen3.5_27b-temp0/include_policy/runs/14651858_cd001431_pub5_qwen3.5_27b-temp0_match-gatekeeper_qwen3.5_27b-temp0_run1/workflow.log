    is_rct = any(term in title.lower() + abstract.lower() for term in                                                   
                 ['randomized', 'randomised', 'random control', 'rct'])                                                 
                                                                                                                        
    # Check if it involves decision aid                                                                                 
    has_da = any(term in title.lower() + abstract.lower() for term in                                                   
                 ['decision aid', 'decision support', 'shared decision', 'decision-making'])                            
                                                                                                                        
    # Check if it compares DA to usual care (not detailed vs simple DA)                                                 
    compares_to_usual_care = any(term in abstract.lower() for term in                                                   
                                 ['usual care', 'control', 'standard care', 'pamphlet', 'brochure',                     
                                  'information only', 'educational pamphlet', 'standard information'])                  
                                                                                                                        
    # Check if it's comparing detailed vs simple DAs (should be excluded)                                               
    compares_detailed_vs_simple = any(term in abstract.lower() for term in                                              
                                      ['detailed versus simple', 'simple versus detailed',                              
                                       'comparing different versions of decision aid',                                  
                                       'audio-guided decision aid vs booklet decision aid',                             
                                       '5-option version vs 2-option version',                                          
                                       'graphic-numeric than text-anchored formats',                                    
                                       'tailored vs nontailored information'])                                          
                                                                                                                        
    # Check if it's about treatment or screening decisions                                                              
    is_treatment_or_screening = any(term in title.lower() + abstract.lower() for term in                                
                                    ['screening', 'treatment', 'therapy', 'cancer', 'diagnosis',                        
                                     'test', 'procedure', 'intervention', 'medication', 'drug'])                        
                                                                                                                        
    # Make decision                                                                                                     
    if is_rct and has_da and compares_to_usual_care and not compares_detailed_vs_simple and is_treatment_or_screening:  
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"RCT comparing decision aid to usual care/control for treatment or screening decision. Meets       
inclusion criteria."                                                                                                    
    elif not is_rct:                                                                                                    
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"Not a randomized controlled trial. Study design does not meet inclusion criteria."                
    elif not has_da:                                                                                                    
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"Does not involve a decision aid intervention. Does not meet inclusion criteria."                  
    elif compares_detailed_vs_simple:                                                                                   
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"Compares different versions/formats of decision aids rather than DA vs usual care. Excluded per   
protocol update."                                                                                                       
    elif not is_treatment_or_screening:                                                                                 
        decision = "EXCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale = f"Not focused on treatment or screening decisions. Does not meet inclusion criteria."               
    else:                                                                                                               
        decision = "INCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale = f"Appears to meet inclusion criteria but requires further verification."                            
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count decisions                                                                                                       
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
