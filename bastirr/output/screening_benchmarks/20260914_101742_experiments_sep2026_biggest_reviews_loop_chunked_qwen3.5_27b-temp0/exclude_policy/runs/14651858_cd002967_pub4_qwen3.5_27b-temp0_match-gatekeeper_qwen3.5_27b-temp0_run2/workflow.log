          elif idx == 173:                                                                                              
              rationale = "Pharmacokinetic/pharmacodynamic modeling study in 12 T2DM patients receiving metformin.      
  Measures fasting lactic acid concentrations as biomarker of tolerability alongside glucose. Provides quantitative     
  lactate response data with metformin dosing."                                                                         
          elif idx == 177:                                                                                              
              rationale = "Observational study comparing cardiovascular, metabolic and hormonal responses during        
  exercise in T2DM patients on metformin vs glyburide. Reports lactate levels higher in metformin group at fasting.     
  Provides comparative lactate data between metformin and sulfonylurea."                                                
          elif idx == 181:                                                                                              
              rationale = "Randomized study of metformin safety in patients with chronic heart failure and type 2       
  diabetes. Explicitly reports no cases of lactic acidosis throughout 12-month follow-up. Addresses lactic acidosis     
  risk in high-risk CHF population on metformin."                                                                       
          elif idx == 186:                                                                                              
              rationale = "Study examining metabolic effects of glucocorticoid and ethanol in phenformin vs             
  metformin-treated obese diabetics. Measures blood lactate and L/P ratio, finding higher levels with phenformin.       
  Provides comparative lactate data between biguanides under stress conditions."                                        
          elif idx == 188:                                                                                              
              rationale = "Double-blind crossover study comparing chronic hyperlactatemic effects of phenformin vs      
  metformin over 6 months. Shows significantly lower plasma lactate and L/P ratio with metformin. Directly addresses    
  lactate levels with metformin vs phenformin."                                                                         
          elif idx == 196:                                                                                              
              rationale = "Observational study investigating metformin effects on hypoxia markers in T2DM. Measures     
  lactate concentration alongside XO activity and TBARS. Provides lactate data with metformin monotherapy vs placebo."  
          else:                                                                                                         
              rationale = "Study evaluates metformin and measures lactate/lactic acidosis outcomes relevant to review   
  objective."                                                                                                           
                                                                                                                        
          confidence = "high"                                                                                           
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          # Determine exclusion reason                                                                                  
          if idx in {109, 127, 144, 166, 172, 197}:                                                                     
              rationale = f"Study {idx} ({title}): Not a primary prospective trial or observational cohort study.       
  {title[:50]}..."                                                                                                      
          elif idx in {113, 132, 140, 168, 178, 192}:                                                                   
              rationale = f"Study {idx} ({title}): Retrospective design or case series, not prospective trial/cohort.   
  Does not meet study design criteria."                                                                                 
          elif idx in {114, 170, 187}:                                                                                  
              rationale = f"Study {idx} ({title}): Insufficient information in abstract to determine eligibility.       
  Cannot assess relevance to lactic acidosis outcomes."                                                                 
          else:                                                                                                         
              rationale = f"Study {idx} ({title}): Does not measure lactic acidosis incidence or blood lactate levels.  
  Primary outcomes focus on glycemic control, metabolic parameters, or other endpoints not relevant to review           
  objective."                                                                                                           
                                                                                                                        
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
