          elif idx == 156:                                                                                              
              rationale = "Open crossover study comparing metformin vs gliclazide in obese NIDDM patients. Reports      
  serum lactate measurements showing significantly lower levels with gliclazide vs metformin. Provides comparative      
  lactate data between metformin and sulfonylurea."                                                                     
          elif idx == 161:                                                                                              
              rationale = "Observational study evaluating incidence and risk factors of biguanide-related lactic        
