  # Screen each study                                                                                                   
  decisions = []                                                                                                        
  n_included = 0                                                                                                        
  n_excluded = 0                                                                                                        
                                                                                                                        
  for study in studies:                                                                                                 
      idx = study['study_index']                                                                                        
      title = study['title']                                                                                            
      abstract = study['abstract']                                                                                      
                                                                                                                        
      # Decision logic based on selection criteria                                                                      
      decision = None                                                                                                   
      rationale = ""                                                                                                    
      confidence = "medium"                                                                                             
                                                                                                                        
      # Check study design (must be RCT)                                                                                
      is_rct = any(term in (title + abstract).lower() for term in ['randomized', 'randomised', 'randomized',            
  'controlled trial', 'double-blind'])                                                                                  
                                                                                                                        
      # Check for tricyclic drugs (TCAs)                                                                                
      tca_drugs = ['imipramine', 'amitriptyline', 'nortriptyline', 'desipramine', 'clomipramine', 'doxepin']            
      has_tca = any(drug in (title + abstract).lower() for drug in tca_drugs)                                           
                                                                                                                        
      # Check for non-TCA drugs                                                                                         
      non_tca = ['fluoxetine', 'paroxetine', 'ssri', 'sertraline', 'citalopram', 'escitalopram']                        
      has_non_tca = any(drug in (title + abstract).lower() for drug in non_tca)                                         
                                                                                                                        
      # Check for placebo comparator                                                                                    
      has_placebo = 'placebo' in (title + abstract).lower()                                                             
                                                                                                                        
      # Check age range (6-18 years)                                                                                    
      age_text = (title + abstract).lower()                                                                             
      age_match = any(term in age_text for term in ['children', 'adolescent', 'pediatric', 'youth'])                    
                                                                                                                        
      # Check route of administration (must be oral, not IV)                                                            
      has_iv = 'intravenous' in (title + abstract).lower() or 'iv' in (title + abstract).lower()                        
                                                                                                                        
      # Check study type (must not be review, observational, or case series)                                            
      is_review = any(term in (title + abstract).lower() for term in ['review', 'meta-analysis', 'mechanism of          
  action'])                                                                                                             
      is_observational = any(term in (title + abstract).lower() for term in ['intoxication', 'poisoning', 'overdose',   
  'ingestion'])                                                                                                         
                                                                                                                        
      # Apply exclusion criteria                                                                                        
      if is_review or is_observational:                                                                                 
          decision = "EXCLUDE"                                                                                          
          rationale = "Not a randomized controlled trial. Study is a review article, meta-analysis, or observational    
  study."                                                                                                               
          confidence = "high"                                                                                           
      elif has_iv:                                                                                                      
          decision = "EXCLUDE"                                                                                          
          rationale = "Route of administration is intravenous, not orally administered as required by selection         
  criteria."                                                                                                            
          confidence = "high"                                                                                           
      elif has_non_tca and not has_tca:                                                                                 
          decision = "EXCLUDE"                                                                                          
          rationale = "Study investigates non-tricyclic antidepressants (e.g., SSRIs) rather than tricyclic drugs."     
          confidence = "high"                                                                                           
      elif '18-65' in age_text or 'adult' in age_text:                                                                  
          decision = "EXCLUDE"                                                                                          
          rationale = "Study population is adults (18-65 years), not children and adolescents (6-18 years)."            
          confidence = "high"                                                                                           
      elif not has_placebo:                                                                                             
          decision = "EXCLUDE"                                                                                          
          rationale = "Study does not include placebo as comparator."                                                   
          confidence = "high"                                                                                           
      elif has_tca and has_placebo and is_rct:                                                                          
          decision = "INCLUDE"                                                                                          
          rationale = "Study is an RCT comparing tricyclic antidepressant with placebo in children/adolescents with     
  depression."                                                                                                          
          confidence = "medium"                                                                                         
      else:                                                                                                             
          decision = "INCLUDE"  # Conservative approach - include when uncertain                                        
          rationale = "Uncertain eligibility; conservatively including for further review."                             
          confidence = "low"                                                                                            
                                                                                                                        
      if decision == "INCLUDE":                                                                                         
          n_included += 1                                                                                               
      else:                                                                                                             
          n_excluded += 1                                                                                               
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  print(f"Total studies: {len(studies)}")                                                                               
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
  print("\nDecisions:")                                                                                                 
  for d in decisions:                                                                                                   
      print(f"Study {d['study_index']}: {d['decision']} - {d['rationale'][:100]}...")                                   
