      596: "Growth rate prediction. Longitudinal surveillance, not diagnostic accuracy.",                               
      597: "EUS-FNA algorithm. Ref std: Pathology. Reports sens/spec.",                                                 
      598: "Review/Summary.",                                                                                           
      599: "EUS-FNA value. Ref std: Pathology. Reports sens/spec.",                                                     
      600: "MRI features. Ref std: Pathology. Reports features."                                                        
  }                                                                                                                     
                                                                                                                        
  # Construct decisions                                                                                                 
  for study in studies:                                                                                                 
      idx = study['study_index']                                                                                        
      title = study['title']                                                                                            
      if idx in included_indices:                                                                                       
          decision = "INCLUDE"                                                                                          
          confidence = "high"                                                                                           
      elif idx in excluded_indices:                                                                                     
          decision = "EXCLUDE"                                                                                          
          confidence = "high"                                                                                           
      else:                                                                                                             
          # Should not happen given the sets cover 501-600                                                              
          decision = "EXCLUDE"                                                                                          
          confidence = "medium"                                                                                         
                                                                                                                        
      rationale = rationales.get(idx, "Decision based on selection criteria.")                                          
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Calculate totals                                                                                                    
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == "EXCLUDE")                                                  
                                                                                                                        
  # Prepare final output                                                                                                
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
