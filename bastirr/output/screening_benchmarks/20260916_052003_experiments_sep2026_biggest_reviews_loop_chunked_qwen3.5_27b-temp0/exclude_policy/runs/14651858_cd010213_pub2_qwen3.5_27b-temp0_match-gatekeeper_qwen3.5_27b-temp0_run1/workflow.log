      elif ('complication' in t_lower or 'safety' in t_lower or 'seeding' in t_lower) and 'accuracy' not in a_lower     
  and 'sensitivity' not in a_lower and 'specificity' not in a_lower:                                                    
          decision = "EXCLUDE"                                                                                          
          rationale = "Focuses on safety/complications rather than diagnostic accuracy."                                
          confidence = "high"                                                                                           
                                                                                                                        
      # 5. General Inclusion Check - More lenient                                                                       
      else:                                                                                                             
          # Check for presence of allowed index tests                                                                   
          allowed_tests = ['ct', 'computed tomography', 'mri', 'magnetic resonance', 'pet', 'positron emission          
  tomography', 'eus', 'endoscopic ultrasound', 'elastography', 'fna', 'fine needle aspiration', 'ceus',                 
  'contrast-enhanced', 'mdct', 'mrcp']                                                                                  
          has_allowed_test = any(test in t_lower or test in a_lower for test in allowed_tests)                          
                                                                                                                        
          # Check for reference standard                                                                                
          ref_standards = ['histopathology', 'pathology', 'biopsy', 'surgery', 'resection', 'follow-up', 'clinical      
  follow', 'confirmed', 'gold standard', 'proven', 'verified']                                                          
          has_ref_standard = any(std in a_lower for std in ref_standards)                                               
                                                                                                                        
          # Check for accuracy metrics - MORE LENIENT                                                                   
          accuracy_metrics = ['sensitivity', 'specificity', 'accuracy', 'ppv', 'npv', 'auc', 'roc', 'positive           
  predictive', 'negative predictive', 'correctly diagnosed', 'diagnostic', 'performance', 'yield', 'true positive',     
  'false negative']                                                                                                     
          has_accuracy = any(metric in a_lower for metric in accuracy_metrics)                                          
                                                                                                                        
          # Also check for numerical values that might indicate accuracy                                                
          import re                                                                                                     
          has_percentages = bool(re.search(r'\d+\.?\d*%', a_lower))                                                     
                                                                                                                        
          if has_allowed_test and has_ref_standard and (has_accuracy or has_percentages):                               
              decision = "INCLUDE"                                                                                      
              rationale = "Meets selection criteria: appropriate index test, reference standard, and reports            
  diagnostic accuracy."                                                                                                 
              confidence = "high"                                                                                       
          elif has_allowed_test and has_ref_standard:                                                                   
              decision = "INCLUDE"                                                                                      
              rationale = "Meets selection criteria: appropriate index test and reference standard. Accuracy metrics    
  may be implied or in full text."                                                                                      
              confidence = "medium"                                                                                     
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Missing key components: index test, reference standard, or accuracy metrics."                
              confidence = "medium"                                                                                     
                                                                                                                        
      # Update counts                                                                                                   
      if decision == "INCLUDE":                                                                                         
          n_included += 1                                                                                               
      else:                                                                                                             
          n_excluded += 1                                                                                               
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Prepare the output structure                                                                                        
  output_json = {                                                                                                       
      "n_total": len(studies),                                                                                          
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output_json, indent=2))                                                                              
