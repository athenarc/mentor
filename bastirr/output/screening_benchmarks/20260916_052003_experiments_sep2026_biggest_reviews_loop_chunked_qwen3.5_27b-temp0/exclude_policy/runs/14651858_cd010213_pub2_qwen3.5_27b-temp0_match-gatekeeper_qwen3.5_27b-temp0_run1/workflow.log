                  rationale = "Focuses on pancreatic lesions."                                                          
                  confidence = "medium"                                                                                 
                                                                                                                        
      # 3. Treatment / Survival Studies without Diagnostic Accuracy                                                     
      elif any(keyword in t_lower or keyword in a_lower for keyword in ['resection outcome', 'survival', 'prognosis',   
  'surgical management', 'adjuvant therapy', 'somatostatin']):                                                          
          if 'diagnostic' not in a_lower and 'accuracy' not in a_lower and 'sensitivity' not in a_lower and             
  'specificity' not in a_lower:                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Treatment or survival study, does not report diagnostic accuracy of imaging modalities."     
              confidence = "high"                                                                                       
          else:                                                                                                         
              decision = "INCLUDE"                                                                                      
              rationale = "Includes diagnostic accuracy data despite treatment focus."                                  
              confidence = "medium"                                                                                     
                                                                                                                        
      # 4. Wrong Index Test (Plain US, ERCP only, etc.)                                                                 
      # Allowed: CT, MRI, PET, EUS, EUS-elastography, EUS-FNA                                                           
      # Disallowed: Plain US, ERCP (unless combined with allowed), X-ray                                                
      elif ('ultrasonography' in t_lower or 'ultrasound' in t_lower) and 'eus' not in t_lower and 'endoscopic' not in   
  t_lower:                                                                                                              
          # Check if it's purely transabdominal US                                                                      
          if 'ct' not in a_lower and 'mri' not in a_lower and 'pet' not in a_lower and 'eus' not in a_lower:            
               decision = "EXCLUDE"                                                                                     
               rationale = "Index test is transabdominal ultrasound, not listed in selection criteria (CT, MRI, PET,    
  EUS)."                                                                                                                
               confidence = "high"                                                                                      
          else:                                                                                                         
              decision = "INCLUDE"                                                                                      
              rationale = "Compares US with allowed modalities (CT/MRI/EUS)."                                           
              confidence = "medium"                                                                                     
                                                                                                                        
      # 5. Safety / Complication Studies without Accuracy                                                               
      elif 'complication' in t_lower or 'safety' in t_lower or 'seeding' in t_lower:                                    
          if 'accuracy' not in a_lower and 'sensitivity' not in a_lower and 'specificity' not in a_lower:               
              decision = "EXCLUDE"                                                                                      
              rationale = "Focuses on safety/complications rather than diagnostic accuracy."                            
              confidence = "high"                                                                                       
          else:                                                                                                         
              decision = "INCLUDE"                                                                                      
              rationale = "Reports diagnostic accuracy alongside safety."                                               
              confidence = "medium"                                                                                     
                                                                                                                        
      # 6. General Inclusion Check                                                                                      
      else:                                                                                                             
          # Check for presence of allowed index tests                                                                   
          allowed_tests = ['ct', 'computed tomography', 'mri', 'magnetic resonance', 'pet', 'positron emission          
  tomography', 'eus', 'endoscopic ultrasound', 'elastography', 'fna', 'fine needle aspiration']                         
          has_allowed_test = any(test in t_lower or test in a_lower for test in allowed_tests)                          
                                                                                                                        
          # Check for reference standard                                                                                
          ref_standards = ['histopathology', 'pathology', 'biopsy', 'surgery', 'resection', 'follow-up', 'clinical      
  follow']                                                                                                              
          has_ref_standard = any(std in a_lower for std in ref_standards)                                               
                                                                                                                        
          # Check for accuracy metrics                                                                                  
          accuracy_metrics = ['sensitivity', 'specificity', 'accuracy', 'ppv', 'npv', 'auc', 'roc', 'positive           
  predictive', 'negative predictive']                                                                                   
          has_accuracy = any(metric in a_lower for metric in accuracy_metrics)                                          
                                                                                                                        
          if has_allowed_test and has_ref_standard and has_accuracy:                                                    
              decision = "INCLUDE"                                                                                      
              rationale = "Meets selection criteria: appropriate index test, reference standard, and reports            
  diagnostic accuracy."                                                                                                 
              confidence = "high"                                                                                       
          elif has_allowed_test and has_ref_standard:                                                                   
              decision = "INCLUDE"                                                                                      
              rationale = "Meets selection criteria: appropriate index test and reference standard. Accuracy metrics    
  may be implied or in full text."                                                                                      
              confidence = "medium"                                                                                     
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Missing key components: index test, reference standard, or accuracy metrics."                
              confidence = "medium"                                                                                     
                                                                                                                        
      # Update counts                                                                                                   
      if decision == "INCLUDE":                                                                                         
          n_included += 1                                                                                               
      else:                                                                                                             
          n_excluded += 1                                                                                               
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Prepare the output structure                                                                                        
  output_json = {                                                                                                       
      "n_total": len(studies),                                                                                          
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  # Print summary for observation                                                                                       
