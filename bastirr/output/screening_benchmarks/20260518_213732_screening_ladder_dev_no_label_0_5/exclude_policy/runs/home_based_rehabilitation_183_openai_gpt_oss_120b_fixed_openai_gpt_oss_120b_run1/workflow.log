def parse_gatekeeper_response(text: str):                                                                               
    """                                                                                                                 
    Extract the first {...} block from `text` and evaluate it safely.                                                   
    Returns the evaluated object (list or dict) or raises.                                                              
    """                                                                                                                 
    # Find the outermost {...} block (greedy from first { to last })                                                    
    start = text.find("{")                                                                                              
    end = text.rfind("}") + 1                                                                                           
    if start == -1 or end == -1:                                                                                        
        raise ValueError("No curly braces found in response")                                                           
    sub = text[start:end]                                                                                               
                                                                                                                        
    # Replace any stray newline characters that break literal_eval                                                      
    sub = sub.replace("\n", " ")                                                                                        
    # Use ast.literal_eval which accepts single quotes etc.                                                             
    try:                                                                                                                
        obj = ast.literal_eval(sub)                                                                                     
    except Exception as e:                                                                                              
        raise ValueError(f"literal_eval failed: {e}")                                                                   
    return obj                                                                                                          
                                                                                                                        
