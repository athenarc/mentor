          confidence = "high"                                                                                           
                                                                                                                        
      # Study 31: Cochrane review on contraceptive effectiveness - EXCLUDE                                              
      elif study_index == 31:                                                                                           
          decision = "EXCLUDE"                                                                                          
          rationale = "Cochrane review comparing contraceptive effectiveness and bleeding patterns of different         
