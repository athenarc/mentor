      # Study 28: women, OC, VTE - INCLUDE                                                                              
      elif study_index == 28:                                                                                           
          decision = "INCLUDE"                                                                                          
          rationale = "Study of women of reproductive age with VTE, includes 140 women using oral contraceptives and    
