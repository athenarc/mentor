          confidence = "high"                                                                                           
                                                                                                                        
      # Study 29: women, OC, VTE - INCLUDE                                                                              
      elif study_index == 29:                                                                                           
          decision = "INCLUDE"                                                                                          
          rationale = "Nested case-control study of women 15-39 years old using oral contraceptives with VTE as         
