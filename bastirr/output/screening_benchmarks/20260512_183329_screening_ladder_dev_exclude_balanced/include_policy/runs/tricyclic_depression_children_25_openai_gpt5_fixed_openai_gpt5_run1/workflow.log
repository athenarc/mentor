add_dec(3, "INCLUDE",                                                                                                   
        "Randomized, double-blind, placebo-controlled trial of the tricyclic nortriptyline in depressed adolescents     
(12–17 years); route consistent with oral TCA dosing.",                                                                 
        "high")                                                                                                         
                                                                                                                        
# 4 Narrative review                                                                                                    
add_dec(4, "EXCLUDE",                                                                                                   
        "Review article, not a randomized controlled trial.",                                                           
        "high")                                                                                                         
                                                                                                                        
# 5 Imipramine double-blind pilot vs placebo in depressed children (small N), oral implicitly (TCA standard)            
add_dec(5, "INCLUDE",                                                                                                   
        "Double-blind, placebo-controlled pilot of imipramine in depressed children; consistent with oral TCA use.",    
        "high")                                                                                                         
                                                                                                                        
# 6 Amitriptyline crossover RCT (mg/kg/day), 9–12-year-olds with MDD; oral route explicit by dosing                     
add_dec(6, "INCLUDE",                                                                                                   
        "Double-blind crossover randomized trial of amitriptyline vs placebo in children with major depressive disorder;
mg/kg/day dosing indicates oral administration.",                                                                       
        "high")                                                                                                         
                                                                                                                        
# 7 Cochrane review of newer antidepressants (SSRIs), not TCA RCT in youth                                              
add_dec(7, "EXCLUDE",                                                                                                   
        "Systematic review focusing on newer-generation antidepressants (e.g., SSRIs), not a primary RCT of tricyclics  
in children/adolescents.",                                                                                              
        "high")                                                                                                         
                                                                                                                        
# 8 Imipramine + CBT vs placebo + CBT in school-refusing adolescents with comorbid anxiety and major depression         
add_dec(8, "INCLUDE",                                                                                                   
        "Randomized, double-blind imipramine vs placebo (both with CBT) in adolescents with comorbid anxiety and major  
depressive disorders; includes depression outcomes; oral TCA implied.",                                                 
        "high")                                                                                                         
                                                                                                                        
# 9 Prepubertal MDD imipramine vs placebo (double-blind), mg/kg dosing implies oral                                     
add_dec(9, "INCLUDE",                                                                                                   
        "Double-blind, placebo-controlled imipramine trial in prepubertal children with major depressive disorder;      
mg/kg/day dosing indicates oral administration.",                                                                       
        "high")                                                                                                         
                                                                                                                        
# 10 Paroxetine and imipramine arms vs placebo in adolescents with MDD; includes imipramine vs placebo                  
add_dec(10, "INCLUDE",                                                                                                  
        "Randomized, double-blind trial in adolescents with MDD that includes an imipramine vs placebo comparison (oral 
titration 200–300 mg).",                                                                                                
        "high")                                                                                                         
                                                                                                                        
# 11 Mechanism of action review                                                                                         
add_dec(11, "EXCLUDE",                                                                                                  
        "Narrative review on antidepressant mechanisms; not a randomized controlled trial.",                            
        "high")                                                                                                         
                                                                                                                        
# 12 SSRI overdose safety review                                                                                        
add_dec(12, "EXCLUDE",                                                                                                  
        "Review of SSRI overdose outcomes; not a randomized controlled efficacy trial of tricyclics in youth.",         
        "high")                                                                                                         
                                                                                                                        
# 13 Methodological note on meta-analytic inconsistency (I^2)                                                           
