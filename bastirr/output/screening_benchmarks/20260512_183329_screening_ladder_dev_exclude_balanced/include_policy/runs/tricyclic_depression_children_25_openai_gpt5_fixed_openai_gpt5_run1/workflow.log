        "Meta-analysis of adult (18–65) hospitalized patients; out of the 6–18 years age range.",                       
        "high")                                                                                                         
                                                                                                                        
# 23 Plasma level-response imipramine study in prepubertal children; no randomization/placebo control described         
add_dec(23, "EXCLUDE",                                                                                                  
        "Imipramine level–response observational study without randomization/placebo control.",                         
        "high")                                                                                                         
                                                                                                                        
# 24 Amitriptyline vs placebo in treatment-resistant adolescent MDD (10-week RCT)                                       
add_dec(24, "INCLUDE",                                                                                                  
        "Randomized, controlled amitriptyline vs placebo trial in adolescents with treatment-resistant major depressive 
