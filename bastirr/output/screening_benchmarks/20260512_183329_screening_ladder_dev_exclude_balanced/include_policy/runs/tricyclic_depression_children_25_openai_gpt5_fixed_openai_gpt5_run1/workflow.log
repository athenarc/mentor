import json                                                                                                             
                                                                                                                        
# Load candidates                                                                                                       
data = json.loads(candidates_json)                                                                                      
studies = {s["study_index"]: s for s in data["studies"]}                                                                
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
def add_dec(idx, decision, rationale, confidence):                                                                      
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": studies[idx]["title"],                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Apply criteria study-by-study:                                                                                        
                                                                                                                        
# 1 IV clomipramine (non-oral) RCT                                                                                      
add_dec(1, "EXCLUDE",                                                                                                   
        "Randomized, placebo-controlled in adolescents with depression but clomipramine was given intravenously         
