        "high")                                                                                                         
                                                                                                                        
# 25 Imipramine compliance in adolescents (school refusal, anxious-depressed) – secondary analysis focused on           
adherence/side effects, not efficacy comparison                                                                         
add_dec(25, "EXCLUDE",                                                                                                  
        "Report focuses on compliance/side effects in an imipramine vs placebo trial for school refusal with            
anxious-depressed adolescents; efficacy comparison not reported in this paper.",                                        
        "medium")                                                                                                       
                                                                                                                        
# Sanity checks                                                                                                         
n_total = len(studies)                                                                                                  
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
result_obj = {                                                                                                          
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
output_json = json.dumps(result_obj, ensure_ascii=False, indent=2)                                                      
print(output_json)                                                                                                      
                                                                                                                        
# Prepare final narrative output with required sections                                                                 
short_outcome = f"Screened {n_total} studies: INCLUDED {n_included}, EXCLUDED {n_excluded}. Included indices:           
{[d['study_index'] for d in decisions if d['decision']=='INCLUDE']}."                                                   
detailed_outcome = output_json                                                                                          
additional_context = (                                                                                                  
    "Conservative inclusion applied. Borderline cases: Study 15 included with low confidence because the abstract       
