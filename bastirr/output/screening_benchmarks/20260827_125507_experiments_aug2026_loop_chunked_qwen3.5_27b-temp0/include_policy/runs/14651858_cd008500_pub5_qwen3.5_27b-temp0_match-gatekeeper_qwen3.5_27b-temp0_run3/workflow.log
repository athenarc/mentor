          rationale = 'Review article about unsuspected pulmonary embolism in cancer patients, not an RCT.'             
      elif study_index == 69:                                                                                           
          # RCT of LMWH prophylaxis in multiple myeloma patients receiving chemotherapy                                 
          decision = 'include'                                                                                          
          rationale = 'Randomized phase III trial comparing chemotherapy regimens with/without LMWH prophylaxis in      
  multiple myeloma patients receiving thalidomide and chemotherapy. Potentially relevant for primary VTE prophylaxis    
  in ambulatory cancer patients.'                                                                                       
      elif study_index == 70:                                                                                           
          # Letter/commentary discussing another study                                                                  
          decision = 'exclude'                                                                                          
          rationale = 'Letter to editor/commentary discussing another study, not a primary RCT.'                        
      elif study_index == 71:                                                                                           
          # RCT but wrong population (general medical patients, not specifically ambulatory cancer patients receiving   
  chemotherapy)                                                                                                         
          decision = 'exclude'                                                                                          
          rationale = 'RCT of LMWH in general medical patients (including MI, coronary disease, and some cancer         
  patients). Population does not match criteria of ambulatory cancer patients receiving chemotherapy.'                  
      elif study_index == 72:                                                                                           
          # Title suggests RCT of apixaban in myeloma patients; no abstract available                                   
          decision = 'include'                                                                                          
          rationale = 'Title suggests RCT of apixaban for thromboprophylaxis in myeloma patients receiving              
  thalidomide/lenalidomide. No abstract available, but potentially relevant - include for further review.'              
      elif study_index == 73:                                                                                           
          # RCT but wrong population (hospitalized palliative care patients, not ambulatory)                            
          decision = 'exclude'                                                                                          
          rationale = 'RCT of prophylactic anticoagulation in hospitalized cancer patients receiving palliative care.   
  Population does not match criteria of ambulatory cancer patients.'                                                    
      elif study_index == 74:                                                                                           
          # Phase II trial but intervention is isoquercetin (flavonoid), not an anticoagulant                           
          decision = 'exclude'                                                                                          
          rationale = 'Phase II trial testing isoquercetin (a flavonoid), not an anticoagulant or mechanical            
  intervention as specified in selection criteria.'                                                                     
      elif study_index == 75:                                                                                           
          # Review article                                                                                              
          decision = 'exclude'                                                                                          
          rationale = 'Review article summarizing literature on VTE prophylaxis in ambulatory cancer patients, not an   
  RCT.'                                                                                                                 
      elif study_index == 76:                                                                                           
          # Review/guidance article                                                                                     
          decision = 'exclude'                                                                                          
          rationale = 'Review/guidance article from NEJM, not an RCT.'                                                  
      elif study_index == 77:                                                                                           
          # Review/guideline article                                                                                    
          decision = 'exclude'                                                                                          
          rationale = 'Review article about incidental VTE and anticoagulation, not an RCT.'                            
      elif study_index == 78:                                                                                           
          # Systematic review and meta-analysis                                                                         
          decision = 'exclude'                                                                                          
          rationale = 'Systematic review and meta-analysis of VTE risk in cancer patients, not an RCT.'                 
      elif study_index == 79:                                                                                           
          # Methodological paper                                                                                        
          decision = 'exclude'                                                                                          
          rationale = 'Methodological paper about assessing quality of controlled trials in systematic reviews, not a   
  clinical trial.'                                                                                                      
      elif study_index == 80:                                                                                           
          # Cochrane Review                                                                                             
          decision = 'exclude'                                                                                          
          rationale = 'Cochrane Review about anticoagulation for cancer patients with central venous catheters, not an  
  RCT.'                                                                                                                 
                                                                                                                        
      decisions.append({                                                                                                
          'study_index': study_index,                                                                                   
          'decision': decision,                                                                                         
          'rationale': rationale                                                                                        
      })                                                                                                                
                                                                                                                        
  # Count included and excluded                                                                                         
  n_included = sum(1 for d in decisions if d['decision'] == 'include')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'exclude')                                                  
                                                                                                                        
  print(f"Total studies: {len(decisions)}")                                                                             
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
  print("\nDecisions:")                                                                                                 
  for d in decisions:                                                                                                   
      print(f"Study {d['study_index']}: {d['decision'].upper()}")                                                       
      print(f"  Rationale: {d['rationale']}")                                                                           
      print()                                                                                                           
                                                                                                                        
  # Output JSON array as required                                                                                       
  json_output = [{"study_index": d['study_index'], "decision": d['decision']} for d in decisions]                       
  print("\nJSON Output:")                                                                                               
  print(json.dumps(json_output, indent=2))                                                                              
