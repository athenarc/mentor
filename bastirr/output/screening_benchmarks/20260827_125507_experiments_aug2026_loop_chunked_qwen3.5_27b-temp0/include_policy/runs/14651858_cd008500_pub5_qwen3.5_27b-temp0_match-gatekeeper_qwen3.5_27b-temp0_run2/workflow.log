        decision = "EXCLUDE"                                                                                            
        rationale = f"Study is a systematic review or meta-analysis, not a primary RCT."                                
    elif 'retrospective' in abstract.lower():                                                                           
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study design is retrospective, not a randomised controlled trial."                                
    elif 'methodological' in abstract.lower() or 'test for' in abstract.lower() or 'measuring inconsistency' in         
