        rationale = f"Study design is an observational cohort study, not a randomised controlled trial (RCT)."          
    elif 'review' in abstract.lower() or 'guideline' in abstract.lower() or 'consensus' in abstract.lower():            
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study is a review article, clinical practice guideline, or consensus statement, not an RCT."      
