          'chronic rhinosinusitis', 'crs', 'fess', 'endoscopic sinus surgery', 'ess'                                    
      ])                                                                                                                
                                                                                                                        
      # Check if there's a proper comparison (non-steroid-eluting stent, packing, or no treatment)                      
      has_comparison = any(term in abstract.lower() for term in [                                                       
