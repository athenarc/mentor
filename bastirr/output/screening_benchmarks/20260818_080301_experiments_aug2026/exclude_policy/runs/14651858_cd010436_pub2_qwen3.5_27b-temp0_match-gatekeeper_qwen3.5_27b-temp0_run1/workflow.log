      ])                                                                                                                
                                                                                                                        
      # Detailed screening logic                                                                                        
      if not is_rct:                                                                                                    
          decision = "EXCLUDE"                                                                                          
          if 'review' in abstract.lower() or 'position paper' in abstract.lower():                                      
              rationale = f"Not a randomised controlled trial. {title} is a review article."                            
          elif 'retrospective' in abstract.lower():                                                                     
              rationale = f"Not a randomised controlled trial. {title} is a retrospective study."                       
          elif 'prevalence' in abstract.lower() or 'epidemiology' in abstract.lower():                                  
              rationale = f"Not a randomised controlled trial. {title} is an epidemiological/prevalence study."         
          elif 'meta-analysis' in abstract.lower():                                                                     
              rationale = f"Not a randomised controlled trial. {title} is a meta-analysis of existing trials."          
          elif 'single-cohort' in abstract.lower() or 'case series' in abstract.lower():                                
              rationale = f"Not a randomised controlled trial. {title} is a single-cohort/case series study."           
          else:                                                                                                         
              rationale = f"Not a randomised controlled trial. {title} does not meet RCT design requirements."          
      elif not has_steroid_device:                                                                                      
          decision = "EXCLUDE"                                                                                          
          rationale = f"Does not involve steroid-eluting sinus stents. The intervention is not a                        
  corticosteroid-eluting device."                                                                                       
      elif not crs_fess:                                                                                                
          decision = "EXCLUDE"                                                                                          
          rationale = f"Does not involve adult CRS patients undergoing FESS."                                           
      elif not has_comparison:                                                                                          
          decision = "EXCLUDE"                                                                                          
          rationale = f"No appropriate comparison group (non-steroid-eluting stent, nasal packing, or no treatment)."   
      else:                                                                                                             
          # Additional specific checks for borderline cases                                                             
          # Study 5: Doxycycline is an antibiotic, not a steroid                                                        
          if study_index == 5:                                                                                          
              decision = "EXCLUDE"                                                                                      
              rationale = "Doxycycline-releasing stents are antibiotic-eluting, not steroid-eluting. Doxycycline is an  
  antibiotic, not a corticosteroid."                                                                                    
          # Study 6: In-office treatment after ESS, not during FESS                                                     
          elif study_index == 6:                                                                                        
              decision = "EXCLUDE"                                                                                      
              rationale = "Study evaluates steroid-eluting implants for in-office treatment of recurrent polyposis      
  AFTER ESS, not during FESS. Does not meet the 'undergoing FESS' criterion."                                           
          # Study 22: Meta-analysis, not primary RCT                                                                    
          elif study_index == 22:                                                                                       
              decision = "EXCLUDE"                                                                                      
              rationale = "This is a meta-analysis of existing RCTs, not a primary randomised controlled trial."        
          # Study 29: Single-cohort trial, not RCT                                                                      
          elif study_index == 29:                                                                                       
              decision = "EXCLUDE"                                                                                      
              rationale = "Single-cohort trial without a control group. Not a randomised controlled trial."             
          # Study 34: Tests systemic steroids on top of steroid-eluting spacer, not comparing stents                    
          elif study_index == 34:                                                                                       
              decision = "EXCLUDE"                                                                                      
              rationale = "Tests postoperative systemic corticosteroids in patients who already received                
  steroid-eluting spacers. Does not compare steroid-eluting vs non-steroid-eluting devices."                            
          else:                                                                                                         
              decision = "INCLUDE"                                                                                      
              rationale = f"RCT comparing steroid-eluting device with non-steroid-eluting control in adult CRS          
  patients undergoing FESS."                                                                                            
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count included and excluded                                                                                         
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  # Create final result                                                                                                 
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
