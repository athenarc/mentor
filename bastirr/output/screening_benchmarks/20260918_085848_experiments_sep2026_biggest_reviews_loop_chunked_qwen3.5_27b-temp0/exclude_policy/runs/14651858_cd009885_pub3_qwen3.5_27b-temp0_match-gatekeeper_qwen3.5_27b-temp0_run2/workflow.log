excluded_indices = [1, 5, 10, 13, 14, 15, 18, 19, 20, 23, 25, 26, 31, 32, 35, 36, 38, 39, 40, 41, 43, 44, 45, 47, 51,   
53, 55, 57, 58, 59, 62, 63, 64, 65, 67, 70, 73, 75, 77, 79, 85, 87, 88, 91, 95, 100]                                    
                                                                                                                        
# Create rationales for each study                                                                                      
for idx in range(1, 101):                                                                                               
    study = next(s for s in candidate_chunk['studies'] if s['study_index'] == idx)                                      
                                                                                                                        
    if idx in included_indices:                                                                                         
        decision = "INCLUDE"                                                                                            
        # Generate specific rationale based on study content                                                            
