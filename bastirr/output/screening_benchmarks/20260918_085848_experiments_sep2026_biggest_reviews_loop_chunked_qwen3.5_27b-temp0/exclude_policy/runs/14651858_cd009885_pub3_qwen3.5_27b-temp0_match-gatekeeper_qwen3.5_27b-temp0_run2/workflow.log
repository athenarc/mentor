          confidence = "high"                                                                                           
      elif idx == 99:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Study with placebo, low, and moderate dose of MPH in 24 children ages 6-11 with hyperactivity.   
  Meets inclusion criteria for RCT comparing MPH vs placebo."                                                           
          confidence = "high"                                                                                           
      elif idx == 100:                                                                                                  
          decision = "EXCLUDE"                                                                                          
          rationale = "Tests divalproex (valproate) as adjunctive treatment vs placebo for children with ADHD and       
  aggression refractory to stimulant monotherapy. All participants received stimulant treatment. Does not meet          
  intervention criterion (must compare methylphenidate vs placebo or no intervention)."                                 
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  # Prepare final output                                                                                                
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(f"Total studies screened: {n_total}")                                                                           
  print(f"Studies included: {n_included}")                                                                              
  print(f"Studies excluded: {n_excluded}")                                                                              
  print(f"\nIncluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'INCLUDE']}")             
  print(f"Excluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'EXCLUDE']}")               
