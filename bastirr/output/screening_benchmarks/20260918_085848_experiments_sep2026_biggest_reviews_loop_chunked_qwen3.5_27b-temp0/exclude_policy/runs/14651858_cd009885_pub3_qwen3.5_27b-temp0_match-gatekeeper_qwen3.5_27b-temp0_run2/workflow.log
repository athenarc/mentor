# Build the decisions list                                                                                              
for study_index, info in study_decisions.items():                                                                       
    # Get title from candidate_chunk                                                                                    
    title = ""                                                                                                          
    for study in candidate_chunk['studies']:                                                                            
        if study['study_index'] == study_index:                                                                         
            title = study['title']                                                                                      
            break                                                                                                       
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": info["decision"],                                                                                   
        "rationale": info["rationale"],                                                                                 
        "confidence": "high"                                                                                            
    })                                                                                                                  
                                                                                                                        
# Count included and excluded                                                                                           
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Create final output                                                                                                   
final_output = {                                                                                                        
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {len(decisions)}")                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(final_output, indent=2))                                                                               
                                                                                                                        
