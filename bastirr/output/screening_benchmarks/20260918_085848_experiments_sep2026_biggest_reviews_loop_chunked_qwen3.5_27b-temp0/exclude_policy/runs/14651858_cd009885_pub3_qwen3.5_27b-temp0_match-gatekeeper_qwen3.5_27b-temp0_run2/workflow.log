          confidence = "high"                                                                                           
      elif idx == 92:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Randomized double-blind placebo-controlled crossover RCT with MPH, atomoxetine, and placebo in   
  19 medication-naive ADHD boys. Includes placebo arm. Meets inclusion criteria."                                       
          confidence = "high"                                                                                           
      elif idx == 93:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Randomized controlled crossover double-blind RCT of single dose MPH vs placebo in 20 children    
  with ADHD. Meets all inclusion criteria."                                                                             
          confidence = "high"                                                                                           
      elif idx == 94:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Triple blind placebo-controlled crossover RCT of two MPH doses and placebo in 63 children with   
  ADHD (with and without motor dysfunction). Meets all inclusion criteria."                                             
          confidence = "high"                                                                                           
      elif idx == 95:                                                                                                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Letter/response about inclusion criteria in a systematic review. Not an RCT."                    
          confidence = "high"                                                                                           
      elif idx == 96:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Randomized placebo-controlled single-blind crossover RCT of two MPH formulations and placebo in  
  53 children aged 6-12 years with ADHD. Meets all inclusion criteria."                                                 
          confidence = "high"                                                                                           
      elif idx == 97:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Randomized double-blind dose-optimized RCT of SDX/d-MPH vs placebo in 149 children aged 6-12     
  years with ADHD. Meets all inclusion criteria."                                                                       
          confidence = "high"                                                                                           
      elif idx == 98:                                                                                                   
          decision = "INCLUDE"                                                                                          
          rationale = "Randomized double-blind multicenter parallel-group placebo-controlled dose-optimization RCT of   
