[{"study_index": 101, "title": "Measurement of the subjective effects of methylphenidate in 11- to 15-year-old children 
with attention-deficit/hyperactivity disorder", "abstract": "OBJECTIVE This study examined subjective and other 
behavioral effects of methylphenidate (MPH) among adolescents. METHODS Standard abuse liability assessment methods that 
