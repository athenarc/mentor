      "studies": chunk_data['studies']                                                                                  
  }                                                                                                                     
                                                                                                                        
  # Call batch_screen_studies                                                                                           
  result = batch_screen_studies(json.dumps(candidates_json))                                                            
  print(result)                                                                                                         
