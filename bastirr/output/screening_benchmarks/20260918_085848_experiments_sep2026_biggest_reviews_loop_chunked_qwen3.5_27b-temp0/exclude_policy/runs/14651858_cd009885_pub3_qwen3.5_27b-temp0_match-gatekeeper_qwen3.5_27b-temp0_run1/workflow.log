# Create decisions list                                                                                                 
for idx, decision, rationale, confidence in studies_info:                                                               
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(f"\nIncluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'INCLUDE']}")               
print(f"\nExcluded study indices: {[d['study_index'] for d in decisions if d['decision'] == 'EXCLUDE']}")               
                                                                                                                        
# Prepare final answer structure                                                                                        
final_result = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print("\nFinal result prepared successfully!")                                                                          
                                                                                                                        
