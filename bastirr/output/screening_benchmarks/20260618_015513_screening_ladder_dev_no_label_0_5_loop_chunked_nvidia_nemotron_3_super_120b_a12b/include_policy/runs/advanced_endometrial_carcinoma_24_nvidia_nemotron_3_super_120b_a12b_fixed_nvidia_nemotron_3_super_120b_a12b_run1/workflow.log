# Process each study                                                                                                    
decisions = []                                                                                                          
for study in studies_data:                                                                                              
    idx = study["study_index"]                                                                                          
    title = study["title"]                                                                                              
    abstract = study["abstract"]                                                                                        
                                                                                                                        
    # Convert to lowercase for easier matching                                                                          
    abstract_lower = abstract.lower()                                                                                   
    title_lower = title.lower()                                                                                         
                                                                                                                        
    # Check if it's an RCT                                                                                              
    is_rct = (                                                                                                          
        "random" in abstract_lower or                                                                                   
        "randomised" in abstract_lower or                                                                               
        "randomized" in abstract_lower or                                                                               
        "phase ii" in abstract_lower or                                                                                 
        "phase iii" in abstract_lower or                                                                                
        "phase ii" in title_lower or                                                                                    
        "phase iii" in title_lower or                                                                                   
        "trial" in abstract_lower                                                                                       
    )                                                                                                                   
                                                                                                                        
    # Check if it involves chemotherapy                                                                                 
    chemo_keywords = [                                                                                                  
        "doxorubicin", "adriamycin", "cyclophosphamide", "cisplatin",                                                   
        "melphalan", "5-fluorouracil", "methotrexate", "vinblastine",                                                   
        "mitomycin", "ifosfamide", "paclitaxel", "docetaxel", "carboplatin",                                            
        "chemotherapy", "cytotoxic"                                                                                     
    ]                                                                                                                   
    has_chemo = any(keyword in abstract_lower for keyword in chemo_keywords)                                            
                                                                                                                        
    # Check if it's about advanced/recurrent/metastatic endometrial cancer                                              
    advanced_keywords = [                                                                                               
        "advanced", "recurrent", "metastatic", "stage iii", "stage iv",                                                 
        "endometrial carcinoma", "endometrial cancer", "uterine corpus carcinoma"                                       
    ]                                                                                                                   
    has_advanced = any(keyword in abstract_lower for keyword in advanced_keywords) or \                                 
                   any(keyword in title_lower for keyword in advanced_keywords)                                         
                                                                                                                        
    # Check if it's adjuvant treatment (should be excluded)                                                             
    is_adjuvant = "adjuvant" in abstract_lower or "adjuvant" in title_lower                                             
                                                                                                                        
    # Check if it's about sarcomatous tumours (should be excluded)                                                      
    is_sarcoma = "sarcoma" in abstract_lower or "sarcoma" in title_lower or "sarcomatous" in abstract_lower             
                                                                                                                        
    # Apply inclusion criteria: RCT + chemotherapy + advanced disease + not adjuvant + not sarcoma                      
    if is_rct and has_chemo and has_advanced and not is_adjuvant and not is_sarcoma:                                    
        decision = "INCLUDE"                                                                                            
        rationale = "RCT comparing chemotherapy interventions in advanced/recurrent endometrial carcinoma."             
        confidence = "high"                                                                                             
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        if not is_rct:                                                                                                  
            rationale = "Not a randomized controlled trial."                                                            
        elif not has_chemo:                                                                                             
            rationale = "Does not involve chemotherapy intervention."                                                   
        elif not has_advanced:                                                                                          
            rationale = "Not focused on advanced, recurrent, or metastatic endometrial cancer."                         
        elif is_adjuvant:                                                                                               
            rationale = "Adjuvant treatment trial, excluded per criteria."                                              
        elif is_sarcoma:                                                                                                
            rationale = "Sarcomatous tumour trial, excluded per criteria."                                              
        else:                                                                                                           
            rationale = "Does not meet selection criteria."                                                             
        confidence = "medium"                                                                                           
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
n_total = len(studies_data)                                                                                             
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(result, indent=2))                                                                                     
""")                                                                                                                    
                                                                                                                        
