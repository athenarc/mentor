decisions = []
for s in studies:
    idx = s["study_index"\]
    title = s["title"\]
    abstract = s["abstract"\]
    # Determine inclusion
    include = False
    rationale = ""
    # Check if RCT: look for keywords like random, randomized, randomised, trial
    lower_abs = abstract.lower()
    lower_title = title.lower()
    is_rct = ("random" in lower_abs or "randomised" in lower_abs or "randomized" in lower_abs or 
              "phase ii" in lower_abs or "phase iii" in lower_abs or "phase ii" in lower_title or 
              "phase iii" in lower_title or "trial" in lower_abs)
    # Check if chemotherapy intervention: look for chemo drug names or cytotoxic chemo
    chemo_keywords = ["doxorubicin", "adriamycin", "cyclophosphamide", "cisplatin", "melphalan", 
                      "5-fluorouracil", "methotrexate", "vinblastine", "mitomycin", "ifosfamide", 
                      "paclitaxel", "docetaxel", "carboplatin", "chemotherapy", "cytotoxic"\]
    has_chemo = any(k in lower_abs for k in chemo_keywords)
    # Check advanced/metastatic/recurrent endometrial cancer
    advanced_keywords = ["advanced", "recurrent", "metastatic", "stage iii", "stage iv", 
                         "endometrial carcinoma", "endometrial cancer", "uterine corpus carcinoma"\]
    has_advanced = any(k in lower_abs for k in advanced_keywords) or any(k in lower_title for k in advanced_keywords)
    # Exclude adjuvant treatment
    is_adjuvant = "adjuvant" in lower_abs or "adjuvant" in lower_title
    # Exclude sarcomatous tumours
    is_sarcoma = "sarcoma" in lower_abs or "sarcoma" in lower_title or "sarcomatous" in lower_abs
    # Apply criteria
    if is_rct and has_chemo and has_advanced and not is_adjuvant and not is_sarcoma:
        include = True
        rationale = f"RCT comparing chemotherapy interventions in advanced/recurrent endometrial carcinoma."
        confidence = "high"
    else:
        include = False
        # Provide specific rationale for exclusion
        if not is_rct:
            rationale = "Not a randomized controlled trial."
        elif not has_chemo:
            rationale = "Does not involve chemotherapy intervention."
        elif not has_advanced:
            rationale = "Not focused on advanced, recurrent, or metastatic endometrial cancer."
        elif is_adjuvant:
            rationale = "Adjuvant treatment trial, excluded per criteria."
        elif is_sarcoma:
            rationale = "Sarcomatous tumour trial, excluded per criteria."
        else:
            rationale = "Does not meet selection criteria."
        confidence = "medium"
    decisions.append({
        "study_index": idx,
        "title": title,
        "decision": "INCLUDE" if include else "EXCLUDE",
        "rationale": rationale,
        "confidence": confidence
    })

n_total = len(studies)
n_included = sum(1 for d in decisions if d["decision"\] == "INCLUDE")
n_excluded = n_total - n_included

output = {
    "n_total": n_total,
    "n_included": n_included,
    "n_excluded": n_excluded,
    "decisions": decisions
}

print(json.dumps(output, indent=2))
