import json                                                                                                             
                                                                                                                        
# Parse the studies JSON string                                                                                         
data = json.loads(studies)                                                                                              
# The variable 'studies' is a JSON string that contains a key "studies" which is the list of 10 studies.                
# But looking at the provided data, the string is the entire object? Actually, the provided 'studies' variable is:      
# '{"title": "Surgical methods for first trimester termination of pregnancy", ... "studies": [ ... ]}'                  
# So we need to get the list from the key "studies".                                                                    
all_studies = data["studies"]                                                                                           
                                                                                                                        
decisions = []                                                                                                          
for study in all_studies:                                                                                               
    idx = study["study_index"]                                                                                          
    title = study["title"]                                                                                              
    abstract = study["abstract"]                                                                                        
                                                                                                                        
    lower_abstract = abstract.lower()                                                                                   
    lower_title = title.lower()                                                                                         
                                                                                                                        
    # Check for randomisation                                                                                           
    is_randomized = ('randomized' in lower_abstract or 'randomised' in lower_abstract or                                
                     'randomly assigned' in lower_abstract or 'randomly treated' in lower_abstract or                   
                     'randomised study' in lower_abstract or 'randomized trial' in lower_abstract)                      
                                                                                                                        
    # Check for comparison                                                                                              
    is_comparison = ('compare' in lower_abstract or 'comparison' in lower_abstract or                                   
                     'versus' in lower_abstract or ' vs ' in lower_abstract or                                          
                     'compared' in lower_abstract)                                                                      
                                                                                                                        
    # Check for different surgical methods                                                                              
    surgical_methods = ['dilatation and curettage', 'd&c', 'vacuum aspiration', 'manual vacuum aspiration', 'mva',      
                        'power operated vacuum aspiration', 'hysterotomy', 'suction curettage', 'electric vacuum        
aspiration',                                                                                                            
                        'electric vacuum curettage', 'manual vacuum aspirator']                                         
    mentioned_methods = [method for method in surgical_methods if method in lower_abstract or method in lower_title]    
    distinct_methods = set(mentioned_methods)                                                                           
    is_different_methods = len(distinct_methods) >= 2                                                                   
                                                                                                                        
    # Check for first trimester                                                                                         
    is_first_trimester = ('first trimester' in lower_abstract or 'first-trimester' in lower_abstract or                 
                          'early pregnancy' in lower_abstract or                                                        
                          ('gestational age' in lower_abstract and                                                      
                           ('less than 12 weeks' in lower_abstract or 'less than 14 weeks' in lower_abstract or         
                            'menstrual weeks' in lower_abstract)))  # rough                                             
                                                                                                                        
    # Decision logic: be conservative -> include unless we are sure it doesn't meet criteria.                           
    # We'll define sure exclusion: if we are confident it's not an RCT or not a comparison or not different methods or  
not first trimester.                                                                                                    
    # But we want to avoid false exclusions.                                                                            
                                                                                                                        
    # Let's compute a score of how many criteria are met.                                                               
    criteria_met = sum([is_randomized, is_comparison, is_different_methods, is_first_trimester])                        
                                                                                                                        
    if criteria_met == 4:                                                                                               
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"Study is a randomised controlled trial comparing {', '.join(sorted(distinct_methods))} for first  
trimester abortion."                                                                                                    
    elif criteria_met >= 2:                                                                                             
        # Some criteria met, but not all: include with low confidence due to uncertainty.                               
        decision = "INCLUDE"                                                                                            
        confidence = "low"                                                                                              
        missing = []                                                                                                    
        if not is_randomized: missing.append("randomised controlled trial")                                             
        if not is_comparison: missing.append("comparison")                                                              
        if not is_different_methods: missing.append("comparison of different surgical methods")                         
        if not is_first_trimester: missing.append("first trimester abortion")                                           
        rationale = f"Study does not clearly meet all criteria (missing: {', '.join(missing)}), but included            
conservatively due to uncertainty."                                                                                     
    else:                                                                                                               
        # Few criteria met: likely exclude, but we'll be conservative and still include if any doubt?                   
        # Actually, if criteria_met < 2, we are fairly sure it doesn't meet criteria. But to be conservative, we might  
still include?                                                                                                          
        # The guideline: "Be CONSERVATIVE: when in doubt, INCLUDE the study."                                           
        # If we are doubtful, we include. If we are sure it does not meet criteria, we exclude.                         
        # We'll set a threshold: if criteria_met == 0, we are sure it doesn't meet any? Then exclude.                   
        # If criteria_met == 1, we are doubtful? Then include.                                                          
        if criteria_met == 0:                                                                                           
            decision = "EXCLUDE"                                                                                        
            confidence = "medium"                                                                                       
            missing = []                                                                                                
            if not is_randomized: missing.append("randomised controlled trial")                                         
            if not is_comparison: missing.append("comparison")                                                          
            if not is_different_methods: missing.append("comparison of different surgical methods")                     
            if not is_first_trimester: missing.append("first trimester abortion")                                       
            rationale = f"Study does not meet criteria (missing: {', '.join(missing)})."                                
        else:  # criteria_met == 1                                                                                      
            decision = "INCLUDE"                                                                                        
            confidence = "low"                                                                                          
            missing = []                                                                                                
            if not is_randomized: missing.append("randomised controlled trial")                                         
            if not is_comparison: missing.append("comparison")                                                          
            if not is_different_methods: missing.append("comparison of different surgical methods")                     
            if not is_first_trimester: missing.append("first trimester abortion")                                       
            rationale = f"Study only meets one criterion (missing: {', '.join(missing)}), but included conservatively   
due to uncertainty."                                                                                                    
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Compute totals                                                                                                        
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
# Output the result as JSON string                                                                                      
print(json.dumps(result, indent=2))                                                                                     
