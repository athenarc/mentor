      gatekeeper_response = gatekeeper(task=task_description, additional_args=additional_args)                          
                                                                                                                        
      # Append the Gatekeeper's decisions to the benchmark artifacts                                                    
      append_result = append_screening_chunk_decisions_json(                                                            
          screening_response=gatekeeper_response,                                                                       
          output_dir=output_dir,                                                                                        
          expected_study_indices_json=chunk_indices_json,                                                               
          expected_n_studies=expected_n_studies                                                                         
      )                                                                                                                 
                                                                                                                        
      # Check if the append operation succeeded (assuming no "error" in the response indicates success)                 
      if "error" not in append_result.lower():                                                                          
          break  # Success, exit retry loop                                                                             
      else:                                                                                                             
          # If this was the last attempt, we still break after logging                                                  
          if attempt == max_attempts - 1:                                                                               
              print(f"Append failed after {max_attempts} attempts. Proceeding anyway.")                                 
          else:                                                                                                         
              print(f"Append failed on attempt {attempt + 1}. Retrying...")                                             
                                                                                                                        
  # Return the screening progress summary as the final answer                                                           
  final_answer(format_screening_progress_summary(review_title=review_title, output_dir=output_dir))                     
