  reference standard of histological confirmation or clinical follow-up\n    # in women with pelvic mass (detected      
  clinically or through USS) suspicious for OC.\n    \n    include = False\n    rationale = \"\"\n    \n    # Check if  
  it's about diagnostic test accuracy for ovarian cancer\n    if 'ovarian cancer' in abstract.lower() or 'ovarian       
  carcinoma' in abstract.lower() or 'malignant ovarian' in abstract.lower():\n        # Check if it evaluates           
  tests/models\n        if any(test in abstract.lower() for test in ['ca125', 'ca-125', 'he4', 'roma', 'risk of         
  malignancy index', 'rmi', 'ultrasound', 'uss', 'biomarker']):\n            # Check if it's a diagnostic accuracy      
  study (sensitivity/specificity/AUC/ROC)\n            if any(term in abstract.lower() for term in ['sensitivity',      
  'specificity', 'auc', 'roc', 'receiver operating characteristic', 'positive predictive value', 'negative predictive   
  value', 'likelihood ratio']):\n                # Check reference standard: histological confirmation or clinical      
  follow-up\n                if any(term in abstract.lower() for term in ['histology', 'histopathological', 'surgical   
  exploration', 'surgery', 'biopsy']):\n                    include = True\n                    rationale =             
  \"Evaluates diagnostic accuracy of biomarker(s) or model(s) for ovarian cancer with histological reference            
  standard.\"\n                else:\n                    # Might still be acceptable if clinical follow-up is          
  implied\n                    include = True\n                    rationale = \"Evaluates diagnostic accuracy of       
  biomarker(s) or model(s) for ovarian cancer; reference standard likely histological or clinical follow-up.\"\n        
  else:\n                # Not a diagnostic accuracy study\n                include = False\n                rationale  
  = \"Does not evaluate diagnostic accuracy (sensitivity/specificity/AUC) of tests.\"\n        else:\n            #     
  Not evaluating relevant tests\n            include = False\n            rationale = \"Does not evaluate ovarian       
  cancer diagnostic tests (e.g., CA125, HE4, ROMA, RMI, ultrasound).\"\n    else:\n        # Not about ovarian cancer   
  diagnosis\n        include = False\n        rationale = \"Not focused on ovarian cancer diagnostic test               
  accuracy.\"\n    \n    # Override for specific cases\n    if idx == 62:\n        include = False\n        rationale   
  = \"Case-control study of symptoms as risk factors, not a diagnostic test accuracy study.\"\n    elif idx == 64:\n    
  include = False\n        rationale = \"Systematic review and meta-analysis, not a primary diagnostic accuracy         
  study.\"\n    elif idx == 66:\n        include = False\n        rationale = \"Commentary on genetic risk assessment,  
  not a diagnostic test accuracy study.\"\n    elif idx == 70:\n        include = False\n        rationale =            
  \"Systematic review and meta-analysis, not a primary diagnostic accuracy study.\"\n    elif idx == 73:\n              
  include = False\n        rationale = \"Tool for risk of bias assessment, not a diagnostic accuracy study.\"\n         
  elif idx == 75:\n        include = False\n        rationale = \"Study on routes to diagnosis using administrative     
  data, not a diagnostic test accuracy study.\"\n    \n    decision = \"INCLUDE\" if include else \"EXCLUDE\"\n         
  confidence = \"high\" if rationale and not rationale.endswith(\".\") else \"medium\"  # Simplified\n    \n            
  decisions.append({\n        \"study_index\": idx,\n        \"title\": title,\n        \"decision\": decision,\n       
  \"rationale\": rationale,\n        \"confidence\": confidence\n    })\n\nn_total = len(studies)\nn_included = sum(1   
  for d in decisions if d[\"decision\"] == \"INCLUDE\")\nn_excluded = n_total - n_included\n\noutput = {\n              
