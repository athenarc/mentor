# Function to decide inclusion                                                                                          
def decide_inclusion(study):                                                                                            
    title = study['title'].lower()                                                                                      
    abstract = study['abstract'].lower()                                                                                
    text = title + ' ' + abstract                                                                                       
                                                                                                                        
    # Exclusion indicators: clearly not about diagnostic test accuracy for ovarian cancer                               
    exclusion_indicators = [                                                                                            
        'mutation', 'brca', 'genetic', 'inherited', 'germline',                                                         
        'prevention', 'treatment', 'chemotherapy', 'survival', 'mortality',                                             
        'incidence', 'trends', 'epidemiology', 'risk factors', 'prognosis',                                             
        'therapy', 'chemoprevention', 'etiology', 'pathogenesis',                                                       
        'family history', 'screening'  # screening might be okay if diagnostic, but often not                           
    ]                                                                                                                   
    has_exclusion = any(indicator in text for indicator in exclusion_indicators)                                        
                                                                                                                        
    # Inclusion indicators                                                                                              
    diagnostic_indicators = [                                                                                           
        'diagnostic', 'accuracy', 'sensitivity', 'specificity', 'auc', 'roc',                                           
        'test', 'marker', 'biomarker', 'ultrasound', 'uss', 'mri', 'ct', 'pet',                                         
        'roma', 'rmi', 'ca125', 'he4', 'risk of malignancy', 'prediction model',                                        
        'cutoff', 'threshold'                                                                                           
    ]                                                                                                                   
    oc_indicators = [                                                                                                   
        'ovarian cancer', 'ovarian carcinoma', 'epithelial ovarian cancer', 'eoc',                                      
        'adnexal mass', 'pelvic mass', 'ovarian tumor', 'ovarian neoplasm',                                             
        'malignant ovarian', 'benign ovarian'                                                                           
    ]                                                                                                                   
    reference_indicators = [                                                                                            
        'histological', 'histology', 'pathological', 'surgical findings',                                               
        'clinical follow-up', 'follow-up', 'reference standard'                                                         
    ]                                                                                                                   
    design_indicators = [                                                                                               
        'cross-sectional', 'prospective', 'retrospective', 'case-control',                                              
        'cohort', 'randomised', 'randomized', 'trial', 'validation',                                                    
        'meta-analysis', 'systematic review'                                                                            
    ]                                                                                                                   
                                                                                                                        
    has_diagnostic = any(indicator in text for indicator in diagnostic_indicators)                                      
    has_oc = any(indicator in text for indicator in oc_indicators)                                                      
    has_reference = any(indicator in text for indicator in reference_indicators)                                        
    has_design = any(indicator in text for indicator in design_indicators)                                              
                                                                                                                        
    # If clearly about genetics etc. and not diagnostic, exclude                                                        
    if has_exclusion and not (has_diagnostic and has_oc):                                                               
        return 'EXCLUDE', 'Focuses on genetics, prevention, treatment, or non-diagnostic aspects without clear          
diagnostic test accuracy evaluation.', 'medium'                                                                         
                                                                                                                        
    # If evaluates diagnostic tests for ovarian cancer with reference standard, include                                 
    if has_diagnostic and has_oc and has_reference:                                                                     
        return 'INCLUDE', 'Evaluates diagnostic test accuracy for ovarian cancer with appropriate reference standard.', 
'high'                                                                                                                  
                                                                                                                        
    # If systematic review/meta-analysis of diagnostic test accuracy studies, include (conservative)                    
    if ('meta-analysis' in text or 'systematic review' in text) and has_diagnostic and has_oc:                          
        return 'INCLUDE', 'Systematic review/meta-analysis of diagnostic test accuracy for ovarian cancer.', 'medium'   
                                                                                                                        
    # If evaluates diagnostic tests for ovarian cancer but reference standard not explicit, still include (conservative)
    if has_diagnostic and has_oc:                                                                                       
        return 'INCLUDE', 'Evaluates diagnostic test accuracy for ovarian cancer; reference standard not explicitly     
mentioned but likely appropriate.', 'medium'                                                                            
                                                                                                                        
    # Default: exclude                                                                                                  
    return 'EXCLUDE', 'Does not clearly meet diagnostic test accuracy criteria for ovarian cancer.', 'low'              
                                                                                                                        
# Process each study                                                                                                    
decisions = []                                                                                                          
for study in studies:                                                                                                   
    decision, rationale, confidence = decide_inclusion(study)                                                           
    decisions.append({                                                                                                  
        'study_index': study['study_index'],                                                                            
        'title': study['title'],                                                                                        
        'decision': decision,                                                                                           
        'rationale': rationale,                                                                                         
        'confidence': confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
n_total = len(studies)                                                                                                  
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
# Print for logging                                                                                                     
print(f'Total studies: {n_total}')                                                                                      
print(f'Included: {n_included}')                                                                                        
print(f'Excluded: {n_excluded}')                                                                                        
for d in decisions:                                                                                                     
    print(f"Study {d['study_index']}: {d['decision']} - {d['rationale']}")                                              
                                                                                                                        
# Final answer                                                                                                          
final_answer({                                                                                                          
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
})                                                                                                                      
                                                                                                                        
