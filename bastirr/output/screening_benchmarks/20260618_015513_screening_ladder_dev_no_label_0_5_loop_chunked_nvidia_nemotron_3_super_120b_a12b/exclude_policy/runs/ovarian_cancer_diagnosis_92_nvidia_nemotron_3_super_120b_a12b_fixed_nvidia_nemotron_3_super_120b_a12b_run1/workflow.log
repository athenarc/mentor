      ])                                                                                                                
                                                                                                                        
      population_ok = has_target_population and (has_oc_context or 'pelvic mass' in text_to_analyze or 'adnexal' in     
  text_to_analyze)                                                                                                      
                                                                                                                        
      # Apply conservative approach: include when uncertain or minimally meets criteria                                 
      if study_design_ok and reference_standard_ok and population_ok:                                                   
          decision = "INCLUDE"                                                                                          
          confidence = "high"                                                                                           
      elif study_design_ok and reference_standard_ok:                                                                   
          # Population might be OK but let's include if design and reference standard are good                          
          decision = "INCLUDE"                                                                                          
          confidence = "medium"                                                                                         
      elif study_design_ok and population_ok:                                                                           
          decision = "INCLUDE"                                                                                          
          confidence = "medium"                                                                                         
      elif reference_standard_ok and population_ok:                                                                     
          decision = "INCLUDE"                                                                                          
          confidence = "medium"                                                                                         
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          # Determine confidence based on how many criteria are met                                                     
          met_criteria = sum([study_design_ok, reference_standard_ok, population_ok])                                   
          if met_criteria == 0:                                                                                         
              confidence = "low"                                                                                        
          elif met_criteria == 1:                                                                                       
              confidence = "medium"                                                                                     
          else:                                                                                                         
              confidence = "medium"  # If 2/3 met but excluding, medium confidence                                      
                                                                                                                        
      # Build rationale                                                                                                 
      met = []                                                                                                          
      if study_design_ok: met.append("study design")                                                                    
      if reference_standard_ok: met.append("reference standard")                                                        
      if population_ok: met.append("population")                                                                        
                                                                                                                        
      not_met = []                                                                                                      
      if not study_design_ok: not_met.append("study design")                                                            
      if not reference_standard_ok: not_met.append("reference standard")                                                
      if not population_ok: not_met.append("population")                                                                
                                                                                                                        
      if decision == "INCLUDE":                                                                                         
          if not_met:                                                                                                   
              rationale = f"Meets criteria: {', '.join(met)}; does not meet: {', '.join(not_met)}."                     
          else:                                                                                                         
              rationale = f"Meets criteria: {', '.join(met)}."                                                          
      else:                                                                                                             
          if met:                                                                                                       
              rationale = f"Does not meet criteria: {', '.join(not_met)}; meets: {', '.join(met)}."                     
          else:                                                                                                         
              rationale = f"Does not meet criteria: {', '.join(not_met)}."                                              
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
      # Debug first few studies                                                                                         
      if study_index <= 5:                                                                                              
          print(f"Study {study_index}: {decision} ({confidence})")                                                      
          print(f"  Design: {study_design_ok}, Ref: {reference_standard_ok}, Pop: {population_ok}")                     
          print(f"  Rationale: {rationale}")                                                                            
          print()                                                                                                       
                                                                                                                        
  # Summary                                                                                                             
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  print(f"Summary: {n_total} total, {n_included} included, {n_excluded} excluded")                                      
                                                                                                                        
  # Prepare final answer in required format                                                                             
  final_answer_data = {                                                                                                 
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
