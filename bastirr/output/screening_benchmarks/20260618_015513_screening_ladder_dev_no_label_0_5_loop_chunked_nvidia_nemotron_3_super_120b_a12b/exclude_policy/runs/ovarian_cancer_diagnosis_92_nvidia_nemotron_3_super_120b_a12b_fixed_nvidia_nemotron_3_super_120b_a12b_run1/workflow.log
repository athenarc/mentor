          evaluates_test_combinations = True                                                                            
                                                                                                                        
      # Check reference standard                                                                                        
      if ('histological' in abstract_lower or                                                                           
          'histopathology' in abstract_lower or                                                                         
          'clinical follow-up' in abstract_lower or                                                                     
          'clinical followup' in abstract_lower or                                                                      
          'reference standard' in abstract_lower):                                                                      
          uses_appropriate_reference = True                                                                             
                                                                                                                        
      # Check population                                                                                                
      if ('pelvic mass' in abstract_lower or                                                                            
          'adnexal mass' in abstract_lower or                                                                           
          'ovarian cancer' in abstract_lower or                                                                         
          'ovarian neoplasm' in abstract_lower or                                                                       
          'ovarian tumor' in abstract_lower or                                                                          
          'ovarian malignancy' in abstract_lower):                                                                      
          population_appropriate = True                                                                                 
                                                                                                                        
      # Make decision based on criteria                                                                                 
      # Must be one of the study types AND evaluate appropriate tests AND have proper reference AND population          
      study_type_appropriate = is_cross_sectional_dta or is_rct_comparing_tests or is_validating_multivariable_model    
      test_evaluation_appropriate = evaluates_single_or_multiple_tests or evaluates_test_combinations                   
                                                                                                                        
      if study_type_appropriate and test_evaluation_appropriate and uses_appropriate_reference and                      
  population_appropriate:                                                                                               
          decision = "INCLUDE"                                                                                          
          confidence = "high"                                                                                           
          rationale = f"Meets criteria: {('Cross-sectional DTA' if is_cross_sectional_dta else '')}{(' RCT comparing    
  tests' if is_rct_comparing_tests else '')}{(' Validating multivariable model' if is_validating_multivariable_model    
  else '')}. Evaluates {('single/multiple tests' if evaluates_single_or_multiple_tests else '')}{(' test combinations'  
  if evaluates_test_combinations else '')}. Uses histological/clinical follow-up reference. Studies women with pelvic   
  mass suspicious for OC."                                                                                              
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          confidence = "medium"  # Could be low if very clearly unrelated                                               
          missing = []                                                                                                  
          if not study_type_appropriate:                                                                                
              missing.append("appropriate study design (cross-sectional DTA, RCT comparing tests, or validating         
  multivariable model)")                                                                                                
          if not test_evaluation_appropriate:                                                                           
              missing.append("evaluation of single tests, multiple tests, or test combinations")                        
          if not uses_appropriate_reference:                                                                            
              missing.append("appropriate reference standard (histological confirmation or clinical follow-up)")        
          if not population_appropriate:                                                                                
              missing.append("appropriate population (women with pelvic mass suspicious for OC)")                       
                                                                                                                        
          rationale = f"Does not meet criteria: missing {', '.join(missing)}."                                          
                                                                                                                        
          # If it's very clearly not about ovarian cancer at all, make confidence low                                   
          if 'ovarian' not in abstract_lower and 'ovarian' not in title_lower and 'adnexal' not in abstract_lower and   
  'adnexal' not in title_lower:                                                                                         
              confidence = "low"                                                                                        
              rationale = f"Does not meet criteria: appears unrelated to ovarian cancer or adnexal masses.              
  {rationale}"                                                                                                          
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
      # Print for debugging                                                                                             
      print(f"Study {study_index}: {decision} - {rationale[:100]}...")                                                  
                                                                                                                        
  print(f"\nProcessed {len(decisions)} studies")                                                                        
