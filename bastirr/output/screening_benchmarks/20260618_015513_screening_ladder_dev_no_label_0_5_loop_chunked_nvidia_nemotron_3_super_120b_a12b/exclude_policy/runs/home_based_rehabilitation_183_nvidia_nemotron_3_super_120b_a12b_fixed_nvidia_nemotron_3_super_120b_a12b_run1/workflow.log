          addresses_patients_needs_phases = True                                                                        
                                                                                                                        
      # Make decision (conservative: include when in doubt)                                                             
      if is_qualitative and addresses_home_based and explores_stakeholder_experiences and                               
  addresses_patients_needs_phases:                                                                                      
          decision = "INCLUDE"                                                                                          
          confidence = "high"                                                                                           
          rationale = "Meets all criteria: qualitative methods, focuses on home-based/telerehabilitation, explores      
  stakeholder experiences/perceptions/behaviors, and addresses patients' needs across health phases."                   
      else:                                                                                                             
          # Determine specific deficiencies for rationale                                                               
          deficiencies = []                                                                                             
          if not is_qualitative:                                                                                        
              deficiencies.append("lacks clear qualitative methodology")                                                
          if not addresses_home_based:                                                                                  
              deficiencies.append("does not focus on home-based rehabilitation or telerehabilitation")                  
          if not explores_stakeholder_experiences:                                                                      
              deficiencies.append("does not explore stakeholder experiences/perceptions/behaviors")                     
          if not addresses_patients_needs_phases:                                                                       
              deficiencies.append("does not address patients' needs in different health phases")                        
                                                                                                                        
          # Conservative approach: include if only one deficiency (doubtful), exclude if two or more                    
          if len(deficiencies) <= 1:                                                                                    
              decision = "INCLUDE"                                                                                      
              confidence = "medium"                                                                                     
              rationale = f"Included due to conservatism; minor deficiency: {deficiencies[0] if deficiencies else       
  'unclear relevance but potential fit'}"                                                                               
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              confidence = "medium"                                                                                     
              rationale = f"Excluded due to multiple deficiencies: {', '.join(deficiencies)}"                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": study['title'],                                                                                      
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Calculate summary statistics                                                                                        
  n_total = len(studies_list)                                                                                           
  n_included = sum(1 for d in decisions if d['decision'] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  # Prepare final answer                                                                                                
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
  print("Screening completed. Results:")                                                                                
  print(f"Total studies: {n_total}")                                                                                    
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
  print("\nDecisions:")                                                                                                 
  for d in decisions:                                                                                                   
      print(f"Study {d['study_index']}: {d['decision']} - {d['rationale']}")                                            
 ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── 
