        rationale = 'Study uses qualitative methods and explores experiences/perceptions/behaviors related to provision 
of home-based rehabilitation and/or telerehabilitation services, meeting all inclusion criteria.'                       
    else:                                                                                                               
        decision = 'EXCLUDE'                                                                                            
        confidence = 'high'                                                                                             
        rationale = 'Study does not meet inclusion criteria: either not qualitative, not focused on home-based          
rehabilitation/telerehabilitation, or does not explore relevant experiences/perceptions/behaviors.'                     
    decisions.append({                                                                                                  
        'study_index': idx,                                                                                             
        'title': title,                                                                                                 
        'decision': decision,                                                                                           
        'rationale': rationale,                                                                                         
        'confidence': confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
n_total = len(studies)                                                                                                  
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
