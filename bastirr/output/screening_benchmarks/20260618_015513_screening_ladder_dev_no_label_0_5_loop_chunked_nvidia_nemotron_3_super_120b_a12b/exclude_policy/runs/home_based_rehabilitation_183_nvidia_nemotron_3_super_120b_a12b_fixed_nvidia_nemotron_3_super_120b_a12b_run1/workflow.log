def is_inclusive(study):                                                                                                
    title = study.get('title', '').lower()                                                                              
    abstract = study.get('abstract', '').lower()                                                                        
    # Check for qualitative methods indicators                                                                          
    qualitative_indicators = ['qualitative', 'interview', 'phenomenology', 'grounded theory', 'thematic analysis',      
                              'content analysis', 'semi-structured', 'focus group', 'descriptive study',                
                              'mixed methods', 'case study', 'action research', 'framework thematic synthesis']         
    is_qualitative = any(ind in abstract for ind in qualitative_indicators) or \                                        
                     any(ind in title for ind in qualitative_indicators)                                                
    if not is_qualitative:                                                                                              
        return False                                                                                                    
    # Check for home-based rehabilitation or telerehabilitation focus                                                   
    rehab_indicators = ['home-based', 'home based', 'telerehabilitation', 'tele-rehabilitation',                        
                        'telehealth', 'tele medicine', 'telemedicine', 'web-based', 'web based',                        
                        'remote', 'digital', 'mobile', 'telephone-delivered', 'video-conferencing',                     
                        'videoconferencing', 'online', 'internet-based', 'home telehealth',                             
                        'home tele-rehabilitation', 'home tele rehabilitation', 'telerehab',                            
                        'tele rehab', 'home exercise', 'home exercise program', 'home exercise programme',              
                        'home intervention', 'home therapy', 'home treatment', 'rehabilitation in the home',            
                        'rehabilitation-at-home', 'rehabilitation at home', 'in-home', 'in home']                       
    has_rehab_focus = any(ind in abstract for ind in rehab_indicators) or any(ind in title for ind in rehab_indicators) 
    if not has_rehab_focus:                                                                                             
        return False                                                                                                    
    # Additionally, ensure it explores experiences/perceptions/behaviors of patients, caregivers, providers,            
stakeholders.                                                                                                           
    experience_indicators = ['experience', 'perception', 'perceptions', 'behaviour', 'behavior',                        
                             'views', 'opinions', 'attitudes', 'feelings', 'satisfaction',                              
                             'acceptability', 'usability', 'facilitators', 'barriers',                                  
                             'adherence', 'non-adherence', 'participation', 'engagement',                               
                             'perspectives', 'stakeholder', 'patient', 'caregiver', 'provider',                         
                             'healthcare professional', 'clinician', 'family', 'relative']                              
    has_experience_focus = any(ind in abstract for ind in experience_indicators) or any(ind in title for ind in         
experience_indicators)                                                                                                  
    if not has_experience_focus:                                                                                        
        return False                                                                                                    
    return True                                                                                                         
                                                                                                                        
decisions = []                                                                                                          
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
