                          'home intervention', 'home therapy', 'home treatment', 'rehabilitation in the home',          
                          'rehabilitation-at-home', 'rehabilitation at home', 'in-home', 'in home']                     
      has_rehab_focus = any(ind in abstract for ind in rehab_indicators) or any(ind in title for ind in                 
  rehab_indicators)                                                                                                     
      if not has_rehab_focus:                                                                                           
          return False                                                                                                  
      # Additionally, ensure it explores experiences/perceptions/behaviors of patients, caregivers, providers,          
  stakeholders.                                                                                                         
      experience_indicators = ['experience', 'perception', 'perceptions', 'behaviour', 'behavior',                      
                               'views', 'opinions', 'attitudes', 'feelings', 'satisfaction',                            
                               'acceptability', 'usability', 'facilitators', 'barriers',                                
                               'adherence', 'non-adherence', 'participation', 'engagement',                             
                               'perspectives', 'stakeholder', 'patient', 'caregiver', 'provider',                       
                               'healthcare professional', 'clinician', 'family', 'relative']                            
      has_experience_focus = any(ind in abstract for ind in experience_indicators) or any(ind in title for ind in       
  experience_indicators)                                                                                                
      if not has_experience_focus:                                                                                      
          return False                                                                                                  
      return True                                                                                                       
                                                                                                                        
