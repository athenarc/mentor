        'content analysis', 'mixed methods' if 'qualitative' in abstract.lower() else None,                             
        'phenomenological', 'ethnographic', 'grounded theory', 'case study'                                             
    ]                                                                                                                   
    # Check for qualitative methods in title and abstract                                                               
    text_to_check = (title + " " + abstract).lower()                                                                    
    uses_qualitative = any(indicator in text_to_check for indicator in qualitative_indicators if indicator is not None) 
                                                                                                                        
    # Check if it explores experiences, perceptions, behaviours of stakeholders                                         
    stakeholders = ['patient', 'caregiver', 'healthcare provider', 'provider', 'clinician',                             
