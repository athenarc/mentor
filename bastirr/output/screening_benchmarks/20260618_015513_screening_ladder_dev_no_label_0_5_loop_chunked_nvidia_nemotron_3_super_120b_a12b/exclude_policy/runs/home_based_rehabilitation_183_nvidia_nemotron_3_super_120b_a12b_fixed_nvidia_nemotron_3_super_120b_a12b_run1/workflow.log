        confidence = "medium"                                                                                           
    elif not uses_qualitative:                                                                                          
        decision = "EXCLUDE"                                                                                            
        n_excluded += 1                                                                                                 
        rationale = "Study does not use qualitative methods for data collection and analysis (uses quantitative, mixed  
