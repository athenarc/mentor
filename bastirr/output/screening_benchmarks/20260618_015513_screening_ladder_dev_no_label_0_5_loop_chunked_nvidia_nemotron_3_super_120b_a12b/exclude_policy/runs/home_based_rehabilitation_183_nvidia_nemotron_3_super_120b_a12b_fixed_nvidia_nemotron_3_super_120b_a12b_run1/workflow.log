    about_rehab_provision = any(term in text_to_check for term in rehab_terms)                                          
                                                                                                                        
    # Check if it responds to patients' needs in different phases of health conditions                                  
    phases_indicators = ['phase', 'stage', 'condition', 'rehabilitation process',                                       
                        'recovery', 'acute', 'chronic', 'post-stroke', 'postoperative']                                 
    addresses_phases = any(indicator in text_to_check for indicator in phases_indicators)                               
                                                                                                                        
    # Make decision: conservative approach - include if uncertain                                                       
    if uses_qualitative and explores_stakeholder_experiences and about_rehab_provision:                                 
        decision = "INCLUDE"                                                                                            
        n_included += 1                                                                                                 
        rationale = f"Study uses qualitative methods ({' and '.join([i for i in qualitative_indicators if i and i in    
