      if ds_count is not None and ds_count < 5:                                                                         
          decision = "EXCLUDE"                                                                                          
          rationale_parts.append(f"Less than 5 DS cases ({ds_count} cases)")                                            
          confidence = "high"                                                                                           
                                                                                                                        
      # Build rationale for included studies                                                                            
      if not rationale_parts:                                                                                           
          if ds_count:                                                                                                  
              rationale_parts.append(f"{ds_count} DS cases identified")                                                 
                                                                                                                        
