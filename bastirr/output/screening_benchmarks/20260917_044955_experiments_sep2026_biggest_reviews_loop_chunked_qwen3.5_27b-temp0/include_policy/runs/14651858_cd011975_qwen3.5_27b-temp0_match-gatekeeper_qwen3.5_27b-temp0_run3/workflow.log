              rationale_parts.append("First trimester screening study")                                                 
          elif 'second trimester' in title.lower() or 'second-trimester' in title.lower():                              
              rationale_parts.append("Second trimester screening study")                                                
          elif 'serum' in title.lower() or 'biochemical' in title.lower():                                              
              rationale_parts.append("Serum/biochemical marker study")                                                  
          elif 'nuchal' in title.lower() or 'ultrasound' in title.lower():                                              
