      ]                                                                                                                 
                                                                                                                        
      for pattern, desc in patterns:                                                                                    
          match = re.search(pattern, text_lower)                                                                        
          if match:                                                                                                     
              try:                                                                                                      
                  ds_count = int(match.group(1))                                                                        
                  break                                                                                                 
              except:                                                                                                   
                  continue                                                                                              
                                                                                                                        
