  decisions = []                                                                                                        
  for idx in range(501, 601):                                                                                           
      study = studies_data[idx]                                                                                         
                                                                                                                        
      # Check if first trimester serum test                                                                             
      is_first_trimester_serum = any(x in study["type"] for x in ["serum_first_trimester"])                             
                                                                                                                        
      # Check DS cases >= 5                                                                                             
      ds_cases_ok = isinstance(study["ds_cases"], int) and study["ds_cases"] >= 5                                       
                                                                                                                        
      # Decision logic                                                                                                  
      if is_first_trimester_serum and ds_cases_ok:                                                                      
          decision = "INCLUDE"                                                                                          
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
                                                                                                                        
      decisions.append({"study_index": idx, "decision": decision})                                                      
                                                                                                                        
  print(f"Total studies: {len(decisions)}")                                                                             
  included = [d for d in decisions if d["decision"] == "INCLUDE"]                                                       
  excluded = [d for d in decisions if d["decision"] == "EXCLUDE"]                                                       
  print(f"Included: {len(included)}")                                                                                   
  print(f"Excluded: {len(excluded)}")                                                                                   
  print(f"Included indices: {[d['study_index'] for d in included]}")                                                    
