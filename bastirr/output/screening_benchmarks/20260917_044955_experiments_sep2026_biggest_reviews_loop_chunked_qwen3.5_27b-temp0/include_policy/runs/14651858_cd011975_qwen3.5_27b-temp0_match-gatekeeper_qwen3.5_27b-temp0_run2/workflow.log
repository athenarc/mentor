  # Parse the JSON                                                                                                      
  data = json.loads(chunk_data)                                                                                         
  studies = data['studies']                                                                                             
                                                                                                                        
  # Create title mapping                                                                                                
  title_map = {s['study_index']: s['title'] for s in studies}                                                           
                                                                                                                        
  # Build final decisions list with actual titles                                                                       
  final_decisions = []                                                                                                  
  for idx in range(301, 401):                                                                                           
      dec = decision_map[idx]                                                                                           
      final_decisions.append({                                                                                          
          "study_index": idx,                                                                                           
          "title": title_map[idx],                                                                                      
          "decision": dec["decision"],                                                                                  
          "rationale": dec["rationale"],                                                                                
          "confidence": dec["confidence"]                                                                               
      })                                                                                                                
                                                                                                                        
  # Count included/excluded                                                                                             
  included = sum(1 for d in final_decisions if d['decision'] == 'INCLUDE')                                              
  excluded = sum(1 for d in final_decisions if d['decision'] == 'EXCLUDE')                                              
                                                                                                                        
  print(f"Total: {len(final_decisions)}, Included: {included}, Excluded: {excluded}")                                   
  print(json.dumps({"n_total": len(final_decisions), "n_included": included, "n_excluded": excluded, "decisions":       
  final_decisions}, indent=2))                                                                                          
