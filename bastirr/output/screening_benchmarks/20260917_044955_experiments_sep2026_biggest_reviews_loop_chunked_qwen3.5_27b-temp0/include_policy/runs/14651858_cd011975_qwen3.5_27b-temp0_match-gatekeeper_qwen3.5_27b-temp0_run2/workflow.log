# Build final decisions list                                                                                            
for study_index, info in studies_data.items():                                                                          
    # Get title from original studies data                                                                              
    title = ""                                                                                                          
    for s in studies['studies']:                                                                                        
        if s['study_index'] == study_index:                                                                             
            title = s['title']                                                                                          
            break                                                                                                       
                                                                                                                        
    decisions.append({                                                                                                  
        'study_index': study_index,                                                                                     
        'title': title,                                                                                                 
        'decision': info['decision'],                                                                                   
        'rationale': info['rationale'],                                                                                 
        'confidence': info['confidence']                                                                                
    })                                                                                                                  
                                                                                                                        
# Calculate summary statistics                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Prepare final answer                                                                                                  
final_result = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(final_result, indent=2))                                                                               
                                                                                                                        
