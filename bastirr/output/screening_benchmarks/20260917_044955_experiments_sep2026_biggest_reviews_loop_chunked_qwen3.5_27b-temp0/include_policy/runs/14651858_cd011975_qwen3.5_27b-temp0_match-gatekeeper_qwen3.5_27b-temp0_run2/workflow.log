decisions = []                                                                                                          
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    dec_info = study_decisions[idx]                                                                                     
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": dec_info["decision"],                                                                               
        "rationale": dec_info["rationale"],                                                                             
        "confidence": dec_info["confidence"]                                                                            
    })                                                                                                                  
                                                                                                                        
# Count included and excluded                                                                                           
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
# Convert to JSON string                                                                                                
final_output_json = json.dumps(output, indent=2)                                                                        
                                                                                                                        
print("Final output prepared successfully")                                                                             
print(f"Total: {n_included + n_excluded}, Included: {n_included}, Excluded: {n_excluded}")                              
                                                                                                                        
