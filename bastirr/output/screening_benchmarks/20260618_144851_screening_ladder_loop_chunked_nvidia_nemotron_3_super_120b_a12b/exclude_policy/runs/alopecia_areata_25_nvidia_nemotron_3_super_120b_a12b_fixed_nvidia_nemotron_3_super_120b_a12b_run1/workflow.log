  # Now evaluate each study for inclusion/exclusion                                                                     
  decisions = []                                                                                                        
  for study in data['studies']:                                                                                         
      idx = study['study_index']                                                                                        
      title = study['title']                                                                                            
      abstract = study['abstract']                                                                                      
                                                                                                                        
      # Combine title and abstract for analysis, convert to lowercase                                                   
      text = (title + ' ' + abstract).lower()                                                                           
                                                                                                                        
      # Check if it's a randomized controlled trial (RCT)                                                               
      is_rct = (                                                                                                        
          'randomized' in text or                                                                                       
          'randomised' in text or                                                                                       
          'randomly' in text or                                                                                         
          'random assignment' in text or                                                                                
          'placebo-controlled' in text or                                                                               
          'double-blind' in text or                                                                                     
          'controlled trial' in text                                                                                    
      )                                                                                                                 
                                                                                                                        
      # Check if it focuses on alopecia areata, totalis, or universalis                                                 
      condition = (                                                                                                     
          'alopecia areata' in text or                                                                                  
          'alopecia totalis' in text or                                                                                 
          'alopecia universalis' in text                                                                                
      )                                                                                                                 
                                                                                                                        
      # Check if it evaluates topical or systemic interventions                                                         
      intervention = (                                                                                                  
          'topical' in text or                                                                                          
          'systemic' in text or                                                                                         
          'minoxidil' in text or                                                                                        
          'corticosteroid' in text or                                                                                   
          'prednisolone' in text or                                                                                     
          'prednisone' in text or                                                                                       
          'inosiplex' in text or                                                                                        
          'isoprinosine' in text or                                                                                     
          'diphenylcyclopropenone' in text or                                                                           
          'dpcp' in text or                                                                                             
          'cyclosporin' in text or                                                                                      
          'thymopentin' in text or                                                                                      
          'puva' in text or                                                                                             
          'immunotherapy' in text or                                                                                    
          'interferon' in text or                                                                                       
          'aromatherapy' in text or                                                                                     
          'photodynamic' in text or                                                                                     
          'ala' in text or                                                                                              
          'betamethasone' in text or                                                                                    
          'clobetasol' in text                                                                                          
      )                                                                                                                 
                                                                                                                        
      # Make inclusion/exclusion decision                                                                               
      if is_rct and condition and intervention:                                                                         
          decision = 'INCLUDE'                                                                                          
          # Confidence is high if it's double-blind, randomized, and placebo-controlled                                 
          confidence = 'high' if (                                                                                      
              'randomized' in text and                                                                                  
              'double-blind' in text and                                                                                
              ('placebo' in text or 'placebo-controlled' in text)                                                       
          ) else 'medium'                                                                                               
          rationale = 'Study is a randomized controlled trial evaluating topical or systemic interventions for          
  alopecia areata/spectrum.'                                                                                            
      else:                                                                                                             
          decision = 'EXCLUDE'                                                                                          
          confidence = 'low'                                                                                            
          rationale_parts = []                                                                                          
          if not is_rct:                                                                                                
              rationale_parts.append('Not a randomized controlled trial')                                               
          if not condition:                                                                                             
              rationale_parts.append('Does not focus on alopecia areata, totalis, or universalis')                      
          if not intervention:                                                                                          
              rationale_parts.append('Does not evaluate a topical or systemic intervention')                            
          rationale = '; '.join(rationale_parts) if rationale_parts else 'Does not meet inclusion criteria'             
                                                                                                                        
      decisions.append({                                                                                                
          'study_index': idx,                                                                                           
          'title': title,                                                                                               
          'decision': decision,                                                                                         
          'rationale': rationale,                                                                                       
          'confidence': confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Calculate summary statistics                                                                                        
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  # Prepare final output                                                                                                
  output = {                                                                                                            
      'n_total': n_total,                                                                                               
      'n_included': n_included,                                                                                         
      'n_excluded': n_excluded,                                                                                         
      'decisions': decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print('Screening results:')                                                                                           
  print(json.dumps(output, indent=2))                                                                                   
  final_answer(output)                                                                                                  
