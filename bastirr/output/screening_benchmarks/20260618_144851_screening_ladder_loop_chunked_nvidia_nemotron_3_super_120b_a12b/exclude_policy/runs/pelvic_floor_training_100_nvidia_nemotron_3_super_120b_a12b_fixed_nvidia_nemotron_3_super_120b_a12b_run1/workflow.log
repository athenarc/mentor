population_ok = True\n            rationale.append(\"Population: Women with urinary incontinence (SUI/UUI/MUI)          
mentioned.\")\n        else:\n            rationale.append(\"Population: Women mentioned but no clear SUI/UUI/MUI.\")\n 
else:\n        rationale.append(\"Population: Not focused on women.\")\n    \n    # Check intervention: PFMT arm\n      
intervention_ok = False\n    if any(term in abstract for term in [\"pelvic floor muscle training\", \"pfmt\", \"pelvic  
floor muscle\", \"pfm training\"]):\n        intervention_ok = True\n        rationale.append(\"Intervention: PFMT      
mentioned.\")\n    else:\n        rationale.append(\"Intervention: No clear PFMT mentioned.\")\n    \n    # Check       
comparison: no treatment, placebo, sham, or inactive control\n    comparison_ok = False\n    control_terms = [\"no      
treatment\", \"placebo\", \"sham\", \"inactive control\", \"control\", \"usual care\", \"waitlist\"]\n    if any(term in
abstract for term in control_terms):\n        comparison_ok = True\n        rationale.append(\"Comparison: No           
treatment/inactive control mentioned.\")\n    else:\n        rationale.append(\"Comparison: No clear no                 
treatment/inactive control mentioned.\")\n    \n    # Check study design: randomized or quasi-randomized controlled     
trial\n    design_ok = False\n    design_terms = [\"randomized\", \"randomised\", \"randomized controlled trial\",      
\"rct\", \"quasi-randomized\", \"quasi-randomised\", \"controlled trial\"]\n    if any(term in abstract for term in     
design_terms):\n        design_ok = True\n        rationale.append(\"Study design: Randomized or quasi-randomized       
controlled trial mentioned.\")\n    else:\n        rationale.append(\"Study design: Not clearly a randomized or         
quasi-randomized controlled trial.\")\n    \n    # Make decision: include if all criteria are met OR if uncertain       
(conservative approach)\n    if population_ok and intervention_ok and comparison_ok and design_ok:\n        decision =  
\"INCLUDE\"\n        confidence = \"high\"\n    else:\n        # Be conservative: if any criterion is unclear but not   
clearly absent, consider including\n        missing_criteria = []\n        if not population_ok:\n                      
missing_criteria.append(\"population\")\n        if not intervention_ok:\n                                              
missing_criteria.append(\"intervention\")\n        if not comparison_ok:\n                                              
missing_criteria.append(\"comparison\")\n        if not design_ok:\n            missing_criteria.append(\"design\")\n   
\n        if missing_criteria:\n            rationale.append(f\"Unclear or missing criteria: {',                        
'.join(missing_criteria)}.\")\n            # If we have at least some evidence related to incontinence and PFMT,        
consider including\n            if \"incontinence\" in abstract and (\"pelvic floor\" in abstract or \"pfmt\" in        
abstract):\n                decision = \"INCLUDE\"\n                confidence = \"medium\"\n                           
rationale.append(\"However, conservative approach: including due to relevance to incontinence and pelvic floor.\")\n    
else:\n                decision = \"EXCLUDE\"\n                confidence = \"low\"\n                                   
rationale.append(\"Insufficient evidence to meet criteria.\")\n        else:\n            # This case shouldn't happen  
due to logic above, but just in case\n            decision = \"EXCLUDE\"\n            confidence = \"low\"\n    \n    # 
Ensure rationale is a single string\n    rationale_str = \" \".join(rationale)\n    \n    decisions.append({\n          
\"study_index\": study_index,\n        \"title\": title,\n        \"decision\": decision,\n        \"rationale\":       
rationale_str,\n        \"confidence\": confidence\n    })\n    \n    # Print for debugging\n    print(f\"Study         
{study_index}: {title[:50]}...\")\n    print(f\"  Decision: {decision} (Confidence: {confidence})\")\n    print(f\"     
Rationale: {rationale_str[:100]}...\")\n    print(\"-\" * 50)\n\n# Count included and excluded\nn_total =               
len(decisions)\nn_included = sum(1 for d in decisions if d[\"decision\"] == \"INCLUDE\")\nn_excluded = n_total -        
n_included\n\n# Prepare final answer\nfinal_answer_obj = {\n    \"n_total\": n_total,\n    \"n_included\": n_included,\n
\"n_excluded\": n_excluded,\n    \"decisions\": decisions\n}\n\nprint(\"\\nScreening Summary:\")\nprint(f\"Total        
studies: {n_total}\")\nprint(f\"Included: {n_included}\")\nprint(f\"Excluded: {n_excluded}\")\n\n# Output the final     
answer using the final_answer tool\nfinal_answer(json.dumps(final_answer_obj))\n"                                       
}                                                                                                                       
