text_to_analyze.lower()\n    \n    # Check for RCT/q-RCT\n    rct_terms = ['randomized', 'randomised', 'randomized 
controlled trial', 'randomised controlled trial', \n                 'rct', 'quasi-random', 'quasi-randomised', 
'quasi-randomized', 'controlled trial'\]\n    is_rct = any(term in text_lower for term in rct_terms)\n    \n    # Check 
for PFMT intervention\n    pfmt_terms = ['pelvic floor muscle training', 'pfmt', 'pelvic floor exercise', 'pelvic floor 
exercises', \n                  'pfmt', 'pelvic floor muscle', ' kegel', 'pelvic floor'\]\n    has_pfmt = any(term in 
text_lower for term in pfmt_terms)\n    \n    # Check for control group (no treatment, placebo, sham, inactive 
control)\n    control_terms = ['no treatment', 'placebo', 'sham', 'inactive control', 'control group', 'usual care', \n 
'waitlist', 'wait list', 'treatment as usual', 'no active treatment'\]\n    has_control = any(term in text_lower for 
term in control_terms)\n    \n    # Check for target population (women with SUI/UUI/MUI)\n    sui_terms = ['stress 
urinary incontinence', 'sui', 'stress incontinence'\]\n    uui_terms = ['urge urinary incontinence', 'uui', 'urge 
incontinence', 'overactive bladder'\]\n    mui_terms = ['mixed urinary incontinence', 'mui'\]\n    incontinence_terms = 
['urinary incontinence', 'incontinence', 'bladder'\]\n    \n    has_incontinence = any(term in text_lower for term in 
incontinence_terms)\n    has_sui = any(term in text_lower for term in sui_terms)\n    has_uui = any(term in text_lower 
for term in uui_terms)\n    has_mui = any(term in text_lower for term in mui_terms)\n    \n    population_ok = 
has_incontinence and (has_sui or has_uui or has_mui)\n    \n    # Make decision\n    if is_rct and has_pfmt and 
has_control and population_ok:\n        decision = \"INCLUDE\"\n        confidence = \"high\"\n        rationale = 
\"Meets all criteria: RCT/q-RCT, women with UI, PFMT arm, control arm\"\n    elif is_rct and has_pfmt and 
population_ok:\n        # Might have control but not clearly described\n        decision = \"INCLUDE\"  # Conservative 
approach - when in doubt, include\n        confidence = \"medium\"\n        rationale = \"RCT/q-RCT with PFMT in women 
with UI; control group not clearly described but may be present\"\n    elif has_pfmt and population_ok:\n        # Not 
clearly RCT but has PFMT and right population\n        decision = \"INCLUDE\"  # Conservative approach\n        
confidence = \"low\"\n        rationale = \"PFMT intervention in women with UI; study design not clearly RCT/q-RCT\"\n  
else:\n        decision = \"EXCLUDE\"\n        confidence = \"medium\"\n        rationale = \"Does not meet key 
criteria: missing RCT/q-RCT design, PFMT intervention, appropriate control, or target population\"\n    \n    
decisions.append({\n        \"study_index\": idx,\n        \"title\": title,\n        \"decision\": decision,\n        
\"rationale\": rationale,\n        \"confidence\": confidence\n    })\n    \n    print(f\"Study {idx}: {decision}\")\n  
print(f\"  Title: {title[:80\]}...\")\n    print(f\"  RCT: {is_rct}, PFMT: {has_pfmt}, Control: {has_control}, 
Population: {population_ok}\")\n    print(f\"  Rationale: {rationale}\\n\")\n\n# Summary\nincluded_count = sum(1 for d 
in decisions if d['decision'\] == 'INCLUDE')\nexcluded_count = len(decisions) - 
included_count\n\nprint(\"=\"*60)\nprint(f\"SUMMARY: {included_count} included, {excluded_count} excluded out of 
{len(decisions)} studies\")\nprint(\"=\"*60)\n\n# Prepare final output\nresult = {\n    \"n_total\": len(decisions),\n  
\"n_included\": included_count,\n    \"n_excluded\": excluded_count,\n    \"decisions\": decisions\n}\n\nprint(\"Final 
result:\")\nprint(json.dumps(result, indent=2))"
