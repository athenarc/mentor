# Parse the JSON string                                                                                                 
data = json.loads(chunk_payload['chunk_payload'])                                                                       
studies = data['studies']                                                                                               
                                                                                                                        
def is_rct_or_quasi_rct(text):                                                                                          
    # Simple heuristics: look for randomized, randomised, quasi-randomised, controlled trial                            
    lower = text.lower()                                                                                                
    return ('randomized' in lower or 'randomised' in lower or 'quasi-randomized' in lower or 'quasi-randomised' in      
lower) and ('controlled trial' in lower or 'randomized controlled trial' in lower or 'randomised controlled trial' in   
lower)                                                                                                                  
                                                                                                                        
def has_pfmt(text):                                                                                                     
    lower = text.lower()                                                                                                
    # Look for pelvic floor muscle training, pelvic muscle exercise, pelvic floor exercises, kinesitherapy (if it's     
exercise), PFMT, pelvic floor muscle training, pelvic muscle training                                                   
    return ('pelvic floor muscle training' in lower or 'pelvic muscle exercise' in lower or 'pelvic floor exercises' in 
lower or 'kinesitherapy' in lower or 'pfmt' in lower or 'pelvic floor muscle' in lower and 'training' in lower) or      
('pelvic floor muscle rehabilitation program' in lower)                                                                 
                                                                                                                        
def has_inactive_control(text):                                                                                         
    lower = text.lower()                                                                                                
    # Control arms described as no treatment, placebo, sham, education, pamphlet, no therapy, control group without     
active treatment                                                                                                        
    inactive_indicators = ['no treatment', 'placebo', 'sham', 'osteoporosis education', 'pamphlet', 'no therapy',       
'control group', 'control intervention', 'education']                                                                   
    for inc in inactive_indicators:                                                                                     
        if inc in lower:                                                                                                
            return True                                                                                                 
    # Also if control group received nothing or usual care (maybe)                                                      
    return False                                                                                                        
                                                                                                                        
def population_women_sui_uui_mui(title_abs):                                                                            
    lower = (title_abs['title'] + ' ' + title_abs['abstract']).lower()                                                  
    # Must be women with SUI, UUI, MUI                                                                                  
    if 'women' not in lower and 'female' not in lower:                                                                  
        return False                                                                                                    
    # Check for incontinence types                                                                                      
    has_sui = 'stress urinary incontinence' in lower or 'stress incontinence' in lower                                  
    has_uui = 'urge urinary incontinence' in lower or 'urge incontinence' in lower                                      
    has_mui = 'mixed urinary incontinence' in lower or 'mixed incontinence' in lower                                    
    # If any of these present, okay                                                                                     
    return has_sui or has_uui or has_mui                                                                                
                                                                                                                        
decisions = []                                                                                                          
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
    combined = title + ' ' + abstract                                                                                   
                                                                                                                        
    # Check design                                                                                                      
    design_ok = is_rct_or_quasi_rct(combined)                                                                           
    # Check population                                                                                                  
    pop_ok = population_women_sui_uui_mui({'title': title, 'abstract': abstract})                                       
    # Check PFMT arm                                                                                                    
    pfmt_ok = has_pfmt(combined)                                                                                        
    # Check control arm inactive                                                                                        
    control_ok = has_inactive_control(combined)                                                                         
                                                                                                                        
    # Decision logic: include if all criteria met; if uncertain, be conservative include                                
    # We'll compute a confidence based on how clear each criterion is.                                                  
    # For simplicity, we'll set confidence high if all clear, medium if some uncertainty, low if major uncertainty.     
    include = False                                                                                                     
    rationale_parts = []                                                                                                
    if not design_ok:                                                                                                   
        rationale_parts.append("Study does not appear to be a randomized or quasi-randomized controlled trial.")        
    if not pop_ok:                                                                                                      
        rationale_parts.append("Population does not clearly consist of women with stress, urge, or mixed urinary        
incontinence.")                                                                                                         
    if not pfmt_ok:                                                                                                     
        rationale_parts.append("No clear pelvic floor muscle training (or equivalent) intervention arm described.")     
    if not control_ok:                                                                                                  
        rationale_parts.append("Control arm does not appear to be no treatment, placebo, sham, or other inactive        
control.")                                                                                                              
                                                                                                                        
    if design_ok and pop_ok and pfmt_ok and control_ok:                                                                 
        include = True                                                                                                  
        confidence = "high"                                                                                             
        rationale = "Meets all inclusion criteria: RCT/q-RCT, women with SUI/UUI/MUI, PFMT arm, inactive control."      
    else:                                                                                                               
        # Be conservative: include if any uncertainty (i.e., not clearly failing)                                       
        # Determine if any criterion is clearly false vs unknown.                                                       
        # We'll treat as include if we cannot definitively say it's excluded.                                           
        # For simplicity, if any criterion is uncertain (we didn't have a clear negative), we include.                  
        # We'll consider a criterion uncertain if we couldn't definitively say it's false.                              
        # Since our functions return True/False based on keyword matches, false means we didn't find evidence.          
        # That could be a false negative. So we will include if we are not sure.                                        
        include = True  # conservative                                                                                  
        # Determine confidence based on how many criteria are met                                                       
        met = sum([design_ok, pop_ok, pfmt_ok, control_ok])                                                             
        if met == 4:                                                                                                    
            confidence = "high"                                                                                         
        elif met >= 2:                                                                                                  
            confidence = "medium"                                                                                       
        else:                                                                                                           
            confidence = "low"                                                                                          
        rationale = "Uncertainty in one or more criteria; being conservative, we include. " + "; ".join(rationale_parts)
if rationale_parts else "Uncertainty in criteria; including conservatively."                                            
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": "INCLUDE" if include else "EXCLUDE",                                                                
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
n_total = len(studies)                                                                                                  
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(output, indent=2))                                                                                     
                                                                                                                        
