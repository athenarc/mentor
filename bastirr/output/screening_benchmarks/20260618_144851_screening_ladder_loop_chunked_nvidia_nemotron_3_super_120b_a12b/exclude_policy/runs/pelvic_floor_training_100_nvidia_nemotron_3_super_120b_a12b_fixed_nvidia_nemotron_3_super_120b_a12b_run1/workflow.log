      abstract_lower = abstract.lower()                                                                                 
      combined = title_lower + ' ' + abstract_lower                                                                     
                                                                                                                        
      # Check for randomised or quasi-randomised controlled trial                                                       
      # We look for indicators: random*, controlled trial, etc.                                                         
      is_randomised = ('randomized' in combined or 'randomised' in combined)                                            
      is_controlled = ('controlled trial' in combined or 'controlled study' in combined or 'rct' in combined)           
      is_quasi_randomised = ('quasi-randomised' in combined or 'quasi-randomized' in combined)                          
      is_rct_or_qrct = (is_randomised and is_controlled) or is_quasi_randomised                                         
                                                                                                                        
      # Check for women with SUI, UUI, or MUI                                                                           
      has_sui = ('sui' in combined or 'stress urinary incontinence' in combined)                                        
      has_uui = ('uui' in combined or 'urge urinary incontinence' in combined)                                          
      has_mui = ('mui' in combined or 'mixed urinary incontinence' in combined)                                         
      has_population = has_sui or has_uui or has_mui                                                                    
                                                                                                                        
      # Check for PFMT in one arm                                                                                       
      has_pfmt = ('pelvic floor muscle training' in combined) or ('pfmt' in combined)                                   
                                                                                                                        
      # Check for control arm: no treatment, placebo, sham, or other inactive control                                   
      has_no_treatment = ('no treatment' in combined)                                                                   
      has_placebo = ('placebo' in combined)                                                                             
      has_sham = ('sham' in combined)                                                                                   
      has_inactive_control = ('inactive control' in combined)                                                           
      has_control = has_no_treatment or has_placebo or has_sham or has_inactive_control                                 
                                                                                                                        
      # Decision: if all criteria are met, INCLUDE; else EXCLUDE.                                                       
      # But we are conservative: if uncertain, we might INCLUDE.                                                        
      # However, we will be strict here because we have to follow the criteria.                                         
      # If any criterion is missing, we EXCLUDE.                                                                        
      if is_rct_or_qrct and has_population and has_pfmt and has_control:                                                
          decision = "INCLUDE"                                                                                          
          rationale = "Meets all criteria: randomised/quasi-randomised controlled trial, women with SUI/UUI/MUI, PFMT   
  arm, and control arm (no treatment/placebo/sham/inactive control)."                                                   
          confidence = "high"                                                                                           
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          missing = []                                                                                                  
          if not is_rct_or_qrct:                                                                                        
              missing.append("not a randomised or quasi-randomised controlled trial")                                   
          if not has_population:                                                                                        
              missing.append("does not specify women with SUI, UUI, or MUI")                                            
          if not has_pfmt:                                                                                              
              missing.append("does not mention pelvic floor muscle training (PFMT) in an intervention arm")             
          if not has_control:                                                                                           
              missing.append("does not mention a control arm of no treatment, placebo, sham, or other inactive          
  control")                                                                                                             
          rationale = "Excluded because: " + "; ".join(missing) + "."                                                   
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Build the final result                                                                                              
  result = {                                                                                                            
      "n_total": len(studies),                                                                                          
      "n_included": sum(1 for d in decisions if d["decision"] == "INCLUDE"),                                            
      "n_excluded": sum(1 for d in decisions if d["decision"] == "EXCLUDE"),                                            
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  # Output as JSON string                                                                                               
