          include = True                                                                                                
          confidence = 'high'                                                                                           
          rationale_str = f"RCT ({'yes' if is_rct else 'no'}), adult HF population ({'yes' if has_hf and is_adult else  
  'no'}), mHealth-delivered education intervention ({'yes' if has_mhealth_education else 'no'}), vs usual HF care       
  ({'yes' if has_usual_comparator else 'no'})."                                                                         
      else:                                                                                                             
          # Be conservative: if uncertain, include.                                                                     
          # We'll consider uncertain if any of the criteria are borderline.                                             
          # We'll define uncertain as missing one criterion but with some indication it might meet.                     
          # For simplicity, if we missing RCT but abstract suggests trial, we might include.                            
          # We'll set confidence low and include if we think it might meet criteria.                                    
          # Let's include if at least RCT and HF population are present, and we suspect mHealth education.              
          # Actually, we should follow guideline: when in doubt, include.                                               
          # So we will include if we are not confidently excluding.                                                     
          # Confident exclusion: clear lack of RCT, or clear lack of HF, or clear lack of mHealth education, or clear   
  lack of usual care comparator.                                                                                        
          # We'll set include = True unless we have high confidence to exclude.                                         
          # Determine if we have high confidence to exclude:                                                            
          high_confidence_exclude = False                                                                               
          if not is_rct:                                                                                                
              # Check if title/abstract clearly indicates not an RCT (e.g., observational, cohort, survey)              
              if ('observational' in abstract.lower()) or ('cohort' in abstract.lower()) or ('cross-sectional' in       
  abstract.lower()) or ('survey' in abstract.lower()) or ('qualitative' in abstract.lower()):                           
                  high_confidence_exclude = True                                                                        
                  rationale_str = "Clearly not an RCT (observational/cohort/survey/qualitative)."                       
          if not has_hf:                                                                                                
              high_confidence_exclude = True                                                                            
              rationale_str = "No heart failure population indicated."                                                  
          if not is_adult:                                                                                              
              # If explicitly pediatric                                                                                 
              if ('pediatric' in abstract.lower()) or ('children' in abstract.lower()) or ('adolescent' in              
  abstract.lower()):                                                                                                    
                  high_confidence_exclude = True                                                                        
                  rationale_str = "Population explicitly not adult (pediatric/adolescent)."                             
          if not has_mhealth_education:                                                                                 
              # Check if intervention is clearly not mHealth education (e.g., drug, device, surgery)                    
              intervention_terms = ['drug', 'medication', 'surgery', 'device', 'implant', 'pacemaker',                  
  'defibrillator']                                                                                                      
              if any(term in abstract.lower() for term in intervention_terms) and not ('education' in                   
  abstract.lower()):                                                                                                    
                  # Might be device trial without education                                                             
                  high_confidence_exclude = True                                                                        
                  rationale_str = "Intervention appears to be device/drug/surgical, not mHealth-delivered education."   
          if not has_usual_comparator:                                                                                  
              # If comparator is clearly not usual care (e.g., another active intervention)                             
              if ('usual care' not in abstract.lower()) and ('control' not in abstract.lower()):                        
                  # Could be active comparator                                                                          
                  high_confidence_exclude = True                                                                        
                  rationale_str = "Comparator does not appear to be usual HF care (may be active intervention)."        
                                                                                                                        
          if high_confidence_exclude:                                                                                   
              include = False                                                                                           
              confidence = 'high'                                                                                       
          else:                                                                                                         
              # Uncertain, so include                                                                                   
              include = True                                                                                            
              confidence = 'low'                                                                                        
              rationale_str = f"Unclear if meets all criteria: RCT={'yes' if is_rct else 'no/unclear'}, HF              
  adult={'yes' if has_hf and is_adult else 'no/unclear'}, mHealth education={'yes' if has_mhealth_education else        
  'no/unclear'}, usual care comparator={'yes' if has_usual_comparator else 'no/unclear'}."                              
                                                                                                                        
      # Append decision                                                                                                 
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": "INCLUDE" if include else "EXCLUDE",                                                              
          "rationale": rationale_str,                                                                                   
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Prepare final answer                                                                                                
  n_total = len(studies)                                                                                                
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  # Convert to JSON string                                                                                              
  import json                                                                                                           
  final_answer_json = json.dumps(result, indent=2)                                                                      
  print(final_answer_json)                                                                                              
