'coaching' in abstract.lower() or 'support' in abstract.lower())\n    \n    # Check if it's versus usual care\n         
versus_usual = ('versus usual' in abstract.lower() or 'vs usual' in abstract.lower() or 'compared to usual' in          
abstract.lower() or\n                    'control group' in abstract.lower() or 'usual care' in abstract.lower())\n     
\n    # Apply selection criteria\n    if is_rct and has_hf and mhealth_education and versus_usual:\n        decision =  
\"INCLUDE\"\n        rationale = f\"Meets all criteria: RCT ({'yes' if is_rct else 'no'}), HF population ({'yes' if     
