# Create decisions list with titles                                                                                     
decisions = []                                                                                                          
for study_index, title, decision, rationale, confidence in studies_data_with_titles:                                    
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count included and excluded                                                                                           
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": 100,                                                                                                     
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies: {output['n_total']}")                                                                            
print(f"Included: {output['n_included']}")                                                                              
print(f"Excluded: {output['n_excluded']}")                                                                              
print(json.dumps(output, indent=2))                                                                                     
                                                                                                                        
