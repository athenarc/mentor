      text = (title + " " + abstract).lower()                                                                           
                                                                                                                        
      decision = "EXCLUDE"                                                                                              
      rationale = ""                                                                                                    
      confidence = "high"                                                                                               
                                                                                                                        
      # Exclusion criteria checks                                                                                       
      if any(kw in text for kw in ['urine', 'urinary']):                                                                
          rationale = "Evaluates urinary markers, not serum or ultrasound."                                             
      elif any(kw in text for kw in ['plasma dna', 'cell free dna', 'cfdna', 'maternal plasma dna sequencing', 'free    
  fetal dna']):                                                                                                         
          rationale = "Evaluates cell-free DNA/NIPT, not ultrasound or serum biochemical tests."                        
      elif any(kw in text for kw in ['qf-pcr', 'mlpa', 'diagnostic accuracy of mlpa', 'stand-alone test for prenatal    
  samples']):                                                                                                           
          rationale = "Evaluates diagnostic molecular tests (QF-PCR/MLPA), not screening."                              
      elif 'second trimester' in text and 'first trimester' not in text and '11-14' not in text and '10-13' not in      
  text and '10-14' not in text:                                                                                         
          rationale = "Focuses on second trimester screening only."                                                     
      elif any(kw in text for kw in ['midtrimester', '15-20 weeks', '14-21 weeks', '14-19 weeks']):                     
          rationale = "Focuses on mid/second trimester screening."                                                      
      elif any(kw in text for kw in ['review', 'commentary', 'happy union?', 'what about the low side?',                
  'socio-demographic disparities', 'uptake of prenatal screening']):                                                    
          rationale = "Review, commentary, or evaluates uptake/disparities rather than test accuracy."                  
      elif any(kw in text for kw in ['sample collection types', 'kryptor immunosassay', 'dpc immulite', 'assay          
  evaluation', 'bias was assessed', 'precision was assessed']):                                                         
          rationale = "Methodology/assay validation study, not clinical screening accuracy."                            
      elif any(kw in text for kw in ['maternal weight adjustment', 'weight correction', 'smoking effect on markers',    
  'ethnic-specific medians', 'influence of maternal bmi', 'effect of fetal gender', 'influence of fetal sex']):         
          rationale = "Evaluates marker adjustments/corrections rather than screening test accuracy."                   
      else:                                                                                                             
          # Inclusion criteria checks                                                                                   
          has_ft = any(kw in text for kw in ['first trimester', '11-14', '10-13', '10-14', '7-13', '8-13', '<14',       
  'week 11', 'week 12', 'week 13', '11 + 0', '13 + 6'])                                                                 
          has_us = any(kw in text for kw in ['nuchal translucency', 'nt', 'ultrasound', 'sonography', 'nasal bone',     
  'ductus venosus', 'tricuspid', 'cystic hygroma', 'hygroma', 'nuchal fold', 'humeral length', 'biometric'])            
          has_ds = any(kw in text for kw in ['down syndrome', 'trisomy 21', 't21', 'ds'])                               
          has_ref = any(kw in text for kw in ['karyotype', 'chromosomal', 'cytogenetic', 'postnatal', 'outcome',        
  'detection rate', 'false positive', 'sensitivity', 'specificity'])                                                    
                                                                                                                        
          if has_ft and has_us and has_ds and has_ref:                                                                  
              decision = "INCLUDE"                                                                                      
              rationale = "Evaluates first trimester ultrasound (with/without serum) for Down syndrome screening with   
  reference standard."                                                                                                  
              confidence = "high"                                                                                       
          elif has_ft and has_ds and has_ref and not has_us:                                                            
              decision = "EXCLUDE"                                                                                      
              rationale = "Evaluates first trimester serum markers only without ultrasound component."                  
              confidence = "medium"                                                                                     
          elif has_ft and has_us and has_ref and not has_ds:                                                            
              decision = "INCLUDE"                                                                                      
              rationale = "Evaluates first trimester ultrasound markers for chromosomal abnormalities including Down    
  syndrome."                                                                                                            
              confidence = "medium"                                                                                     
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Does not meet inclusion criteria for first trimester ultrasound/serum screening for Down     
  syndrome."                                                                                                            
              confidence = "medium"                                                                                     
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(studies),                                                                                          
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
