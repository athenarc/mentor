    39: "EXCLUDE: Protocol for telemonitoring medication support; not mHealth education; no educational content         
specified.",                                                                                                            
    40: "EXCLUDE: Overview of systematic reviews; not a primary RCT of mHealth education in HF.",                       
    41: "EXCLUDE: Meta-analysis/economic model of remote monitoring; not an educational mHealth RCT.",                  
    42: "EXCLUDE: Meta-analysis of implantable device telemonitoring; not educational mHealth.",                        
    43: "EXCLUDE: RCT of ICT-guided disease management with telemonitoring; not mHealth-delivered education.",          
    44: "EXCLUDE: Review of automated telephone educational messaging across conditions; not a primary adult HF RCT.",  
    45: "EXCLUDE: Small prospective decision-support analysis; not RCT and not education-focused.",                     
    46: "EXCLUDE: Telephonic health coaching across high-risk members; not HF-specific RCT and not mobile app/SMS/social
media–based education.",                                                                                                
    47: "EXCLUDE: RCT in young adults on heart disease risk prevention; not HF population.",                            
    48: "EXCLUDE: Pilot randomized mixed-methods mHealth monitoring; focus on self-monitoring/communication, not        
educational content.",                                                                                                  
    49: "EXCLUDE: Qualitative telehealth with digital pens; not RCT; not educational mHealth.",                         
    50: "EXCLUDE: Online heart disease support group; not HF-specific and desktop web; not mobile/wireless education per
protocol.",                                                                                                             
    51: "EXCLUDE: RCT of systematic education using nurse/pharmacist with Photo-CD; not mobile/wireless mHealth.",      
    52: "EXCLUDE: RCT of interactive CD program; desktop/CD-based, not mobile/wireless mHealth.",                       
    53: "EXCLUDE: Quasi-experimental self-care program with video/booklet and phone counseling; not randomized; not     
mobile mHealth.",                                                                                                       
    54: "EXCLUDE: Tablet/web-based app pilot with educational video; not randomized controlled trial.",                 
    55: "EXCLUDE: Internet-based CBT proof-of-concept; not RCT; focuses on depression, not HF education via mobile.",   
    56: "EXCLUDE: Pilot RCT of guided web-based CBT; desktop web and depression-focused, not HF mHealth education via   
mobile.",                                                                                                               
    57: "EXCLUDE: RCT of remote/device fluid monitoring; monitoring without educational content.",                      
    58: "EXCLUDE: RCT of home telemonitoring in home health; telemonitoring-only, no educational mHealth content.",     
    59: "EXCLUDE: Multidisciplinary disease management program; not mobile/wireless education; not mHealth per          
protocol.",                                                                                                             
    60: "EXCLUDE: MITI-HF design—motivational interviewing via home/phone; not mobile app/SMS/social                    
media/web-for-mobile education.",                                                                                       
    61: "EXCLUDE: MITI-HF RCT—motivational interviewing by nurse calls; not mHealth-delivered education via mobile      
platforms.",                                                                                                            
    62: "EXCLUDE: Cost-effectiveness of implantable devices; not an educational mHealth RCT.",                          
    63: "EXCLUDE: Observational comparison of ICD remote monitoring vs hospital follow-up; not RCT educational          
mHealth.",                                                                                                              
    64: "EXCLUDE: RCT of email reminders to nurses (provider-focused); not patient mHealth education.",                 
    65: "EXCLUDE: RCT of telephone tele-monitoring; phone monitoring not educational mHealth per criteria.",            
    66: "EXCLUDE: Qualitative study of nurses’ perceptions on telehealth; not RCT; not educational mHealth.",           
    67: "EXCLUDE: BEAT-HF RCT—telemonitoring + health coaching calls; not mobile app/SMS/social media/web-for-mobile    
education.",                                                                                                            
    68: "EXCLUDE: Meta-analysis/narrative review of CHIT RCTs; not a primary adult HF RCT focused on mHealth education."
}                                                                                                                       
                                                                                                                        
# Construct decisions preserving indices and titles                                                                     
for s in studies:                                                                                                       
    idx = s["study_index"]                                                                                              
    title = s["title"]                                                                                                  
    rationale_full = rationales.get(idx, "EXCLUDE: Does not meet RCT mHealth education criteria for adult HF.")         
    # label is the first word before colon                                                                              
    label = rationale_full.split(":")[0]                                                                                
    rationale_text = rationale_full.split(": ", 1)[1] if ": " in rationale_full else rationale_full                     
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": label,                                                                                              
        "rationale": rationale_text,                                                                                    
        "confidence": "high"                                                                                            
    })                                                                                                                  
                                                                                                                        
# Summaries                                                                                                             
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Prepare the corrected JSON in the required structure for the user's subtask                                           
corrected_json = {                                                                                                      
    "decisions": [                                                                                                      
        {"study_index": d["study_index"], "label": d["decision"], "rationale": d["rationale"]}                          
        for d in decisions                                                                                              
    ]                                                                                                                   
}                                                                                                                       
                                                                                                                        
# Also prepare the gatekeeper-required summary object                                                                   
gatekeeper_summary = {                                                                                                  
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
# Print outputs to use in final step                                                                                    
print(json.dumps(corrected_json, ensure_ascii=False))                                                                   
print(json.dumps(gatekeeper_summary, ensure_ascii=False))                                                               
                                                                                                                        
