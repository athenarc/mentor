import json                                                                                                             
                                                                                                                        
# Parse inputs                                                                                                          
chunk = json.loads(chunk_json)                                                                                          
studies = chunk["studies"]                                                                                              
                                                                                                                        
# Build decisions with rationales per protocol                                                                          
decisions = []                                                                                                          
                                                                                                                        
# Helper mapping of exclusions with rationales                                                                          
rationales = {                                                                                                          
    35: "EXCLUDE: Mixed integrated care/telemedicine across multiple conditions; not an RCT of mHealth-delivered        
education for adult HF.",                                                                                               
    36: "EXCLUDE: Study concerns recruitment for smoking reduction; not adult HF mHealth education RCT.",               
    37: "EXCLUDE: Internet-based telemedicine for monitoring/communication; RCT but telemonitoring, not educational     
