import json                                                                                                             
                                                                                                                        
# Parse the candidates_json to extract study information                                                                
candidates_data = json.loads(candidates_json)                                                                           
                                                                                                                        
# Extract selection criteria                                                                                            
selection_criteria = candidates_data['selection_criteria']                                                              
                                                                                                                        
# List of all studies                                                                                                   
studies = candidates_data['studies']                                                                                    
                                                                                                                        
# Initialize decision lists                                                                                             
included_studies = []                                                                                                   
excluded_studies = []                                                                                                   
                                                                                                                        
# Screen each study based on selection criteria:                                                                        
# "Only phase II and III randomised controlled clinical trials were included in the analysis."                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Check if study is a randomized controlled trial (RCT)                                                             
    # Look for keywords indicating randomization                                                                        
    has_randomization = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                     
                           for keyword in ['randomized', 'randomised', 'randomization', 'randomisation', 'randomly      
assigned', 'randomly allocated'])                                                                                       
                                                                                                                        
    # Check if study mentions phase II or III                                                                           
    has_phase_info = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                        
                        for keyword in ['phase ii', 'phase iii', 'phase 2', 'phase 3'])                                 
                                                                                                                        
    # Check for indicators that would exclude the study                                                                 
    is_review = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                             
                   for keyword in ['review', 'overview', 'literature', 'systematic', 'meta-analysis'])                  
    is_case_series = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                        
                        for keyword in ['case series', 'clinical experience', 'consecutive series'])                    
    is_diagnostic = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                         
                       for keyword in ['accuracy', 'diagnostic', 'imaging', 'sonography', 'MRI', 'MR imaging',          
'ultrasound', 'TRUS'])                                                                                                  
    is_observational = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                      
                          for keyword in ['prospective study', 'retrospective', 'cohort', 'observational'])             
    is_wrong_cancer = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                       
                         for keyword in ['head and neck', 'cervical', 'cervix', 'uterine cervix', 'anal canal'])        
    is_subgroup_analysis = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                  
                              for keyword in ['subgroup', 'pooled data', 'both arms', 'secondary'])                     
    is_molecular = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                          
                      for keyword in ['genetic', 'molecular', 'biomarker', 'apoptosis', 'cell cycle', 'gene'])          
    is_qol_only = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                           
                     for keyword in ['quality of life', 'QoL', 'QLQ-C30', 'GIQLI'])                                     
    is_phase_i = any(keyword.lower() in abstract.lower() or keyword.lower() in title.lower()                            
                    for keyword in ['phase i', 'phase 1'])                                                              
                                                                                                                        
    # Make decision                                                                                                     
    if has_randomization and not is_review and not is_diagnostic and not is_wrong_cancer and not is_molecular:          
        # Additional checks for potential false positives                                                               
        if is_subgroup_analysis or is_qol_only:                                                                         
            decision = "EXCLUDE"                                                                                        
            reason = f"Not a primary RCT; {is_subgroup_analysis and 'subgroup analysis' or 'QoL-only analysis'}"        
            confidence = "medium"                                                                                       
        elif is_phase_i:                                                                                                
            decision = "EXCLUDE"                                                                                        
            reason = "Phase I study, not Phase II or III"                                                               
            confidence = "high"                                                                                         
        else:                                                                                                           
            decision = "INCLUDE"                                                                                        
            reason = "Randomized controlled trial meeting selection criteria"                                           
            confidence = "high"                                                                                         
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        if is_review:                                                                                                   
            reason = "Review article, not an original RCT"                                                              
        elif is_diagnostic:                                                                                             
            reason = "Diagnostic/imaging study, not a therapeutic RCT"                                                  
        elif is_wrong_cancer:                                                                                           
            reason = "Wrong cancer type (not rectal cancer)"                                                            
        elif is_molecular:                                                                                              
            reason = "Molecular/biomarker study, not a clinical RCT"                                                    
        elif is_case_series:                                                                                            
            reason = "Case series, not a randomized controlled trial"                                                   
        elif is_observational:                                                                                          
            reason = "Observational study, not a randomized controlled trial"                                           
        elif is_subgroup_analysis:                                                                                      
            reason = "Subgroup analysis of another trial, not a primary RCT"                                            
        elif is_qol_only:                                                                                               
            reason = "Quality of life analysis only, not a primary therapeutic RCT"                                     
        elif is_phase_i:                                                                                                
            reason = "Phase I study, not Phase II or III"                                                               
