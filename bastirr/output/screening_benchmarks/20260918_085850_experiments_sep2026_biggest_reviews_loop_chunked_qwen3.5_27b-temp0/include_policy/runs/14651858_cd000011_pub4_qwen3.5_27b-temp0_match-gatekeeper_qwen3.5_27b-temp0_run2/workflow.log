    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
    study_index = study['study_index']                                                                                  
                                                                                                                        
    # Check if RCT                                                                                                      
    rct_keywords = ['randomized', 'randomised', 'random allocation', 'randomly assigned', 'randomly allocated', 'RCT',  
