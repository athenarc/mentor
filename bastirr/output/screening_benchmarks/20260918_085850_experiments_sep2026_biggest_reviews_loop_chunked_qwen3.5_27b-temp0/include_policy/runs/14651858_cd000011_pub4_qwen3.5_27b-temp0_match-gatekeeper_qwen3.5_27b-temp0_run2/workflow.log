    is_rct = any(keyword in abstract.lower() for keyword in rct_keywords)                                               
                                                                                                                        
    # Check if intervention is to improve adherence                                                                     
    adherence_keywords = ['adherence', 'compliance', 'adherent', 'compliant']                                           
    is_adherence_intervention = any(keyword in abstract.lower() for keyword in adherence_keywords)                      
                                                                                                                        
    # Check if measures both adherence and clinical outcome                                                             
    # This is tricky from abstract alone. We look for mentions of both.                                                 
    has_adherence_measure = any(keyword in abstract.lower() for keyword in ['adherence', 'compliance', 'pill count',    
