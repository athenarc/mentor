    has_clinical_outcome = any(keyword in abstract.lower() for keyword in ['blood pressure', 'HbA1c', 'glycemic', 'viral
load', 'CD4', 'mortality', 'hospitalization', 'readmission', 'symptoms', 'quality of life', 'clinical outcome',         
'clinical improvement', 'control', 'remission', 'relapse', 'exacerbation', 'morbidity'])                                
                                                                                                                        
    # Check follow-up rate (often mentioned as completion rate)                                                         
    # This is hard to extract automatically. We'll assume if not mentioned, we can't confirm 80%.                       
    # But for the purpose of this task, we'll look for explicit mentions of follow-up rates.                            
    follow_up_rate = None                                                                                               
    if 'follow-up' in abstract.lower() or 'completion' in abstract.lower():                                             
        # Try to find a percentage                                                                                      
        import re                                                                                                       
        matches = re.findall(r'(\d+)%', abstract)                                                                       
        if matches:                                                                                                     
            # This is a rough heuristic                                                                                 
            pass                                                                                                        
                                                                                                                        
    # Check duration                                                                                                    
    duration_keywords = ['6 months', '12 months', '1 year', '2 years', '6-month', '12-month', '1-year', '2-year']       
    has_long_term = any(keyword in abstract.lower() for keyword in duration_keywords)                                   
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "medium"                                                                                               
                                                                                                                        
    # Decision logic                                                                                                    
    if not is_rct:                                                                                                      
        decision = "EXCLUDE"                                                                                            
        rationale = "Not a randomized controlled trial."                                                                
        confidence = "high"                                                                                             
    elif not is_adherence_intervention:                                                                                 
        decision = "EXCLUDE"                                                                                            
        rationale = "Intervention does not target medication adherence."                                                
        confidence = "high"                                                                                             
    elif not (has_adherence_measure and has_clinical_outcome):                                                          
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not measure both medication adherence and clinical outcome."                                  
        confidence = "medium"                                                                                           
    else:                                                                                                               
        # Check follow-up and duration                                                                                  
        # For long-term treatments, need 6 months follow-up                                                             
        # We'll be conservative and include if it seems to meet criteria                                                
        decision = "INCLUDE"                                                                                            
        rationale = "RCT of adherence intervention measuring both adherence and clinical outcomes."                     
        confidence = "medium"                                                                                           
                                                                                                                        
    return {                                                                                                            
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    }                                                                                                                   
                                                                                                                        
