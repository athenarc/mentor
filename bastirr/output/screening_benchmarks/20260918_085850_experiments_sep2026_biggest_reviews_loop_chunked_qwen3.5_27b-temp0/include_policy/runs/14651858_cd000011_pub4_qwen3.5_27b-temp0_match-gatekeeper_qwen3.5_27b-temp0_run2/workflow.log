      "confidence": "high"                                                                                              
  })                                                                                                                    
                                                                                                                        
  # Study 505: INCLUDE - RCT, antidepressant dosing regimen intervention, measures compliance and depression outcomes   
  decisions.append({                                                                                                    
      "study_index": 505,                                                                                               
      "title": "Out‐patient compliance with antidepressant medication",                                                 
      "decision": "INCLUDE",                                                                                            
      "rationale": "RCT comparing different antidepressant dosing regimens (once-daily vs three-times-daily, patient    
  choice vs doctor-prescribed). Measures compliance via interrogation and pill count, and clinical outcomes             
  (depression ratings). 12-week follow-up. Meets selection criteria.",                                                  
      "confidence": "high"                                                                                              
  })                                                                                                                    
                                                                                                                        
  # Study 506: INCLUDE - RCT, supportive measures for hypertension medication adherence, measures adherence and BP      
  decisions.append({                                                                                                    
      "study_index": 506,                                                                                               
      "title": "Impact of supportive measures on drug adherence in patients with essential hypertension treated with    
  valsartan: the randomized, open‐label, parallel group study VALIDATE",                                                
      "decision": "INCLUDE",                                                                                            
      "rationale": "RCT testing supportive measures (stickers, timers, information) to improve valsartan adherence.     
