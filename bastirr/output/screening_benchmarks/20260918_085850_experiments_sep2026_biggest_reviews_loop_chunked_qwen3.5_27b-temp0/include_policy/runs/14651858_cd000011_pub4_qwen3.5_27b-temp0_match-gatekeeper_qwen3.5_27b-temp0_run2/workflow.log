      "study_index": 501,                                                                                               
      "title": "Effectiveness of an education programme by a general practice assistant for asthma and COPD patients:   
  results from a randomised controlled trial",                                                                          
      "decision": "INCLUDE",                                                                                            
      "rationale": "RCT testing education intervention for asthma/COPD patients on medication. Measures both            
  compliance (no significant difference found) and clinical outcomes (inhalation technique, disease symptoms, quality   
  of life). Follow-up at 1 and 2 years exceeds 6-month requirement. Meets all selection criteria.",                     
      "confidence": "high"                                                                                              
  })                                                                                                                    
                                                                                                                        
  # Study 502: EXCLUDE - Does not measure medication adherence as outcome                                               
  decisions.append({                                                                                                    
