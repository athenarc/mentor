decisions = []                                                                                                          
                                                                                                                        
# Study 1: Improving compliance with hormonal replacement therapy in primary osteoporosis prevention                    
# - RCT: Yes (randomized to HRT alternatives)                                                                           
# - Intervention to improve adherence: Yes (offering alternative formulations to improve tolerability/compliance)       
# - Measures adherence: Yes (compliance rates at 5 years)                                                               
