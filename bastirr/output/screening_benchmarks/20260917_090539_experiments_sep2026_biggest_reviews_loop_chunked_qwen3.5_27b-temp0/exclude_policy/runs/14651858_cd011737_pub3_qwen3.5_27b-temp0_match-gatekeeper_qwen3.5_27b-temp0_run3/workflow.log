[{"study_index": 401, "title": "Effects of weight-loss by exercise and by diet on apolipoproteins A-I and A-II and the 
particle-size distribution of high-density lipoproteins in men", "abstract": "We studied separately the effects of 
weight-loss by dieting or by running on apolipoprotein (apo) A-I, apo A-II, and high-density lipoprotein (HDL) 
