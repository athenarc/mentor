          elif not has_cvd_outcome:                                                                                     
              decision = "EXCLUDE"                                                                                      
              rationale = f"Outcome measures do not include mortality or cardiovascular morbidity. Does not meet        
  criterion 7."                                                                                                         
              confidence = "high"                                                                                       
          elif is_multifactorial:                                                                                       
              decision = "EXCLUDE"                                                                                      
              rationale = f"Multifactorial intervention (includes exercise, smoking cessation, or other non-dietary     
  components). Does not meet criterion 4."                                                                              
              confidence = "high"                                                                                       
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = f"Does not meet one or more selection criteria upon detailed review."                         
              confidence = "medium"                                                                                     
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count included/excluded                                                                                             
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
