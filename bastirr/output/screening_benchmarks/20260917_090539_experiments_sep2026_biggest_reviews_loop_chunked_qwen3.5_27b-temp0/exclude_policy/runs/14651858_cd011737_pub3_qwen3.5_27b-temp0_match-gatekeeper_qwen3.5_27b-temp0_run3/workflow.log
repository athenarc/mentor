# Selection criteria checklist:                                                                                         
# 1) randomised                                                                                                         
# 2) intention to reduce saturated fat intake OR intention to alter dietary fats and achieving a reduction in saturated 
fat                                                                                                                     
# 3) compared with higher saturated fat intake or usual diet                                                            
# 4) not multifactorial                                                                                                 
# 5) in adult humans with or without cardiovascular disease (but not acutely ill, pregnant or breastfeeding)            
# 6) intervention duration at least 24 months                                                                           
# 7) mortality or cardiovascular morbidity data available                                                               
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Initialize decision variables                                                                                     
    is_randomized = False                                                                                               
    reduces_sat_fat = False                                                                                             
    vs_higher_sat_or_usual = False                                                                                      
    not_multifactorial = True                                                                                           
    adult_humans_not_acute = True                                                                                       
    duration_24mo_plus = False                                                                                          
    has_mortality_cv_outcome = False                                                                                    
                                                                                                                        
    # Check if randomized                                                                                               
    if 'random' in abstract.lower() or 'random' in title.lower():                                                       
        is_randomized = True                                                                                            
                                                                                                                        
    # Check for saturated fat reduction                                                                                 
    sat_fat_keywords = ['saturated fat', 'saturated fatty acid', 'sat fat', 'sfa', 'low-fat', 'reduced fat']            
    if any(kw in abstract.lower() for kw in sat_fat_keywords):                                                          
        reduces_sat_fat = True                                                                                          
                                                                                                                        
    # Check comparison group                                                                                            
    if 'control' in abstract.lower() or 'usual' in abstract.lower() or 'vs' in abstract.lower():                        
        vs_higher_sat_or_usual = True                                                                                   
                                                                                                                        
    # Check for multifactorial interventions                                                                            
    multi_keywords = ['multifactorial', 'multiple risk factors', 'lifestyle', 'exercise', 'smoking', 'physical          
activity', 'stress management', 'drug treatment', 'pharmacologic']                                                      
    if any(kw in abstract.lower() for kw in multi_keywords):                                                            
        not_multifactorial = False                                                                                      
                                                                                                                        
    # Check population - exclude acute illness, pregnancy, breastfeeding                                                
    exclude_pop = ['acute myocardial infarction', 'acute mi', 'pregnant', 'breastfeeding', 'postpartum']                
    if any(kw in abstract.lower() for kw in exclude_pop):                                                               
        adult_humans_not_acute = False                                                                                  
                                                                                                                        
    # Check duration - look for time periods                                                                            
    duration_keywords = ['month', 'year', 'yr', 'years']                                                                
    duration_found = False                                                                                              
    for kw in duration_keywords:                                                                                        
        if kw in abstract.lower():                                                                                      
            duration_found = True                                                                                       
            break                                                                                                       
                                                                                                                        
    # Try to extract duration from text                                                                                 
    import re                                                                                                           
    months_match = re.search(r'(\d+)\s*(?:month|mo)', abstract.lower())                                                 
    years_match = re.search(r'(\d+)\s*(?:year|yr)', abstract.lower())                                                   
                                                                                                                        
    if months_match:                                                                                                    
        months = int(months_match.group(1))                                                                             
        if months >= 24:                                                                                                
            duration_24mo_plus = True                                                                                   
    elif years_match:                                                                                                   
        years = int(years_match.group(1))                                                                               
        if years >= 2:                                                                                                  
            duration_24mo_plus = True                                                                                   
                                                                                                                        
    # Check for mortality or CV outcomes                                                                                
    cv_outcomes = ['mortality', 'death', 'cardiovascular', 'coronary heart disease', 'chd', 'myocardial infarction',    
'mi', 'stroke', 'cv event', 'cardiac event', 'fatal', 'nonfatal']                                                       
    if any(kw in abstract.lower() for kw in cv_outcomes):                                                               
        has_mortality_cv_outcome = True                                                                                 
                                                                                                                        
    # Make decision                                                                                                     
    if is_randomized and reduces_sat_fat and vs_higher_sat_or_usual and not_multifactorial and adult_humans_not_acute   
and duration_24mo_plus and has_mortality_cv_outcome:                                                                    
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
    elif not is_randomized or not reduces_sat_fat or not vs_higher_sat_or_usual or not not_multifactorial or not        
adult_humans_not_acute or not duration_24mo_plus or not has_mortality_cv_outcome:                                       
        decision = "EXCLUDE"                                                                                            
        confidence = "medium"                                                                                           
    else:                                                                                                               
        decision = "INCLUDE"  # Be conservative                                                                         
        confidence = "low"                                                                                              
                                                                                                                        
    decisions.append({                                                                                                  
        'study_index': idx,                                                                                             
        'title': title[:80] + '...' if len(title) > 80 else title,                                                      
        'decision': decision,                                                                                           
        'is_randomized': is_randomized,                                                                                 
        'reduces_sat_fat': reduces_sat_fat,                                                                             
        'duration_24mo_plus': duration_24mo_plus,                                                                       
        'has_mortality_cv_outcome': has_mortality_cv_outcome,                                                           
        'not_multifactorial': not_multifactorial,                                                                       
        'adult_humans_not_acute': adult_humans_not_acute                                                                
    })                                                                                                                  
                                                                                                                        
# Print summary                                                                                                         
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
print(f"\nInitial screening results:")                                                                                  
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Show excluded studies with reasons                                                                                    
print("\n\nExcluded studies details:")                                                                                  
for d in decisions:                                                                                                     
