# Create decisions list                                                                                                 
decisions = []                                                                                                          
                                                                                                                        
# Process each study                                                                                                    
for study in chunk_data['studies']:                                                                                     
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Default decision is EXCLUDE                                                                                       
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check criteria systematically                                                                                     
                                                                                                                        
    # Criterion 1: Randomised                                                                                           
    is_randomized = any(word in abstract.lower() for word in ['random', 'randomised', 'randomized'])                    
                                                                                                                        
    # Criterion 2: Intention to reduce saturated fat OR alter dietary fats achieving reduction in saturated fat         
    has_sat_fat_focus = any(word in abstract.lower() for word in ['saturated fat', 'saturated fatty acid', 'sfa',       
'low-fat', 'low fat'])                                                                                                  
                                                                                                                        
    # Criterion 3: Compared with higher saturated fat or usual diet                                                     
    has_comparison = any(word in abstract.lower() for word in ['control', 'usual', 'normal', 'placebo'])                
                                                                                                                        
    # Criterion 4: Not multifactorial                                                                                   
    is_multifactorial = any(word in abstract.lower() for word in ['multiple risk', 'smoking', 'exercise', 'drug',       
'multifactorial', 'combination'])                                                                                       
                                                                                                                        
    # Criterion 5: Adult humans, not acutely ill, pregnant, or breastfeeding                                            
    is_adult_human = any(word in abstract.lower() for word in ['adult', 'men', 'women', 'patients', 'subjects'])        
    is_acutely_ill = any(word in abstract.lower() for word in ['acute', 'pregnant', 'breastfeeding'])                   
                                                                                                                        
    # Criterion 6: Duration at least 24 months                                                                          
    has_duration = any(word in abstract.lower() for word in ['2 year', '24 month', '3 year', '4 year', '5 year', '6     
year', '15 year'])                                                                                                      
    short_duration = any(word in abstract.lower() for word in ['1 year', '12 month', '6 month', '8 week', '21 day', '5  
day', '2 week', '1 week', 'fortnightly'])                                                                               
                                                                                                                        
    # Criterion 7: Mortality or cardiovascular morbidity data                                                           
    has_cvd_outcome = any(word in abstract.lower() for word in ['mortality', 'death', 'cardiovascular', 'chd',          
'coronary', 'myocardial infarction', 'heart attack', 'stroke', 'cvd', 'relapse'])                                       
                                                                                                                        
    # Determine decision based on criteria                                                                              
    if not is_randomized:                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Not a randomised trial. {title}"                                                                  
        confidence = "high"                                                                                             
    elif is_multifactorial:                                                                                             
        decision = "EXCLUDE"                                                                                            
        rationale = f"Multifactorial intervention (includes smoking cessation, exercise, drugs, or multiple components).
{title}"                                                                                                                
        confidence = "high"                                                                                             
    elif is_acutely_ill:                                                                                                
        decision = "EXCLUDE"                                                                                            
        rationale = f"Population includes acutely ill, pregnant, or breastfeeding individuals. {title}"                 
        confidence = "high"                                                                                             
    elif short_duration and not has_duration:                                                                           
        decision = "EXCLUDE"                                                                                            
        rationale = f"Intervention duration less than 24 months. {title}"                                               
        confidence = "high"                                                                                             
    elif not has_cvd_outcome:                                                                                           
        decision = "EXCLUDE"                                                                                            
        rationale = f"No mortality or cardiovascular morbidity data available. {title}"                                 
        confidence = "high"                                                                                             
    elif not has_sat_fat_focus:                                                                                         
        decision = "EXCLUDE"                                                                                            
        rationale = f"Intervention does not specifically target saturated fat reduction. {title}"                       
        confidence = "medium"                                                                                           
    else:                                                                                                               
        # Check if it's a review/meta-analysis                                                                          
        is_review = any(word in title.lower() for word in ['review', 'meta-analysis', 'systematic', 'guideline',        
'commentary', 'methodological'])                                                                                        
        if is_review:                                                                                                   
            decision = "EXCLUDE"                                                                                        
            rationale = f"This is a review/meta-analysis/guideline, not a primary RCT. {title}"                         
            confidence = "high"                                                                                         
        else:                                                                                                           
            decision = "INCLUDE"                                                                                        
            rationale = f"Meets all selection criteria: randomised, targets saturated fat reduction, appropriate        
comparison, not multifactorial, adult population, duration >=24 months, has CVD outcomes. {title}"                      
            confidence = "medium"                                                                                       
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
# Prepare final output                                                                                                  
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print("\nDecisions summary:")                                                                                           
for d in decisions[:10]:  # Print first 10 as sample                                                                    
    print(f"Study {d['study_index']}: {d['decision']} - {d['rationale'][:100]}...")                                     
                                                                                                                        
