    elif has_satfat_reduction and has_cv_outcome and has_duration_24mo:                                                 
        decision = "INCLUDE"                                                                                            
        rationale = f"Meets inclusion criteria: randomized, reduces saturated fat, CV outcomes, ≥24 months duration"    
    else:                                                                                                               
        rationale = f"Does not meet key inclusion criteria"                                                             
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title[:100] + "...",                                                                                   
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
