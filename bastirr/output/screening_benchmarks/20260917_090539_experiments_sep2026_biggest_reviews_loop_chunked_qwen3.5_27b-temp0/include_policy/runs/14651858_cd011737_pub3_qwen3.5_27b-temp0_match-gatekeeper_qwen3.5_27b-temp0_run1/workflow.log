    is_hypertension_only = any(word in abstract for word in ["hypertension", "blood pressure", "antihypertensive"]) and 
"saturated fat" not in abstract                                                                                         
                                                                                                                        
    # Apply decision logic                                                                                              
    if not has_randomized:                                                                                              
        rationale = f"Not randomized trial"                                                                             
    elif is_breast_cancer:                                                                                              
        rationale = f"Breast cancer outcome, not cardiovascular disease"                                                
    elif is_acute_mi:                                                                                                   
        rationale = f"Acutely ill patients (acute MI), excluded by protocol"                                            
    elif not has_cv_outcome:                                                                                            
        rationale = f"No mortality or cardiovascular morbidity outcomes reported"                                       
    elif not has_duration_24mo:                                                                                         
        rationale = f"Intervention duration less than 24 months"                                                        
    elif is_multifactorial and "diet" in abstract.lower():                                                              
