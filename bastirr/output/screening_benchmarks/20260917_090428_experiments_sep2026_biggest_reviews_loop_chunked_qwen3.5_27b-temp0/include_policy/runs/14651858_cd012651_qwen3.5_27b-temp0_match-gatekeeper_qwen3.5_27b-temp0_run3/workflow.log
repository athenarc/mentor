  # First, let me extract the studies from the candidate_chunk                                                          
  studies = candidate_chunk['studies']                                                                                  
                                                                                                                        
  decisions = []                                                                                                        
                                                                                                                        
  for study in studies:                                                                                                 
      study_index = study['study_index']                                                                                
      title = study['title']                                                                                            
      abstract = study['abstract']                                                                                      
                                                                                                                        
      decision = "EXCLUDE"                                                                                              
      rationale = ""                                                                                                    
      confidence = "medium"                                                                                             
                                                                                                                        
      # Check for RCT                                                                                                   
      rct_keywords = ['randomized', 'randomised', 'RCT', 'cluster-randomized', 'cluster-randomised', 'random            
  allocation', 'random assignment']                                                                                     
      is_rct = any(kw.lower() in abstract.lower() for kw in rct_keywords)                                               
                                                                                                                        
      # Check for age range (6-11 years)                                                                                
      age_keywords = ['6', '7', '8', '9', '10', '11', '6-11', '7-11', '8-11', '9-11', '10-11', 'elementary', 'primary   
  school', 'grades 1-4', 'grades 3-4', 'grades 4-5', 'preadolescent', 'prepubescent']                                   
      age_match = any(kw.lower() in abstract.lower() for kw in age_keywords)                                            
                                                                                                                        
      # Check for follow-up >= 6 months                                                                                 
      followup_keywords = ['6 months', '12 months', '1 year', '2 years', '18 months', '24 months', '6-mo', '12-mo',     
  '1-y', '2-y', 'six months', 'twelve months', 'one year', 'two years']                                                 
      has_followup = any(kw.lower() in abstract.lower() for kw in followup_keywords)                                    
                                                                                                                        
      # Check for intervention type                                                                                     
      intervention_keywords = ['diet', 'exercise', 'physical activity', 'behavioral', 'lifestyle', 'family-based',      
  'nutrition', 'weight loss', 'weight control', 'obesity intervention']                                                 
      has_intervention = any(kw.lower() in abstract.lower() for kw in intervention_keywords)                            
                                                                                                                        
      # Check for exclusion criteria                                                                                    
      exclude_keywords = ['eating disorder', 'type 2 diabetes', 'diabetes mellitus', 'syndromic', 'secondary cause',    
  'protocol', 'design and methods', 'rationale and design', 'systematic review', 'literature review', 'meta-analysis',  
  'feasibility', 'pilot', 'cost-effectiveness', 'cost and effectiveness']                                               
      is_excluded = any(kw.lower() in abstract.lower() for kw in exclude_keywords)                                      
                                                                                                                        
      # Make decision                                                                                                   
      if is_excluded:                                                                                                   
          decision = "EXCLUDE"                                                                                          
          rationale = f"Study does not meet inclusion criteria. {title}"                                                
      elif not is_rct:                                                                                                  
          decision = "EXCLUDE"                                                                                          
          rationale = f"Not a randomized controlled trial. {title}"                                                     
      elif not has_followup:                                                                                            
          decision = "EXCLUDE"                                                                                          
          rationale = f"Follow-up period less than 6 months. {title}"                                                   
      elif not age_match:                                                                                               
          decision = "EXCLUDE"                                                                                          
          rationale = f"Age range does not match 6-11 years. {title}"                                                   
      elif not has_intervention:                                                                                        
          decision = "EXCLUDE"                                                                                          
          rationale = f"No relevant intervention (diet, physical activity, or behavioral). {title}"                     
      else:                                                                                                             
          decision = "INCLUDE"                                                                                          
          rationale = f"Meets inclusion criteria: RCT of diet/physical activity/behavioral intervention for             
  overweight/obese children aged 6-11 years with 6+ months follow-up. {title}"                                          
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  # Prepare final output                                                                                                
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
