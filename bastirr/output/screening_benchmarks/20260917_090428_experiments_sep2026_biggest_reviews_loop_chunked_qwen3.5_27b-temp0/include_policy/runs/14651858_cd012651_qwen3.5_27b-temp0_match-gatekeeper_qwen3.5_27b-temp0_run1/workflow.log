        # Determine exclusion reason                                                                                    
        if "protocol" in study['abstract'].lower() or "design" in study['abstract'].lower() and "methods" in            
study['abstract'].lower():                                                                                              
            reason = "Protocol paper or study design paper without results"                                             
        elif "systematic review" in study['abstract'].lower() or "meta-analysis" in study['abstract'].lower() or        
"review" in study['abstract'].lower():                                                                                  
            reason = "Review article or meta-analysis, not primary RCT"                                                 
        elif "epidemiolog" in study['abstract'].lower() or "prevalence" in study['abstract'].lower() or "secular trend" 
in study['abstract'].lower():                                                                                           
            reason = "Epidemiological study, not intervention trial"                                                    
        elif "drug" in study['abstract'].lower() or "pharmacological" in study['abstract'].lower() or "medication" in   
study['abstract'].lower():                                                                                              
            reason = "Drug/pharmacological intervention, outside scope of diet/physical activity/behavioral             
interventions"                                                                                                          
        elif "surgery" in study['abstract'].lower() or "bariatric" in study['abstract'].lower():                        
            reason = "Surgical intervention, outside scope"                                                             
        elif "secondary analysis" in study['abstract'].lower() or "predictor" in study['abstract'].lower():             
            reason = "Secondary analysis of existing trial data"                                                        
        elif "3-" in study['abstract'].lower() or "preschool" in study['abstract'].lower() or "infant" in               
study['abstract'].lower() or "4-5" in study['abstract'].lower() or "5 years" in study['abstract'].lower():              
            reason = "Age range includes children under 6 years"                                                        
        elif "12" in study['abstract'].lower() or "13" in study['abstract'].lower() or "14" in study['abstract'].lower()
or "15" in study['abstract'].lower() or "16" in study['abstract'].lower() or "17" in study['abstract'].lower() or "18"  
in study['abstract'].lower() or "adolescent" in study['abstract'].lower():                                              
            reason = "Age range extends beyond 11 years or includes adolescents"                                        
        elif "3-month" in study['abstract'].lower() or "4-month" in study['abstract'].lower() or "8-week" in            
study['abstract'].lower() or "12-week" in study['abstract'].lower() or "16-week" in study['abstract'].lower() or        
"20-week" in study['abstract'].lower() or "24-week" in study['abstract'].lower() or "5-month" in                        
study['abstract'].lower():                                                                                              
            reason = "Follow-up less than 6 months"                                                                     
        elif "non-randomized" in study['abstract'].lower() or "controlled" in study['abstract'].lower() and "random" not
in study['abstract'].lower():                                                                                           
            reason = "Not a randomized controlled trial"                                                                
        elif "quasi-random" in study['abstract'].lower():                                                               
            reason = "Quasi-randomized trial, not true RCT"                                                             
        elif "pilot" in study['abstract'].lower():                                                                      
            reason = "Pilot study with unclear randomization or insufficient follow-up"                                 
        else:                                                                                                           
            reason = "Does not meet inclusion criteria (age, study design, or follow-up requirements)"                  
                                                                                                                        
        decisions.append({                                                                                              
            "study_index": study_idx,                                                                                   
            "title": study['title'],                                                                                    
            "decision": "EXCLUDE",                                                                                      
            "rationale": reason,                                                                                        
            "confidence": "high"                                                                                        
        })                                                                                                              
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
# Prepare final output                                                                                                  
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print("\nIncluded study indices:", [d["study_index"] for d in decisions if d["decision"] == "INCLUDE"])                 
                                                                                                                        
