import json                                                                                                             
                                                                                                                        
# The chunk_data is already provided as a string variable                                                               
# Let's parse it properly                                                                                               
data = json.loads(chunk_data)                                                                                           
                                                                                                                        
# Extract studies                                                                                                       
studies = data["studies"]                                                                                               
n_studies = len(studies)                                                                                                
                                                                                                                        
print(f"Total studies in chunk: {n_studies}")                                                                           
print(f"Study indices: {data['chunk_study_indices']}")                                                                  
                                                                                                                        
# Now I'll analyze each study against the selection criteria:                                                           
# - RCTs                                                                                                                
# - Diet, physical activity, and/or behavioural interventions                                                           
# - Overweight or obese children aged 6 to 11 years                                                                     
# - Minimum 6 months follow-up                                                                                          
# - Exclude: eating disorders, type 2 diabetes, secondary/syndromic obesity                                             
                                                                                                                        
# Let me create decisions for each study                                                                                
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study["study_index"]                                                                                  
    title = study["title"]                                                                                              
    abstract = study["abstract"]                                                                                        
                                                                                                                        
    # Default to EXCLUDE, will change to INCLUDE if criteria met                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check if it's an RCT                                                                                              
    is_rct = any(term in abstract.lower() for term in ["randomized", "randomised", "random allocation", "random         
assignment", "randomly assigned", "randomly allocated", "RCT", "randomized controlled trial"])                          
                                                                                                                        
    # Check age range (6-11 years)                                                                                      
    age_match = any(term in abstract.lower() for term in ["6-11", "6 to 11", "7-11", "8-11", "9-11", "6-10", "7-10",    
"8-10", "9-10", "6 to 10", "7 to 10", "8 to 10", "9 to 10", "6-9", "7-9", "8-9", "9-12", "6 to 12", "7 to 12", "8 to    
12", "9 to 12", "prepubertal", "preadolescent", "school-aged", "elementary"])                                           
                                                                                                                        
    # Check for overweight/obese children                                                                               
    population_match = any(term in abstract.lower() for term in ["overweight", "obese", "obesity", "BMI", "body mass    
index", "weight"])                                                                                                      
                                                                                                                        
    # Check for intervention type                                                                                       
    intervention_match = any(term in abstract.lower() for term in ["diet", "exercise", "physical activity",             
"behavioral", "lifestyle", "nutrition", "intervention"])                                                                
                                                                                                                        
    # Check follow-up (minimum 6 months)                                                                                
    followup_match = any(term in abstract.lower() for term in ["6 month", "6-month", "12 month", "12-month", "1 year",  
"2 year", "3 year", "6 months", "12 months", "18 months", "24 months", "36 months", "9 month", "9-month", "10 month",   
"10-month", "14 month", "14-month", "1 year", "2 years", "3 years", "4 years", "5 years", "10 years"])                  
                                                                                                                        
    # Check for exclusion criteria                                                                                      
    is_excluded = any(term in abstract.lower() for term in ["eating disorder", "type 2 diabetes", "syndromic",          
"secondary cause", "surgery", "bariatric", "drug", "pharmacological", "metformin", "sibutramine", "orlistat"])          
                                                                                                                        
    # Determine decision                                                                                                
    if is_rct and population_match and intervention_match and followup_match and not is_excluded:                       
        # Check age more carefully                                                                                      
        if age_match or "6" in abstract or "7" in abstract or "8" in abstract or "9" in abstract or "10" in abstract or 
"11" in abstract:                                                                                                       
            decision = "INCLUDE"                                                                                        
            rationale = f"RCT of diet/physical activity/behavioral intervention for overweight/obese children with ≥6   
months follow-up. Age range appears to include 6-11 years."                                                             
        else:                                                                                                           
            decision = "EXCLUDE"                                                                                        
            rationale = f"RCT but age range unclear or outside 6-11 years."                                             
    elif not is_rct:                                                                                                    
        decision = "EXCLUDE"                                                                                            
        rationale = "Not a randomized controlled trial."                                                                
    elif not population_match:                                                                                          
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not target overweight/obese children."                                                        
    elif not intervention_match:                                                                                        
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not involve diet, physical activity, or behavioral intervention."                             
    elif not followup_match:                                                                                            
        decision = "EXCLUDE"                                                                                            
        rationale = "Follow-up less than 6 months."                                                                     
    elif is_excluded:                                                                                                   
        decision = "EXCLUDE"                                                                                            
        rationale = "Excluded due to eating disorders, type 2 diabetes, secondary obesity, or drug/surgery              
intervention."                                                                                                          
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not meet selection criteria."                                                                 
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count decisions                                                                                                       
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
print(f"\nDecisions summary:")                                                                                          
print(f"Total: {n_studies}")                                                                                            
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Print first few decisions for verification                                                                            
for d in decisions[:5]:                                                                                                 
    print(f"\nStudy {d['study_index']}: {d['decision']}")                                                               
    print(f"  Rationale: {d['rationale'][:100]}...")                                                                    
                                                                                                                        
