              decision = "EXCLUDE"                                                                                      
              rationale = f"Study follow-up is less than 6 months."                                                     
              confidence = "high"                                                                                       
      # Check for non-RCT designs                                                                                       
      elif any(keyword in abstract.lower() for keyword in ['observational', 'cohort', 'cross-sectional', 'pre and       
  post', 'before-and-after', 'secondary analysis', 'pilot study', 'non-randomized', 'quasi-randomized']):               
          if 'randomized' not in abstract.lower() and 'randomised' not in abstract.lower() and 'randomization' not in   
  abstract.lower() and 'random assignment' not in abstract.lower():                                                     
              decision = "EXCLUDE"                                                                                      
              rationale = f"Study is not a randomized controlled trial."                                                
              confidence = "high"                                                                                       
      # Check for non-diet/physical activity/behavioral interventions                                                   
      elif any(keyword in abstract.lower() for keyword in ['acupuncture', 'neurofeedback', 'drug', 'pharmacological',   
  'surgery', 'bariatric', 'metformin', 'sibutramine', 'orlistat', 'tuberil', 'cla', 'synbiotic', 'dha', 'milk',         
  'dairy', 'protein', 'glycemic', 'water', 'beverage', 'supplement']):                                                  
          if 'diet' not in abstract.lower() and 'physical activity' not in abstract.lower() and 'exercise' not in       
  abstract.lower() and 'behavioral' not in abstract.lower() and 'lifestyle' not in abstract.lower() and 'nutrition'     
  not in abstract.lower():                                                                                              
              decision = "EXCLUDE"                                                                                      
              rationale = f"Study intervention is not diet, physical activity, or behavioral."                          
              confidence = "medium"                                                                                     
      # Check for non-treatment studies (prevention only)                                                               
      elif any(keyword in abstract.lower() for keyword in ['prevention', 'primary prevention']):                        
          if 'treatment' not in abstract.lower() and 'obese' not in abstract.lower() and 'overweight' not in            
  abstract.lower():                                                                                                     
              decision = "EXCLUDE"                                                                                      
              rationale = f"Study is a prevention study, not a treatment study."                                        
              confidence = "medium"                                                                                     
      else:                                                                                                             
          # Default to INCLUDE if it seems to meet criteria                                                             
          decision = "INCLUDE"                                                                                          
          rationale = f"Study appears to be an RCT of diet, physical activity, and/or behavioral interventions for      
  overweight/obese children aged 6-11 years with ≥6 months follow-up."                                                  
          confidence = "medium"                                                                                         
                                                                                                                        
      decisions.append({                                                                                                
