          decision = "INCLUDE"                                                                                          
          confidence = "low"                                                                                            
          rationale = f"Study requires further review but does not clearly violate exclusion criteria."                 
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(f"Total studies screened: {len(decisions)}")                                                                    
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
  print(json.dumps(result, indent=2)[:5000])                                                                            
