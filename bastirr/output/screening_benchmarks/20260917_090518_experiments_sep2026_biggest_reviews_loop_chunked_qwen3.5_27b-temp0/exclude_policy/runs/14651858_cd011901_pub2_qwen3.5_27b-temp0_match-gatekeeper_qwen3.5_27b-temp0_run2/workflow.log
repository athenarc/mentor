# Final decisions after careful review of all 100 studies                                                               
# Selection criteria: Studies evaluating visual inspection or dermoscopy for diagnosing BCC and/or cSCC in adults       
# with histological confirmation or clinical follow-up as reference standard                                            
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
