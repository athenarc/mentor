    if i in [12, 21, 31, 32, 36, 46, 53, 71, 72, 75, 87, 91, 95, 97]:                                                   
        decisions.append({"study_index": i, "decision": "INCLUDE"})                                                     
    else:                                                                                                               
        decisions.append({"study_index": i, "decision": "EXCLUDE"})                                                     
                                                                                                                        
# Output as JSON array string                                                                                           
json_output = json.dumps(decisions, indent=2)                                                                           
print(json_output)                                                                                                      
                                                                                                                        
# Summary statistics                                                                                                    
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
print(f"\nSummary: {n_included} included, {n_excluded} excluded, {len(decisions)} total")                               
                                                                                                                        
