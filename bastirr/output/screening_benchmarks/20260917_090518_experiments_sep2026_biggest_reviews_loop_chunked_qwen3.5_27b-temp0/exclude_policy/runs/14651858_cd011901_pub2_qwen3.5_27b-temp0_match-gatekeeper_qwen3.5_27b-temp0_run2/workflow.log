        confidence = "high"                                                                                             
                                                                                                                        
    # Study 97: Diagnostic accuracy for skin cancer - GP vs dermatologist                                               
    elif idx == 97:                                                                                                     
        decision = "INCLUDE"                                                                                            
        rationale = "Examines diagnostic accuracy for skin cancer including non-melanoma cancers comparing GP,          
dermatologist, and histopathologist."                                                                                   
        confidence = "medium"                                                                                           
                                                                                                                        
    # Studies that are clearly melanoma-focused                                                                         
    elif ('melanoma' in title_lower or 'melanocytic' in title_lower or                                                  
          'pigmented lesion' in title_lower or 'pigmented skin' in title_lower):                                        
        decision = "EXCLUDE"                                                                                            
        rationale = "Focuses on melanoma or pigmented lesions rather than keratinocyte cancers (BCC/cSCC)."             
        confidence = "high"                                                                                             
                                                                                                                        
    # Reviews, treatment studies, protocols                                                                             
    elif ('review' in title_lower or 'treatment' in title_lower or 'therapy' in title_lower or                          
          'protocol' in title_lower or 'trial' in title_lower or 'guideline' in title_lower):                           
        decision = "EXCLUDE"                                                                                            
        rationale = "Not a primary diagnostic accuracy study for BCC/cSCC."                                             
        confidence = "high"                                                                                             
                                                                                                                        
    # Methodological papers                                                                                             
    elif ('meta-analysis' in title_lower or 'method' in title_lower or 'performance' in title_lower):                   
        decision = "EXCLUDE"                                                                                            
        rationale = "Methodological paper not evaluating diagnostic accuracy for BCC/cSCC."                             
        confidence = "high"                                                                                             
                                                                                                                        
    # Case reports                                                                                                      
    elif 'case' in title_lower or 'report' in title_lower:                                                              
        decision = "EXCLUDE"                                                                                            
        rationale = "Case report does not provide diagnostic accuracy data."                                            
        confidence = "high"                                                                                             
                                                                                                                        
    # Unclear - default to conservative INCLUDE                                                                         
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not clearly evaluate visual inspection or dermoscopy for BCC/cSCC diagnosis with reference    
standard."                                                                                                              
        confidence = "medium"                                                                                           
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
result = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(result, indent=2))                                                                                     
                                                                                                                        
