# Build decisions list                                                                                                  
for idx, title, rationale, confidence in include_studies:                                                               
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": "INCLUDE",                                                                                          
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
for idx, title, rationale, confidence in exclude_studies:                                                               
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": "EXCLUDE",                                                                                          
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Sort by study_index                                                                                                   
decisions.sort(key=lambda x: x["study_index"])                                                                          
                                                                                                                        
# Count totals                                                                                                          
n_included = len(include_studies)                                                                                       
n_excluded = len(exclude_studies)                                                                                       
n_total = n_included + n_excluded                                                                                       
                                                                                                                        
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
