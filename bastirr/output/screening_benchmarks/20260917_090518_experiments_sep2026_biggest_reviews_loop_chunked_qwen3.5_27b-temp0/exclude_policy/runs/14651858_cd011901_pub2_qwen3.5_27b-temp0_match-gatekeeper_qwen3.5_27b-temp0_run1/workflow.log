      # 4. Risk factors / Epidemiology without diagnostic accuracy                                                      
      if "risk factor" in title.lower() or "incidence" in title.lower() or "epidemiology" in title.lower():             
          if "diagnostic accuracy" not in abstract and "sensitivity" not in abstract and "specificity" not in           
  abstract:                                                                                                             
              rationale = "Epidemiological or risk factor study, does not evaluate diagnostic accuracy of               
  inspection/dermoscopy."                                                                                               
              decisions.append({"study_index": idx, "title": title, "decision": decision, "rationale": rationale,       
  "confidence": confidence})                                                                                            
              continue                                                                                                  
                                                                                                                        
      # 5. Treatment studies                                                                                            
      if "treatment" in title.lower() or "therapy" in title.lower() or "surgery" in title.lower():                      
          if "diagnosis" not in abstract and "diagnostic" not in abstract:                                              
              rationale = "Treatment study, does not evaluate diagnostic accuracy."                                     
              decisions.append({"study_index": idx, "title": title, "decision": decision, "rationale": rationale,       
  "confidence": confidence})                                                                                            
              continue                                                                                                  
                                                                                                                        
      # 6. Check for Diagnostic Accuracy components                                                                     
      # Needs: Visual inspection OR Dermoscopy AND Reference Standard (Histology/Follow-up)                             
      has_inspection = "visual" in abstract or "clinical" in abstract or "naked eye" in abstract                        
      has_dermoscopy = "dermoscopy" in abstract or "dermatoscopy" in abstract or "epiluminescence" in abstract or       
  "surface microscopy" in abstract                                                                                      
      has_reference = "histology" in abstract or "histopathology" in abstract or "biopsy" in abstract or "follow-up"    
  in abstract                                                                                                           
                                                                                                                        
      if (has_inspection or has_dermoscopy) and has_reference:                                                          
          decision = "INCLUDE"                                                                                          
          if has_bcc or has_scc:                                                                                        
              rationale = "Evaluates visual inspection/dermoscopy for skin cancer diagnosis with histological           
  reference standard. Includes BCC/cSCC."                                                                               
          else:                                                                                                         
              # If it includes BCC/SCC implicitly or generally "skin cancer"                                            
              rationale = "Evaluates visual inspection/dermoscopy for skin cancer diagnosis with histological           
  reference standard."                                                                                                  
      else:                                                                                                             
          rationale = "Does not clearly evaluate diagnostic accuracy of visual inspection/dermoscopy against a          
  reference standard for BCC/cSCC."                                                                                     
                                                                                                                        
      decisions.append({"study_index": idx, "title": title, "decision": decision, "rationale": rationale,               
  "confidence": confidence})                                                                                            
                                                                                                                        
  # Count totals                                                                                                        
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
