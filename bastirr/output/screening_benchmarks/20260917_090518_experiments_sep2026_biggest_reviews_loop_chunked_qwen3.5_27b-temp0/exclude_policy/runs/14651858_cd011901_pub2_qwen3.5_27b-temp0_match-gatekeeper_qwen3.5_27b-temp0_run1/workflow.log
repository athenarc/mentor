  data = json.loads(studies_data)                                                                                       
  studies = data['studies']                                                                                             
                                                                                                                        
  # Now I'll analyze each study against the selection criteria                                                          
  # Selection criteria: Studies of any design that evaluated visual inspection or dermoscopy or both in adults with     
  lesions suspicious for skin cancer, compared with a reference standard of either histological confirmation or         
  clinical follow-up.                                                                                                   
  # IMPORTANT: The review is specifically about KERATINOCYTE SKIN CANCERS (BCC and cSCC), NOT MELANOMA                  
                                                                                                                        
  decisions = []                                                                                                        
                                                                                                                        
  for study in studies:                                                                                                 
      idx = study['study_index']                                                                                        
      title = study['title']                                                                                            
      abstract = study['abstract']                                                                                      
                                                                                                                        
      # Key exclusion criteria:                                                                                         
      # 1. Study focuses ONLY on melanoma (not BCC/cSCC)                                                                
      # 2. Study is a review/article not evaluating diagnostic accuracy                                                 
      # 3. Study doesn't have proper reference standard                                                                 
      # 4. Study is about treatment, not diagnosis                                                                      
                                                                                                                        
      decision = "EXCLUDE"                                                                                              
      rationale = ""                                                                                                    
      confidence = "high"                                                                                               
                                                                                                                        
      # Check for melanoma-only studies                                                                                 
      melanoma_keywords = ['melanoma', 'melanocytic', 'nevus', 'naevus', 'dysplastic nevus', 'dysplastic naevus']       
      bcc_scc_keywords = ['basal cell carcinoma', 'BCC', 'squamous cell carcinoma', 'SCC', 'cSCC', 'nonmelanoma',       
  'non-melanoma', 'keratinocyte']                                                                                       
                                                                                                                        
      has_melanoma_focus = any(kw.lower() in title.lower() or kw.lower() in abstract.lower() for kw in                  
  melanoma_keywords)                                                                                                    
      has_bcc_scc_focus = any(kw.lower() in title.lower() or kw.lower() in abstract.lower() for kw in                   
  bcc_scc_keywords)                                                                                                     
                                                                                                                        
      # Determine decision based on content                                                                             
      if 'review' in title.lower() or 'systematic review' in title.lower() or 'meta-analysis' in title.lower():         
          decision = "EXCLUDE"                                                                                          
          rationale = f"Study is a {title.split()[0].lower()} article, not a primary diagnostic accuracy study."        
          confidence = "high"                                                                                           
      elif 'treatment' in title.lower() or 'therapy' in title.lower() or 'intervention' in title.lower():               
          decision = "EXCLUDE"                                                                                          
          rationale = "Study focuses on treatment/intervention rather than diagnostic accuracy of visual inspection or  
  dermoscopy."                                                                                                          
          confidence = "high"                                                                                           
      elif 'protocol' in title.lower() or 'trial' in title.lower() and 'randomised' in title.lower():                   
          decision = "EXCLUDE"                                                                                          
          rationale = "Study is a trial protocol or intervention trial, not a diagnostic accuracy study."               
          confidence = "medium"                                                                                         
      elif has_melanoma_focus and not has_bcc_scc_focus:                                                                
          decision = "EXCLUDE"                                                                                          
          rationale = "Study focuses exclusively on melanoma/melanocytic lesions, not keratinocyte skin cancers         
  (BCC/cSCC)."                                                                                                          
          confidence = "high"                                                                                           
      elif has_bcc_scc_focus and ('dermoscopy' in title.lower() or 'dermatoscopy' in title.lower() or 'visual           
  inspection' in title.lower() or 'clinical' in title.lower()):                                                         
          decision = "INCLUDE"                                                                                          
          rationale = "Study evaluates dermoscopy/visual inspection for BCC/cSCC diagnosis with histological reference  
  standard."                                                                                                            
          confidence = "high"                                                                                           
      elif 'diagnostic accuracy' in abstract.lower() or 'sensitivity' in abstract.lower() or 'specificity' in           
  abstract.lower():                                                                                                     
          if has_bcc_scc_focus:                                                                                         
              decision = "INCLUDE"                                                                                      
              rationale = "Study evaluates diagnostic accuracy for BCC/cSCC with appropriate reference standard."       
              confidence = "high"                                                                                       
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Study does not focus on BCC/cSCC diagnosis."                                                 
              confidence = "medium"                                                                                     
      elif 'case report' in title.lower() or 'case series' in title.lower():                                            
          decision = "EXCLUDE"                                                                                          
          rationale = "Study is a case report/series, not suitable for diagnostic accuracy assessment."                 
          confidence = "high"                                                                                           
      else:                                                                                                             
          # Default to conservative inclusion if uncertain                                                              
          if has_bcc_scc_focus:                                                                                         
              decision = "INCLUDE"                                                                                      
              rationale = "Study may contain relevant data on BCC/cSCC diagnosis; requires full-text review."           
              confidence = "medium"                                                                                     
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = "Study does not appear to focus on BCC/cSCC diagnostic accuracy."                             
              confidence = "medium"                                                                                     
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count totals                                                                                                        
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  print(f"Total studies: {n_total}")                                                                                    
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
                                                                                                                        
  # Output the decisions                                                                                                
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
