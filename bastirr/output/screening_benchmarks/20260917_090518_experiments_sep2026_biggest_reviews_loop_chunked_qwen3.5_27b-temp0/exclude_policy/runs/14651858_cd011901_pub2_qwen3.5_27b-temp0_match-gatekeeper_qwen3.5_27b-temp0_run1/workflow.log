data = json.loads(studies_raw)                                                                                          
studies = data['studies']                                                                                               
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    title_lower = title.lower()                                                                                         
    abstract_lower = abstract.lower()                                                                                   
                                                                                                                        
    # Check for melanoma-only studies                                                                                   
    melanoma_only = ('melanoma' in title_lower or 'melanocytic' in title_lower or 'nevus' in title_lower or 'naevus' in 
title_lower) and \                                                                                                      
                    ('bcc' not in title_lower and 'basal cell' not in title_lower and 'squamous cell' not in title_lower
and 'scc' not in title_lower and 'nonmelanoma' not in title_lower and 'non-melanoma' not in title_lower)                
                                                                                                                        
    # Check for BCC/cSCC focus                                                                                          
    has_bcc_scc = ('bcc' in title_lower or 'basal cell' in title_lower or 'squamous cell' in title_lower or 'scc' in    
title_lower or 'nonmelanoma' in title_lower or 'non-melanoma' in title_lower)                                           
                                                                                                                        
    # Determine decision based on content                                                                               
    if 'review' in title_lower or 'systematic review' in title_lower or 'meta-analysis' in title_lower or '[review]' in 
title_lower:                                                                                                            
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study is a review article, not a primary diagnostic accuracy study."                              
        confidence = "high"                                                                                             
    elif 'treatment' in title_lower or 'therapy' in title_lower or 'randomised controlled trial' in title_lower or      
'randomized controlled trial' in title_lower:                                                                           
        decision = "EXCLUDE"                                                                                            
        rationale = "Study focuses on treatment/intervention rather than diagnostic accuracy of visual inspection or    
dermoscopy."                                                                                                            
        confidence = "high"                                                                                             
    elif 'protocol' in title_lower:                                                                                     
        decision = "EXCLUDE"                                                                                            
        rationale = "Study is a trial protocol, not a completed diagnostic accuracy study."                             
        confidence = "high"                                                                                             
    elif 'case report' in title_lower or 'two patients' in abstract_lower:                                              
        decision = "EXCLUDE"                                                                                            
        rationale = "Study is a case report/series, not suitable for diagnostic accuracy assessment."                   
        confidence = "high"                                                                                             
    elif 'urinary' in title_lower or 'uti' in title_lower:                                                              
        decision = "EXCLUDE"                                                                                            
        rationale = "Study is about urinary tract infection, not skin cancer."                                          
        confidence = "high"                                                                                             
    elif melanoma_only:                                                                                                 
        decision = "EXCLUDE"                                                                                            
        rationale = "Study focuses exclusively on melanoma/melanocytic lesions, not keratinocyte skin cancers           
(BCC/cSCC)."                                                                                                            
        confidence = "high"                                                                                             
    elif has_bcc_scc and ('dermoscopy' in title_lower or 'dermatoscopy' in title_lower or 'clinical' in title_lower or  
'diagnostic' in title_lower or 'accuracy' in title_lower):                                                              
        decision = "INCLUDE"                                                                                            
        rationale = "Study evaluates dermoscopy/visual inspection for BCC/cSCC diagnosis with histological reference    
standard."                                                                                                              
        confidence = "high"                                                                                             
    elif has_bcc_scc and ('diagnostic accuracy' in abstract_lower or 'sensitivity' in abstract_lower or 'specificity' in
abstract_lower):                                                                                                        
        decision = "INCLUDE"                                                                                            
        rationale = "Study evaluates diagnostic accuracy for BCC/cSCC with appropriate reference standard."             
        confidence = "high"                                                                                             
    elif 'skin cancer' in title_lower and ('dermoscopy' in title_lower or 'clinical' in title_lower or 'diagnostic' in  
title_lower):                                                                                                           
        decision = "INCLUDE"                                                                                            
        rationale = "Study may contain relevant data on skin cancer diagnosis; requires full-text review."              
        confidence = "medium"                                                                                           
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = "Study does not appear to focus on BCC/cSCC diagnostic accuracy."                                   
        confidence = "medium"                                                                                           
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Output the decisions                                                                                                  
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(output, indent=2))                                                                                     
                                                                                                                        
