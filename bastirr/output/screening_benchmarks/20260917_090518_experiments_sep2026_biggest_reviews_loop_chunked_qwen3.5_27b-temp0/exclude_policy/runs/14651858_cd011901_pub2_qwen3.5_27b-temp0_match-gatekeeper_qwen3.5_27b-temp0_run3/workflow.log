      study_index = study['study_index']                                                                                
      title = study['title']                                                                                            
      abstract = study['abstract']                                                                                      
                                                                                                                        
      # Default decision                                                                                                
      decision = "EXCLUDE"                                                                                              
      rationale = ""                                                                                                    
      confidence = "high"                                                                                               
                                                                                                                        
      # Check for Melanoma focus (Exclude)                                                                              
      if 'melanoma' in title.lower() or 'melanoma' in abstract.lower():                                                 
          # Check if it also includes BCC/cSCC data                                                                     
          if 'basal cell carcinoma' in abstract.lower() or 'squamous cell carcinoma' in abstract.lower() or 'bcc' in    
  abstract.lower() or 'scc' in abstract.lower():                                                                        
              # Check if it reports accuracy for BCC/cSCC                                                               
              if 'sensitivity' in abstract.lower() and ('bcc' in abstract.lower() or 'scc' in abstract.lower() or       
  'basal cell' in abstract.lower() or 'squamous cell' in abstract.lower()):                                             
                  decision = "INCLUDE"                                                                                  
                  rationale = f"Evaluates dermoscopy/visual inspection for BCC/cSCC with accuracy metrics."             
              else:                                                                                                     
                  decision = "EXCLUDE"                                                                                  
                  rationale = f"Focuses primarily on melanoma; BCC/cSCC data not sufficiently reported for accuracy."   
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = f"Focuses solely on melanoma."                                                                
      elif 'treatment' in title.lower() or 'treatment' in abstract.lower():                                             
          decision = "EXCLUDE"                                                                                          
          rationale = f"Focuses on treatment outcomes rather than diagnostic accuracy."                                 
      elif 'education' in title.lower() or 'training' in title.lower() or 'educational' in title.lower():               
          decision = "EXCLUDE"                                                                                          
          rationale = f"Focuses on education/training rather than diagnostic accuracy of the tool."                     
      elif 'review' in title.lower() or 'meta-analysis' in title.lower() or 'systematic' in title.lower():              
          decision = "EXCLUDE"                                                                                          
          rationale = f"Review article or meta-analysis."                                                               
      elif 'epidemiology' in title.lower() or 'incidence' in title.lower() or 'prevalence' in title.lower():            
          decision = "EXCLUDE"                                                                                          
          rationale = f"Epidemiological study, not diagnostic accuracy."                                                
      elif 'referral' in title.lower() and ('accuracy' in abstract.lower() or 'pick up' in abstract.lower()):           
          # Referral accuracy studies can be included if they evaluate diagnostic suspicion                             
          if 'bcc' in abstract.lower() or 'scc' in abstract.lower() or 'basal cell' in abstract.lower() or 'squamous    
  cell' in abstract.lower():                                                                                            
              decision = "INCLUDE"                                                                                      
              rationale = f"Evaluates diagnostic accuracy/referral accuracy for BCC/cSCC."                              
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = f"Referral study without specific BCC/cSCC accuracy data."                                    
      elif 'screening' in title.lower() or 'campaign' in title.lower():                                                 
          if 'bcc' in abstract.lower() or 'scc' in abstract.lower() or 'basal cell' in abstract.lower() or 'squamous    
  cell' in abstract.lower():                                                                                            
              decision = "INCLUDE"                                                                                      
              rationale = f"Screening study evaluating visual inspection for BCC/cSCC."                                 
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = f"Screening study without specific BCC/cSCC data."                                            
      elif 'dermoscopy' in title.lower() or 'dermatoscopy' in title.lower() or 'epiluminescence' in title.lower():      
          if 'bcc' in abstract.lower() or 'scc' in abstract.lower() or 'basal cell' in abstract.lower() or 'squamous    
  cell' in abstract.lower():                                                                                            
              if 'sensitivity' in abstract.lower() or 'specificity' in abstract.lower() or 'accuracy' in                
  abstract.lower():                                                                                                     
                  decision = "INCLUDE"                                                                                  
                  rationale = f"Evaluates dermoscopy for BCC/cSCC with accuracy metrics."                               
              else:                                                                                                     
                  decision = "EXCLUDE"                                                                                  
                  rationale = f"Dermoscopy study for BCC/cSCC but lacks accuracy metrics."                              
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = f"Dermoscopy study not focused on BCC/cSCC."                                                  
      elif 'visual' in title.lower() or 'clinical' in title.lower():                                                    
          if 'bcc' in abstract.lower() or 'scc' in abstract.lower() or 'basal cell' in abstract.lower() or 'squamous    
  cell' in abstract.lower():                                                                                            
              if 'sensitivity' in abstract.lower() or 'specificity' in abstract.lower() or 'accuracy' in                
  abstract.lower():                                                                                                     
                  decision = "INCLUDE"                                                                                  
                  rationale = f"Evaluates visual inspection for BCC/cSCC with accuracy metrics."                        
              else:                                                                                                     
                  decision = "EXCLUDE"                                                                                  
                  rationale = f"Visual inspection study for BCC/cSCC but lacks accuracy metrics."                       
          else:                                                                                                         
              decision = "EXCLUDE"                                                                                      
              rationale = f"Visual inspection study not focused on BCC/cSCC."                                           
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          rationale = f"Does not meet selection criteria (focus, population, or outcome)."                              
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": study_index,                                                                                   
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Calculate totals                                                                                                    
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
  n_total = len(decisions)                                                                                              
                                                                                                                        
  # Prepare final output                                                                                                
  output = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
