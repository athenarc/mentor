                rationale = f"Dermoscopy study for BCC/cSCC but lacks accuracy metrics."                                
        else:                                                                                                           
            decision = "EXCLUDE"                                                                                        
            rationale = f"Dermoscopy study not focused on BCC/cSCC."                                                    
    elif 'visual' in title.lower() or 'clinical' in title.lower():                                                      
        if 'bcc' in abstract.lower() or 'scc' in abstract.lower() or 'basal cell' in abstract.lower() or 'squamous cell'
in abstract.lower():                                                                                                    
            if 'sensitivity' in abstract.lower() or 'specificity' in abstract.lower() or 'accuracy' in abstract.lower():
                decision = "INCLUDE"                                                                                    
                rationale = f"Evaluates visual inspection for BCC/cSCC with accuracy metrics."                          
            else:                                                                                                       
                decision = "EXCLUDE"                                                                                    
                rationale = f"Visual inspection study for BCC/cSCC but lacks accuracy metrics."                         
        else:                                                                                                           
            decision = "EXCLUDE"                                                                                        
            rationale = f"Visual inspection study not focused on BCC/cSCC."                                             
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Does not meet selection criteria (focus, population, or outcome)."                                
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Calculate totals                                                                                                      
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
n_total = len(decisions)                                                                                                
                                                                                                                        
# Prepare final output                                                                                                  
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
