            decision = "EXCLUDE"                                                                                        
            rationale = f"Screening study without specific BCC/cSCC data."                                              
    elif 'dermoscopy' in title.lower() or 'dermatoscopy' in title.lower() or 'epiluminescence' in title.lower():        
        if 'bcc' in abstract.lower() or 'scc' in abstract.lower() or 'basal cell' in abstract.lower() or 'squamous cell'
in abstract.lower():                                                                                                    
            if 'sensitivity' in abstract.lower() or 'specificity' in abstract.lower() or 'accuracy' in abstract.lower():
                decision = "INCLUDE"                                                                                    
                rationale = f"Evaluates dermoscopy for BCC/cSCC with accuracy metrics."                                 
            else:                                                                                                       
