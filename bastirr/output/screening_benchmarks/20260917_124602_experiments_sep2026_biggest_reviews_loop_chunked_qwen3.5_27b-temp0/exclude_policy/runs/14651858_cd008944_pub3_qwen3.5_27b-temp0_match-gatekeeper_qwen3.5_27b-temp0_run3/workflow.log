<code>                                                                                                                  
import json                                                                                                             
                                                                                                                        
# Parse the chunk payload                                                                                               
chunk_data = json.loads(chunk_payload)                                                                                  
                                                                                                                        
# Selection criteria summary:                                                                                           
# - Population: Childhood cancer survivors (treated before age 21)                                                      
# - Intervention: Cisplatin, carboplatin, ifosfamide, radiation involving kidney region, nephrectomy, or combinations   
# - Outcome: Renal function ≥1 year after cessation of treatment                                                        
# - Study Design: All except case reports, case series, and studies with <20 participants                               
                                                                                                                        
studies = chunk_data['studies']                                                                                         
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Analyze each study against criteria                                                                               
    decision = None                                                                                                     
    rationale = ""                                                                                                      
    confidence = "medium"                                                                                               
                                                                                                                        
    # Check for review articles, guidelines, commentaries                                                               
    if any(keyword in title.lower() or keyword in abstract.lower()                                                      
            for keyword in ['review', 'guidelines', 'report from', 'synthesis', 'discussion']):                         
        decision = "EXCLUDE"                                                                                            
        rationale = f"Review article or guideline document, not original research reporting renal function outcomes."   
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for adult populations                                                                                       
    elif any(keyword in title.lower() or keyword in abstract.lower()                                                    
             for keyword in ['testicular', 'germ cell', 'adult', '58.6 years', 'average age 58']):                      
        decision = "EXCLUDE"                                                                                            
        rationale = f"Adult population, not childhood cancer survivors."                                                
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for small sample sizes (<20)                                                                                
    elif any(f"{n} patient" in abstract.lower() or f"{n} children" in abstract.lower()                                  
             for n in range(1, 20)):                                                                                    
        # Need to check if there's actually a count < 20                                                                
        import re                                                                                                       
        counts = re.findall(r'\b(\d+)\s+(?:patient|children|cases)\b', abstract.lower())                                
        if counts:                                                                                                      
            min_count = min(int(c) for c in counts)                                                                     
            if min_count < 20:                                                                                          
                decision = "EXCLUDE"                                                                                    
                rationale = f"Sample size less than 20 participants (n={min_count})."                                   
                confidence = "high"                                                                                     
                                                                                                                        
    # Check for case reports/case series                                                                                
    elif any(keyword in title.lower() or keyword in abstract.lower()                                                    
             for keyword in ["case report", "case series", "the patient described", "three of"]):                       
        decision = "EXCLUDE"                                                                                            
        rationale = "Case report or case series format."                                                                
        confidence = "high"                                                                                             
                                                                                                                        
    # Check for insufficient follow-up (<1 year post-treatment)                                                         
    elif "6 months" in abstract.lower() and "year" not in abstract.lower():                                             
        decision = "EXCLUDE"                                                                                            
        rationale = "Follow-up less than 1 year after treatment cessation."                                             
        confidence = "medium"                                                                                           
                                                                                                                        
    # Check if renal function is NOT the primary outcome                                                                
    elif not any(keyword in abstract.lower()                                                                            
                 for keyword in ['gfr', 'glomerular filtration', 'renal function', 'kidney function',                   
                                 'renal dysfunction', 'renal toxicity', 'nephrotoxicity',                               
                                 'creatinine', 'proteinuria', 'tubulopathy', 'eGFR']):                                  
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not report renal function as a primary outcome measure."                                      
        confidence = "medium"                                                                                           
                                                                                                                        
    # Check for acute toxicity only (not long-term)                                                                     
    elif "acute" in abstract.lower() and ("long-term" not in abstract.lower() and "chronic" not in abstract.lower()):   
        decision = "EXCLUDE"                                                                                            
        rationale = "Focuses on acute toxicity rather than long-term renal function ≥1 year post-treatment."            
        confidence = "medium"                                                                                           
                                                                                                                        
    # Check for mixed/non-cancer populations                                                                            
    elif any(keyword in abstract.lower()                                                                                
             for keyword in ['congenital', 'benign causes', 'non-oncological']):                                        
        decision = "EXCLUDE"                                                                                            
        rationale = "Mixed population including non-cancer cases."                                                      
        confidence = "medium"                                                                                           
                                                                                                                        
    # Default to INCLUDE if meets criteria                                                                              
    else:                                                                                                               
        decision = "INCLUDE"                                                                                            
        rationale = "Meets selection criteria: childhood cancer survivors with potentially nephrotoxic treatment,       
reporting renal function ≥1 year post-treatment, with adequate sample size."                                            
        confidence = "high"                                                                                             
                                                                                                                        
