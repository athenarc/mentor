  [{"study_index": 401, "title": "Children\'s toxicology from bench to bed － drug‐induced renal injury (2):            
  nephrotoxicity induced by cisplatin and ifosfamide in children", "abstract": "Cisplatin and carboplatin cause         
  dose-dependent renal dysfunction. Electrolyte abnormalities such as hypomagnesaemia and hypokalemia are commonly      
  reported adverse effects, in addition to increased serum creatinine and uremia. Cumulative dose, dehydration,         
  hypoalbuminemia, and concurrent use of nephrotoxic drugs have been suggested as risk factors for cisplatin            
