for idx in range(201, 301):                                                                                             
    decision_info = study_decisions[idx]                                                                                
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": titles.get(idx, f"Study {idx}"),                                                                       
        "decision": decision_info["decision"],                                                                          
        "rationale": decision_info["rationale"],                                                                        
        "confidence": "high" if "EXCLUDE" in decision_info["decision"] else "medium"                                    
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Output the full JSON                                                                                                  
result = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(result, indent=2))                                                                                     
                                                                                                                        
