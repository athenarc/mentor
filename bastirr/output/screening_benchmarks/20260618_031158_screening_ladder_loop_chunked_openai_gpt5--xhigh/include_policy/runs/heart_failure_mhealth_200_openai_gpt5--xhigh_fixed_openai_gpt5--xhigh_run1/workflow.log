      decision, rationale, confidence = decisions_map[idx]                                                              
      if decision == "INCLUDE":                                                                                         
          included_count += 1                                                                                           
      decisions_list.append({                                                                                           
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  output = {                                                                                                            
      "n_total": len(studies),                                                                                          
      "n_included": included_count,                                                                                     
      "n_excluded": len(studies) - included_count,                                                                      
      "decisions": decisions_list                                                                                       
  }                                                                                                                     
                                                                                                                        
  final_answer(json.dumps(output))                                                                                      
