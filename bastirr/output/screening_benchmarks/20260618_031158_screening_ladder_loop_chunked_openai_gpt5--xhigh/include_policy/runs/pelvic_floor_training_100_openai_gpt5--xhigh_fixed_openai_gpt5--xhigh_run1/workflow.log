  # Compute counts                                                                                                      
  n_total = len(studies)                                                                                                
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
                                                                                                                        
  # Prepare final structured result with additional context sections requested by manager                               
  result = {                                                                                                            
