# Build decisions list                                                                                                  
for idx in range(701, 801):                                                                                             
    if idx in include_studies:                                                                                          
        decisions.append({                                                                                              
            "study_index": idx,                                                                                         
            "title": include_studies[idx]["title"],                                                                     
            "decision": "INCLUDE",                                                                                      
            "rationale": include_studies[idx]["rationale"],                                                             
            "confidence": include_studies[idx]["confidence"]                                                            
        })                                                                                                              
    else:                                                                                                               
        decisions.append({                                                                                              
            "study_index": idx,                                                                                         
            "title": exclude_studies[idx]["title"],                                                                     
            "decision": "EXCLUDE",                                                                                      
            "rationale": exclude_studies[idx]["rationale"],                                                             
            "confidence": exclude_studies[idx]["confidence"]                                                            
        })                                                                                                              
                                                                                                                        
# Count totals                                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(output, indent=2))                                                                                     
                                                                                                                        
