<code>                                                                                                                  
import json                                                                                                             
                                                                                                                        
# Load the chunk data                                                                                                   
chunk_dict = json.loads(chunk_data)                                                                                     
studies = chunk_dict['studies']                                                                                         
selection_criteria = chunk_dict['selection_criteria']                                                                   
review_title = chunk_dict['title']                                                                                      
                                                                                                                        
# Prepare input for batch_screen_studies                                                                                
# The tool requires 'studies', 'title', and 'selection_criteria'                                                        
input_for_batch = {                                                                                                     
    "studies": studies,                                                                                                 
    "title": review_title,                                                                                              
    "selection_criteria": selection_criteria                                                                            
}                                                                                                                       
input_json_str = json.dumps(input_for_batch)                                                                            
                                                                                                                        
# Call the batch_screen_studies tool                                                                                    
formatted_batch = batch_screen_studies(candidates_json=input_json_str)                                                  
print("Formatted batch received.")                                                                                      
print(formatted_batch[:500]) # Print first 500 chars to confirm                                                         
                                                                                                                        
# Now process the studies to make decisions                                                                             
decisions = []                                                                                                          
n_included = 0                                                                                                          
n_excluded = 0                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study.get('abstract', '')                                                                                
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    confidence = "high"                                                                                                 
    rationale = ""                                                                                                      
                                                                                                                        
    # Check Index Tests: Urea Breath Test (13C/14C), Serology, Stool Antigen                                            
    # Check Reference Standard: Histopathology (H&E, special stains, IHC)                                               
    # Check Population: Suspected H. pylori                                                                             
                                                                                                                        
    title_lower = title.lower()                                                                                         
    abstract_lower = abstract.lower()                                                                                   
                                                                                                                        
    # Keywords for Index Tests                                                                                          
    has_ubt = any(term in title_lower or term in abstract_lower for term in ['urea breath test', 'ubt', 'c-13', 'c13',  
'c-14', 'c14', 'breath test'])                                                                                          
    has_serology = any(term in title_lower or term in abstract_lower for term in ['serology', 'serological', 'elisa',   
'igg', 'iga', 'igm', 'antibody', 'immunoblot'])                                                                         
    has_stool = any(term in title_lower or term in abstract_lower for term in ['stool antigen', 'hpsa', 'fecal antigen',
'faecal antigen'])                                                                                                      
                                                                                                                        
    has_index_test = has_ubt or has_serology or has_stool                                                               
                                                                                                                        
    # Keywords for Reference Standard (Histopathology)                                                                  
    has_histology = any(term in title_lower or term in abstract_lower for term in ['histology', 'histopathological',    
'biopsy', 'hematoxylin', 'eosin', 'h&e', 'giemsa', 'warthin-starry', 'immunohistochemical'])                            
                                                                                                                        
    # Keywords for Exclusion (Other tests as primary focus without index tests)                                         
    # e.g. PCR, String test, Urine test (unless comparing index tests too)                                              
    # We need to be careful: if they evaluate PCR but NOT index tests, exclude.                                         
    # If they evaluate Index Test vs Histology, include.                                                                
                                                                                                                        
    # Check if study is a review/meta-analysis/commentary                                                               
    is_review = any(term in title_lower or term in abstract_lower for term in ['meta-analysis', 'systematic review',    
'comment', 'letter', 'editorial', 'overview'])                                                                          
                                                                                                                        
    # Logic                                                                                                             
    if is_review:                                                                                                       
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study appears to be a review/meta-analysis/commentary rather than a primary diagnostic accuracy   
study."                                                                                                                 
        confidence = "high"                                                                                             
    elif not has_index_test:                                                                                            
        decision = "EXCLUDE"                                                                                            
        rationale = f"Study does not evaluate any of the specified index tests (Urea Breath Test, Serology, Stool       
Antigen)."                                                                                                              
        confidence = "high"                                                                                             
    elif not has_histology:                                                                                             
        # Check if reference is culture or RUT only                                                                     
        has_culture = 'culture' in abstract_lower                                                                       
        has_rut = 'rapid urease' in abstract_lower or 'clo-test' in abstract_lower                                      
        if has_culture or has_rut:                                                                                      
            decision = "EXCLUDE"                                                                                        
            rationale = f"Study uses culture or rapid urease test as reference standard instead of histopathology."     
            confidence = "medium"                                                                                       
        else:                                                                                                           
            decision = "EXCLUDE"                                                                                        
            rationale = f"Study does not appear to use histopathology as the reference standard."                       
            confidence = "medium"                                                                                       
    else:                                                                                                               
        # Potential Include                                                                                             
        # Check population: suspected H. pylori                                                                         
        # Most studies in this domain are on dyspeptic patients or similar, which fits "suspected".                     
        # Check if it's purely prevalence or treatment follow-up without accuracy metrics                               
        if 'prevalence' in title_lower and 'diagnostic accuracy' not in abstract_lower and 'sensitivity' not in         
abstract_lower and 'specificity' not in abstract_lower:                                                                 
             decision = "EXCLUDE"                                                                                       
             rationale = "Study focuses on prevalence rather than diagnostic accuracy."                                 
             confidence = "medium"                                                                                      
        else:                                                                                                           
            decision = "INCLUDE"                                                                                        
