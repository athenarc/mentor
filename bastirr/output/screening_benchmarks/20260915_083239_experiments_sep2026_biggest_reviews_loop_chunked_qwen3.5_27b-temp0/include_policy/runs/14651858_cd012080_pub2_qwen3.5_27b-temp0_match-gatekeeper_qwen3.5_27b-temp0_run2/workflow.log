    ]                                                                                                                   
    has_ref_std = any(re.search(p, text) for p in ref_std_patterns)                                                     
                                                                                                                        
    # Check for Diagnostic Accuracy Metrics                                                                             
    accuracy_patterns = [                                                                                               
        r'sensitiv', r'specific', r'accu', r'predictive value', r'kappa', r'roc'                                        
    ]                                                                                                                   
    has_accuracy = any(re.search(p, text) for p in accuracy_patterns)                                                   
                                                                                                                        
    # Specific Exclusions for non-index tests                                                                           
    non_index_tests = ['urine', 'saliva', 'breath ammonia', 'pcr', 'optical analyzer', 'spectroscopy', 'pet', 'imaging']
    # Note: Some studies might mention urine/saliva but focus on UBT/Serology. We need to be careful.                   
    # If the main focus is urine/saliva/PCR without UBT/Serology/Stool, exclude.                                        
    # If it compares UBT/Serology/Stool to others, include.                                                             
                                                                                                                        
    # Logic refinement:                                                                                                 
    # Must have Index Test AND Reference Standard AND Accuracy Metrics                                                  
    if not has_index_test:                                                                                              
        return "EXCLUDE", "No eligible index test (UBT, Serology, Stool Antigen) identified.", "medium"                 
                                                                                                                        
    if not has_ref_std:                                                                                                 
        return "EXCLUDE", "No eligible reference standard (Histology, Biopsy, Culture) identified.", "medium"           
                                                                                                                        
    if not has_accuracy:                                                                                                
        return "EXCLUDE", "No diagnostic accuracy metrics (Sensitivity/Specificity) reported.", "medium"                
                                                                                                                        
    # Additional check: Is the study purely about treatment efficacy?                                                   
    if 'eradication' in text and 'therapy' in text and not ('diagnos' in text or 'accuracy' in text or 'sensitiv' in    
text):                                                                                                                  
        # Might be a treatment trial. But many eradication studies also report diagnostic accuracy of follow-up tests.  
        # If it reports sensitivity/specificity of a test for confirming eradication, it's usually included.            
        # Our accuracy check above covers this.                                                                         
        pass                                                                                                            
                                                                                                                        
    # Check for specific non-H. pylori organisms                                                                        
    if 'campylobacter' in text and 'pylori' not in text:                                                                
        return "EXCLUDE", "Focuses on Campylobacter species other than H. pylori.", "high"                              
                                                                                                                        
    # Check for animal studies                                                                                          
    if 'rat' in text or 'mouse' in text or 'animal' in text:                                                            
        return "EXCLUDE", "Animal study.", "high"                                                                       
                                                                                                                        
    # Check for PCR-only studies (PCR is not an index test in criteria)                                                 
    # If PCR is the ONLY test mentioned and no UBT/Serology/Stool, exclude.                                             
    # But if PCR is compared to UBT/Serology/Stool, include.                                                            
    # Our index_test_patterns cover UBT/Serology/Stool. If has_index_test is True, we are good.                         
    # However, if the study is "PCR vs Histology", has_index_test might be False (unless PCR matches nothing).          
    # Let's check if PCR is the main focus without index tests.                                                         
    if 'pcr' in text and not has_index_test:                                                                            
        return "EXCLUDE", "PCR is not an eligible index test according to protocol.", "high"                            
                                                                                                                        
    # Check for Urine/Saliva tests as primary index (not eligible)                                                      
    # If the study evaluates Urine or Saliva test accuracy, it should be excluded unless it also evaluates              
UBT/Serology/Stool.                                                                                                     
    # If 'urine' or 'saliva' is prominent and no UBT/Serology/Stool, exclude.                                           
    # But 'serology' often involves serum. Urine/Saliva are distinct.                                                   
    # If the text says "Urine test" and "Serology" (meaning serum), it's mixed.                                         
    # Protocol says: "index tests (urea breath test..., serology and stool antigen test)".                              
    # Urine/Saliva are NOT in the list.                                                                                 
    # So if the study is primarily about Urine/Saliva, exclude.                                                         
    # If it compares Urine to Serum (Serology), and includes Serology, it might be included for the Serology part.      
    # But if the title is "Urine test...", it's likely focused on Urine.                                                
    if ('urine' in text or 'saliva' in text) and not ('serolog' in text or 'ubt' in text or 'stool' in text):           
         # If it mentions urine/saliva but NO serology/ubt/stool, exclude.                                              
         # If it mentions urine AND serology, it might be comparing them. Serology is eligible.                         
         pass                                                                                                           
                                                                                                                        
    # Specific case: Study 617 (Liver fibrosis) - caught by 'liver fibrosis' keyword.                                   
    # Study 624 (Stroke) - caught by 'stroke'.                                                                          
    # Study 625 (Campylobacter jejuni) - caught by 'campylobacter jejuni'.                                              
    # Study 632 (Review) - caught by 'review'.                                                                          
    # Study 639 (Fucoidans review) - Abstract talks about review.                                                       
