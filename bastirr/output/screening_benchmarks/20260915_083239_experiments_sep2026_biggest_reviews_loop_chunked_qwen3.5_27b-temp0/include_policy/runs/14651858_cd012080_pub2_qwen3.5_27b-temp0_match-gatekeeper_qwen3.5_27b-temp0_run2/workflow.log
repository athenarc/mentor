    # Study 682 (Maastricht Consensus) - caught by 'consensus'.                                                         
    # Study 687 (Accurate diagnosis... PCR) - Abstract discusses PCR.                                                   
                                                                                                                        
    # Let's allow the logic to run and catch these.                                                                     
                                                                                                                        
    return "INCLUDE", "Meets selection criteria: evaluates eligible index test(s) against reference standard with       
accuracy metrics.", "medium"                                                                                            
                                                                                                                        
# Process studies                                                                                                       
