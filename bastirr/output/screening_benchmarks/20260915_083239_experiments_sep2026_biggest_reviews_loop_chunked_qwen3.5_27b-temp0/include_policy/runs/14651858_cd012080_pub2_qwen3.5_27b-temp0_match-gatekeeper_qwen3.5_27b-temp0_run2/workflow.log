    print(f"Loaded {len(studies)} studies.")                                                                            
except Exception as e:                                                                                                  
    print(f"Error parsing chunk_data: {e}")                                                                             
    studies = []                                                                                                        
                                                                                                                        
# Step 3: Screen each study                                                                                             
decisions = []                                                                                                          
excluded_reasons = {}                                                                                                   
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title'].lower()                                                                                      
    abstract = study['abstract'].lower()                                                                                
    text = title + " " + abstract                                                                                       
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
                                                                                                                        
    # 1. Check for Reviews, Guidelines, Meta-analyses (Secondary Research)                                              
    if "guideline" in text:                                                                                             
        rationale = "Guideline document, not a primary diagnostic accuracy study."                                      
        decisions.append({"study_index": idx, "decision": "EXCLUDE", "rationale": rationale})                           
        continue                                                                                                        
    if "meta-analysis" in text or "systematic review" in text:                                                          
        rationale = "Meta-analysis or systematic review, not a primary diagnostic accuracy study."                      
        decisions.append({"study_index": idx, "decision": "EXCLUDE", "rationale": rationale})                           
        continue                                                                                                        
    if "review" in text and "article" in text:                                                                          
        rationale = "Review article, not a primary diagnostic accuracy study."                                          
        decisions.append({"study_index": idx, "decision": "EXCLUDE", "rationale": rationale})                           
        continue                                                                                                        
                                                                                                                        
    # 2. Check for Eligible Index Tests                                                                                 
    # UBT: urea breath test, 13c, 14c, breath test                                                                      
    # Serology: serology, elisa, igg, iga, antibody, serum                                                              
    # Stool: stool antigen, hpsa, fecal antigen                                                                         
    has_ubt = any(term in text for term in ["urea breath test", "13c", "14c", "breath test"])                           
    has_serology = any(term in text for term in ["serology", "serological", "elisa", "igg", "iga", "antibody", "serum"])
    has_stool = any(term in text for term in ["stool antigen", "hpsa", "fecal antigen"])                                
                                                                                                                        
    has_index = has_ubt or has_serology or has_stool                                                                    
                                                                                                                        
    if not has_index:                                                                                                   
        rationale = "Does not evaluate an eligible index test (UBT, serology, or stool antigen)."                       
        decisions.append({"study_index": idx, "decision": "EXCLUDE", "rationale": rationale})                           
        continue                                                                                                        
                                                                                                                        
    # 3. Check for Reference Standard (Histopathology)                                                                  
    # Must use histology/biopsy/stain as reference                                                                      
    has_histology = any(term in text for term in ["histology", "histopathological", "biopsy", "h&e", "hematoxylin",     
"giemsa", "warthin-starry", "immunohistochemical", "stain"])                                                            
                                                                                                                        
    # Check if reference is ONLY culture or another non-invasive test                                                   
    # If text mentions "gold standard" or "reference" and links it to culture only, exclude.                            
    # However, if histology is mentioned alongside culture, it's usually acceptable.                                    
    # Simple heuristic: If no histology keywords found, exclude.                                                        
                                                                                                                        
    if not has_histology:                                                                                               
        rationale = "Does not use histopathological examination as the reference standard."                             
        decisions.append({"study_index": idx, "decision": "EXCLUDE", "rationale": rationale})                           
        continue                                                                                                        
                                                                                                                        
    # 4. Check for Diagnostic Accuracy Focus                                                                            
    # Ensure it's not just a prevalence study or treatment study without accuracy evaluation                            
    # Look for accuracy metrics or comparison language                                                                  
    has_accuracy_terms = any(term in text for term in ["sensitivity", "specificity", "accuracy", "diagnostic",          
"predictive value", "likelihood ratio", "compared to", "versus"])                                                       
                                                                                                                        
    if not has_accuracy_terms:                                                                                          
        # Might be a prevalence study or case series                                                                    
        rationale = "Does not appear to evaluate diagnostic accuracy (no sensitivity/specificity/comparison to          
reference)."                                                                                                            
        decisions.append({"study_index": idx, "decision": "EXCLUDE", "rationale": rationale})                           
        continue                                                                                                        
                                                                                                                        
    # 5. Include                                                                                                        
    decision = "INCLUDE"                                                                                                
    tests = []                                                                                                          
    if has_ubt: tests.append("UBT")                                                                                     
    if has_serology: tests.append("Serology")                                                                           
    if has_stool: tests.append("Stool Antigen")                                                                         
    rationale = f"Evaluates {', '.join(tests)} against histopathological examination in suspected H. pylori patients."  
                                                                                                                        
    decisions.append({"study_index": idx, "decision": decision, "rationale": rationale})                                
                                                                                                                        
# Step 4: Summarize results                                                                                             
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
print(f"Screening Complete: Total={n_total}, Included={n_included}, Excluded={n_excluded}")                             
                                                                                                                        
# Prepare Final Answer Content                                                                                          
outcome_short = f"Screened {n_total} studies. {n_included} INCLUDED, {n_excluded} EXCLUDED."                            
outcome_detailed = json.dumps(decisions, indent=2)                                                                      
context = "Studies were screened based on the presence of eligible index tests (UBT, serology, stool antigen) evaluated 
against histopathological reference standards in suspected H. pylori populations. Secondary research (reviews,          
guidelines, meta-analyses) and studies lacking histology reference were excluded."                                      
                                                                                                                        
final_output = f"""### 1. Task outcome (short version):                                                                 
