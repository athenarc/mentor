    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {included_count}")                                                                                    
print(f"Excluded: {excluded_count}")                                                                                    
