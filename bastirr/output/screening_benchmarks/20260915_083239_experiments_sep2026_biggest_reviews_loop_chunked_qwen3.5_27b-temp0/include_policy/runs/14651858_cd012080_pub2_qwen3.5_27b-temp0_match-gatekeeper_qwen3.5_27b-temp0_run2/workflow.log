# Build decisions list                                                                                                  
for study_index, title, rationale, confidence in include_studies:                                                       
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": "INCLUDE",                                                                                          
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
for study_index, title, rationale, confidence in exclude_studies:                                                       
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": "EXCLUDE",                                                                                          
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Sort by study_index                                                                                                   
decisions.sort(key=lambda x: x["study_index"])                                                                          
                                                                                                                        
# Create final answer                                                                                                   
final_result = {                                                                                                        
    "n_total": 100,                                                                                                     
    "n_included": 55,                                                                                                   
    "n_excluded": 45,                                                                                                   
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
