    decision, rationale, confidence = evaluate_study(study)                                                             
                                                                                                                        
    if decision == "INCLUDE":                                                                                           
        included_count += 1                                                                                             
    else:                                                                                                               
        excluded_count += 1                                                                                             
                                                                                                                        
    decisions.append({                                                                                                  
