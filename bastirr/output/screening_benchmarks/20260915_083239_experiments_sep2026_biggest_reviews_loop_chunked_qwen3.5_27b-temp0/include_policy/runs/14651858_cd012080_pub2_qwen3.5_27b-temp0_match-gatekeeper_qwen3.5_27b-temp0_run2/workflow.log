    # Check for Index Tests (UBT, Serology, Stool Antigen)                                                              
    index_test_patterns = [                                                                                             
        r'urea breath test', r'ubt', r'13c', r'14c', r'serolog', r'elisa', r'antibod',                                  
        r'stool antigen', r'hpsa', r'fecal test', r'immunochromatograph'                                                
    ]                                                                                                                   
    has_index_test = any(re.search(p, text) for p in index_test_patterns)                                               
                                                                                                                        
