validation, systematic review, meta-analysis, cross-sectional study, narrative review, or guideline document)."         
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"Study {study_idx} does not meet one or more selection criteria - may lack appropriate population, 
intervention type, study design, or outcome measures required by the protocol."                                         
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_idx,                                                                                       
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Calculate totals                                                                                                      
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
# Create final answer structure                                                                                         
final_result = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
# Output the complete JSON                                                                                              
print(json.dumps(final_result, indent=2))                                                                               
                                                                                                                        
