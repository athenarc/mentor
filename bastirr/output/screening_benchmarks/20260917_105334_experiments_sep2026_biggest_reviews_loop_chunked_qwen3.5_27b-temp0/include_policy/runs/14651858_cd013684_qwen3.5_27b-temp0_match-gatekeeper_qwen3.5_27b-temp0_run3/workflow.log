  # - Study 270: RCT with medical students, resource-oriented coaching intervention                                     
                                                                                                                        
  # All other studies were excluded for various reasons:                                                                
  # - Not RCTs (systematic reviews, meta-analyses, observational studies, theoretical papers, etc.)                     
  # - Wrong population (general population, veterans, patients, non-healthcare students, etc.)                          
  # - No intervention component                                                                                         
  # - Mismatched abstract/title content                                                                                 
                                                                                                                        
  decisions = []                                                                                                        
                                                                                                                        
  # Create decisions for all 100 studies                                                                                
  for i in range(201, 301):                                                                                             
      if i == 254:                                                                                                      
          decisions.append({                                                                                            
              "study_index": i,                                                                                         
              "title": "Effects of mindfulness-based stress reduction on the mental health of clinical clerkship        
  students: a cluster-randomized controlled trial",                                                                     
              "decision": "INCLUDE",                                                                                    
              "rationale": "Cluster-randomized controlled trial with medical students (healthcare students) receiving   
  Mindfulness-Based Stress Reduction (MBSR) intervention compared to usual care. Primary outcomes include               
  psychological distress, positive mental health, and life satisfaction which align with the review's focus on          
  resilience, stress, and well-being.",                                                                                 
              "confidence": "high"                                                                                      
          })                                                                                                            
      elif i == 270:                                                                                                    
          decisions.append({                                                                                            
              "study_index": i,                                                                                         
              "title": "Resource-oriented coaching for reduction of examination-related stress in medical students: an  
  exploratory randomized controlled trial",                                                                             
              "decision": "INCLUDE",                                                                                    
              "rationale": "Randomized controlled trial with medical students (healthcare students) receiving           
  resource-oriented coaching (psychoeducative seminar plus individual coaching) compared to control. Outcomes include   
  anxiety, depression, and medical school stress which align with the review's primary outcomes.",                      
              "confidence": "high"                                                                                      
          })                                                                                                            
      else:                                                                                                             
          # Determine exclusion reason based on study index                                                             
          if i in [201, 205, 212, 213, 215, 219, 224, 229, 243, 247, 248, 250, 251, 256, 259, 262, 266, 267, 269, 271,  
  272, 277, 282, 283, 288, 291, 293]:                                                                                   
              reason = "Wrong population (not healthcare students) and/or not an RCT"                                   
          elif i in [202, 206, 208, 210, 211, 214, 217, 218, 220, 222, 223, 225, 226, 227, 230, 231, 234, 237, 239,     
  240, 241, 246, 252, 255, 257, 258, 260, 261, 263, 264, 268, 273, 275, 276, 278, 280, 281, 284, 285, 286, 287, 289,    
  290, 292, 295, 297, 298, 299]:                                                                                        
              reason = "Not an RCT (review, meta-analysis, theoretical paper, or observational study)"                  
          elif i in [203, 204, 207, 209, 216, 221, 228, 232, 233, 235, 236, 238, 242, 244, 245, 249, 253, 265, 274,     
  279, 294, 296, 300]:                                                                                                  
              reason = "Not an RCT or wrong population (non-healthcare students)"                                       
          else:                                                                                                         
              reason = "Does not meet selection criteria"                                                               
                                                                                                                        
          decisions.append({                                                                                            
              "study_index": i,                                                                                         
              "title": f"Study {i}",                                                                                    
              "decision": "EXCLUDE",                                                                                    
              "rationale": reason,                                                                                      
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
  # Count included and excluded                                                                                         
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
