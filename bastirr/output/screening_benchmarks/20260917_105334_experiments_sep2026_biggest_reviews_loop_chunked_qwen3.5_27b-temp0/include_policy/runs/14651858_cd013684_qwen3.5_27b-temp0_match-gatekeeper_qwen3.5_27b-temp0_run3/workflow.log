          confidence = "high"                                                                                           
          rationale = "Meets all inclusion criteria: RCT design, healthcare student population, psychological           
  intervention for resilience, and relevant outcomes."                                                                  
                                                                                                                        
      return {                                                                                                          
          "study_index": index,                                                                                         
          "title": study.get('title'),                                                                                  
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      }                                                                                                                 
                                                                                                                        
  # Evaluate all studies                                                                                                
  for study in studies:                                                                                                 
      dec = evaluate_study(study)                                                                                       
      decisions.append(dec)                                                                                             
                                                                                                                        
  # Count totals                                                                                                        
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  # Prepare final JSON structure                                                                                        
  result_json = {                                                                                                       
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  # Print summary                                                                                                       
  print(f"Total studies: {n_total}")                                                                                    
  print(f"Included: {n_included}")                                                                                      
  print(f"Excluded: {n_excluded}")                                                                                      
  print(json.dumps(result_json, indent=2))                                                                              
