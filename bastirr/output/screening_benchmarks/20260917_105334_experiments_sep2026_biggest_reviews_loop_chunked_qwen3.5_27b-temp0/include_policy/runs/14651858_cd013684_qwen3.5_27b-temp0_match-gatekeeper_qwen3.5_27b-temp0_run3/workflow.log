import json                                                                                                             
                                                                                                                        
# Parse the candidate_chunk JSON properly                                                                               
candidate_data = json.loads(candidate_chunk)                                                                            
                                                                                                                        
# Extract studies                                                                                                       
studies = candidate_data['studies']                                                                                     
                                                                                                                        
# Create decisions based on the selection criteria                                                                      
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    confidence = "high"                                                                                                 
    rationale = ""                                                                                                      
                                                                                                                        
    # Check if it's an RCT                                                                                              
    is_rct = any(term in abstract.lower() for term in ['randomized', 'randomised', 'random allocation', 'random         
assignment', 'randomly assigned', 'randomly allocated', 'randomized controlled trial', 'randomised controlled trial',   
'RCT', 'randomised wait list', 'randomised comparative'])                                                               
                                                                                                                        
    # Check if population is healthcare students                                                                        
    is_healthcare_student = any(term in abstract.lower() or term in title.lower() for term in [                         
        'medical student', 'nursing student', 'paramedic student', 'healthcare student',                                
        'health professional student', 'physical therapy student', 'allied health',                                     
        'psychology student', 'doctoral physical therapy', 'nursing education'                                          
    ])                                                                                                                  
                                                                                                                        
    # Check if intervention is psychological/resilience-focused                                                         
    is_psychological_intervention = any(term in abstract.lower() or term in title.lower() for term in [                 
        'resilience', 'hardiness', 'stress management', 'mindfulness', 'coping',                                        
        'psychological intervention', 'mental health', 'well-being', 'resiliency training',                             
        'stress reduction', 'yoga', 'meditation', 'cognitive', 'emotional', 'resilience training'                       
    ])                                                                                                                  
                                                                                                                        
    # Check if it's a review/meta-analysis                                                                              
    is_review = any(term in abstract.lower() or term in title.lower() for term in [                                     
        'systematic review', 'meta-analysis', 'literature review', 'scoping review',                                    
        'review of', 'critical review', 'review', 'meta-analytic'                                                       
    ])                                                                                                                  
                                                                                                                        
    # Check if it's a scale development/validation study                                                                
    is_scale_dev = any(term in abstract.lower() or term in title.lower() for term in [                                  
        'scale development', 'validation', 'psychometric', 'measure development',                                       
        'instrument development', 'questionnaire development', 'factor analysis',                                       
        'confirmatory factor analysis', 'exploratory factor analysis', 'translation'                                    
    ])                                                                                                                  
                                                                                                                        
    # Check if it's about non-student populations                                                                       
    is_non_student = any(term in abstract.lower() or term in title.lower() for term in [                                
        'veteran', 'older adult', 'patient', 'cancer', 'HIV', 'coronary', 'breast cancer',                              
        'spinal cord', 'earthquake', 'bereavement', 'divorce', 'maltreated', 'children',                                
        'child', 'employee', 'worker', 'manager', 'teacher', 'college student',                                         
        'graduate student', 'doctoral student', 'STEM', 'general population'                                            
    ])                                                                                                                  
                                                                                                                        
    # Make decision                                                                                                     
    if is_review or is_scale_dev:                                                                                       
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        if is_review:                                                                                                   
            rationale = "Study is a review/meta-analysis, not an RCT intervention study."                               
        else:                                                                                                           
            rationale = "Study is a scale development/validation study, not an intervention RCT."                       
    elif not is_rct:                                                                                                    
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = "Study is not a randomised controlled trial (RCT)."                                                 
    elif is_non_student and not is_healthcare_student:                                                                  
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = "Study population is not healthcare students (e.g., veterans, patients, general population,         
employees, teachers, STEM students)."                                                                                   
    elif not is_healthcare_student:                                                                                     
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = "Study population is not healthcare students."                                                      
    elif not is_psychological_intervention:                                                                             
        decision = "EXCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale = "Study does not appear to focus on psychological intervention for resilience/hardiness/stress."     
    else:                                                                                                               
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = "RCT of psychological intervention targeting resilience/stress in healthcare students."             
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count decisions                                                                                                       
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
# Create final output                                                                                                   
output = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(output))                                                                                               
                                                                                                                        
