          "study_index": idx,                                                                                           
          "title": study["title"],                                                                                      
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Count included/excluded                                                                                             
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(f"Total studies screened: {result['n_total']}")                                                                 
  print(f"Included: {result['n_included']}")                                                                            
  print(f"Excluded: {result['n_excluded']}")                                                                            
  print("\nIncluded studies:")                                                                                          
  for d in decisions:                                                                                                   
      if d["decision"] == "INCLUDE":                                                                                    
          print(f"  Study {d['study_index']}: {d['title']}")                                                            
