# Screening decisions based on selection criteria:                                                                      
# - Randomised controlled trials                                                                                        
# - Orally administered tricyclic drugs                                                                                 
# - Compared with placebo                                                                                               
# - In depressed people aged 6 to 18 years                                                                              
                                                                                                                        
decisions = [                                                                                                           
    {"study_index": 1, "title": "Pulse intravenous clomipramine for depressed adolescents: double‐blind, controlled     
trial", "decision": "EXCLUDE", "rationale": "Study uses intravenous (IV) administration of clomipramine, not oral       
administration as required by selection criteria.", "confidence": "high"},                                              
    {"study_index": 2, "title": "A double‐blind, randomized, placebo‐controlled trial of fluoxetine in children and     
adolescents with depression", "decision": "EXCLUDE", "rationale": "Study tests fluoxetine (an SSRI), not a tricyclic    
antidepressant. Drug class does not meet selection criteria.", "confidence": "high"},                                   
    {"study_index": 3, "title": "Double‐blind placebo‐controlled study of nortriptyline in depressed adolescents using a
\"fixed plasma level\" design", "decision": "INCLUDE", "rationale": "RCT comparing oral nortriptyline (tricyclic) vs    
placebo in adolescents aged 12-17 years with major depressive disorder. Meets all selection criteria.", "confidence":   
"high"},                                                                                                                
    {"study_index": 4, "title": "Childhood and adolescent depression: a review of the past 10 years. Part I",           
"decision": "EXCLUDE", "rationale": "This is a qualitative review article, not a randomised controlled trial. Study     
design does not meet selection criteria.", "confidence": "high"},                                                       
    {"study_index": 5, "title": "Imipramine treatment of depressed children: a double‐blind pilot study", "decision":   
"INCLUDE", "rationale": "Double-blind controlled trial comparing oral imipramine (tricyclic) vs placebo in depressed    
children. Meets selection criteria despite small sample size.", "confidence": "medium"},                                
    {"study_index": 6, "title": "Amitriptyline in children with major depressive disorder: a double‐blind crossover     
pilot study", "decision": "INCLUDE", "rationale": "Double-blind crossover RCT comparing oral amitriptyline (tricyclic)  
vs placebo in children aged 9-12 years with major depressive disorder. Meets all selection criteria.", "confidence":    
"high"},                                                                                                                
    {"study_index": 7, "title": "Newer generation antidepressants for depressive disorders in children and adolescents",
"decision": "EXCLUDE", "rationale": "This review focuses on newer generation antidepressants (SSRIs), not tricyclic     
drugs. Also appears to be a review rather than an RCT.", "confidence": "high"},                                         
    {"study_index": 8, "title": "Imipramine plus cognitive‐behavioural therapy in the treatment of school refusal",     
"decision": "INCLUDE", "rationale": "RCT comparing imipramine (tricyclic) vs placebo in adolescents with comorbid       
anxiety and depression. Both groups received CBT, but the drug comparison is valid. Ages appear to be adolescent        
range.", "confidence": "medium"},                                                                                       
    {"study_index": 9, "title": "Imipramine in prepubertal major depressive disorders", "decision": "INCLUDE",          
"rationale": "RCT comparing oral imipramine (tricyclic) vs placebo in prepubertal children with major depressive        
disorder. Meets all selection criteria.", "confidence": "high"},                                                        
    {"study_index": 10, "title": "Efficacy of paroxetine treatment in the treatment of adolescent depression: a         
randomized, controlled trial", "decision": "INCLUDE", "rationale": "RCT that includes an imipramine (tricyclic) vs      
placebo comparison arm in adolescents with major depression. The imipramine arm meets selection criteria.",             
"confidence": "high"},                                                                                                  
    {"study_index": 11, "title": "Mechanism of action of antidepressant medications", "decision": "EXCLUDE",            
"rationale": "This is a review/discussion paper about mechanism of action, not a randomised controlled trial. Study     
design does not meet selection criteria.", "confidence": "high"},                                                       
    {"study_index": 12, "title": "SSRI safety in overdose", "decision": "EXCLUDE", "rationale": "This is a review of    
overdose data, not an RCT of TCA efficacy for depression treatment. Study design and purpose do not meet selection      
criteria.", "confidence": "high"},                                                                                      
    {"study_index": 13, "title": "Measuring inconsistency in meta‐analyses", "decision": "EXCLUDE", "rationale": "This  
is a methodological paper about meta-analysis, not a clinical RCT. Study design does not meet selection criteria.",     
"confidence": "high"},                                                                                                  
    {"study_index": 14, "title": "Clinical, electrocardiographic, and laboratory findings in children with amitriptyline
intoxication", "decision": "EXCLUDE", "rationale": "This is an observational study of amitriptyline poisoning cases, not
an RCT of TCA efficacy for depression treatment. Population and study design do not meet selection criteria.",          
"confidence": "high"},                                                                                                  
    {"study_index": 15, "title": "The effect of concomitant disorders in childhood depression on predicting treatment   
response", "decision": "EXCLUDE", "rationale": "This appears to be an observational analysis of treatment response data 
rather than a standalone RCT comparing TCA vs placebo. Study design unclear for selection criteria.", "confidence":     
"medium"},                                                                                                              
    {"study_index": 16, "title": "Adolescent depression: controlled desipramine treatment and atypical features",       
"decision": "INCLUDE", "rationale": "RCT comparing oral desipramine (tricyclic) vs placebo in adolescents aged 13-18    
years with major depression. Meets all selection criteria.", "confidence": "high"},                                     
    {"study_index": 17, "title": "Psychopharmacology of child and adolescent major depression: present status and future
directions", "decision": "EXCLUDE", "rationale": "This is a review/discussion paper about psychopharmacology status and 
future directions, not a randomised controlled trial. Study design does not meet selection criteria.", "confidence":    
"high"},                                                                                                                
    {"study_index": 18, "title": "Comparative studies of pharmacotherapy for school refusal", "decision": "INCLUDE",    
"rationale": "Includes a double-blind, placebo-controlled study comparing imipramine (tricyclic) vs placebo. While the  
primary focus is school refusal, the RCT design with TCA vs placebo comparison meets criteria.", "confidence":          
"medium"},                                                                                                              
    {"study_index": 19, "title": "Selected tricyclic antidepressant ingestions involving children 6 years old or less", 
"decision": "EXCLUDE", "rationale": "This is an observational study of unintentional TCA poisonings, not an RCT of TCA  
efficacy for depression treatment. Population (6 years or less) and study purpose do not meet selection criteria.",     
"confidence": "high"},                                                                                                  
    {"study_index": 20, "title": "A randomized, controlled trial of amitriptyline in the acute treatment of adolescent  
major depression", "decision": "INCLUDE", "rationale": "RCT comparing oral amitriptyline (tricyclic) vs placebo in      
adolescents aged 12-17 years with major depressive disorder. Meets all selection criteria.", "confidence": "high"},     
    {"study_index": 21, "title": "School phobia: a therapeutic trial with clomipramine and short‐term outcome",         
"decision": "INCLUDE", "rationale": "Double-blind trial comparing oral clomipramine (tricyclic) vs placebo in children  
with school refusal (with depression mentioned as showing relief). Meets selection criteria with conservative           
interpretation.", "confidence": "medium"},                                                                              
    {"study_index": 22, "title": "Meta‐analysis of early phase II studies with paroxetine in hospitalised depressed     
patients", "decision": "EXCLUDE", "rationale": "Patients aged 18-65 years, which is outside the required age range of   
6-18 years. Population does not meet selection criteria.", "confidence": "high"},                                       
    {"study_index": 23, "title": "Depression in children: relationship between plasma imipramine levels and response",  
"decision": "EXCLUDE", "rationale": "This appears to be a pharmacokinetic/pharmacodynamic study examining plasma levels 
and response, not a clear placebo-controlled RCT. Study design unclear for selection criteria.", "confidence":          
"medium"},                                                                                                              
    {"study_index": 24, "title": "Randomized, controlled trial of amitriptyline versus placebo for adolescents with     
\"treatment‐resistant\" major depression", "decision": "INCLUDE", "rationale": "RCT comparing oral amitriptyline        
(tricyclic) vs placebo in adolescents with treatment-resistant major depressive disorder. Meets all selection           
criteria.", "confidence": "high"},                                                                                      
    {"study_index": 25, "title": "Imipramine compliance in adolescents", "decision": "INCLUDE", "rationale": "This is a 
sub-study/compliance analysis from an 8-week double-blind RCT comparing imipramine (tricyclic) vs placebo in            
adolescents. The underlying trial meets selection criteria.", "confidence": "medium"}                                   
]                                                                                                                       
                                                                                                                        
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(result, indent=2))                                                                                     
                                                                                                                        
