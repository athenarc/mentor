          # If we are uncertain, we might be conservative and include.                                                  
          if not has_proms_feedback:                                                                                    
              rationale = "Does not appear to involve PROMs feedback to healthcare professionals, patients, or both."   
              confidence = "medium"                                                                                     
          elif not has_control_no_feedback:                                                                             
              rationale = "Control group does not appear to be no feedback."                                            
              confidence = "medium"                                                                                     
          else:                                                                                                         
              # Check outcomes: patient-reported health outcomes or processes of care                                   
              has_patient_reported_outcome = False                                                                      
              if "patient-reported" in abstract.lower() or "patient reported" in abstract.lower():                      
                  has_patient_reported_outcome = True                                                                   
              # Also look for specific PROMS: quality of life, symptoms, etc.                                           
              # Processes of care: communication, referral, etc.                                                        
              if "processes of care" in abstract.lower() or "communication" in abstract.lower() or "referral" in        
  abstract.lower():                                                                                                     
                  has_patient_reported_outcome = True  # considering processes of care as acceptable                    
                                                                                                                        
              if not has_patient_reported_outcome:                                                                      
                  rationale = "Does not report patient-reported health outcomes or processes of care."                  
                  confidence = "medium"                                                                                 
              else:                                                                                                     
                  decision = "INCLUDE"                                                                                  
                  rationale = "Meets criteria: RCT with PROMs feedback to healthcare professionals, patients, or both   
  vs no feedback, reporting patient-reported health outcomes or processes of care."                                     
                  confidence = "high"                                                                                   
                                                                                                                        
      # If we are unsure and the rationale is not set, we default to include with low confidence.                       
      if decision == "EXCLUDE" and rationale == "":                                                                     
          rationale = "Unclear if meets criteria; being conservative, we include."                                      
          decision = "INCLUDE"                                                                                          
          confidence = "low"                                                                                            
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": index,                                                                                         
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Now, we have to output the final answer in the required format.                                                     
  # We need to return a JSON string with:                                                                               
  #   n_total: total number of studies in this chunk                                                                    
  #   n_included: number included                                                                                       
  #   n_excluded: number excluded                                                                                       
  #   decisions: list of decision objects                                                                               
                                                                                                                        
  n_total = len(studies)                                                                                                
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  # We must return a JSON string? The final_answer tool expects any type, but we can pass a string or a dict?           
  # The final_answer tool says: "Provides a final answer to the given problem." and takes an argument `answer` of any   
  type.                                                                                                                 
  # We can pass the dict, but the problem says to return a JSON string? Actually, the example outputs are strings or    
  numbers.                                                                                                              
  # However, the required output format is a JSON string. We can pass a JSON string to final_answer.                    
                                                                                                                        
  import json                                                                                                           
  final_answer_json = json.dumps(result)                                                                                
  final_answer(final_answer_json)                                                                                       
