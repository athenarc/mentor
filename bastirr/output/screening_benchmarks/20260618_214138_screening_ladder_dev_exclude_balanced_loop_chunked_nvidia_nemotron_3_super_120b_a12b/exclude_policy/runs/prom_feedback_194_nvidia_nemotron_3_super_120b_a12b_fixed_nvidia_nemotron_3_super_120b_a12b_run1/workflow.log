decisions = []                                                                                                          
                                                                                                                        
def assess_study(study):                                                                                                
    study_index = study.get('study_index')                                                                              
    title = study.get('title')                                                                                          
    abstract = study.get('abstract', '').lower()                                                                        
                                                                                                                        
    # Criteria flags                                                                                                    
    is_rct = False                                                                                                      
    has_proms_feedback = False                                                                                          
    has_no_feedback_control = False                                                                                     
    rationale_parts = []                                                                                                
                                                                                                                        
    # 1. Check for RCT design                                                                                           
    rct_indicators = ['randomized', 'randomised', 'randomly assigned', 'randomised controlled trial',                   
                     'randomized controlled trial', 'rct', 'cluster-randomized', 'cluster randomised',                  
                     'controlled trial']                                                                                
    if any(indicator in abstract for indicator in rct_indicators):                                                      
        is_rct = True                                                                                                   
        rationale_parts.append("Randomised trial design present")                                                       
    else:                                                                                                               
        rationale_parts.append("No clear randomised trial design")                                                      
                                                                                                                        
    # 2. Check for PROMs feedback intervention                                                                          
    # Need: patient-reported outcome measure + feedback of results to providers/patients                                
    prom_indicators = ['patient-reported outcome', 'patient reported outcome', 'prom', 'pro',                           
                      'questionnaire', 'instrument', 'scale', 'measure', 'assessment',                                  
                      'health-related quality of life', 'quality of life', 'symptom']                                   
                                                                                                                        
    feedback_indicators = ['feedback', 'disclosed', 'provided', 'given', 'informed',                                    
                          'results shared', 'information provided', 'notified', 'communicated']                         
                                                                                                                        
    # Check if study mentions both PROMs and feedback                                                                   
    has_prom_terms = any(indicator in abstract for indicator in prom_indicators)                                        
    has_feedback_terms = any(indicator in abstract for indicator in feedback_indicators)                                
                                                                                                                        
    if has_prom_terms and has_feedback_terms:                                                                           
        # Now check if feedback is specifically of PROM/PRO results                                                     
        # Look for patterns like: feedback of [results/scores], provided with [information], etc.                       
        feedback_patterns = ['feedback of', 'feedback on', 'provided with', 'informed of',                              
                           'notified of', 'results were', 'scores were', 'information was']                             
                                                                                                                        
        # Check if the feedback relates to patient-reported outcomes                                                    
        if any(pattern in abstract for pattern in feedback_patterns):                                                   
            # Additional check: see if it's clear this is feeding back PRO/PROM results                                 
            if ('feedback' in abstract and ('patient-reported' in abstract or 'outcome' in abstract or                  
                   'questionnaire' in abstract or 'scale' in abstract or 'prom' in abstract)) or \                      
               ('provided' in abstract and ('information' in abstract or 'results' in abstract)) or \                   
               ('informed' in abstract and ('about' in abstract or 'of' in abstract)):                                  
                has_proms_feedback = True                                                                               
                rationale_parts.append("Clear PROMs feedback intervention described")                                   
            else:                                                                                                       
                # Check if feedback is mentioned in context of sharing results                                          
                if ('feedback' in abstract and ('result' in abstract or 'score' in abstract or                          
                       'information' in abstract)) or \                                                                 
                   ('provided' in abstract and ('result' in abstract or 'information' in abstract)):                    
                    has_proms_feedback = True                                                                           
                    rationale_parts.append("Feedback of results/information described (likely PROMs)")                  
                else:                                                                                                   
                    rationale_parts.append("PROMs and feedback mentioned but unclear link")                             
        else:                                                                                                           
            # Feedback mentioned but not clearly linked to providing results                                            
            rationale_parts.append("Feedback mentioned but not clearly about providing results information")            
    elif has_prom_terms:                                                                                                
        rationale_parts.append("PROMs elements present but no clear feedback of results")                               
    else:                                                                                                               
        rationale_parts.append("No clear PROMs elements")                                                               
                                                                                                                        
    # 3. Check for no-feedback control group                                                                            
    control_indicators = ['control group', 'usual care', 'no feedback', 'blinded', 'not receiving',                     
                         'without feedback', 'standard care', 'treatment as usual', 'no intervention']                  
    if any(indicator in abstract for indicator in control_indicators):                                                  
        # Check if control truly lacks the PROMs feedback intervention                                                  
        exclusion_indicators = ['blinded', 'not receiving', 'without', 'usual care', 'no feedback',                     
                               'standard care', 'treatment as usual', 'control']                                        
        if any(excl in abstract for excl in exclusion_indicators):                                                      
            # Make sure it's not just usual care plus something else                                                    
            has_no_feedback_control = True                                                                              
            rationale_parts.append("No-feedback control group described")                                               
        else:                                                                                                           
            rationale_parts.append("Control group mentioned but may include active components")                         
    else:                                                                                                               
        rationale_parts.append("No clear no-feedback control group")                                                    
                                                                                                                        
    # Make decision - be conservative but stricter about PROMs feedback                                                 
    if is_rct and has_proms_feedback and has_no_feedback_control:                                                       
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
    elif is_rct and has_proms_feedback:                                                                                 
        # Missing clear control but strong RCT/PROMs feedback - be conservative                                         
        decision = "INCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale_parts.append("Included conservatively: RCT with clear PROMs feedback but control clarity needed")     
    elif is_rct and has_no_feedback_control:                                                                            
        # Missing clear PROMs feedback but has RCT and control - typically exclude unless strong implication            
        decision = "EXCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale_parts.append("Excluded: RCT with control but lacks clear PROMs feedback intervention")                
    else:                                                                                                               
        # Missing multiple key elements or weak on key elements                                                         
        decision = "EXCLUDE"                                                                                            
        # Determine confidence based on how many criteria are met                                                       
        criteria_met = sum([is_rct, bool(has_proms_feedback), bool(has_no_feedback_control)])                           
        if criteria_met == 0:                                                                                           
            confidence = "low"                                                                                          
        elif criteria_met == 1:                                                                                         
            confidence = "low"                                                                                          
        else:  # 2 criteria met                                                                                         
            confidence = "medium"                                                                                       
                                                                                                                        
    rationale = "; ".join(rationale_parts)                                                                              
                                                                                                                        
    return {                                                                                                            
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    }                                                                                                                   
                                                                                                                        
# Assess each study                                                                                                     
for study in studies:                                                                                                   
    decision = assess_study(study)                                                                                      
    decisions.append(decision)                                                                                          
    print(f"Study {decision['study_index']}: {decision['decision']} ({decision['confidence']} confidence)")             
    print(f"  {decision['rationale']}")                                                                                 
    print()                                                                                                             
                                                                                                                        
# Summary                                                                                                               
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
print(f"\nSUMMARY:")                                                                                                    
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Prepare final answer                                                                                                  
result = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
final_answer(result)                                                                                                    
                                                                                                                        
