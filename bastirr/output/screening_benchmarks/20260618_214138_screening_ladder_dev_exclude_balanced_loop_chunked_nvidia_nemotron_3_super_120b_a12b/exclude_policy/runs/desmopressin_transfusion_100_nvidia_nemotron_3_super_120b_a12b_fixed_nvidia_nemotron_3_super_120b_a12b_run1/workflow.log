    has_timing = any(k in text for k in timing_keywords)                                                                
                                                                                                                        
    # Check population: adults or children (no inherited bleeding disorders)                                            
    # Explicit exclusion if mentions inherited bleeding disorders (hemophilia, etc.)                                    
    excl_pop = ['hemophilia', 'inherited bleeding', 'congenital bleeding', 'von willebrand']                            
    has_excl_pop = any(k in text for k in excl_pop)                                                                     
                                                                                                                        
    # Additional: not a review/meta-analysis/letter unless it's an RCT (but we already have RCT check)                  
    excl_types = ['meta-analysis', 'systematic review', 'review', 'letter', 'comment', 'editorial', 'case report']      
    is_excl_type = any(k in text for k in excl_types)                                                                   
                                                                                                                        
    # Decision logic                                                                                                    
    if not is_rct:                                                                                                      
        return 'EXCLUDE', 'Not a randomized controlled trial.', 'high' if is_excl_type else 'medium'                    
    if not intervention:                                                                                                
        return 'EXCLUDE', 'Does not evaluate desmopressin/DDAVP as an intervention.', 'high'                            
    if not has_comparator:                                                                                              
