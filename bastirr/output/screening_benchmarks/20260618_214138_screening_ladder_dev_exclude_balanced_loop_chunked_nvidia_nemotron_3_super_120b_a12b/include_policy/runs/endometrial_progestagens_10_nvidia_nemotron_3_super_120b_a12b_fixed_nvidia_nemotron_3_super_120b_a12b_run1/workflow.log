      has_progestagen = any(term in text for term in ["progestagen", "progestin", "progesterone",                       
  "hydroxyprogesterone", "medroxyprogesterone"])                                                                        
      has_endometrial = any(term in text for term in ["endometrial cancer", "endometrial carcinoma"])                   
      has_surgery = any(term in text for term in ["surgery", "hysterectomy", "surgical", "postoperative", "after        
  surgery"])                                                                                                            
      pop_criteria = has_endometrial and has_surgery                                                                    
                                                                                                                        
      # Determine decision (conservative: include if uncertain)                                                         
      uncertain = not (is_rct and has_progestagen and pop_criteria)                                                     
      if uncertain or (is_rct and has_progestagen and pop_criteria):                                                    
          decision = "INCLUDE"                                                                                          
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
                                                                                                                        
      # Confidence                                                                                                      
      confidence = "high" if not uncertain else "medium"                                                                
                                                                                                                        
      # Rationale                                                                                                       
      rationale_parts = []                                                                                              
      rationale_parts.append("RCT: " + ("Yes" if is_rct else "No"))                                                     
      rationale_parts.append("Progestagen therapy: " + ("Yes" if has_progestagen else "No"))                            
      rationale_parts.append("Post-surgery endometrial cancer population: " + ("Yes" if pop_criteria else "No"))        
      if uncertain:                                                                                                     
          rationale_parts.append("Uncertainty noted; included conservatively.")                                         
      else:                                                                                                             
          rationale_parts.append("All criteria met." if decision == "INCLUDE" else "Criteria not met.")                 
      rationale = " ".join(rationale_parts)                                                                             
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  # Summary                                                                                                             
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  # Prepare final answer                                                                                                
  result = {                                                                                                            
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
  final_answer(json.dumps(result))                                                                                      
