bypass', 'CPB', 'cardiac surgery', 'total knee replacement',\n                    'hepatectomy', 'neurosurgery', 
'invasive procedure'\]\n    for term in timing_terms:\n        if term in abstract.lower():\n            timing_ok = 
True\n            break\n    if not timing_ok:\n        rationale_parts.append('Timing not appropriate')\n    # Check 
population\n    population_ok = False\n    if 'adult' in abstract.lower() or 'children' in abstract.lower() or 
'pediatric' in abstract.lower():\n        population_ok = True\n    elif 'patients' in abstract.lower() and ('adult' in 
abstract.lower() or 'child' in abstract.lower()):\n        population_ok = True\n    if not population_ok:\n        
rationale_parts.append('Population not adults/children')\n    # Decision\n    if is_rct and has_ddavp and has_comparator
and timing_ok and population_ok:\n        decision = 'INCLUDE'\n        rationale_parts = ['RCT', 'DDAVP intervention', 
'Comparator present', 'Appropriate timing', 'Adult/child population'\]\n        confidence = 'high'\n    else:\n        
# Be conservative: if uncertain, include\n        met = sum([is_rct, has_ddavp, has_comparator, timing_ok, 
population_ok\])\n        if met >= 2:\n            decision = 'INCLUDE'\n            confidence = 'medium'\n        
else:\n            decision = 'EXCLUDE'\n            confidence = 'high'\n    # Ensure rationale is a string\n    
rationale = '; '.join(rationale_parts)\n    decisions.append({\n        'study_index': idx,\n        'title': title,\n  
'decision': decision,\n        'rationale': rationale,\n        'confidence': confidence\n    })\n# Summary\nincluded = 
[d for d in decisions if d['decision'\] == 'INCLUDE']\nexcluded = [d for d in decisions if d['decision'\] == 
'EXCLUDE']\nprint('Total studies: {}'.format(len(decisions)))\nprint('Included: 
{}'.format(len(included)))\nprint('Excluded: {}'.format(len(excluded)))\n# Print all decisions for verification\nfor d 
in decisions:\n    print('Study {}: {} - {} ({})'.format(d['study_index'\], d['decision'\], d['rationale'\], 
d['confidence'\]))\n"
