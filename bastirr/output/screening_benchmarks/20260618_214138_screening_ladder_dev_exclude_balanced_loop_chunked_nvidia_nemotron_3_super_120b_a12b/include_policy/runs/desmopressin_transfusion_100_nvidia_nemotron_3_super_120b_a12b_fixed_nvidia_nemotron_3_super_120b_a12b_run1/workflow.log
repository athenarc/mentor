            # Might be a controlled trial but not explicitly randomized; be conservative and include                    
            pass                                                                                                        
        else:                                                                                                           
            return ('EXCLUDE', 'Not a randomized controlled trial (or insufficient evidence of randomization)', 'high') 
                                                                                                                        
    # If no DDAVP, exclude                                                                                              
    if not has_ddavp:                                                                                                   
        return ('EXCLUDE', 'Does not evaluate desmopressin (DDAVP)', 'high')                                            
                                                                                                                        
    # If no comparator, exclude                                                                                         
    if not has_comparator:                                                                                              
        return ('EXCLUDE', 'No comparison to placebo or active comparator (e.g., tranexamic acid, aprotinin)', 'high')  
                                                                                                                        
    # If no surgery/invasive procedure, exclude                                                                         
    if not has_surgery:                                                                                                 
        return ('EXCLUDE', 'Not evaluating surgery or invasive procedure', 'high')                                      
                                                                                                                        
    # If all criteria met, include                                                                                      
    return ('INCLUDE', 'Meets selection criteria: RCT comparing DDAVP to placebo/active comparator in surgical          
patients', 'high')                                                                                                      
                                                                                                                        
# Apply to each study                                                                                                   
decisions = []                                                                                                          
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    decision, rationale, confidence = decide_inclusion(study)                                                           
    decisions.append({                                                                                                  
        'study_index': idx,                                                                                             
        'title': title,                                                                                                 
        'decision': decision,                                                                                           
        'rationale': rationale,                                                                                         
        'confidence': confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Prepare final answer                                                                                                  
