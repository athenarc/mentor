    # Check if comparison to placebo or active comparator (tranexamic acid, aprotinin)                                  
    has_comparator = ('placebo' in abstract or 'tranexamic acid' in abstract or 'aprotinin' in abstract)                
                                                                                                                        
    # Check if surgery or invasive procedure                                                                            
    surgery_terms = ['surgery', 'surgical', 'operation', 'operative', 'arthroplasty',                                   
