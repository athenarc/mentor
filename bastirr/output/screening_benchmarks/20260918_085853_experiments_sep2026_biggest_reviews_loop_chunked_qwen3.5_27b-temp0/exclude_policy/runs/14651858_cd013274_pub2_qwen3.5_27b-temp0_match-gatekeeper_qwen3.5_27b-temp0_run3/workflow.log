    # Key indicators for inclusion                                                                                      
    has_consumer_involvement = any(term in title_lower or term in abstract_lower for term in [                          
        "consumer", "patient", "service user", "user involvement", "public involvement",                                
        "community participation", "partnership", "co-design", "co-production", "collaboration"                         
    ])                                                                                                                  
                                                                                                                        
    has_formal_group = any(term in title_lower or term in abstract_lower for term in [                                  
        "committee", "board", "steering group", "advisory", "council", "group", "team",                                 
        "network", "forum", "panel", "partnership group"                                                                
    ])                                                                                                                  
                                                                                                                        
    has_health_service_focus = any(term in title_lower or term in abstract_lower for term in [                          
        "health service", "health care", "mental health", "hospital", "clinical",                                       
        "primary care", "nursing", "health system", "healthcare"                                                        
    ])                                                                                                                  
                                                                                                                        
    has_qualitative = any(term in title_lower or term in abstract_lower for term in [                                   
        "qualitative", "interviews", "focus group", "thematic analysis", "grounded theory",                             
        "ethnographic", "case study", "phenomenological"                                                                
    ])                                                                                                                  
                                                                                                                        
    # Systematic reviews and methodology papers are excluded                                                            
    is_review_or_methodology = any(term in title_lower or term in abstract_lower for term in [                          
        "systematic review", "meta-analysis", "methodology", "methods for", "review identified",                        
        "GRADE-CERQual", "thematic synthesis", "evidence synthesis"                                                     
    ])                                                                                                                  
                                                                                                                        
    # Quantitative-only studies are excluded                                                                            
    is_quantitative_only = any(term in title_lower or term in abstract_lower for term in [                              
        "randomized trial", "cluster RCT", "quantitative", "survey of", "questionnaire"                                 
    ]) and not has_qualitative                                                                                          
                                                                                                                        
    # Make decision                                                                                                     
    if is_review_or_methodology:                                                                                        
        decision = "exclude"                                                                                            
        rationale = f"Systematic review or methodology paper, not primary qualitative research on partnership           
experiences."                                                                                                           
        confidence = "high"                                                                                             
    elif is_quantitative_only:                                                                                          
        decision = "exclude"                                                                                            
        rationale = f"Quantitative study without qualitative component exploring partnership experiences."              
        confidence = "high"                                                                                             
    elif has_consumer_involvement and has_formal_group and has_health_service_focus and has_qualitative:                
        decision = "include"                                                                                            
        rationale = f"Qualitative study exploring consumer/patient involvement in formal group partnerships for health  
services."                                                                                                              
        confidence = "high"                                                                                             
    elif has_consumer_involvement and has_health_service_focus and has_qualitative:                                     
        decision = "include"                                                                                            
        rationale = f"Qualitative study on consumer involvement in health services; may involve formal partnerships."   
        confidence = "medium"                                                                                           
    elif has_consumer_involvement and has_qualitative:                                                                  
        decision = "include"                                                                                            
        rationale = f"Qualitative study on consumer involvement; potential relevance to partnership approaches."        
        confidence = "low"                                                                                              
    else:                                                                                                               
        decision = "exclude"                                                                                            
        rationale = f"Does not meet selection criteria for qualitative studies on consumer-provider partnerships in     
health services."                                                                                                       
        confidence = "medium"                                                                                           
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "decision": decision,                                                                                           
        "rationale": rationale                                                                                          
    })                                                                                                                  
                                                                                                                        
# Count results                                                                                                         
n_included = sum(1 for d in decisions if d["decision"] == "include")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "exclude")                                                    
                                                                                                                        
print(f"\nScreening Results:")                                                                                          
print(f"Total studies: {len(decisions)}")                                                                               
print(f"Included: {n_included}")                                                                                        
