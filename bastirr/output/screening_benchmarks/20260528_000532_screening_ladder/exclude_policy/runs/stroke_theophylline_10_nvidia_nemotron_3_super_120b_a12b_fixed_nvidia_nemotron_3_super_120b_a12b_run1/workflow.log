n_included = sum(1 for d in decisions if d.get("decision", "").upper() == "INCLUDE")                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
# Prepare final answer JSON                                                                                             
final_output = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
print("Final decision JSON:")                                                                                           
print(json.dumps(final_output, indent=2))                                                                               
                                                                                                                        
