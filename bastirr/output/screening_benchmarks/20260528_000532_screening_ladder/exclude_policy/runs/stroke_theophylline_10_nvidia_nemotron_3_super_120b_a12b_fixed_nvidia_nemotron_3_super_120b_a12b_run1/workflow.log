  # Calculate totals                                                                                                    
  n_total = len(studies)                                                                                                
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  # Prepare final output                                                                                                
  final_output = {                                                                                                      
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
