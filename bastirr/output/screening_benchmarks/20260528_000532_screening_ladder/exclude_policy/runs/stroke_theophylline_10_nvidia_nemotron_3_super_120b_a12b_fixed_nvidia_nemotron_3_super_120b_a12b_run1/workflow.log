          confidence = "high"                                                                                           
      else:                                                                                                             
          # Build rationale for exclusion                                                                               
          if not is_randomised:                                                                                         
              rationale_parts.append("Not a randomised trial.")                                                         
          if not is_theophylline_analogue:                                                                              
