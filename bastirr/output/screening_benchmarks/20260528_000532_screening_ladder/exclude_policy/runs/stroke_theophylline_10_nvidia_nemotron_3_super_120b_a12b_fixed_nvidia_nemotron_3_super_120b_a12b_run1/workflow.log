def extract_json_array(text):                                                                                           
    # Find the first '[' and last ']' that encloses a valid JSON array                                                  
    start = text.find('[')                                                                                              
    if start == -1:                                                                                                     
        return None                                                                                                     
    # We'll try to find a matching ']' by counting brackets                                                             
    bracket_count = 0                                                                                                   
    for i in range(start, len(text)):                                                                                   
        char = text[i]                                                                                                  
        if char == '[':                                                                                                 
            bracket_count += 1                                                                                          
        elif char == ']':                                                                                               
            bracket_count -= 1                                                                                          
            if bracket_count == 0:                                                                                      
                # Found matching closing bracket                                                                        
                json_str = text[start:i+1]                                                                              
                try:                                                                                                    
                    data = json.loads(json_str)                                                                         
                    if isinstance(data, list):                                                                          
                        return data                                                                                     
                except json.JSONDecodeError:                                                                            
                    pass                                                                                                
                # If not valid, continue searching                                                                      
    return None                                                                                                         
                                                                                                                        
