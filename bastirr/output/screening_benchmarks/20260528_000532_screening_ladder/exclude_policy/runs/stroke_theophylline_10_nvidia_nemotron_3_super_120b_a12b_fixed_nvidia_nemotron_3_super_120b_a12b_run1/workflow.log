for study in studies:                                                                                                   
    idx = study.get("study_index")                                                                                      
    title = study.get("title", "")                                                                                      
    abstract = study.get("abstract", "")                                                                                
    # Call screen_study for this study                                                                                  
    result = screen_study(                                                                                              
        study_title=title,                                                                                              
        study_abstract=abstract,                                                                                        
        selection_criteria=selection_criteria,                                                                          
        study_index=idx                                                                                                 
    )                                                                                                                   
    print(f"Study {idx} result:")                                                                                       
    print(result)                                                                                                       
    print("\n---\n")                                                                                                    
    # The result is expected to be a JSON string; we will try to parse it.                                              
    # If parsing fails, we'll treat it as raw text and extract decision manually.                                       
    try:                                                                                                                
        decision_obj = json.loads(result)                                                                               
        # Expect keys: study_index, title, decision, rationale, confidence                                              
        # Ensure we have study_index from input; if not, use idx.                                                       
        decision_obj["study_index"] = decision_obj.get("study_index", idx)                                              
        decision_obj["title"] = decision_obj.get("title", title)                                                        
        decisions.append(decision_obj)                                                                                  
    except Exception as e:                                                                                              
        print(f"Failed to parse result for study {idx}: {e}")                                                           
        # Fallback: create a decision object with unknown decision                                                      
        decisions.append({                                                                                              
            "study_index": idx,                                                                                         
            "title": title,                                                                                             
            "decision": "UNCERTAIN",                                                                                    
            "rationale": f"Could not parse screen_study output: {result}",                                              
            "confidence": "low"                                                                                         
        })                                                                                                              
                                                                                                                        
# Compute totals                                                                                                        
