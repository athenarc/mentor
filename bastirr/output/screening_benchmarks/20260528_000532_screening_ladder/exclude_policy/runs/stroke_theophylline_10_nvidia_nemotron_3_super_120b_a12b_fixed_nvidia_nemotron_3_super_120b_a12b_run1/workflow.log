people with confirmed or presumed acute ischaemic stroke. Trials were included if treatment was started within one week 
of stroke onset."                                                                                                       
                                                                                                                        
# Function to screen a single study against criteria                                                                    
def screen_study_decision(study):                                                                                       
    idx = study.get("study_index")                                                                                      
    title = study.get("title", "")                                                                                      
    abstract = study.get("abstract", "")                                                                                
                                                                                                                        
    # Initialize decision components                                                                                    
    decision = "EXCLUDE"  # Default to exclude, be conservative but only include if criteria met                        
    rationale_parts = []                                                                                                
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check if it's a randomised trial                                                                                  
    is_randomised = False                                                                                               
    if "randomised" in abstract.lower() or "randomized" in abstract.lower() or "double-blind" in abstract.lower() or    
"controlled trial" in abstract.lower():                                                                                 
        is_randomised = True                                                                                            
                                                                                                                        
    # Check if it's about theophylline or an analogue (aminophylline, caffeine)                                         
    is_theophylline_analogue = False                                                                                    
    intervention_lower = (title + " " + abstract).lower()                                                               
    if any(drug in intervention_lower for drug in ["theophylline", "aminophylline", "caffeine"]):                       
        is_theophylline_analogue = True                                                                                 
                                                                                                                        
    # Check if it's placebo or control controlled                                                                       
    has_control = False                                                                                                 
    if "placebo" in intervention_lower or "control" in intervention_lower:                                              
        has_control = True                                                                                              
                                                                                                                        
    # Check if population is confirmed or presumed acute ischaemic stroke                                               
    is_acute_stroke_population = False                                                                                  
    if "acute ischemic stroke" in abstract.lower() or "acute cerebral infarction" in abstract.lower() or "acute         
ischaemic stroke" in abstract.lower():                                                                                  
        is_acute_stroke_population = True                                                                               
                                                                                                                        
    # Check if treatment started within one week of stroke onset                                                        
    within_one_week = False                                                                                             
    time_phrases = ["within 6 hours", "within 24 hours", "within 48 hours", "within 3 days", "within one week", "within 
7 days"]                                                                                                                
    for phrase in time_phrases:                                                                                         
        if phrase in abstract.lower():                                                                                  
            within_one_week = True                                                                                      
            break                                                                                                       
    # Also check for explicit mention of acute timing                                                                   
    if "acute" in abstract.lower() and ("hours" in abstract.lower() or "days" in abstract.lower()):                     
        # Might be within week but not guaranteed                                                                       
        pass                                                                                                            
                                                                                                                        
    # Apply criteria: ALL must be true for inclusion                                                                    
    if is_randomised and is_theophylline_analogue and has_control and is_acute_stroke_population and within_one_week:   
        decision = "INCLUDE"                                                                                            
        rationale_parts.append("Meets all criteria: randomised trial of theophylline/analogue vs placebo/control in     
acute ischemic stroke with treatment within one week.")                                                                 
        confidence = "high"                                                                                             
    else:                                                                                                               
        # Build rationale for exclusion                                                                                 
        if not is_randomised:                                                                                           
            rationale_parts.append("Not a randomised trial.")                                                           
        if not is_theophylline_analogue:                                                                                
            rationale_parts.append("Does not examine theophylline or an analogue compound.")                            
        if not has_control:                                                                                             
            rationale_parts.append("Lacks placebo or control comparison.")                                              
        if not is_acute_stroke_population:                                                                              
            rationale_parts.append("Population not confirmed or presumed acute ischaemic stroke.")                      
        if not within_one_week:                                                                                         
            rationale_parts.append("Treatment initiation time window not specified or not within one week of stroke     
onset.")                                                                                                                
        rationale = " ".join(rationale_parts)                                                                           
        confidence = "medium" if len(rationale_parts) > 1 else "high"                                                   
                                                                                                                        
    # If we couldn't determine clearly, be conservative and include with low confidence                                 
    if decision == "EXCLUDE" and not rationale_parts:                                                                   
        decision = "INCLUDE"                                                                                            
        rationale = "Insufficient detail to exclude definitively; conservatively included for further review."          
        confidence = "low"                                                                                              
    elif decision == "INCLUDE" and not rationale_parts:                                                                 
        rationale = "Meets all selection criteria based on available information."                                      
                                                                                                                        
    return {                                                                                                            
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale if 'rationale' in locals() else " ".join(rationale_parts),                               
        "confidence": confidence                                                                                        
    }                                                                                                                   
                                                                                                                        
# Process all studies                                                                                                   
decisions = []                                                                                                          
for study in studies:                                                                                                   
    dec = screen_study_decision(study)                                                                                  
    decisions.append(dec)                                                                                               
    print(f"Study {dec['study_index']}: {dec['decision']} - {dec['rationale']}")                                        
                                                                                                                        
# Calculate totals                                                                                                      
n_total = len(studies)                                                                                                  
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
# Prepare final output                                                                                                  
final_output = {                                                                                                        
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print("\nFinal screening results:")                                                                                     
print(json.dumps(final_output, indent=2))                                                                               
                                                                                                                        
