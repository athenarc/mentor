              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 33: Review article                                                                                        
      elif idx == 33:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is a review article discussing risk communication framing strategies, not a            
  randomised controlled trial. No primary data or intervention outcomes are reported.",                                 
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 34: Decision aid for bowel cancer screening - strong match                                                
      elif idx == 34:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "INCLUDE",                                                                                    
              "rationale": "This RCT tests a decision aid with quantitative risk information for bowel cancer           
  screening. It directly measures informed choice (adequate knowledge and consistency between attitudes and behavior)   
  as a main outcome, along with knowledge, attitudes, screening participation, and decisional conflict. This is a       
  strong match for all selection criteria.",                                                                            
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 35: Survey, not RCT                                                                                       
      elif idx == 35:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is a telephone survey examining how benefit framing affects screening decisions, not   
