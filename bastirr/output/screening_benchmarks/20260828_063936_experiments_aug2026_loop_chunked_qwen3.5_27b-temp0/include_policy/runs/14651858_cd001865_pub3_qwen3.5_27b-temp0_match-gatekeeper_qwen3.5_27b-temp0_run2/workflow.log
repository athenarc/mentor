              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 32: Individualized education but no informed decision measures                                            
      elif idx == 32:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This RCT tests individualized health education for cervical cancer screening. While it      
