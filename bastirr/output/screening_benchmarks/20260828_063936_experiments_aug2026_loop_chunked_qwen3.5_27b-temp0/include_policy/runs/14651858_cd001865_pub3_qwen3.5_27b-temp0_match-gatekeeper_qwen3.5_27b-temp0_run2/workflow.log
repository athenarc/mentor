          })                                                                                                            
                                                                                                                        
      # Study 23: RCT with tailored intervention but no informed decision measures                                      
      elif idx == 23:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "While this is an RCT with tailored interventions for colorectal cancer screening, it only   
  reports cost-effectiveness and screening uptake outcomes. There are no measures of informed decisions (knowledge,     
  risk perception accuracy, decisional conflict, or informed choice).",                                                 
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 24: RCT with tailored intervention but no informed decision measures                                      
      elif idx == 24:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This RCT tests a tailored computer intervention for mammography screening but only reports  
  screening uptake as the outcome. No measures of informed decisions are reported.",                                    
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 25: Risk perception study but not about screening decision                                                
      elif idx == 25:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This study examines women already attending a surveillance program, not individuals         
  deciding whether to undergo screening. The intervention focuses on improving risk perception after enrollment rather  
