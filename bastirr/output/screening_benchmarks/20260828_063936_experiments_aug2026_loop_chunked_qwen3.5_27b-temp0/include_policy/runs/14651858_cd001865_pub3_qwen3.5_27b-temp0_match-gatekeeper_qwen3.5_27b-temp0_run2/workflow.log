              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 31: Tailored messages but no informed decision measures                                                   
      elif idx == 31:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
