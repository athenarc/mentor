              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 36: Opinion piece                                                                                         
      elif idx == 36:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is an opinion piece/commentary calling for a shift in approach to cancer screening.    
  It is not a randomised controlled trial and reports no empirical data.",                                              
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 37: Tailored letters but no informed decision measures                                                    
      elif idx == 37:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This RCT tests tailored vs standardized mammography recommendation letters. While it        
  reports letter recall and mammography status, it does not report measures of informed decisions (knowledge, risk      
  perception accuracy, decisional conflict, or informed choice).",                                                      
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 38: Editorial                                                                                             
      elif idx == 38:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is an editorial discussing benefits and harms of mammography screening, not a          
  randomised controlled trial. No primary data or intervention outcomes are reported.",                                 
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 39: Systematic review                                                                                     
      elif idx == 39:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is a systematic review and meta-analysis of the emotional impact of screening, not a   
  primary randomised controlled trial. While it synthesizes RCT data, it is not itself an RCT.",                        
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 40: Literature review                                                                                     
      elif idx == 40:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is a literature review searching for systematic reviews on informed choice and         
  screening, not a randomised controlled trial. No primary data or intervention outcomes are reported.",                
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
  # Count included and excluded                                                                                         
  n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                  
  n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                  
                                                                                                                        
  result = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result, indent=2))                                                                                   
