      # Study 21: Cochrane Review Protocol - not an RCT                                                                 
      if idx == 21:                                                                                                     
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is a protocol for a Cochrane Review, not a primary randomised controlled trial. The    
  study describes objectives for a future systematic review rather than reporting original RCT data.",                  
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 22: Editorial/news article                                                                                
      elif idx == 22:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
