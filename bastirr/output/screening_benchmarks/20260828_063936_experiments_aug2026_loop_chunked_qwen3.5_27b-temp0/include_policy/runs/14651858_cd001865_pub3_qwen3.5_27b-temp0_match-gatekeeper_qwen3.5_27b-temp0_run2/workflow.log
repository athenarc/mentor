              "confidence": "medium"                                                                                    
          })                                                                                                            
                                                                                                                        
      # Study 26: Conceptual/theoretical paper                                                                          
      elif idx == 26:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "EXCLUDE",                                                                                    
              "rationale": "This is a conceptual/theoretical paper exploring risk communication strategies, not a       
  randomised controlled trial. No empirical data or intervention outcomes are reported.",                               
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 27: Decision aid for prenatal testing - borderline                                                        
      elif idx == 27:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "INCLUDE",                                                                                    
              "rationale": "This is an RCT testing a decision aid (Ottawa Personal Decision Guide) for prenatal         
  testing decisions. It measures decisional conflict (a measure of informed decision quality) and self-esteem. While    
  prenatal testing is diagnostic rather than traditional screening, it involves similar decision-making processes       
  about whether to undergo testing. Conservative approach suggests inclusion for full-text review.",                    
              "confidence": "medium"                                                                                    
          })                                                                                                            
                                                                                                                        
      # Study 28: Tailored print materials for BRCA testing                                                             
      elif idx == 28:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "INCLUDE",                                                                                    
              "rationale": "This RCT compares tailored vs non-tailored print materials for BRCA genetic testing. It     
  reports knowledge improvement and risk perception accuracy - both critical components of informed decision making.    
  The tailored materials constitute personalised risk communication. BRCA testing serves a screening function for       
  high-risk individuals.",                                                                                              
              "confidence": "high"                                                                                      
          })                                                                                                            
                                                                                                                        
      # Study 29: Social comparison risk feedback for CRC screening                                                     
      elif idx == 29:                                                                                                   
          decisions.append({                                                                                            
              "study_index": idx,                                                                                       
              "title": title,                                                                                           
              "decision": "INCLUDE",                                                                                    
              "rationale": "This RCT tests tailored CRC risk factor feedback with social comparison for colorectal      
  cancer screening. It reports cognitive outcomes (perceived risks, ambivalence) and behavioral outcomes (screening     
  intentions, FOBT completion) addressing the screening decision. While explicit informed decision measures are not     
