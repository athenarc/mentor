<code>                                                                                                                  
import json                                                                                                             
                                                                                                                        
# The chunk_data is already available as a variable from the task                                                       
# Let's parse it and process the studies                                                                                
                                                                                                                        
data = json.loads(chunk_data)                                                                                           
studies = data['studies']                                                                                               
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    study_index = study['study_index']                                                                                  
    title = study['title']                                                                                              
    abstract = study['abstract'].lower()                                                                                
                                                                                                                        
    # Check if it's an RCT                                                                                              
    rct_keywords = ['randomized', 'randomised', 'random', 'rct', 'trial', 'placebo-controlled', 'double-blind',         
'cross-over']                                                                                                           
    is_rct = any(keyword in abstract for keyword in rct_keywords)                                                       
                                                                                                                        
    # Check for specified antioxidant supplements                                                                       
    antioxidant_keywords = ['beta-carotene', 'beta carotene', 'vitamin a', 'vitamin c', 'vitamin e', 'selenium',        
                           'alpha-tocopherol', 'ascorbic acid', 'tocopherol', 'carotene', 'retinol']                    
    has_antioxidant = any(keyword in abstract for keyword in antioxidant_keywords)                                      
                                                                                                                        
    # Check for placebo or no intervention comparison                                                                   
    has_comparison = any(keyword in abstract for keyword in ['placebo', 'no intervention', 'control'])                  
                                                                                                                        
    # Determine decision based on selection criteria                                                                    
    if is_rct and has_antioxidant and has_comparison:                                                                   
        decision = "INCLUDE"                                                                                            
        confidence = "high"                                                                                             
        rationale = f"RCT comparing antioxidant supplement(s) versus placebo/control in adults."                        
    elif is_rct and has_antioxidant:                                                                                    
        decision = "INCLUDE"                                                                                            
        confidence = "medium"                                                                                           
        rationale = f"RCT with antioxidant supplement(s), comparison group details unclear from abstract."              
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        confidence = "high"                                                                                             
        if not is_rct:                                                                                                  
            rationale = "Not a randomised clinical trial."                                                              
        elif not has_antioxidant:                                                                                       
            rationale = "Does not involve specified antioxidant supplements (beta-carotene, vitamin A, vitamin C,       
vitamin E, selenium)."                                                                                                  
        else:                                                                                                           
            rationale = "Does not meet selection criteria."                                                             
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": study_index,                                                                                     
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count included and excluded                                                                                           
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
# Create output                                                                                                         
output = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
