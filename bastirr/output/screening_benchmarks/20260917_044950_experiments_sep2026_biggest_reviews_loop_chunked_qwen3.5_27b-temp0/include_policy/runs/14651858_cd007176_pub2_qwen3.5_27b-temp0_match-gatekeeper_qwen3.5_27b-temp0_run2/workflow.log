# Selection criteria from protocol:                                                                                     
# - Randomised clinical trials (RCTs)                                                                                   
# - Antioxidant supplements: beta-carotene, vitamin A, vitamin C, vitamin E, selenium                                   
# - Versus placebo or no intervention                                                                                   
# - Primary or secondary prevention                                                                                     
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for s in studies:                                                                                                       
    idx = s['study_index']                                                                                              
    title = s['title']                                                                                                  
    abstract = s['abstract'].lower()                                                                                    
                                                                                                                        
    # Check if it's an RCT                                                                                              
    is_rct = any(term in abstract for term in ['randomized', 'randomised', 'random allocation', 'randomly assigned'])   
                                                                                                                        
    # Check for specific antioxidants                                                                                   
    has_antioxidant = any(term in abstract.lower() for term in [                                                        
        'beta-carotene', 'beta carotene', 'vitamin c', 'ascorbic acid',                                                 
        'vitamin e', 'tocopherol', 'alpha-tocopherol', 'selenium', 'vitamin a', 'retinol'                               
    ])                                                                                                                  
                                                                                                                        
    # Check for placebo control                                                                                         
    has_placebo = any(term in abstract.lower() for term in ['placebo', 'no intervention'])                              
                                                                                                                        
    # Check for review/overview/meta-analysis (exclude these)                                                           
    is_review = any(term in abstract.lower() for term in [                                                              
        'review', 'meta-analysis', 'overview', 'this paper assesses critically',                                        
        'literature reporting', 'cumulative meta-analyses', 'trial sequential analysis'                                 
    ])                                                                                                                  
                                                                                                                        
    # Check for non-prevention contexts (treatment only, not prevention)                                                
    is_treatment_only = any(term in abstract.lower() for term in [                                                      
        'treatment of', 'therapy for', 'management of'                                                                  
    ]) and 'prevention' not in abstract.lower()                                                                         
                                                                                                                        
    # Decision logic                                                                                                    
    if is_review:                                                                                                       
        decision = "EXCLUDE"                                                                                            
        rationale = f"Review article or meta-analysis, not a primary RCT"                                               
    elif not is_rct:                                                                                                    
        decision = "EXCLUDE"                                                                                            
        rationale = f"Not a randomized controlled trial"                                                                
    elif not has_antioxidant:                                                                                           
        decision = "EXCLUDE"                                                                                            
        rationale = f"Does not test specified antioxidant supplements (beta-carotene, vitamin A, C, E, selenium)"       
    elif not has_placebo:                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Does not compare antioxidant to placebo or no intervention"                                       
    else:                                                                                                               
        decision = "INCLUDE"                                                                                            
        rationale = f"RCT of antioxidant supplement(s) vs placebo for prevention"                                       
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": "high" if is_rct and has_antioxidant and has_placebo else "medium"                                
    })                                                                                                                  
                                                                                                                        
# Count results                                                                                                         
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
print(f"Total screened: {len(decisions)}")                                                                              
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Print excluded studies for verification                                                                               
print("\n=== EXCLUDED STUDIES ===")                                                                                     
for d in decisions:                                                                                                     
