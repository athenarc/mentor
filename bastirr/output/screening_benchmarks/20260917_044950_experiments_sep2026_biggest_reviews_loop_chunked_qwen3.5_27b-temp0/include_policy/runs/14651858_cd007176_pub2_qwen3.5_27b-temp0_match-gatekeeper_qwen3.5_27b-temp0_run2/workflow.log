for study in data['studies']:                                                                                           
    idx = study['study_index']                                                                                          
    result = screening_results[idx]                                                                                     
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": study['title'],                                                                                        
        "decision": result['decision'],                                                                                 
        "rationale": result['rationale'],                                                                               
        "confidence": result['confidence']                                                                              
    })                                                                                                                  
                                                                                                                        
# Count totals                                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
