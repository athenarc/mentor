  'vitamin c', 'vitamin e'])                                                                                            
                                                                                                                        
      # Check Comparison                                                                                                
      has_comp = any(kw in abs_lower or kw in title_lower for kw in ['placebo', 'no intervention', 'control',           
  'untreated'])                                                                                                         
                                                                                                                        
      # Check if it's a review/meta-analysis/methods paper                                                              
      is_review = any(kw in abs_lower or kw in title_lower for kw in ['review', 'meta-analysis', 'systematic review',   
  'guidelines', 'prisma', 'methods for combining', 'literature searching', 'trial sequential analysis'])                
                                                                                                                        
      if is_review:                                                                                                     
          decision = "EXCLUDE"                                                                                          
          rationale = "Review, meta-analysis, or methodological paper, not a primary RCT."                              
          confidence = "high"                                                                                           
      elif is_rct and has_antiox and has_comp:                                                                          
          decision = "INCLUDE"                                                                                          
          rationale = "RCT evaluating specified antioxidant supplement(s) versus placebo/control."                      
          confidence = "high"                                                                                           
      elif is_rct and has_antiox:                                                                                       
          decision = "INCLUDE"                                                                                          
          rationale = "RCT with antioxidant supplement(s); comparison details unclear but likely eligible."             
          confidence = "medium"                                                                                         
      else:                                                                                                             
          decision = "EXCLUDE"                                                                                          
          if not is_rct:                                                                                                
              rationale = "Not a randomised clinical trial."                                                            
          elif not has_antiox:                                                                                          
              rationale = "Does not test specified antioxidant supplements (beta-carotene, vitamin A, C, E,             
  selenium)."                                                                                                           
          else:                                                                                                         
              rationale = "Does not meet selection criteria."                                                           
          confidence = "high"                                                                                           
                                                                                                                        
      decisions.append({                                                                                                
          "study_index": idx,                                                                                           
          "title": title,                                                                                               
          "decision": decision,                                                                                         
          "rationale": rationale,                                                                                       
          "confidence": confidence                                                                                      
      })                                                                                                                
                                                                                                                        
  n_inc = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                       
  n_exc = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                       
                                                                                                                        
  output = {                                                                                                            
      "n_total": len(decisions),                                                                                        
      "n_included": n_inc,                                                                                              
      "n_excluded": n_exc,                                                                                              
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(output, indent=2))                                                                                   
