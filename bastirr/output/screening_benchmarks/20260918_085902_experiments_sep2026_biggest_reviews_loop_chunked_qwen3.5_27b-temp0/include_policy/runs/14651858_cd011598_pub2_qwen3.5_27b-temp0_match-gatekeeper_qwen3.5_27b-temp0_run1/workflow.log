studies = data['studies']                                                                                               
selection_criteria = data['selection_criteria']                                                                         
review_title = data['title']                                                                                            
                                                                                                                        
# Initialize counters                                                                                                   
n_total = len(studies)                                                                                                  
n_included = 0                                                                                                          
n_excluded = 0                                                                                                          
decisions = []                                                                                                          
                                                                                                                        
# Screening Logic Function                                                                                              
def screen_study(study):                                                                                                
    index = study['study_index']                                                                                        
    title = study['title'].lower()                                                                                      
    abstract = study['abstract'].lower()                                                                                
    text = title + " " + abstract                                                                                       
                                                                                                                        
    # Check for RCT                                                                                                     
    is_rct = any(term in text for term in ['randomized', 'randomised', 'random allocation', 'randomly assigned',        
'randomly divided'])                                                                                                    
                                                                                                                        
    # Check for Hospitalised Adults                                                                                     
    # Exclude pediatric/neonatal                                                                                        
    is_pediatric = any(term in text for term in ['children', 'pediatric', 'neonatal', 'infant', 'adolescent', 'child',  
'school-age'])                                                                                                          
    # Look for hospital/inpatient context                                                                               
    is_hospitalised = any(term in text for term in ['hospital', 'inpatient', 'ward', 'admission', 'postoperative',      
'surgical', 'intensive care', 'icu', 'emergency department'])                                                           
    # Some studies might be outpatient but we need hospitalised.                                                        
    # If it mentions surgery/hospitalization, it counts.                                                                
                                                                                                                        
    # Check for Nutritional Risk                                                                                        
    # Keywords indicating risk/malnutrition                                                                             
    is_nutritional_risk = any(term in text for term in ['malnourished', 'nutritional risk', 'underweight',              
'malnutrition', 'cachexia', 'weight loss', 'at risk', 'poor nutritional status'])                                       
                                                                                                                        
    # Check for Nutrition Support Intervention                                                                          
    # Keywords for intervention                                                                                         
    has_nutrition_support = any(term in text for term in ['nutrition support', 'enteral nutrition', 'parenteral         
nutrition', 'oral nutritional supplement', 'tube feeding', 'hyperalimentation', 'dietary counseling', 'nutritional      
intervention', 'feeding'])                                                                                              
                                                                                                                        
    # Check for Control Group                                                                                           
    has_control = any(term in text for term in ['control', 'placebo', 'usual care', 'standard care', 'conventional', 'no
intervention', 'ad lib'])                                                                                               
                                                                                                                        
    # Decision Making                                                                                                   
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "medium"                                                                                               
                                                                                                                        
    # Primary Exclusion: Not RCT                                                                                        
    if not is_rct:                                                                                                      
        decision = "EXCLUDE"                                                                                            
        rationale = "Not a randomised clinical trial."                                                                  
        confidence = "high"                                                                                             
        return {"study_index": index, "title": study['title'], "decision": decision, "rationale": rationale,            
"confidence": confidence}                                                                                               
                                                                                                                        
    # Primary Exclusion: Pediatric                                                                                      
    if is_pediatric:                                                                                                    
        decision = "EXCLUDE"                                                                                            
        rationale = "Population is pediatric/neonatal, not hospitalised adults."                                        
        confidence = "high"                                                                                             
        return {"study_index": index, "title": study['title'], "decision": decision, "rationale": rationale,            
"confidence": confidence}                                                                                               
                                                                                                                        
    # Primary Inclusion: Must be hospitalised                                                                           
    # If no hospital context found, exclude                                                                             
    if not is_hospitalised:                                                                                             
        decision = "EXCLUDE"                                                                                            
        rationale = "Population does not appear to be hospitalised adults."                                             
        confidence = "medium"                                                                                           
        return {"study_index": index, "title": study['title'], "decision": decision, "rationale": rationale,            
"confidence": confidence}                                                                                               
                                                                                                                        
    # Primary Inclusion: Must be at nutritional risk                                                                    
    if not is_nutritional_risk:                                                                                         
        decision = "EXCLUDE"                                                                                            
        rationale = "Population does not appear to be at nutritional risk."                                             
        confidence = "medium"                                                                                           
        return {"study_index": index, "title": study['title'], "decision": decision, "rationale": rationale,            
"confidence": confidence}                                                                                               
                                                                                                                        
    # Primary Inclusion: Must compare nutrition support vs control                                                      
    if not has_nutrition_support or not has_control:                                                                    
        decision = "EXCLUDE"                                                                                            
        rationale = "Does not compare nutrition support versus control."                                                
        confidence = "medium"                                                                                           
        return {"study_index": index, "title": study['title'], "decision": decision, "rationale": rationale,            
"confidence": confidence}                                                                                               
                                                                                                                        
    # Check for non-standard nutrition support (Exclusion criterion)                                                    
    # This is harder to detect automatically. We look for specific exclusions like "non-standard", "experimental diet"  
not related to general support.                                                                                         
    # However, the criteria says "Exclude trials assessing non-standard nutrition support."                             
    # Most EN/TPN/ONS are standard. Specific immunonutrition or specialized formulas might be borderline.               
    # We will be conservative and INCLUDE unless clearly non-standard (e.g. specific drug-nutrient interaction not for  
nutrition).                                                                                                             
    # Looking at titles like "omega-3 fatty acid-supplemented enteral nutrition" -> This is often considered standard   
immunonutrition in surgical contexts, but could be non-standard.                                                        
    # Given the instruction "Be CONSERVATIVE: when in doubt, INCLUDE", we will lean towards INCLUDE for specialized     
nutrition unless it's clearly a drug trial.                                                                             
                                                                                                                        
    decision = "INCLUDE"                                                                                                
    rationale = "Randomised clinical trial comparing nutrition support versus control in hospitalised adults at         
nutritional risk."                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    return {"study_index": index, "title": study['title'], "decision": decision, "rationale": rationale, "confidence":  
confidence}                                                                                                             
                                                                                                                        
# Process all studies                                                                                                   
for study in studies:                                                                                                   
    result = screen_study(study)                                                                                        
    decisions.append(result)                                                                                            
    if result['decision'] == 'INCLUDE':                                                                                 
        n_included += 1                                                                                                 
    else:                                                                                                               
        n_excluded += 1                                                                                                 
                                                                                                                        
# Prepare final output structure                                                                                        
output = {                                                                                                              
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
# Print summary for verification                                                                                        
print(f"Total studies: {n_total}")                                                                                      
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(output, indent=2))                                                                                     
                                                                                                                        
