# Selection criteria:                                                                                                   
# "Studies evaluating tests of combining first and second trimester maternal serum markers in women up to 24 weeks of   
gestation for Down's syndrome, with or without first trimester ultrasound markers, compared with a reference standard,  
either chromosomal verification or macroscopic postnatal inspection."                                                   
# Key requirement: Must evaluate a test that combines 1st AND 2nd trimester maternal serum markers.                     
# Ultrasound is optional ("with or without first trimester ultrasound markers").                                        
# Studies evaluating only 1st trimester serum or only 2nd trimester serum are EXCLUDED.                                 
# Studies evaluating 1st trimester ultrasound + 2nd trimester serum (without 1st trimester serum) are EXCLUDED.         
                                                                                                                        
decisions = []                                                                                                          
                                                                                                                        
for study in chunk_data["studies"]:                                                                                     
    index = study["study_index"]                                                                                        
    title = study["title"]                                                                                              
    abstract = study["abstract"]                                                                                        
                                                                                                                        
    decision = "exclude"                                                                                                
    rationale = ""                                                                                                      
                                                                                                                        
    # Check for inclusion criteria                                                                                      
    # Must combine 1st and 2nd trimester serum markers.                                                                 
                                                                                                                        
    # Study 225: Costs and effects... mentions "first- and second-trimester combined test".                             
    if index == 225:                                                                                                    
        decision = "include"                                                                                            
        rationale = "Evaluates costs and effects of prenatal screening methods including the 'first- and                
second-trimester combined test', which combines serum markers from both trimesters."                                    
                                                                                                                        
    # Study 230: Repeated measurement of PAPP-A in 1st and 2nd trimester.                                               
    elif index == 230:                                                                                                  
        decision = "include"                                                                                            
        rationale = "Evaluates repeated measurement of PAPP-A in both first- and second-trimester serum samples,        
combining serum markers from both trimesters."                                                                          
                                                                                                                        
    # Study 244: Impact of smoking on 1st and 2nd trimester markers... mentions "integrated tests".                     
    elif index == 244:                                                                                                  
        decision = "include"                                                                                            
        rationale = "Examines the impact of smoking on first and second trimester screening markers, including          
integrated tests which combine serum markers from both trimesters."                                                     
                                                                                                                        
    # Study 248: Temporal variation in biochemical markers across 1st and 2nd trimesters.                               
    elif index == 248:                                                                                                  
        decision = "include"                                                                                            
        rationale = "Assesses the impact of temporal variation in biochemical markers across the first and second       
trimesters on risk estimation, evaluating algorithms using markers from both trimesters."                               
                                                                                                                        
    # Study 273: Combined first- and second-trimester screening... proMBP.                                              
    elif index == 273:                                                                                                  
        decision = "include"                                                                                            
        rationale = "Evaluates screening performance of different combinations of first- and second-trimester markers,  
including integrated tests."                                                                                            
                                                                                                                        
    # Study 288: Combining first and second trimester markers... integrated and serum integrated.                       
    elif index == 288:                                                                                                  
        decision = "include"                                                                                            
        rationale = "Compares different screening strategies including integrated and serum integrated screening, which 
combine serum markers from both trimesters."                                                                            
                                                                                                                        
    # Study 292: Second and first trimester estimation of risk... integrated test.                                      
    elif index == 292:                                                                                                  
        decision = "include"                                                                                            
        rationale = "Evaluates implementation and performance of integrated screening protocols (five- and six-marker)  
which combine first and second trimester serum markers."                                                                
                                                                                                                        
    # All others are excluded based on strict criteria (only 1st trimester, only 2nd trimester, or 1st ultrasound + 2nd 
serum without 1st serum).                                                                                               
    else:                                                                                                               
        if index == 280:                                                                                                
            rationale = "Evaluates sequential screening using nuchal translucency (1st trimester ultrasound) and triple 
test (2nd trimester serum). Does not combine 1st and 2nd trimester serum markers."                                      
        elif index == 203:                                                                                              
            rationale = "Evaluates combined screening (NT + serum), likely 1st trimester combined test. Does not        
explicitly combine 1st and 2nd trimester serum markers."                                                                
        elif index == 218:                                                                                              
            rationale = "Evaluates 1st trimester combined screening (NT + PAPP-A + free beta-hCG). Does not combine 1st 
and 2nd trimester serum markers."                                                                                       
        elif index == 293:                                                                                              
            rationale = "Evaluates 1st trimester risk evaluation (NT + PAPP-A + free beta HCG). Does not combine 1st and
2nd trimester serum markers."                                                                                           
        elif index == 297:                                                                                              
            rationale = "Simulation study of genetic sonography after 1st trimester screening. Uses 1st trimester serum 
+ NT and 2nd trimester ultrasound. Does not combine 1st and 2nd trimester serum markers."                               
        else:                                                                                                           
            rationale = "Study evaluates screening using only first trimester serum markers, only second trimester serum
markers, or ultrasound markers without combining serum markers from both trimesters."                                   
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": index,                                                                                           
        "decision": decision,                                                                                           
        "rationale": rationale                                                                                          
    })                                                                                                                  
                                                                                                                        
# Output the decisions                                                                                                  
print(json.dumps(decisions, indent=2))                                                                                  
                                                                                                                        
