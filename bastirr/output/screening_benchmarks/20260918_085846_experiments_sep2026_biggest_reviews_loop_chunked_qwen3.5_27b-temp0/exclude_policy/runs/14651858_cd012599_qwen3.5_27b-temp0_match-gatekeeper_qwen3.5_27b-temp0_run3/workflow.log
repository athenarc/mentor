              })                                                                                                        
          elif i == 93:                                                                                                 
              decisions.append({                                                                                        
                  "study_index": i,                                                                                     
                  "decision": "include",                                                                                
                  "rationale": "NTplus method combines early PAPP-A (9-10 weeks, first trimester) with NT (11-13        
