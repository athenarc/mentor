              })                                                                                                        
          elif i == 77:                                                                                                 
              decisions.append({                                                                                        
                  "study_index": i,                                                                                     
                  "decision": "include",                                                                                
                  "rationale": "Serial first and second trimester screening tests evaluating both first trimester (NT,  
  free β-HCG, PAPP-A) and second trimester (AFP, intact HCG, uE3) markers"                                              
              })                                                                                                        
          elif i == 83:                                                                                                 
              decisions.append({                                                                                        
                  "study_index": i,                                                                                     
                  "decision": "include",                                                                                
                  "rationale": "Integrated screening combines first trimester (NT, free β-hCG, PAPP-A) with second      
