    has_provider = any(term in abstract for term in provider_terms)                                                     
    has_patient = any(term in abstract for term in patient_terms)                                                       
                                                                                                                        
    # Decision logic                                                                                                    
    if not is_randomised:                                                                                               
        return 'exclude', 'Not a randomized trial'                                                                      
    if not is_diabetes:                                                                                                 
        return 'exclude', 'Not focused on diabetes population'                                                          
    if not is_outpatient:                                                                                               
        return 'exclude', 'Not in outpatient setting'                                                                   
                                                                                                                        
    # Need at least one system or provider strategy, OR patient strategy with system/provider                           
    if has_system or has_provider:                                                                                      
        return 'include', 'Meets QI strategy criteria'                                                                  
    elif has_patient and (has_system or has_provider):                                                                  
