# Define exclusion criteria based on selection criteria                                                                 
# Exclude:                                                                                                              
# - Not RCTs (systematic reviews, qualitative reviews)                                                                  
# - Not primarily diabetes population                                                                                   
# - Patient-targeted only without provider/system component                                                             
# - Not outpatient settings                                                                                             
# - Economic evaluations only                                                                                           
                                                                                                                        
excluded_indices = {                                                                                                    
    103,  # Population not primarily diabetes (hypertensive men with various risk factors)                              
    114,  # Economic evaluation only                                                                                    
    122,  # Cochrane Review                                                                                             
    126,  # Cochrane Review                                                                                             
    128,  # Patient-targeted only (web-based intervention without provider component)                                   
    131,  # Patient-targeted only (Islamic care method education)                                                       
    132,  # Patient-targeted only (self-tracking)                                                                       
    156,  # Patient-targeted only (pedometer/group intervention)                                                        
    157,  # Not a diabetes trial (contacting authors)                                                                   
    169,  # Patient-targeted only (peer education vs professional)                                                      
    179,  # Cochrane Review                                                                                             
    180,  # Cochrane Review                                                                                             
    184,  # Patient-targeted only (mailings/patient activation)                                                         
    190,  # Patient-targeted only (lifestyle education)                                                                 
    192,  # Patient-targeted only (multimedia education)                                                                
    193,  # Patient-targeted only (group vs individual education)                                                       
    194,  # Qualitative systematic review                                                                               
    199   # Patient-targeted only (lay peer led)                                                                        
}                                                                                                                       
                                                                                                                        
decisions = []                                                                                                          
n_included = 0                                                                                                          
n_excluded = 0                                                                                                          
                                                                                                                        
for study in chunk_data['studies']:                                                                                     
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
                                                                                                                        
    if idx in excluded_indices:                                                                                         
        decision = "exclude"                                                                                            
        n_excluded += 1                                                                                                 
        if idx == 103:                                                                                                  
            rationale = "Population not primarily diabetes (hypertensive men with various risk factors including        
diabetes as one criterion)"                                                                                             
        elif idx in [122, 126, 179, 180]:                                                                               
            rationale = "Cochrane Review - not a primary RCT"                                                           
        elif idx == 114:                                                                                                
            rationale = "Economic evaluation only, not primary effectiveness trial"                                     
        elif idx == 157:                                                                                                
            rationale = "Not a diabetes trial - study about contacting authors for systematic review"                   
        elif idx == 194:                                                                                                
            rationale = "Qualitative systematic review - not an RCT"                                                    
        else:                                                                                                           
            rationale = "Patient-targeted intervention only without provider or system-targeted component"              
    else:                                                                                                               
        decision = "include"                                                                                            
        n_included += 1                                                                                                 
        rationale = "RCT assessing QI strategy with provider/system component in outpatient diabetes care"              
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": "high"                                                                                            
    })                                                                                                                  
                                                                                                                        
result_summary = {                                                                                                      
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {result_summary['n_total']}")                                                           
print(f"Included: {result_summary['n_included']}")                                                                      
print(f"Excluded: {result_summary['n_excluded']}")                                                                      
print(json.dumps(result_summary, indent=2))                                                                             
                                                                                                                        
