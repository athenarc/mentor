# Screen each study against selection criteria                                                                          
decisions = []                                                                                                          
                                                                                                                        
for study in chunk_data['studies']:                                                                                     
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract'].lower()                                                                                
                                                                                                                        
    # Check if randomized trial                                                                                         
    is_randomized = any(term in abstract for term in ['randomiz', 'randomised', 'rct', 'controlled trial'])             
                                                                                                                        
    # Check if diabetes population                                                                                      
    is_diabetes = 'diabet' in abstract                                                                                  
                                                                                                                        
    # Check if outpatient setting                                                                                       
    is_outpatient = any(term in abstract for term in ['primary care', 'clinic', 'outpatient', 'community', 'practice',  
'residency'])                                                                                                           
                                                                                                                        
    # Check for system/provider-targeted strategies                                                                     
    has_qi_strategy = False                                                                                             
    qi_strategies_found = []                                                                                            
                                                                                                                        
    # System-targeted: CM, TC, EPR, FR, CQI                                                                             
    if any(term in abstract for term in ['case manag', 'case management']):                                             
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CM')                                                                                
    if any(term in abstract for term in ['team chang', 'shared care', 'shared appointment', 'pharmacist', 'nurse-led',  
'multidisciplinary']):                                                                                                  
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('TC')                                                                                
    if any(term in abstract for term in ['electronic regist', 'registry', 'epr']):                                      
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('EPR')                                                                               
    if any(term in abstract for term in ['facilitat', 'relay', 'information']):                                         
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('FR')                                                                                
    if any(term in abstract for term in ['continuous qualit', 'cqi', 'quality improvement']):                           
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CQI')                                                                               
                                                                                                                        
    # Provider-targeted: AF, CE, CR, FI                                                                                 
    if any(term in abstract for term in ['audit', 'feedback']):                                                         
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('AF')                                                                                
    if any(term in abstract for term in ['physician educat', 'clinician educat', 'educational material', 'academic      
detail']):                                                                                                              
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CE')                                                                                
    if any(term in abstract for term in ['reminder', 'prompt']):                                                        
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CR')                                                                                
    if any(term in abstract for term in ['financial incentiv', 'payment']):                                             
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('FI')                                                                                
                                                                                                                        
    # Make decision                                                                                                     
    if not is_randomized:                                                                                               
        decision = "exclude"                                                                                            
        rationale = f"Not a randomized trial. Study design described as '{study.get('design', 'not specified')}'."      
        confidence = "high"                                                                                             
    elif not is_diabetes:                                                                                               
        decision = "exclude"                                                                                            
        rationale = "Population does not include patients with diabetes."                                               
        confidence = "high"                                                                                             
    elif not is_outpatient:                                                                                             
        decision = "exclude"                                                                                            
        rationale = "Setting is not outpatient."                                                                        
        confidence = "medium"                                                                                           
    elif not has_qi_strategy:                                                                                           
        decision = "exclude"                                                                                            
        rationale = "No system/provider-targeted QI strategy identified. Only patient-targeted strategies or none."     
        confidence = "high"                                                                                             
    else:                                                                                                               
        decision = "include"                                                                                            
        rationale = f"Randomized trial of diabetes QI programme in outpatient setting with {',                          
'.join(qi_strategies_found)} strategy(ies)."                                                                            
        confidence = "high"                                                                                             
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Print summary                                                                                                         
print(f"Total studies screened: {len(decisions)}")                                                                      
included = sum(1 for d in decisions if d['decision'] == 'include')                                                      
excluded = sum(1 for d in decisions if d['decision'] == 'exclude')                                                      
print(f"Included: {included}")                                                                                          
print(f"Excluded: {excluded}")                                                                                          
print("\nDetailed decisions:")                                                                                          
for d in decisions:                                                                                                     
    print(f"\nStudy {d['study_index']}: {d['decision'].upper()}")                                                       
    print(f"Rationale: {d['rationale']}")                                                                               
    print(f"Confidence: {d['confidence']}")                                                                             
                                                                                                                        
# Output final JSON array                                                                                               
print("\n\nFinal JSON output:")                                                                                         
print(json.dumps(decisions, indent=2))                                                                                  
                                                                                                                        
