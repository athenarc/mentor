        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('FR')                                                                                
                                                                                                                        
    # Continuous Quality Improvement (CQI)                                                                              
    if any(term in abstract.lower() for term in ['continuous quality improvement', 'cqi']):                             
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CQI')                                                                               
                                                                                                                        
    # Audit and Feedback (AF)                                                                                           
    if any(term in abstract.lower() for term in ['audit', 'feedback']):                                                 
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('AF')                                                                                
                                                                                                                        
    # Clinician Education (CE)                                                                                          
    if any(term in abstract.lower() for term in ['training', 'education', 'clinician education', 'physicians received   
training']):                                                                                                            
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CE')                                                                                
                                                                                                                        
    # Clinician Reminders (CR)                                                                                          
    if any(term in abstract.lower() for term in ['reminders', 'prompt', 'flow sheets', 'guidelines', 'identifiers']):   
        has_qi_strategy = True                                                                                          
        qi_strategies_found.append('CR')                                                                                
                                                                                                                        
    # Financial Incentives (FI)                                                                                         
