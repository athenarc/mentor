    # System-targeted: CM, TC, EPR, FR, CQI                                                                             
    system_terms = ['case management', 'team change', 'electronic registry', 'registry', 'relay', 'quality improvement',
'cqi', 'continuous quality']                                                                                            
                                                                                                                        
    # Provider-targeted: AF, CE, CR, FI                                                                                 
    provider_terms = ['audit', 'feedback', 'education', 'reminder', 'incentive', 'clinician education', 'provider       
