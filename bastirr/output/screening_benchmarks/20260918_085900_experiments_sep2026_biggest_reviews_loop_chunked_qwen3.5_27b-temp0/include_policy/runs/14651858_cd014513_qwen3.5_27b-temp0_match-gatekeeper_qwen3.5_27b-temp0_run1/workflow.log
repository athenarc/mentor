# Build decisions list                                                                                                  
for study_index, decision, rationale, confidence in studies_info:                                                       
    # Find the title for this study                                                                                     
    study = next((s for s in candidate_data['studies'] if s['study_index'] == study_index), None)                       
    title = study['title'] if study else "Unknown"                                                                      
                                                                                                                        
    decisions.append({                                                                                                  
        'study_index': study_index,                                                                                     
        'title': title,                                                                                                 
        'decision': decision,                                                                                           
        'rationale': rationale,                                                                                         
        'confidence': confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Calculate summary statistics                                                                                          
n_total = len(decisions)                                                                                                
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
# Create final output                                                                                                   
final_output = {                                                                                                        
    'n_total': n_total,                                                                                                 
    'n_included': n_included,                                                                                           
    'n_excluded': n_excluded,                                                                                           
    'decisions': decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(f"Total studies screened: {n_total}")                                                                             
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
print(json.dumps(final_output, indent=2))                                                                               
                                                                                                                        
