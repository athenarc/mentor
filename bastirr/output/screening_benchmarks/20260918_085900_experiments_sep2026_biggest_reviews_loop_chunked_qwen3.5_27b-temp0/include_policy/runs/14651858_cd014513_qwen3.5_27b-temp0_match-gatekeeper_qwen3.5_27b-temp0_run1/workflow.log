<code>                                                                                                                  
import json                                                                                                             
                                                                                                                        
# Parse the chunk data                                                                                                  
chunk_data = json.loads(chunk_data)                                                                                     
                                                                                                                        
# Initialize decisions list                                                                                             
decisions = []                                                                                                          
                                                                                                                        
# Selection criteria:                                                                                                   
# 1. Randomised trials                                                                                                  
# 2. Outpatient settings                                                                                                
# 3. People with diabetes                                                                                               
# 4. At least one system- or provider-targeted QI strategy                                                              
#    OR patient-targeted WITH at least one provider/system strategy                                                     
                                                                                                                        
# System-targeted: CM, TC, EPR, FR, CQI                                                                                 
# Provider-targeted: AF, CE, CR, FI                                                                                     
# Patient-targeted: PE, PSM, PR (must be combined with provider/system strategy)                                        
                                                                                                                        
def screen_study(study):                                                                                                
    """Screen a single study and return decision with rationale"""                                                      
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
    study_index = study['study_index']                                                                                  
                                                                                                                        
    # Check if randomised trial                                                                                         
    randomised_keywords = ['randomized', 'randomised', 'RCT', 'cluster randomised', 'cluster randomized']               
    is_randomised = any(kw.lower() in abstract.lower() for kw in randomised_keywords)                                   
                                                                                                                        
    # Check if diabetes population                                                                                      
    diabetes_keywords = ['diabetes', 'diabetic', 'T2D', 'type 2 diabetes', 'type 1 diabetes']                           
    is_diabetes = any(kw.lower() in abstract.lower() for kw in diabetes_keywords)                                       
                                                                                                                        
    # Check if outpatient setting                                                                                       
    outpatient_keywords = ['outpatient', 'primary care', 'ambulatory', 'community', 'general practice', 'clinic',       
'health center']                                                                                                        
    is_outpatient = any(kw.lower() in abstract.lower() for kw in outpatient_keywords)                                   
                                                                                                                        
    # Check for QI strategies                                                                                           
    # System-targeted                                                                                                   
    system_strategies = ['case management', 'team change', 'electronic registry', 'registry', 'relay', 'continuous      
quality improvement', 'CQI']                                                                                            
    has_system = any(kw.lower() in abstract.lower() for kw in system_strategies)                                        
                                                                                                                        
    # Provider-targeted                                                                                                 
    provider_strategies = ['audit', 'feedback', 'education', 'reminder', 'incentive', 'clinician', 'provider',          
'physician', 'nurse', 'pharmacist']                                                                                     
    has_provider = any(kw.lower() in abstract.lower() for kw in provider_strategies)                                    
                                                                                                                        
    # Patient-targeted                                                                                                  
    patient_strategies = ['patient education', 'self-management', 'self management', 'patient reminder', 'reminders']   
    has_patient = any(kw.lower() in abstract.lower() for kw in patient_strategies)                                      
                                                                                                                        
    # Decision logic                                                                                                    
    if not is_randomised:                                                                                               
        return {                                                                                                        
            'study_index': study_index,                                                                                 
            'title': title,                                                                                             
            'decision': 'exclude',                                                                                      
            'rationale': 'Not a randomised trial',                                                                      
            'confidence': 'high'                                                                                        
        }                                                                                                               
                                                                                                                        
    if not is_diabetes:                                                                                                 
        return {                                                                                                        
            'study_index': study_index,                                                                                 
            'title': title,                                                                                             
            'decision': 'exclude',                                                                                      
            'rationale': 'Not focused on diabetes population',                                                          
            'confidence': 'high'                                                                                        
        }                                                                                                               
                                                                                                                        
    if not is_outpatient:                                                                                               
        return {                                                                                                        
            'study_index': study_index,                                                                                 
            'title': title,                                                                                             
            'decision': 'exclude',                                                                                      
            'rationale': 'Not in outpatient setting',                                                                   
            'confidence': 'medium'                                                                                      
        }                                                                                                               
                                                                                                                        
    # Check for QI strategies                                                                                           
    has_qi = has_system or has_provider or (has_patient and (has_system or has_provider))                               
                                                                                                                        
    if not has_qi:                                                                                                      
        return {                                                                                                        
            'study_index': study_index,                                                                                 
            'title': title,                                                                                             
            'decision': 'exclude',                                                                                      
            'rationale': 'No eligible QI strategy identified',                                                          
            'confidence': 'medium'                                                                                      
        }                                                                                                               
                                                                                                                        
    return {                                                                                                            
        'study_index': study_index,                                                                                     
        'title': title,                                                                                                 
        'decision': 'include',                                                                                          
        'rationale': 'Meets selection criteria: randomised trial, diabetes population, outpatient setting, with QI      
strategy',                                                                                                              
        'confidence': 'medium'                                                                                          
    }                                                                                                                   
                                                                                                                        
# Screen all studies                                                                                                    
for study in chunk_data['studies']:                                                                                     
    decision = screen_study(study)                                                                                      
    decisions.append(decision)                                                                                          
                                                                                                                        
# Count decisions                                                                                                       
n_included = sum(1 for d in decisions if d['decision'] == 'include')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'exclude')                                                    
                                                                                                                        
print(f"Total screened: {len(decisions)}")                                                                              
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Show first 10 decisions                                                                                               
for d in decisions[:10]:                                                                                                
    print(f"\nStudy {d['study_index']}: {d['decision'].upper()}")                                                       
    print(f"  Rationale: {d['rationale']}")                                                                             
                                                                                                                        
