decisions = []                                                                                                          
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    dec_info = decisions_map[idx]                                                                                       
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": dec_info["decision"],                                                                               
        "rationale": dec_info["rationale"],                                                                             
        "confidence": dec_info["confidence"]                                                                            
    })                                                                                                                  
                                                                                                                        
n_included = sum(1 for d in decisions if d['decision'] == 'INCLUDE')                                                    
n_excluded = sum(1 for d in decisions if d['decision'] == 'EXCLUDE')                                                    
                                                                                                                        
result = {                                                                                                              
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print(json.dumps(result, indent=2))                                                                                     
                                                                                                                        
