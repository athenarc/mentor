data = json.loads(chunk_data)                                                                                           
studies = data['studies']                                                                                               
                                                                                                                        
# Create decisions for each study                                                                                       
decisions = []                                                                                                          
                                                                                                                        
for study in studies:                                                                                                   
    idx = study['study_index']                                                                                          
    title = study['title']                                                                                              
    abstract = study['abstract']                                                                                        
                                                                                                                        
    # Determine decision based on selection criteria                                                                    
    # Must be: randomised trial, QI programme for diabetes in outpatient settings,                                      
    # with at least one system- or provider-targeted strategy                                                           
                                                                                                                        
    decision = "EXCLUDE"                                                                                                
    rationale = ""                                                                                                      
    confidence = "high"                                                                                                 
                                                                                                                        
    # Check for key exclusion criteria                                                                                  
    if "framework" in title.lower() or "meta-analysis" in title.lower() or "systematic" in title.lower():               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Not a primary randomised trial - {title}"                                                         
    elif "dialysis" in abstract.lower() or "pregnant" in abstract.lower() or "hypertension" in title.lower():           
        decision = "EXCLUDE"                                                                                            
        rationale = f"Inappropriate setting or population - {title}"                                                    
    elif "type 1" in title.lower() or "type 1" in abstract.lower():                                                     
        decision = "EXCLUDE"                                                                                            
        rationale = f"Type 1 diabetes only - {title}"                                                                   
    elif "patient education" in abstract.lower() and "physician" not in abstract.lower() and "provider" not in          
abstract.lower() and "team" not in abstract.lower() and "case management" not in abstract.lower() and "feedback" not in 
abstract.lower() and "reminder" not in abstract.lower() and "registry" not in abstract.lower() and "facilitat" not in   
abstract.lower() and "quality improvement" not in abstract.lower():                                                     
        decision = "EXCLUDE"                                                                                            
        rationale = f"Patient-targeted only without system/provider component - {title}"                                
    elif "mobile app" in title.lower() or "web-based" in title.lower() or "internet-based" in title.lower() or          
"telemedicine" in title.lower() or "telemonitoring" in title.lower():                                                   
        # Check if there's a system/provider component                                                                  
        if "feedback" in abstract.lower() or "provider" in abstract.lower() or "physician" in abstract.lower() or       
"nurse" in abstract.lower() or "pharmacist" in abstract.lower() or "case management" in abstract.lower() or "team" in   
abstract.lower():                                                                                                       
            decision = "INCLUDE"                                                                                        
            rationale = f"System/provider-targeted QI strategy with patient component - {title}"                        
        else:                                                                                                           
            decision = "EXCLUDE"                                                                                        
            rationale = f"Patient-targeted only without system/provider component - {title}"                            
    elif "case management" in abstract.lower() or "team" in abstract.lower() or "feedback" in abstract.lower() or       
"audit" in abstract.lower() or "education" in abstract.lower() or "reminder" in abstract.lower() or "registry" in       
abstract.lower() or "facilitat" in abstract.lower() or "quality improvement" in abstract.lower() or "practice           
facilitation" in abstract.lower() or "continuous quality" in abstract.lower() or "clinician" in abstract.lower() or     
"physician" in abstract.lower() or "provider" in abstract.lower() or "pharmacist" in abstract.lower() or "nurse" in     
abstract.lower() or "CHW" in abstract.lower() or "community health worker" in abstract.lower():                         
        decision = "INCLUDE"                                                                                            
        rationale = f"Contains system- or provider-targeted QI strategy - {title}"                                      
    else:                                                                                                               
        decision = "EXCLUDE"                                                                                            
        rationale = f"Does not meet selection criteria - {title}"                                                       
                                                                                                                        
    decisions.append({                                                                                                  
        "study_index": idx,                                                                                             
        "title": title,                                                                                                 
        "decision": decision,                                                                                           
        "rationale": rationale,                                                                                         
        "confidence": confidence                                                                                        
    })                                                                                                                  
                                                                                                                        
# Count included/excluded                                                                                               
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = sum(1 for d in decisions if d["decision"] == "EXCLUDE")                                                    
                                                                                                                        
print(f"Total studies: {len(decisions)}")                                                                               
print(f"Included: {n_included}")                                                                                        
print(f"Excluded: {n_excluded}")                                                                                        
                                                                                                                        
# Print all decisions                                                                                                   
for d in decisions:                                                                                                     
    print(f"Study {d['study_index']}: {d['decision']} - {d['rationale'][:100]}...")                                     
                                                                                                                        
# Prepare final answer                                                                                                  
final_result = {                                                                                                        
    "n_total": len(decisions),                                                                                          
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded,                                                                                           
    "decisions": decisions                                                                                              
}                                                                                                                       
                                                                                                                        
print("\n\nFinal JSON result:")                                                                                         
print(json.dumps(final_result, indent=2))                                                                               
                                                                                                                        
