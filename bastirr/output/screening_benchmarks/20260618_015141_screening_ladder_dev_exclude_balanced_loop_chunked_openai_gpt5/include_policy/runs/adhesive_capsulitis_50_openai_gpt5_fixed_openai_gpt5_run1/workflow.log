              "Methods chapter on meta-analysis; not a clinical trial.",                                                
              "high"                                                                                                    
          ))                                                                                                            
      elif idx == 47:                                                                                                   
          decisions.append(make_decision(                                                                               
              idx, title, "INCLUDE",                                                                                    
              "Title indicates randomized controlled study of joint mobilization versus self-exercises in adhesive      
  capsulitis (LGHM). Although abstract wording is observational, err on inclusion due to RCT indication and relevant    
  interventions.",                                                                                                      
              "low"                                                                                                     
          ))                                                                                                            
      elif idx == 48:                                                                                                   
          decisions.append(make_decision(                                                                               
              idx, title, "INCLUDE",                                                                                    
              "Prospective systematically allocated (quasi-randomized) clinical trial comparing chiropractic            
  manipulation+exercise vs mobilization+exercise in adhesive capsulitis.",                                              
              "medium"                                                                                                  
          ))                                                                                                            
      elif idx == 49:                                                                                                   
          decisions.append(make_decision(                                                                               
              idx, title, "INCLUDE",                                                                                    
              "Randomized controlled trial comparing high-grade vs low-grade mobilizations in adhesive capsulitis;      
  manual therapy focus.",                                                                                               
              "high"                                                                                                    
          ))                                                                                                            
      elif idx == 50:                                                                                                   
          decisions.append(make_decision(                                                                               
              idx, title, "INCLUDE",                                                                                    
              "Single-blind randomized pilot: passive joint mobilization added to home-care after corticosteroid        
  injection versus home-care alone in adhesive capsulitis.",                                                            
              "medium"                                                                                                  
          ))                                                                                                            
      else:                                                                                                             
          # Fallback (should not happen)                                                                                
          decisions.append(make_decision(                                                                               
              idx, title, "EXCLUDE",                                                                                    
              "Insufficient information to determine eligibility at title/abstract level.",                             
              "low"                                                                                                     
          ))                                                                                                            
                                                                                                                        
  # Sanity checks: preserve expected indices and counts                                                                 
  indexed = [d["study_index"] for d in decisions]                                                                       
  assert sorted(indexed) == sorted(expected_indices), "Mismatch in study indices."                                      
                                                                                                                        
  n_total = len(decisions)                                                                                              
  n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                  
  n_excluded = n_total - n_included                                                                                     
                                                                                                                        
  result_payload = {                                                                                                    
      "n_total": n_total,                                                                                               
      "n_included": n_included,                                                                                         
      "n_excluded": n_excluded,                                                                                         
      "decisions": decisions                                                                                            
  }                                                                                                                     
                                                                                                                        
  print(json.dumps(result_payload, ensure_ascii=False, indent=2))                                                       
                                                                                                                        
  # Finalize                                                                                                            
  final_answer(json.dumps(result_payload, ensure_ascii=False))                                                          
