import json                                                                                                             
                                                                                                                        
# Load the provided candidates JSON                                                                                     
data = json.loads(candidates_json)                                                                                      
title = data.get("title")                                                                                               
criteria = data.get("selection_criteria")                                                                               
studies = data.get("studies", [])                                                                                       
                                                                                                                        
# Helper to safely parse tool output to JSON                                                                            
def safe_parse_decision(raw):                                                                                           
    try:                                                                                                                
        return json.loads(raw)                                                                                          
    except Exception:                                                                                                   
        # If parsing fails, wrap as a minimal object (fallback)                                                         
        return {"study_index": None, "title": None, "decision": "EXCLUDE", "rationale": "Screening tool output could not
be parsed.", "confidence": "low"}                                                                                       
                                                                                                                        
# Run screening for each study                                                                                          
decisions_raw = []                                                                                                      
for s in studies:                                                                                                       
    si = s.get("study_index")                                                                                           
    stitle = s.get("title", "")                                                                                         
    sabstract = s.get("abstract", "")                                                                                   
    # Call the screening tool                                                                                           
    res = screen_study(study_title=stitle, study_abstract=sabstract, selection_criteria=criteria, study_index=si)       
    decisions_raw.append(res)                                                                                           
                                                                                                                        
# Parse all decisions into a normalized structure                                                                       
normalized_decisions = []                                                                                               
for raw in decisions_raw:                                                                                               
    obj = safe_parse_decision(raw)                                                                                      
    # Map to the manager-requested fields                                                                               
    sid = obj.get("study_index", None)                                                                                  
    stitle = obj.get("title", None)                                                                                     
    decision = obj.get("decision", "EXCLUDE")                                                                           
    rationale = obj.get("rationale", "")                                                                                
    normalized_decisions.append({                                                                                       
        "id": sid,                                                                                                      
        "title": stitle,                                                                                                
        "decision": decision,                                                                                           
        "rationale": rationale                                                                                          
    })                                                                                                                  
                                                                                                                        
# Sort by id to ensure 1..n ordering                                                                                    
normalized_decisions = sorted(normalized_decisions, key=lambda x: (x["id"] is None, x["id"]))                           
                                                                                                                        
# Sanity check and counts                                                                                               
n_total = len(normalized_decisions)                                                                                     
n_included = sum(1 for d in normalized_decisions if d["decision"] == "INCLUDE")                                         
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
# Build the final manager-requested schema                                                                              
manager_schema = {                                                                                                      
    "title": title,                                                                                                     
    "selection_criteria": criteria,                                                                                     
    "studies": normalized_decisions                                                                                     
}                                                                                                                       
                                                                                                                        
# Prepare detailed summary text                                                                                         
summary_counts = {                                                                                                      
    "n_total": n_total,                                                                                                 
    "n_included": n_included,                                                                                           
    "n_excluded": n_excluded                                                                                            
}                                                                                                                       
                                                                                                                        
# Print the JSON blocks needed in the final answer                                                                      
print(json.dumps(summary_counts))                                                                                       
print(json.dumps(manager_schema))                                                                                       
                                                                                                                        
