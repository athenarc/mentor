# Sort decisions by study_index for readability                                                                         
decisions = sorted(decisions, key=lambda d: d["study_index"])                                                           
                                                                                                                        
n_total = len(studies)                                                                                                  
n_included = sum(1 for d in decisions if d["decision"] == "INCLUDE")                                                    
n_excluded = n_total - n_included                                                                                       
                                                                                                                        
# Build narrative sections                                                                                              
short_outcome = f"Screened {n_total} studies; included {n_included} randomized controlled trials of topical and/or      
systemic interventions for alopecia areata (including totalis/universalis); excluded {n_excluded} that were             
non-randomized, non-interventional, or otherwise ineligible."                                                           
                                                                                                                        
# Extremely detailed narrative (concise but comprehensive)                                                              
included_list = [f"{d['study_index']}. {d['title']}" for d in decisions if d["decision"] == "INCLUDE"]                  
excluded_list = [f"{d['study_index']}. {d['title']} — {d['rationale']}" for d in decisions if d["decision"] ==          
"EXCLUDE"]                                                                                                              
                                                                                                                        
detailed_outcome = (                                                                                                    
