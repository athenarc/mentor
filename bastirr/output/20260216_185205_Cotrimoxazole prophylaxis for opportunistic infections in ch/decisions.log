    "and studies without routine cotrimoxazole prophylaxis comparator. "
    "Return ONLY a JSON array where each item has: study_index, decision (INCLUDE or EXCLUDE), and reason."
)
gate_args = {
    "review_json": review_json,
    "candidate_studies_json": lib_result
}
gate_result = gatekeeper(task=gate_task, additional_args=gate_args)
print("GATEKEEPER_RESULT_START")
print(gate_result)
print("GATEKEEPER_RESULT_END")

# Step 3: Parse included studies from gatekeeper result using regex
gate_body = gate_result
# Find all study_index numbers where decision is INCLUDE
# Pattern: capture the study_index preceding a decision INCLUDE within the same item
include_pattern = r'"study_index"\s*:\s*(\d+)[\s\S]*?"decision"\s*:\s*"INCLUDE"'
included_indices = [int(m.group(1)) for m in re.finditer(include_pattern, gate_body)]
print("INCLUDED_INDICES", included_indices)

# Build included studies JSON (list of {study_index, title, abstract})
included_studies_json = build_included_studies_json(review_json, included_indices)
print("INCLUDED_STUDIES_JSON_START")
