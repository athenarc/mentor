# Utility regex-based helpers (no json module allowed)                                                                  
import re                                                                                                               
                                                                                                                        
def extract_objective(review_str):                                                                                      
    m = re.search(r'"objective"\s*:\s*"([^"]*)"', review_str)                                                           
    return m.group(1) if m else ""                                                                                      
                                                                                                                        
def extract_title_abstract_for_index(review_str, idx):                                                                  
    # Match the study block for the given index and extract title and abstract                                          
    # Use a regex that finds the block starting with "study_index": idx and captures title and abstract                 
    pattern = rf'{{\s*"study_index"\s*:\s*{idx}\s*,\s*"title"\s*:\s*"([^"]+)"\s*,\s*"abstract"\s*:\s*"([\s\S]*?)"\s*}}' 
    m = re.search(pattern, review_str)                                                                                  
    if m:                                                                                                               
        title = m.group(1)                                                                                              
        abstract = m.group(2)                                                                                           
        # Escape any double quotes in the abstract for JSON string building                                             
        title_esc = title.replace('"', '\\"')                                                                           
        abstract_esc = abstract.replace('"', '\\"')                                                                     
        return title_esc, abstract_esc                                                                                  
    return "", ""                                                                                                       
                                                                                                                        
def build_included_studies_json(review_str, included_indices):                                                          
    items = []                                                                                                          
    for idx in included_indices:                                                                                        
        title, abstract = extract_title_abstract_for_index(review_str, idx)                                             
        if title:                                                                                                       
            items.append(f'{{"study_index": {idx}, "title": "{title}", "abstract": "{abstract}"}}')                     
    return "[" + ", ".join(items) + "]"                                                                                 
                                                                                                                        
# Step 1: SEARCH - call the librarian agent                                                                             
lib_task = (                                                                                                            
    "You are the Search & Retrieval agent for a systematic review. "                                                    
    "Given the review protocol JSON (fields: title, objective, background, selection_criteria, studies), "              
    "retrieve and return all candidate studies for screening, as a JSON list of candidate studies "                     
    "with at least: study_index, title, abstract. Include all studies provided. "                                       
    "Return ONLY a JSON string."                                                                                        
)                                                                                                                       
lib_args = {"review_json": review_json}                                                                                 
lib_result = librarian(task=lib_task, additional_args=lib_args)                                                         
print("LIBRARIAN_RESULT_START")                                                                                         
print(lib_result)                                                                                                       
print("LIBRARIAN_RESULT_END")                                                                                           
                                                                                                                        
# Step 2: SCREENING - call the gatekeeper agent                                                                         
gate_task = (                                                                                                           
    "You are the Screening agent. Screen each candidate study against the selection criteria. "                         
    "Inclusion criteria: Randomised or quasi-randomised trials comparing routinely administered "                       
    "cotrimoxazole (trimethoprim-sulfamethoxazole) versus placebo or no treatment in children (<15 years) with HIV      
infection, "                                                                                                            
    "or infants (<18 months) with HIV-infected mothers. Exclude non-randomized studies, adult-only trials, observational
or diagnostic studies, "                                                                                                
    "and studies without routine cotrimoxazole prophylaxis comparator. "                                                
    "Return ONLY a JSON array where each item has: study_index, decision (INCLUDE or EXCLUDE), and reason."             
)                                                                                                                       
gate_args = {                                                                                                           
    "review_json": review_json,                                                                                         
    "candidate_studies_json": lib_result                                                                                
}                                                                                                                       
gate_result = gatekeeper(task=gate_task, additional_args=gate_args)                                                     
print("GATEKEEPER_RESULT_START")                                                                                        
print(gate_result)                                                                                                      
print("GATEKEEPER_RESULT_END")                                                                                          
                                                                                                                        
# Step 3: Parse included studies from gatekeeper result using regex                                                     
gate_body = gate_result                                                                                                 
# Find all study_index numbers where decision is INCLUDE                                                                
# Pattern: capture the study_index preceding a decision INCLUDE within the same item                                    
include_pattern = r'"study_index"\s*:\s*(\d+)[\s\S]*?"decision"\s*:\s*"INCLUDE"'                                        
included_indices = [int(m.group(1)) for m in re.finditer(include_pattern, gate_body)]                                   
print("INCLUDED_INDICES", included_indices)                                                                             
                                                                                                                        
# Build included studies JSON (list of {study_index, title, abstract})                                                  
included_studies_json = build_included_studies_json(review_json, included_indices)                                      
print("INCLUDED_STUDIES_JSON_START")                                                                                    
print(included_studies_json)                                                                                            
print("INCLUDED_STUDIES_JSON_END")                                                                                      
                                                                                                                        
# Extract objective text                                                                                                
objective_text = extract_objective(review_json)                                                                         
print("OBJECTIVE_START")                                                                                                
print(objective_text)                                                                                                   
print("OBJECTIVE_END")                                                                                                  
                                                                                                                        
# Step 4: EXTRACTION - call the miner agent with included studies and objective                                         
miner_task = (                                                                                                          
    "You are the Evidence Extraction agent. For each included study, extract structured PICO and outcomes. "            
    "For each study provide: study_index, Participants (age range, HIV status, setting), "                              
    "Intervention (cotrimoxazole dose/schedule/duration), Comparator, Outcomes (mortality, illness episodes,            
hospitalizations, adverse events), "                                                                                    
    "Effect sizes (hazard ratios, risk ratios, counts where available), Study design features (randomization, blinding, 
follow-up), and Notes. "                                                                                                
    "Return ONLY a JSON array of studies with these fields."                                                            
)                                                                                                                       
miner_args = {                                                                                                          
    "included_studies_json": included_studies_json,                                                                     
    "objective": objective_text                                                                                         
}                                                                                                                       
miner_result = miner(task=miner_task, additional_args=miner_args)                                                       
print("MINER_RESULT_START")                                                                                             
print(miner_result)                                                                                                     
print("MINER_RESULT_END")                                                                                               
                                                                                                                        
# Step 5: SYNTHESIS - call the critic agent to assess quality and synthesize                                            
critic_task = (                                                                                                         
    "You are the Synthesis & Quality Assessment agent. Using the extracted evidence JSON and the review objective, "    
    "assess risk of bias (randomization, allocation concealment, blinding, attrition, selective reporting, early        
stopping) for each study, "                                                                                             
    "and produce a narrative synthesis focusing on the effects of routinely administered cotrimoxazole on mortality and 
illness episodes, "                                                                                                     
    "and safety (adverse events). Identify evidence gaps (e.g., infants of HIV-infected mothers). "                     
    "Return ONLY a JSON object with fields: quality_assessment (per study), and narrative_synthesis (with citations by  
study_index)."                                                                                                          
)                                                                                                                       
critic_args = {                                                                                                         
    "extracted_evidence_json": miner_result,                                                                            
    "objective": objective_text                                                                                         
}                                                                                                                       
critic_result = critic(task=critic_task, additional_args=critic_args)                                                   
print("CRITIC_RESULT_START")                                                                                            
print(critic_result)                                                                                                    
print("CRITIC_RESULT_END")                                                                                              
                                                                                                                        
# Step 6: Compile final report components                                                                               
                                                                                                                        
# Count number of candidates found from librarian output by counting occurrences of "study_index":                      
num_candidates = len(re.findall(r'"study_index"\s*:\s*\d+', lib_result))                                                
print("NUM_CANDIDATES", num_candidates)                                                                                 
                                                                                                                        
# Build decisions mapping for reporting                                                                                 
decision_items = re.findall(r'\{[\s\S]*?\}', gate_result)  # crude split of items                                       
decisions_summary = []                                                                                                  
included_set = set(included_indices)                                                                                    
for item in decision_items:                                                                                             
    m_idx = re.search(r'"study_index"\s*:\s*(\d+)', item)                                                               
    m_dec = re.search(r'"decision"\s*:\s*"([^"]+)"', item)                                                              
    m_rea = re.search(r'"reason"\s*:\s*"([^"]+)"', item)                                                                
    if m_idx and m_dec:                                                                                                 
        idx = int(m_idx.group(1))                                                                                       
        dec = m_dec.group(1)                                                                                            
        rea = m_rea.group(1) if m_rea else ""                                                                           
        decisions_summary.append((idx, dec, rea))                                                                       
                                                                                                                        
included_count = len(included_indices)                                                                                  
excluded_count = num_candidates - included_count                                                                        
                                                                                                                        
# Prepare Evidence Extraction Summary: We'll pass through the miner_result as-is for clarity                            
evidence_summary = miner_result                                                                                         
                                                                                                                        
# Prepare Synthesis & Quality Assessment: pass through critic_result                                                    
synthesis_summary = critic_result                                                                                       
                                                                                                                        
# Build final structured report text                                                                                    
report_lines = []                                                                                                       
                                                                                                                        
# 1. Review Summary                                                                                                     
title_match = re.search(r'"title"\s*:\s*"([^"]+)"', review_json)                                                        
title_text = title_match.group(1) if title_match else "Untitled Review"                                                 
report_lines.append("1. Review Summary")                                                                                
