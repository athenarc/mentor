          title = m.group(1)                                                                                            
          abstract = m.group(2)                                                                                         
          # Escape any double quotes in the abstract for JSON string building                                           
          title_esc = title.replace('"', '\\"')                                                                         
          abstract_esc = abstract.replace('"', '\\"')                                                                   
          return title_esc, abstract_esc                                                                                
      return "", ""                                                                                                     
                                                                                                                        
