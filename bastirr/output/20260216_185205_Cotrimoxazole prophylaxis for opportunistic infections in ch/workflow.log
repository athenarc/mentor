  import re                                                                                                             
                                                                                                                        
  # Utility: JSON-safe string escaping for output                                                                       
  def json_escape_string(s):                                                                                            
      s = str(s)                                                                                                        
      s = s.replace('\\', '\\\\').replace('"', '\\"')                                                                   
      s = s.replace('\b', '\\b').replace('\f', '\\f').replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')    
      return s                                                                                                          
                                                                                                                        
  def to_json(value):                                                                                                   
      if value is None:                                                                                                 
          return "null"                                                                                                 
      if isinstance(value, bool):                                                                                       
          return "true" if value else "false"                                                                           
      if isinstance(value, (int, float)):                                                                               
          return str(value)                                                                                             
      if isinstance(value, str):                                                                                        
          return '"' + json_escape_string(value) + '"'                                                                  
      if isinstance(value, list):                                                                                       
          return '[' + ', '.join(to_json(v) for v in value) + ']'                                                       
      if isinstance(value, dict):                                                                                       
          return '{' + ', '.join(to_json(str(k)) + ': ' + to_json(v) for k, v in value.items()) + '}'                   
      return '"' + json_escape_string(str(value)) + '"'                                                                 
                                                                                                                        
  # Utility: minimal unescape for JSON-like strings present in review_json                                              
  def unescape_json_like_string(s):                                                                                     
      out = []                                                                                                          
      i = 0                                                                                                             
      while i < len(s):                                                                                                 
          c = s[i]                                                                                                      
          if c != '\\':                                                                                                 
              out.append(c)                                                                                             
              i += 1                                                                                                    
              continue                                                                                                  
          # Handle escape                                                                                               
          i += 1                                                                                                        
          if i >= len(s):                                                                                               
              break                                                                                                     
          esc = s[i]                                                                                                    
          i += 1                                                                                                        
          if esc == '"':                                                                                                
              out.append('"')                                                                                           
          elif esc == '\\':                                                                                             
              out.append('\\')                                                                                          
          elif esc == '/':                                                                                              
              out.append('/')                                                                                           
          elif esc == 'b':                                                                                              
              out.append('\b')                                                                                          
          elif esc == 'f':                                                                                              
              out.append('\f')                                                                                          
          elif esc == 'n':                                                                                              
              out.append('\n')                                                                                          
          elif esc == 'r':                                                                                              
              out.append('\r')                                                                                          
          elif esc == 't':                                                                                              
              out.append('\t')                                                                                          
          elif esc == "'":                                                                                              
              out.append("'")                                                                                           
          elif esc == 'u' and i + 4 <= len(s):                                                                          
              hexcode = s[i:i+4]                                                                                        
              try:                                                                                                      
                  out.append(chr(int(hexcode, 16)))                                                                     
                  i += 4                                                                                                
              except:                                                                                                   
                  out.append('\\u' + hexcode)                                                                           
                  i += 4                                                                                                
          else:                                                                                                         
              # Unknown escape, keep literal                                                                            
              out.append('\\' + esc)                                                                                    
      return ''.join(out)                                                                                               
                                                                                                                        
