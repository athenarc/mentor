# Helper: extract the JSON array that follows the first occurrence of '"extracted":'                                    
def extract_extracted_list(text):                                                                                       
    key = '"extracted"'                                                                                                 
    idx = text.find(key)                                                                                                
    if idx == -1:                                                                                                       
        return []                                                                                                       
    # Find the first '[' after the key                                                                                  
    lb = text.find('[', idx)                                                                                            
    if lb == -1:                                                                                                        
        return []                                                                                                       
    # Scan forward to find the matching closing ']'                                                                     
    depth = 0                                                                                                           
    in_str = False                                                                                                      
    esc = False                                                                                                         
    for i in range(lb, len(text)):                                                                                      
        ch = text[i]                                                                                                    
        if in_str:                                                                                                      
            if esc:                                                                                                     
                esc = False                                                                                             
            elif ch == '\\':                                                                                            
                esc = True                                                                                              
            elif ch == '"':                                                                                             
                in_str = False                                                                                          
        else:                                                                                                           
            if ch == '"':                                                                                               
                in_str = True                                                                                           
            elif ch == '[':                                                                                             
                depth += 1                                                                                              
            elif ch == ']':                                                                                             
                depth -= 1                                                                                              
                if depth == 0:                                                                                          
                    rb = i                                                                                              
                    array_str = text[lb:rb+1]                                                                           
                    try:                                                                                                
                        return json.loads(array_str)                                                                    
                    except json.JSONDecodeError:                                                                        
                        # Try to sanitize any control characters that might break JSON                                  
                        sanitized = array_str.replace('\u2013', '-').replace('\u2014', '-')                             
                        return json.loads(sanitized)                                                                    
    return []                                                                                                           
                                                                                                                        
